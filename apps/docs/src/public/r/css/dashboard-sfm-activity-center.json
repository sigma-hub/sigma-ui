{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-sfm-activity-center",
  "type": "registry:block",
  "title": "Activity center",
  "description": "A header button with a live job count that opens a popover of running jobs with progress and cancel, and a collapsible list of finished jobs with retry and dismiss.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "card",
    "collapsible",
    "popover",
    "progress",
    "separator",
    "spinner"
  ],
  "files": [
    {
      "path": "blocks/dashboard-sfm-activity-center/DashboardSfmActivityCenter.vue",
      "content": "<script setup lang=\"ts\">\nimport { onBeforeUnmount, onMounted, ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport ActivityCenter from './components/ActivityCenter.vue';\nimport { demoDescription, demoTitle, initialItems, kindIcons, pageDescription, pageTitle, sampleJobs } from './data';\nimport type { ActivityItem, ActivityKind } from './data';\n\nwithDefaults(defineProps<{\n  defaultOpen?: boolean;\n}>(), {\n  defaultOpen: true,\n});\n\nconst items = ref<ActivityItem[]>(initialItems.map(item => ({ ...item })));\nconst timers = new Map<string, ReturnType<typeof setInterval>>();\nlet jobCounter = 0;\n\nfunction updateItem(id: string, patch: Partial<ActivityItem>) {\n  const item = items.value.find(entry => entry.id === id);\n\n  if (item) {\n    Object.assign(item, patch);\n  }\n}\n\nfunction stopTimer(id: string) {\n  const timer = timers.get(id);\n\n  if (timer !== undefined) {\n    clearInterval(timer);\n  }\n\n  timers.delete(id);\n}\n\n// Simulates a job. Replace this with real progress events from your API or worker.\nfunction runJob(id: string, successMessage: string) {\n  stopTimer(id);\n  let ticks = 0;\n  timers.set(id, setInterval(() => {\n    const item = items.value.find(entry => entry.id === id);\n\n    if (!item || item.status !== 'running') {\n      stopTimer(id);\n      return;\n    }\n\n    ticks += 1;\n\n    if (item.progress === null) {\n      if (ticks >= 4) {\n        item.progress = 0;\n      }\n\n      return;\n    }\n\n    item.progress = Math.min(100, item.progress + 4 + (ticks % 3) * 2);\n\n    if (item.progress >= 100) {\n      Object.assign(item, { status: 'success', message: successMessage });\n      stopTimer(id);\n    }\n  }, 1000));\n}\n\nfunction startJob(kind: ActivityKind) {\n  const sample = sampleJobs[kind];\n  jobCounter += 1;\n  const id = `demo-job-${jobCounter}`;\n  items.value.unshift({\n    id,\n    kind: sample.kind,\n    title: sample.title,\n    subtitle: sample.subtitle,\n    status: 'running',\n    progress: kind === 'sync' ? null : 0,\n  });\n  runJob(id, sample.successMessage);\n}\n\nfunction cancelJob(id: string) {\n  updateItem(id, { status: 'cancelled', message: 'Cancelled' });\n  stopTimer(id);\n}\n\nfunction cancelAll() {\n  items.value.filter(item => item.status === 'running').forEach(item => cancelJob(item.id));\n}\n\nfunction dismissJob(id: string) {\n  stopTimer(id);\n  items.value = items.value.filter(item => item.id !== id);\n}\n\nfunction clearCompleted() {\n  items.value = items.value.filter(item => item.status === 'running');\n}\n\nfunction retryJob(id: string) {\n  const item = items.value.find(entry => entry.id === id);\n\n  if (!item) {\n    return;\n  }\n\n  updateItem(id, { status: 'running', progress: null, message: undefined });\n  runJob(id, 'Completed');\n}\n\nonMounted(() => {\n  items.value\n    .filter(item => item.status === 'running')\n    .forEach(item => runJob(item.id, 'Completed'));\n});\n\nonBeforeUnmount(() => {\n  timers.forEach(timer => clearInterval(timer));\n  timers.clear();\n});\n</script>\n\n<template>\n  <div class=\"dashboard-sfm-activity-center\">\n    <header class=\"dashboard-sfm-activity-center__header\">\n      <div class=\"dashboard-sfm-activity-center__intro\">\n        <h2 class=\"dashboard-sfm-activity-center__page-title\">\n          {{ pageTitle }}\n        </h2>\n        <p class=\"dashboard-sfm-activity-center__page-description\">\n          {{ pageDescription }}\n        </p>\n      </div>\n      <ActivityCenter\n        :items=\"items\"\n        :default-open=\"defaultOpen\"\n        @cancel=\"cancelJob\"\n        @cancel-all=\"cancelAll\"\n        @dismiss=\"dismissJob\"\n        @clear-completed=\"clearCompleted\"\n        @retry=\"retryJob\"\n      />\n    </header>\n\n    <Card>\n      <CardHeader>\n        <CardTitle>{{ demoTitle }}</CardTitle>\n        <CardDescription>{{ demoDescription }}</CardDescription>\n      </CardHeader>\n      <CardContent>\n        <div class=\"dashboard-sfm-activity-center__actions\">\n          <Button\n            v-for=\"sample in sampleJobs\"\n            :key=\"sample.kind\"\n            variant=\"outline\"\n            @click=\"startJob(sample.kind)\"\n          >\n            <component\n              :is=\"kindIcons[sample.kind]\"\n              aria-hidden=\"true\"\n            />\n            {{ sample.label }}\n          </Button>\n        </div>\n      </CardContent>\n    </Card>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-sfm-activity-center {\n    display: flex;\n    width: 100%;\n    max-width: 64rem;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    margin-inline: auto;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-sfm-activity-center__header {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-activity-center__intro {\n    display: flex;\n    min-width: 0;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-sfm-activity-center__page-title {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.025em;\n    line-height: 2rem;\n  }\n\n  .dashboard-sfm-activity-center__page-description {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-sfm-activity-center__actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-sfm-activity-center {\n      padding: calc(var(--spacing) * 6);\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sfm-activity-center/components/ActivityCenter.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, nextTick, ref } from 'vue';\nimport { ActivityIcon, ChevronDownIcon, ChevronRightIcon, InboxIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible';\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';\nimport { Separator } from '@/components/ui/separator';\nimport { Spinner } from '@/components/ui/spinner';\nimport ActivityRow from './ActivityRow.vue';\nimport { activityLabel, emptyHint, emptyLabel } from '../data';\nimport type { ActivityItem } from '../data';\n\nconst props = withDefaults(defineProps<{\n  items: ActivityItem[];\n  defaultOpen?: boolean;\n}>(), {\n  defaultOpen: false,\n});\n\nconst emit = defineEmits<{\n  cancel: [id: string];\n  cancelAll: [];\n  dismiss: [id: string];\n  clearCompleted: [];\n  retry: [id: string];\n}>();\n\nconst open = ref(props.defaultOpen);\nconst headingRef = ref<HTMLElement | null>(null);\nconst completedOpen = ref(true);\n\nconst running = computed(() => props.items.filter(item => item.status === 'running'));\nconst completed = computed(() => props.items.filter(item => item.status !== 'running'));\nconst failedCount = computed(() => completed.value.filter(item => item.status === 'error').length);\n\nconst summary = computed(() => {\n  if (props.items.length === 0) {\n    return emptyLabel;\n  }\n\n  const parts: string[] = [];\n\n  if (running.value.length > 0) {\n    parts.push(`${running.value.length} running`);\n  }\n\n  if (completed.value.length > 0) {\n    parts.push(`${completed.value.length} finished`);\n  }\n\n  if (failedCount.value > 0) {\n    parts.push(`${failedCount.value} failed`);\n  }\n\n  return parts.join(' · ');\n});\n\n/**\n * Reka focuses the first button when the panel opens, which is the destructive \"Cancel all\".\n * Focus the panel heading instead, so Tab still reaches every control in order.\n */\nfunction focusHeading(event: Event) {\n  event.preventDefault();\n  nextTick(() => headingRef.value?.focus({ preventScroll: true }));\n}\n\nconst triggerLabel = computed(() => `${activityLabel}: ${summary.value}`);\n</script>\n\n<template>\n  <Popover v-model:open=\"open\">\n    <PopoverTrigger as-child>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        :aria-label=\"triggerLabel\"\n      >\n        <Spinner\n          v-if=\"running.length > 0\"\n          label=\"Jobs running\"\n        />\n        <ActivityIcon\n          v-else\n          aria-hidden=\"true\"\n        />\n        {{ activityLabel }}\n        <Badge\n          v-if=\"running.length > 0\"\n          variant=\"secondary\"\n        >\n          {{ running.length }}\n        </Badge>\n        <Badge\n          v-else-if=\"failedCount > 0\"\n          variant=\"destructive\"\n        >\n          {{ failedCount }}\n        </Badge>\n      </Button>\n    </PopoverTrigger>\n    <PopoverContent\n      align=\"end\"\n      class=\"dashboard-sfm-activity-center__popover\"\n      @open-auto-focus=\"focusHeading\"\n    >\n      <div class=\"dashboard-sfm-activity-center__panel-header\">\n        <div class=\"dashboard-sfm-activity-center__heading\">\n          <h3\n            ref=\"headingRef\"\n            tabindex=\"-1\"\n            class=\"dashboard-sfm-activity-center__heading-title\"\n          >\n            {{ activityLabel }}\n          </h3>\n          <p class=\"dashboard-sfm-activity-center__summary\">\n            {{ summary }}\n          </p>\n        </div>\n        <Button\n          v-if=\"running.length > 1\"\n          variant=\"outline\"\n          size=\"xs\"\n          @click=\"emit('cancelAll')\"\n        >\n          Cancel all\n        </Button>\n      </div>\n      <Separator />\n\n      <div\n        v-if=\"items.length === 0\"\n        class=\"dashboard-sfm-activity-center__empty\"\n      >\n        <InboxIcon\n          class=\"dashboard-sfm-activity-center__empty-icon\"\n          aria-hidden=\"true\"\n        />\n        <p class=\"dashboard-sfm-activity-center__empty-title\">\n          {{ emptyLabel }}\n        </p>\n        <p class=\"dashboard-sfm-activity-center__empty-hint\">\n          {{ emptyHint }}\n        </p>\n      </div>\n\n      <div\n        v-else\n        class=\"dashboard-sfm-activity-center__scroll\"\n      >\n        <ul\n          v-if=\"running.length > 0\"\n          class=\"dashboard-sfm-activity-center__list\"\n          aria-label=\"Running jobs\"\n        >\n          <ActivityRow\n            v-for=\"item in running\"\n            :key=\"item.id\"\n            :item=\"item\"\n            @cancel=\"emit('cancel', $event)\"\n          />\n        </ul>\n\n        <Collapsible\n          v-if=\"completed.length > 0\"\n          v-model:open=\"completedOpen\"\n          :class=\"{ 'dashboard-sfm-activity-center__completed--divided': running.length > 0 }\"\n        >\n          <div class=\"dashboard-sfm-activity-center__completed-header\">\n            <CollapsibleTrigger as-child>\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n              >\n                <ChevronDownIcon v-if=\"completedOpen\" />\n                <ChevronRightIcon v-else />\n                Finished\n                <Badge variant=\"secondary\">\n                  {{ completed.length }}\n                </Badge>\n              </Button>\n            </CollapsibleTrigger>\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              @click=\"emit('clearCompleted')\"\n            >\n              Clear\n            </Button>\n          </div>\n          <CollapsibleContent>\n            <ul\n              class=\"dashboard-sfm-activity-center__list dashboard-sfm-activity-center__list--bordered\"\n              aria-label=\"Finished jobs\"\n            >\n              <ActivityRow\n                v-for=\"item in completed\"\n                :key=\"item.id\"\n                :item=\"item\"\n                @dismiss=\"emit('dismiss', $event)\"\n                @retry=\"emit('retry', $event)\"\n              />\n            </ul>\n          </CollapsibleContent>\n        </Collapsible>\n      </div>\n    </PopoverContent>\n  </Popover>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-sfm-activity-center__popover.dashboard-sfm-activity-center__popover {\n    width: min(24rem, calc(100vw - 2rem));\n    padding: 0;\n  }\n\n  .dashboard-sfm-activity-center__panel-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-sfm-activity-center__heading {\n    min-width: 0;\n  }\n\n  .dashboard-sfm-activity-center__heading-title {\n    margin: 0;\n    outline: none;\n    font-size: 0.875rem;\n    font-weight: 600;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-sfm-activity-center__summary {\n    overflow: hidden;\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    line-height: 1rem;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .dashboard-sfm-activity-center__empty {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: calc(var(--spacing) * 10) calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 2);\n    text-align: center;\n  }\n\n  .dashboard-sfm-activity-center__empty-icon {\n    width: calc(var(--spacing) * 6);\n    height: calc(var(--spacing) * 6);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-sfm-activity-center__empty-title {\n    margin: 0;\n    font-size: 0.875rem;\n    font-weight: 500;\n  }\n\n  .dashboard-sfm-activity-center__empty-hint {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n  }\n\n  .dashboard-sfm-activity-center__scroll {\n    max-height: min(26rem, 60vh);\n    overflow-y: auto;\n  }\n\n  .dashboard-sfm-activity-center__list {\n    padding: 0;\n    margin: 0;\n    list-style: none;\n  }\n\n  .dashboard-sfm-activity-center__list > li + li {\n    border-top: 1px solid var(--border);\n  }\n\n  .dashboard-sfm-activity-center__list--bordered {\n    border-top: 1px solid var(--border);\n  }\n\n  .dashboard-sfm-activity-center__completed--divided {\n    border-top: 1px solid var(--border);\n  }\n\n  .dashboard-sfm-activity-center__completed-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2);\n    gap: calc(var(--spacing) * 2);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sfm-activity-center/components/ActivityRow.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport { BanIcon, CircleAlertIcon, CircleCheckIcon, RotateCwIcon, XIcon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { Progress } from '@/components/ui/progress';\nimport { kindIcons } from '../data';\nimport type { ActivityItem } from '../data';\n\nconst props = defineProps<{\n  item: ActivityItem;\n}>();\n\nconst emit = defineEmits<{\n  cancel: [id: string];\n  dismiss: [id: string];\n  retry: [id: string];\n}>();\n\nconst isRunning = computed(() => props.item.status === 'running');\nconst isSuccess = computed(() => props.item.status === 'success');\nconst isError = computed(() => props.item.status === 'error');\n\nconst statusIcon = computed(() => {\n  if (props.item.status === 'success') {\n    return CircleCheckIcon;\n  }\n\n  if (props.item.status === 'error') {\n    return CircleAlertIcon;\n  }\n\n  if (props.item.status === 'cancelled') {\n    return BanIcon;\n  }\n\n  return kindIcons[props.item.kind];\n});\n\nconst detail = computed(() => {\n  if (isRunning.value) {\n    return props.item.subtitle;\n  }\n\n  return props.item.message ?? (props.item.status === 'cancelled' ? 'Cancelled' : props.item.subtitle);\n});\n\nconst percentLabel = computed(() => {\n  return props.item.progress === null ? '' : `${Math.round(props.item.progress)}%`;\n});\n</script>\n\n<template>\n  <li class=\"dashboard-sfm-activity-center__row\">\n    <div\n      class=\"dashboard-sfm-activity-center__icon\"\n      :class=\"isSuccess\n        ? 'dashboard-sfm-activity-center__icon--success'\n        : isError\n          ? 'dashboard-sfm-activity-center__icon--error'\n          : 'dashboard-sfm-activity-center__icon--idle'\"\n    >\n      <component\n        :is=\"statusIcon\"\n        aria-hidden=\"true\"\n      />\n    </div>\n    <div class=\"dashboard-sfm-activity-center__body\">\n      <div class=\"dashboard-sfm-activity-center__text\">\n        <p class=\"dashboard-sfm-activity-center__title\">\n          {{ item.title }}\n        </p>\n        <p\n          class=\"dashboard-sfm-activity-center__detail\"\n          :class=\"isError ? 'dashboard-sfm-activity-center__detail--error' : 'dashboard-sfm-activity-center__detail--idle'\"\n        >\n          {{ detail }}\n        </p>\n      </div>\n      <div\n        v-if=\"isRunning\"\n        class=\"dashboard-sfm-activity-center__progress\"\n      >\n        <Progress\n          :model-value=\"item.progress ?? 100\"\n          :aria-label=\"`${item.title} progress`\"\n          :class=\"{ 'dashboard-sfm-activity-center__bar--pending': item.progress === null }\"\n        />\n        <span class=\"dashboard-sfm-activity-center__percent\">\n          {{ percentLabel }}\n        </span>\n      </div>\n    </div>\n    <Button\n      v-if=\"isError\"\n      variant=\"ghost\"\n      size=\"icon-xs\"\n      :aria-label=\"`Retry ${item.title}`\"\n      @click=\"emit('retry', item.id)\"\n    >\n      <RotateCwIcon />\n    </Button>\n    <Button\n      variant=\"ghost\"\n      size=\"icon-xs\"\n      :aria-label=\"isRunning ? `Cancel ${item.title}` : `Dismiss ${item.title}`\"\n      @click=\"isRunning ? emit('cancel', item.id) : emit('dismiss', item.id)\"\n    >\n      <XIcon />\n    </Button>\n  </li>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-sfm-activity-center__row {\n    display: flex;\n    align-items: flex-start;\n    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-sfm-activity-center__icon {\n    display: flex;\n    width: calc(var(--spacing) * 8);\n    height: calc(var(--spacing) * 8);\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    border-radius: calc(var(--radius) - 2px);\n  }\n\n  .dashboard-sfm-activity-center__icon--idle {\n    background-color: var(--muted);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-sfm-activity-center__icon svg {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-activity-center__icon--success {\n    background-color: color-mix(in oklch, var(--success, oklch(62.3% 0.169 149.178deg)) 12%, transparent);\n    color: var(--success, oklch(62.3% 0.169 149.178deg));\n  }\n\n  .dashboard-sfm-activity-center__icon--error {\n    background-color: color-mix(in oklch, var(--destructive) 10%, transparent);\n    color: var(--destructive);\n  }\n\n  .dashboard-sfm-activity-center__body {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-sfm-activity-center__text {\n    min-width: 0;\n  }\n\n  .dashboard-sfm-activity-center__title,\n  .dashboard-sfm-activity-center__detail {\n    overflow: hidden;\n    margin: 0;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .dashboard-sfm-activity-center__title {\n    font-size: 0.875rem;\n    font-weight: 500;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-sfm-activity-center__detail {\n    font-size: 0.75rem;\n    line-height: 1rem;\n  }\n\n  .dashboard-sfm-activity-center__detail--idle {\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-sfm-activity-center__detail--error {\n    color: var(--destructive);\n  }\n\n  .dashboard-sfm-activity-center__progress {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-sfm-activity-center__bar--pending {\n    animation: dashboard-sfm-activity-center-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  }\n\n  @keyframes dashboard-sfm-activity-center-pulse {\n    50% {\n      opacity: 0.5;\n    }\n  }\n\n  .dashboard-sfm-activity-center__percent {\n    width: calc(var(--spacing) * 9);\n    flex-shrink: 0;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    font-variant-numeric: tabular-nums;\n    line-height: 1rem;\n    text-align: right;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sfm-activity-center/data.ts",
      "content": "import type { Component } from 'vue';\nimport { DownloadIcon, FileInputIcon, RefreshCwIcon, UploadIcon } from '@lucide/vue';\n\nexport type ActivityKind = 'upload' | 'export' | 'sync' | 'import';\nexport type ActivityStatus = 'running' | 'success' | 'error' | 'cancelled';\n\nexport interface ActivityItem {\n  id: string;\n  kind: ActivityKind;\n  title: string;\n  subtitle: string;\n  status: ActivityStatus;\n  /** 0-100, or null while the job is still preparing and has no measurable progress. */\n  progress: number | null;\n  /** Result text shown once the job is no longer running. */\n  message?: string;\n}\n\nexport const kindIcons: Record<ActivityKind, Component> = {\n  upload: UploadIcon,\n  export: DownloadIcon,\n  sync: RefreshCwIcon,\n  import: FileInputIcon,\n};\n\nexport const sampleJobs: Record<ActivityKind, Pick<ActivityItem, 'kind' | 'title' | 'subtitle'> & { successMessage: string; label: string }> = {\n  upload: {\n    kind: 'upload',\n    label: 'Start upload',\n    title: 'Uploading brand-assets.zip',\n    subtitle: '48 files to Marketing / Assets',\n    successMessage: 'Uploaded 48 files',\n  },\n  export: {\n    kind: 'export',\n    label: 'Start export',\n    title: 'Exporting orders report',\n    subtitle: 'CSV, last 90 days',\n    successMessage: 'Report is ready to download',\n  },\n  sync: {\n    kind: 'sync',\n    label: 'Start sync',\n    title: 'Syncing contacts',\n    subtitle: 'Connecting to CRM',\n    successMessage: 'Synced 2,418 contacts',\n  },\n  import: {\n    kind: 'import',\n    label: 'Start import',\n    title: 'Importing customers.csv',\n    subtitle: '1,248 rows',\n    successMessage: 'Added 1,248 customers',\n  },\n};\n\nexport const initialItems: ActivityItem[] = [\n  {\n    id: 'job-a',\n    kind: 'upload',\n    title: 'Uploading design-files.zip',\n    subtitle: '12.4 MB of 19.4 MB',\n    status: 'running',\n    progress: 64,\n  },\n  {\n    id: 'job-b',\n    kind: 'export',\n    title: 'Exporting invoices',\n    subtitle: 'PDF, March 2026',\n    status: 'running',\n    progress: 32,\n  },\n  {\n    id: 'job-c',\n    kind: 'sync',\n    title: 'Syncing contacts',\n    subtitle: 'Connecting to CRM',\n    status: 'running',\n    progress: null,\n  },\n  {\n    id: 'job-d',\n    kind: 'import',\n    title: 'Importing customers.csv',\n    subtitle: '1,248 rows',\n    status: 'success',\n    progress: 100,\n    message: 'Added 1,248 customers',\n  },\n  {\n    id: 'job-e',\n    kind: 'sync',\n    title: 'Backing up to cloud storage',\n    subtitle: 'Nightly backup',\n    status: 'error',\n    progress: 41,\n    message: 'Connection timed out',\n  },\n];\n\nexport const pageTitle = 'Workspace';\nexport const pageDescription = 'Long-running tasks keep going in the background. Follow them from the activity center.';\nexport const demoTitle = 'Background jobs';\nexport const demoDescription = 'Start a sample job and watch it move through the activity center.';\nexport const activityLabel = 'Activity';\nexport const emptyLabel = 'No background activity';\nexport const emptyHint = 'Uploads, exports and syncs will show up here.';\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "900px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
