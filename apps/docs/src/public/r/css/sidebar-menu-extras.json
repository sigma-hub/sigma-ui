{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-menu-extras",
  "type": "registry:example",
  "title": "SidebarMenuExtras",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "dropdown-menu",
    "sidebar"
  ],
  "files": [
    {
      "path": "example/SidebarMenuExtras.vue",
      "content": "<script setup lang=\"ts\">\nimport { FolderIcon, InboxIcon, MoreHorizontalIcon, PlusIcon, SendIcon, StarIcon, Trash2Icon } from '@lucide/vue';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupAction,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInput,\n  SidebarMenu,\n  SidebarMenuAction,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSkeleton,\n  SidebarProvider,\n  SidebarSeparator,\n} from '@/components/ui/sidebar';\n\nconst mailboxes = [\n  { title: 'Inbox', icon: InboxIcon, count: 128, isActive: true },\n  { title: 'Starred', icon: StarIcon, count: 9 },\n  { title: 'Sent', icon: SendIcon },\n  { title: 'Trash', icon: Trash2Icon, count: 23 },\n];\n\nconst projects = ['Design system', 'Marketing site'];\n</script>\n\n<template>\n  <div class=\"example-sidebar-extras\">\n    <SidebarProvider\n      cookie-name=\"\"\n      class=\"example-sidebar-extras__provider\"\n    >\n      <Sidebar\n        collapsible=\"none\"\n        class=\"example-sidebar-extras__sidebar\"\n      >\n        <SidebarHeader>\n          <SidebarInput placeholder=\"Search mail...\" />\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Mailboxes</SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem\n                  v-for=\"mailbox in mailboxes\"\n                  :key=\"mailbox.title\"\n                >\n                  <SidebarMenuButton :is-active=\"mailbox.isActive\">\n                    <component :is=\"mailbox.icon\" />\n                    <span>{{ mailbox.title }}</span>\n                  </SidebarMenuButton>\n                  <SidebarMenuBadge v-if=\"mailbox.count\">\n                    {{ mailbox.count }}\n                  </SidebarMenuBadge>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n          <SidebarSeparator />\n          <SidebarGroup>\n            <SidebarGroupLabel>Projects</SidebarGroupLabel>\n            <SidebarGroupAction\n              title=\"Add project\"\n              aria-label=\"Add project\"\n            >\n              <PlusIcon />\n            </SidebarGroupAction>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem\n                  v-for=\"project in projects\"\n                  :key=\"project\"\n                >\n                  <SidebarMenuButton>\n                    <FolderIcon />\n                    <span>{{ project }}</span>\n                  </SidebarMenuButton>\n                  <DropdownMenu>\n                    <DropdownMenuTrigger as-child>\n                      <SidebarMenuAction\n                        show-on-hover\n                        aria-label=\"More\"\n                      >\n                        <MoreHorizontalIcon />\n                      </SidebarMenuAction>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent\n                      side=\"right\"\n                      align=\"start\"\n                    >\n                      <DropdownMenuItem>View project</DropdownMenuItem>\n                      <DropdownMenuItem>Share project</DropdownMenuItem>\n                      <DropdownMenuItem>Delete project</DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </SidebarMenuItem>\n                <SidebarMenuItem>\n                  <SidebarMenuSkeleton show-icon />\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n      </Sidebar>\n      <main class=\"example-sidebar-extras__main\">\n        Select a mailbox\n      </main>\n    </SidebarProvider>\n  </div>\n</template>\n\n<style>\n.example-sidebar-extras {\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  height: 480px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  transform: translateZ(0);\n}\n\n.example-sidebar-extras .example-sidebar-extras__provider {\n  height: 100%;\n  min-height: 100%;\n}\n\n.example-sidebar-extras .example-sidebar-extras__sidebar {\n  border-right: 1px solid var(--border);\n}\n\n.example-sidebar-extras__main {\n  display: flex;\n  flex: 1;\n  align-items: center;\n  justify-content: center;\n  padding: calc(var(--spacing) * 4);\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
