{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-scroll-body",
  "type": "registry:example",
  "title": "DialogScrollBody",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "dialog"
  ],
  "files": [
    {
      "path": "example/DialogScrollBody.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\n</script>\n\n<template>\n  <Dialog>\n    <DialogTrigger as-child>\n      <Button variant=\"outline\">\n        Edit Profile\n      </Button>\n    </DialogTrigger>\n    <DialogContent class=\"example-sigma-ui-dialog-scroll__content example-sigma-ui-dialog-scroll__content--scroll\">\n      <DialogHeader class=\"example-sigma-ui-dialog-scroll__header\">\n        <DialogTitle>Edit profile</DialogTitle>\n        <DialogDescription>\n          Make changes to your profile here. Click save when you're done.\n        </DialogDescription>\n      </DialogHeader>\n      <div class=\"example-sigma-ui-dialog-scroll__body\">\n        <div class=\"example-sigma-ui-dialog-scroll__scroll-content\">\n          <p>\n            This is some placeholder content to show the scrolling behavior for modals. We use repeated line breaks to demonstrate how content can exceed minimum inner height, thereby showing inner scrolling. When content becomes longer than the predefined max-height of modal, content will be cropped and scrollable within the modal.\n          </p>\n\n          <p>This content should appear at the bottom after you scroll.</p>\n        </div>\n      </div>\n      <DialogFooter class=\"example-sigma-ui-dialog-scroll__footer\">\n        <Button type=\"submit\">\n          Save changes\n        </Button>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-sigma-ui-dialog-scroll__content {\n    max-width: 425px;\n  }\n\n  .example-sigma-ui-dialog-scroll__content--scroll {\n    display: grid;\n    max-height: 90dvh;\n    padding: 0;\n    grid-template-rows: auto minmax(0, 1fr) auto;\n  }\n\n  @media (width >= 40rem) {\n    .example-sigma-ui-dialog-scroll__content {\n      max-width: 425px;\n    }\n  }\n\n  .example-sigma-ui-dialog-scroll__header {\n    padding: calc(var(--spacing) * 6);\n    padding-bottom: 0;\n  }\n\n  .example-sigma-ui-dialog-scroll__body {\n    display: grid;\n    padding: calc(var(--spacing) * 6);\n    gap: calc(var(--spacing) * 4);\n    overflow-y: auto;\n  }\n\n  .example-sigma-ui-dialog-scroll__scroll-content {\n    display: flex;\n    height: 300dvh;\n    flex-direction: column;\n    justify-content: space-between;\n  }\n\n  .example-sigma-ui-dialog-scroll__footer {\n    padding: calc(var(--spacing) * 6);\n    padding-top: 0;\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
