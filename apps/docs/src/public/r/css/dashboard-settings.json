{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-settings",
  "type": "registry:block",
  "title": "Settings page",
  "description": "A settings page. The settings page has a sidebar navigation and a main content area. The main content area has a form to update the store name and a form to update the plugins directory. The sidebar navigation has links to general, security, integrations, support, organizations, and advanced settings.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button",
    "card",
    "checkbox",
    "dropdown-menu",
    "input",
    "sheet"
  ],
  "files": [
    {
      "path": "blocks/dashboard-settings/DashboardSettings.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport PluginsDirectoryCard from './components/PluginsDirectoryCard.vue';\nimport SettingsNav from './components/SettingsNav.vue';\nimport StoreNameCard from './components/StoreNameCard.vue';\nimport {\n  accountMenu,\n  brandHref,\n  brandName,\n  headerLinks,\n  navigationLabel,\n  pageTitle,\n  pluginsDirectoryCard,\n  searchPlaceholder,\n  settingsLinks,\n  storeNameCard,\n  userMenuLabel,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-settings\">\n    <AppHeader\n      :brand-name=\"brandName\"\n      :brand-href=\"brandHref\"\n      :links=\"headerLinks\"\n      :search-placeholder=\"searchPlaceholder\"\n      :menu-entries=\"accountMenu\"\n      :user-menu-label=\"userMenuLabel\"\n      :navigation-label=\"navigationLabel\"\n    />\n    <main class=\"dashboard-settings__main\">\n      <div class=\"dashboard-settings__intro\">\n        <h1 class=\"dashboard-settings__title\">\n          {{ pageTitle }}\n        </h1>\n      </div>\n      <div class=\"dashboard-settings__layout\">\n        <SettingsNav :links=\"settingsLinks\" />\n        <div class=\"dashboard-settings__cards\">\n          <StoreNameCard\n            :title=\"storeNameCard.title\"\n            :description=\"storeNameCard.description\"\n            :placeholder=\"storeNameCard.placeholder\"\n            :save-label=\"storeNameCard.saveLabel\"\n          />\n          <PluginsDirectoryCard\n            :title=\"pluginsDirectoryCard.title\"\n            :description=\"pluginsDirectoryCard.description\"\n            :placeholder=\"pluginsDirectoryCard.placeholder\"\n            :directory=\"pluginsDirectoryCard.directory\"\n            :checkbox-id=\"pluginsDirectoryCard.checkboxId\"\n            :checkbox-label=\"pluginsDirectoryCard.checkboxLabel\"\n            :include-checked=\"pluginsDirectoryCard.includeChecked\"\n            :save-label=\"pluginsDirectoryCard.saveLabel\"\n          />\n        </div>\n      </div>\n    </main>\n  </div>\n</template>\n\n<style>\n.dashboard-settings {\n  display: flex;\n  width: 100%;\n  min-height: 100vh;\n  flex-direction: column;\n}\n\n.dashboard-settings__main {\n  display: flex;\n  min-height: calc(100vh - 4rem);\n  flex: 1 1 0%;\n  flex-direction: column;\n  gap: 1rem;\n  background-color: hsl(var(--muted) / 40%);\n  padding: 1rem;\n}\n\n.dashboard-settings__intro,\n.dashboard-settings__layout {\n  display: grid;\n  width: 100%;\n  max-width: 72rem;\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.dashboard-settings__intro {\n  gap: 0.5rem;\n}\n\n.dashboard-settings__layout {\n  align-items: start;\n  gap: 1.5rem;\n}\n\n.dashboard-settings__title {\n  margin: 0;\n  font-size: 1.875rem;\n  font-weight: 600;\n  line-height: 2.25rem;\n}\n\n.dashboard-settings__cards {\n  display: grid;\n  gap: 1.5rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-settings__main {\n    gap: 2rem;\n    padding: 2.5rem;\n  }\n\n  .dashboard-settings__layout {\n    grid-template-columns: 180px 1fr;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-settings__layout {\n    grid-template-columns: 250px 1fr;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { MenuIcon, Package2Icon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { AccountMenuEntry, NavLink } from '../data';\nimport SearchForm from './SearchForm.vue';\nimport UserMenu from './UserMenu.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  searchPlaceholder: string;\n  menuEntries: AccountMenuEntry[];\n  userMenuLabel: string;\n  navigationLabel: string;\n}>();\n</script>\n\n<template>\n  <header class=\"dashboard-settings__header\">\n    <nav class=\"dashboard-settings__desktop-nav\">\n      <a\n        :href=\"brandHref\"\n        class=\"dashboard-settings__brand dashboard-settings__brand--desktop\"\n      >\n        <Package2Icon class=\"dashboard-settings__icon-lg\" />\n        <span class=\"dashboard-settings__sr-only\">{{ brandName }}</span>\n      </a>\n      <a\n        v-for=\"link in links\"\n        :key=\"link.label\"\n        :href=\"link.href\"\n        class=\"dashboard-settings__desktop-link\"\n        :class=\"{ 'dashboard-settings__desktop-link--active': link.isActive }\"\n      >\n        {{ link.label }}\n      </a>\n    </nav>\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          variant=\"outline\"\n          size=\"icon\"\n          class=\"dashboard-settings__menu-button\"\n        >\n          <MenuIcon class=\"dashboard-settings__icon-md\" />\n          <span class=\"dashboard-settings__sr-only\">{{ navigationLabel }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent side=\"left\">\n        <nav class=\"dashboard-settings__mobile-nav\">\n          <a\n            :href=\"brandHref\"\n            class=\"dashboard-settings__brand\"\n          >\n            <Package2Icon class=\"dashboard-settings__icon-lg\" />\n            <span class=\"dashboard-settings__sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"link in links\"\n            :key=\"link.label\"\n            :href=\"link.href\"\n            class=\"dashboard-settings__mobile-link\"\n            :class=\"{ 'dashboard-settings__mobile-link--muted': !link.isActive }\"\n          >\n            {{ link.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <div class=\"dashboard-settings__tools\">\n      <SearchForm :placeholder=\"searchPlaceholder\" />\n      <UserMenu\n        :entries=\"menuEntries\"\n        :trigger-label=\"userMenuLabel\"\n      />\n    </div>\n  </header>\n</template>\n\n<style>\n.dashboard-settings__header {\n  position: sticky;\n  top: 0;\n  display: flex;\n  height: 4rem;\n  align-items: center;\n  gap: 1rem;\n  border-bottom: 1px solid hsl(var(--border));\n  background-color: hsl(var(--background));\n  padding: 0 1rem;\n}\n\n.dashboard-settings__desktop-nav {\n  display: none;\n  font-weight: 500;\n}\n\n.dashboard-settings__brand {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: inherit;\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n  text-decoration: none;\n}\n\n.dashboard-settings__desktop-link {\n  color: hsl(var(--muted-foreground));\n  text-decoration: none;\n  transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-settings__desktop-link:hover,\n.dashboard-settings__desktop-link--active,\n.dashboard-settings__desktop-link--active:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-settings__mobile-nav {\n  display: grid;\n  gap: 1.5rem;\n  font-size: 1.125rem;\n  font-weight: 500;\n  line-height: 1.75rem;\n}\n\n.dashboard-settings__mobile-link {\n  color: hsl(var(--foreground));\n  text-decoration: none;\n}\n\n.dashboard-settings__mobile-link:hover,\n.dashboard-settings__mobile-link--muted:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-settings__mobile-link--muted {\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-settings__tools {\n  display: flex;\n  width: 100%;\n  align-items: center;\n  gap: 1rem;\n}\n\n.dashboard-settings__menu-button {\n  flex-shrink: 0;\n}\n\n.dashboard-settings__icon-lg {\n  width: 1.5rem;\n  height: 1.5rem;\n}\n\n.dashboard-settings__icon-md {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-settings__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n@media (width >= 768px) {\n  .dashboard-settings__header {\n    padding: 0 1.5rem;\n  }\n\n  .dashboard-settings__desktop-nav {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    gap: 1.25rem;\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-settings__brand--desktop {\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n\n  .dashboard-settings__tools {\n    margin-left: auto;\n    gap: 0.5rem;\n  }\n\n  .dashboard-settings__menu-button.dashboard-settings__menu-button {\n    display: none;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-settings__desktop-nav {\n    gap: 1.5rem;\n  }\n\n  .dashboard-settings__tools {\n    gap: 1rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/PluginsDirectoryCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport { Input } from '@/components/ui/input';\nimport type { PluginsDirectoryCardData } from '../data';\n\ndefineProps<PluginsDirectoryCardData>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n      <CardDescription>\n        {{ description }}\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <form class=\"dashboard-settings__plugin-form\">\n        <Input\n          :placeholder=\"placeholder\"\n          :model-value=\"directory\"\n        />\n        <div class=\"dashboard-settings__checkbox-row\">\n          <Checkbox\n            :id=\"checkboxId\"\n            :model-value=\"includeChecked\"\n          />\n          <label\n            :for=\"checkboxId\"\n            class=\"dashboard-settings__checkbox-label\"\n          >\n            {{ checkboxLabel }}\n          </label>\n        </div>\n      </form>\n    </CardContent>\n    <CardFooter class=\"dashboard-settings__card-footer\">\n      <Button>{{ saveLabel }}</Button>\n    </CardFooter>\n  </Card>\n</template>\n\n<style>\n.dashboard-settings__plugin-form {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.dashboard-settings__checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.dashboard-settings__checkbox-label {\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1;\n}\n\n.dashboard-settings__card-footer.dashboard-settings__card-footer {\n  border-top: 1px solid hsl(var(--border));\n  padding: 1rem 1.5rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/SearchForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { SearchIcon } from 'lucide-vue-next';\nimport { Input } from '@/components/ui/input';\n\ndefineProps<{\n  placeholder: string;\n}>();\n</script>\n\n<template>\n  <form class=\"dashboard-settings__search\">\n    <div class=\"dashboard-settings__search-field\">\n      <SearchIcon class=\"dashboard-settings__search-icon\" />\n      <Input\n        type=\"search\"\n        :placeholder=\"placeholder\"\n        class=\"dashboard-settings__search-input\"\n      />\n    </div>\n  </form>\n</template>\n\n<style>\n.dashboard-settings__search {\n  margin-left: auto;\n  flex: 1 1 0%;\n}\n\n.dashboard-settings__search-field {\n  position: relative;\n}\n\n.dashboard-settings__search-icon {\n  position: absolute;\n  top: 0.625rem;\n  left: 0.625rem;\n  width: 1rem;\n  height: 1rem;\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-settings__search-input.dashboard-settings__search-input {\n  padding-left: 2rem;\n}\n\n@media (width >= 640px) {\n  .dashboard-settings__search {\n    flex: 0 1 auto;\n  }\n\n  .dashboard-settings__search-input.dashboard-settings__search-input {\n    width: 300px;\n  }\n}\n\n@media (width >= 768px) {\n  .dashboard-settings__search-input.dashboard-settings__search-input {\n    width: 200px;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-settings__search-input.dashboard-settings__search-input {\n    width: 300px;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/SettingsNav.vue",
      "content": "<script setup lang=\"ts\">\nimport type { SettingsLink } from '../data';\n\ndefineProps<{\n  links: SettingsLink[];\n}>();\n</script>\n\n<template>\n  <nav class=\"dashboard-settings__side-nav\">\n    <a\n      v-for=\"link in links\"\n      :key=\"link.label\"\n      :href=\"link.href\"\n      class=\"dashboard-settings__side-link\"\n      :class=\"{ 'dashboard-settings__side-link--active': link.isActive }\"\n    >\n      {{ link.label }}\n    </a>\n  </nav>\n</template>\n\n<style>\n.dashboard-settings__side-nav {\n  display: grid;\n  gap: 1rem;\n}\n\n.dashboard-settings__side-link {\n  color: hsl(var(--muted-foreground));\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-decoration: none;\n}\n\n.dashboard-settings__side-link--active {\n  color: hsl(var(--primary));\n  font-weight: 600;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/StoreNameCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport type { StoreNameCardData } from '../data';\n\ndefineProps<StoreNameCardData>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n      <CardDescription>\n        {{ description }}\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <form>\n        <Input :placeholder=\"placeholder\" />\n      </form>\n    </CardContent>\n    <CardFooter class=\"dashboard-settings__card-footer\">\n      <Button>{{ saveLabel }}</Button>\n    </CardFooter>\n  </Card>\n</template>\n\n<style>\n.dashboard-settings__card-footer.dashboard-settings__card-footer {\n  border-top: 1px solid hsl(var(--border));\n  padding: 1rem 1.5rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/components/UserMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { CircleUserIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport type { AccountMenuEntry } from '../data';\n\ndefineProps<{\n  entries: AccountMenuEntry[];\n  triggerLabel: string;\n}>();\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button\n        variant=\"secondary\"\n        size=\"icon\"\n        class=\"dashboard-settings__user-button\"\n      >\n        <CircleUserIcon class=\"dashboard-settings__icon-md\" />\n        <span class=\"dashboard-settings__sr-only\">{{ triggerLabel }}</span>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\">\n      <template\n        v-for=\"entry in entries\"\n        :key=\"entry.id\"\n      >\n        <DropdownMenuLabel v-if=\"entry.kind === 'label'\">\n          {{ entry.label }}\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator v-else-if=\"entry.kind === 'separator'\" />\n        <DropdownMenuItem v-else-if=\"entry.kind === 'action'\">\n          {{ entry.label }}\n        </DropdownMenuItem>\n      </template>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n\n<style>\n.dashboard-settings__user-button.dashboard-settings__user-button {\n  border-radius: 9999px;\n}\n\n.dashboard-settings__icon-md {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-settings__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-settings/data.ts",
      "content": "export interface NavLink {\n  label: string;\n  href: string;\n  isActive?: boolean;\n}\n\nexport type AccountMenuEntry =\n  | { id: string; kind: 'label'; label: string }\n  | { id: string; kind: 'separator' }\n  | { id: string; kind: 'action'; label: string };\n\nexport interface SettingsLink {\n  label: string;\n  href: string;\n  isActive?: boolean;\n}\n\nexport interface StoreNameCardData {\n  title: string;\n  description: string;\n  placeholder: string;\n  saveLabel: string;\n}\n\nexport interface PluginsDirectoryCardData {\n  title: string;\n  description: string;\n  placeholder: string;\n  directory: string;\n  checkboxId: string;\n  checkboxLabel: string;\n  includeChecked: boolean;\n  saveLabel: string;\n}\n\nexport const brandName = 'Acme Inc';\n\nexport const brandHref = '#';\n\nexport const searchPlaceholder = 'Search products...';\n\nexport const navigationLabel = 'Toggle navigation menu';\n\nexport const userMenuLabel = 'Toggle user menu';\n\nexport const pageTitle = 'Settings';\n\nexport const headerLinks: NavLink[] = [\n  { label: 'Dashboard', href: '#' },\n  { label: 'Orders', href: '#' },\n  { label: 'Products', href: '#' },\n  { label: 'Customers', href: '#' },\n  { label: 'Settings', href: '#', isActive: true },\n];\n\nexport const accountMenu: AccountMenuEntry[] = [\n  { id: 'account-label', kind: 'label', label: 'My Account' },\n  { id: 'account-separator', kind: 'separator' },\n  { id: 'settings', kind: 'action', label: 'Settings' },\n  { id: 'support', kind: 'action', label: 'Support' },\n  { id: 'logout-separator', kind: 'separator' },\n  { id: 'logout', kind: 'action', label: 'Logout' },\n];\n\nexport const settingsLinks: SettingsLink[] = [\n  { label: 'General', href: '#', isActive: true },\n  { label: 'Security', href: '#' },\n  { label: 'Integrations', href: '#' },\n  { label: 'Support', href: '#' },\n  { label: 'Organizations', href: '#' },\n  { label: 'Advanced', href: '#' },\n];\n\nexport const storeNameCard: StoreNameCardData = {\n  title: 'Store Name',\n  description: 'Used to identify your store in the marketplace.',\n  placeholder: 'Store Name',\n  saveLabel: 'Save',\n};\n\nexport const pluginsDirectoryCard: PluginsDirectoryCardData = {\n  title: 'Plugins Directory',\n  description: 'The directory within your project, in which your plugins are located.',\n  placeholder: 'Project Name',\n  directory: '/content/plugins',\n  checkboxId: 'include',\n  checkboxLabel: 'Allow administrators to change the directory.',\n  includeChecked: true,\n  saveLabel: 'Save',\n};\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "780px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard",
    "settings"
  ]
}
