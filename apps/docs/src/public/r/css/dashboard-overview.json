{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-overview",
  "type": "registry:block",
  "title": "Dashboard overview",
  "description": "A dashboard with a team switcher, date range, stat cards, a monthly bar chart, and a list of recent sales.",
  "dependencies": [
    "@internationalized/date@^3.12.4",
    "@lucide/vue@^1.59.0",
    "reka-ui@^2.11.0"
  ],
  "registryDependencies": [
    "avatar",
    "button",
    "card",
    "chart-bar",
    "command",
    "dialog",
    "dropdown-menu",
    "input",
    "label",
    "popover",
    "range-calendar",
    "select",
    "tabs"
  ],
  "files": [
    {
      "path": "blocks/dashboard-overview/DashboardOverview.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport DateRangeField from './components/DateRangeField.vue';\nimport OverviewChart from './components/OverviewChart.vue';\nimport RecentSalesCard from './components/RecentSalesCard.vue';\nimport StatCard from './components/StatCard.vue';\nimport TeamSwitcher from './components/TeamSwitcher.vue';\nimport UserMenu from './components/UserMenu.vue';\nimport {\n  accountMenu,\n  analyticsTabLabel,\n  cancelLabel,\n  continueLabel,\n  createTeamDescription,\n  createTeamLabel,\n  createTeamTitle,\n  datePlaceholder,\n  downloadLabel,\n  emptyTeamLabel,\n  navigation,\n  notificationsTabLabel,\n  overview,\n  overviewCardTitle,\n  overviewTabLabel,\n  pageTitle,\n  planLabel,\n  planPlaceholder,\n  plans,\n  recentSales,\n  recentSalesDescription,\n  recentSalesTitle,\n  reportsTabLabel,\n  searchPlaceholder,\n  statCards,\n  teamGroups,\n  teamNameLabel,\n  teamNamePlaceholder,\n  teamPlaceholder,\n  userMenuLabel,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-overview\">\n    <div class=\"dashboard-overview__header\">\n      <div class=\"dashboard-overview__header-bar\">\n        <TeamSwitcher\n          :groups=\"teamGroups\"\n          :plans=\"plans\"\n          :search-placeholder=\"teamPlaceholder\"\n          :empty-label=\"emptyTeamLabel\"\n          :create-label=\"createTeamLabel\"\n          :dialog-title=\"createTeamTitle\"\n          :dialog-description=\"createTeamDescription\"\n          :name-label=\"teamNameLabel\"\n          :name-placeholder=\"teamNamePlaceholder\"\n          :plan-label=\"planLabel\"\n          :plan-placeholder=\"planPlaceholder\"\n          :cancel-label=\"cancelLabel\"\n          :continue-label=\"continueLabel\"\n        />\n        <nav class=\"dashboard-overview__nav\">\n          <button\n            v-for=\"link in navigation\"\n            :key=\"link.label\"\n            type=\"button\"\n            class=\"dashboard-overview__nav-link\"\n            :class=\"{ 'dashboard-overview__nav-link--active': link.isActive }\"\n          >\n            {{ link.label }}\n          </button>\n        </nav>\n        <div class=\"dashboard-overview__header-actions\">\n          <Input\n            type=\"search\"\n            :placeholder=\"searchPlaceholder\"\n            class=\"dashboard-overview__search\"\n          />\n          <UserMenu\n            :entries=\"accountMenu\"\n            :trigger-label=\"userMenuLabel\"\n          />\n        </div>\n      </div>\n    </div>\n    <div class=\"dashboard-overview__main\">\n      <div class=\"dashboard-overview__title-row\">\n        <h2 class=\"dashboard-overview__title\">\n          {{ pageTitle }}\n        </h2>\n        <div class=\"dashboard-overview__title-actions\">\n          <DateRangeField :placeholder=\"datePlaceholder\" />\n          <Button>{{ downloadLabel }}</Button>\n        </div>\n      </div>\n      <Tabs\n        default-value=\"overview\"\n        class=\"dashboard-overview__tabs\"\n      >\n        <TabsList>\n          <TabsTrigger value=\"overview\">\n            {{ overviewTabLabel }}\n          </TabsTrigger>\n          <TabsTrigger\n            value=\"analytics\"\n            disabled\n          >\n            {{ analyticsTabLabel }}\n          </TabsTrigger>\n          <TabsTrigger\n            value=\"reports\"\n            disabled\n          >\n            {{ reportsTabLabel }}\n          </TabsTrigger>\n          <TabsTrigger\n            value=\"notifications\"\n            disabled\n          >\n            {{ notificationsTabLabel }}\n          </TabsTrigger>\n        </TabsList>\n        <TabsContent\n          value=\"overview\"\n          class=\"dashboard-overview__panel\"\n        >\n          <div class=\"dashboard-overview__stats\">\n            <StatCard\n              v-for=\"stat in statCards\"\n              :key=\"stat.title\"\n              :title=\"stat.title\"\n              :value=\"stat.value\"\n              :change=\"stat.change\"\n              :icon=\"stat.icon\"\n            />\n          </div>\n          <div class=\"dashboard-overview__lower\">\n            <OverviewChart\n              :title=\"overviewCardTitle\"\n              :data=\"overview\"\n            />\n            <RecentSalesCard\n              :title=\"recentSalesTitle\"\n              :description=\"recentSalesDescription\"\n              :sales=\"recentSales\"\n            />\n          </div>\n        </TabsContent>\n      </Tabs>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-overview {\n  display: flex;\n  min-height: 100vh;\n  flex-direction: column;\n}\n\n.dashboard-overview__header {\n  border-bottom: 1px solid var(--border);\n}\n\n.dashboard-overview__header-bar,\n.dashboard-overview__nav,\n.dashboard-overview__header-actions,\n.dashboard-overview__title-row,\n.dashboard-overview__title-actions {\n  display: flex;\n  align-items: center;\n}\n\n.dashboard-overview__header-bar {\n  height: calc(var(--spacing) * 16);\n  padding: 0 calc(var(--spacing) * 4);\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__nav {\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__nav-link {\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: var(--muted-foreground);\n  cursor: pointer;\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.25rem;\n}\n\n.dashboard-overview__nav-link:hover,\n.dashboard-overview__nav-link--active {\n  color: var(--primary);\n}\n\n.dashboard-overview__header-actions {\n  margin-left: auto;\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__main {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: calc(var(--spacing) * 6) calc(var(--spacing) * 8) calc(var(--spacing) * 8);\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__title-row {\n  justify-content: space-between;\n  gap: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__title {\n  margin: 0;\n  font-size: 1.875rem;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  line-height: 2.25rem;\n}\n\n.dashboard-overview__title-actions {\n  gap: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__tabs,\n.dashboard-overview__panel {\n  display: flex;\n  flex-direction: column;\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__stats,\n.dashboard-overview__lower {\n  display: grid;\n  gap: calc(var(--spacing) * 4);\n}\n\n@media (width >= 48rem) {\n  .dashboard-overview__search {\n    width: 100px;\n  }\n\n  .dashboard-overview__stats,\n  .dashboard-overview__lower {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (width >= 64rem) {\n  .dashboard-overview__nav {\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-overview__search {\n    width: 300px;\n  }\n\n  .dashboard-overview__stats {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .dashboard-overview__lower {\n    grid-template-columns: repeat(7, minmax(0, 1fr));\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/DateRangeField.vue",
      "content": "<script setup lang=\"ts\">\nimport type { DateRange } from 'reka-ui';\nimport { CalendarDate, DateFormatter, getLocalTimeZone } from '@internationalized/date';\nimport { CalendarIcon } from '@lucide/vue';\nimport { type Ref, ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';\nimport { RangeCalendar } from '@/components/ui/range-calendar';\n\ndefineProps<{\n  placeholder: string;\n}>();\n\nconst formatter = new DateFormatter('en-US', {\n  dateStyle: 'medium',\n});\n\nconst start = new CalendarDate(2023, 1, 20);\n\nconst value = ref({\n  start,\n  end: start.add({ days: 20 }),\n}) as Ref<DateRange>;\n\nfunction formatDate(date: DateRange['start']) {\n  if (!date) {\n    return '';\n  }\n\n  return formatter.format(date.toDate(getLocalTimeZone()));\n}\n</script>\n\n<template>\n  <Popover>\n    <PopoverTrigger as-child>\n      <Button\n        id=\"date\"\n        variant=\"outline\"\n        class=\"dashboard-overview__date-button\"\n      >\n        <CalendarIcon class=\"dashboard-overview__date-icon\" />\n        <template v-if=\"value.start\">\n          <template v-if=\"value.end\">\n            {{ formatDate(value.start) }} - {{ formatDate(value.end) }}\n          </template>\n          <template v-else>\n            {{ formatDate(value.start) }}\n          </template>\n        </template>\n        <template v-else>\n          {{ placeholder }}\n        </template>\n      </Button>\n    </PopoverTrigger>\n    <PopoverContent\n      class=\"dashboard-overview__date-popover\"\n      align=\"end\"\n    >\n      <RangeCalendar\n        v-model=\"value\"\n        weekday-format=\"short\"\n        :number-of-months=\"2\"\n        :placeholder=\"value.start\"\n      />\n    </PopoverContent>\n  </Popover>\n</template>\n\n<style>\n.dashboard-overview__date-button {\n  width: 300px;\n  justify-content: flex-start;\n  font-weight: 400;\n  text-align: left;\n}\n\n.dashboard-overview__date-icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n  margin-right: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__date-popover {\n  width: auto;\n  padding: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/OverviewChart.vue",
      "content": "<script setup lang=\"ts\">\nimport { BarChart } from '@/components/ui/chart-bar';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { OverviewPoint } from '../data';\n\ndefineProps<{\n  title: string;\n  data: OverviewPoint[];\n}>();\n</script>\n\n<template>\n  <Card class=\"dashboard-overview__chart\">\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n    </CardHeader>\n    <CardContent class=\"dashboard-overview__chart-content\">\n      <BarChart\n        :data=\"data\"\n        :categories=\"['total']\"\n        index=\"name\"\n        :rounded-corners=\"4\"\n      />\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.dashboard-overview__chart {\n  grid-column: span 4;\n}\n\n.dashboard-overview__chart-content {\n  padding-left: calc(var(--spacing) * 2);\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/RecentSalesCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Avatar } from '@/components/ui/avatar';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { SaleRow } from '../data';\n\ndefineProps<{\n  title: string;\n  description: string;\n  sales: SaleRow[];\n}>();\n</script>\n\n<template>\n  <Card class=\"dashboard-overview__sales\">\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n      <CardDescription>\n        {{ description }}\n      </CardDescription>\n    </CardHeader>\n    <CardContent class=\"dashboard-overview__sales-list\">\n      <div\n        v-for=\"sale in sales\"\n        :key=\"sale.id\"\n        class=\"dashboard-overview__sale\"\n      >\n        <Avatar size=\"sm\">\n          <template #fallback>\n            <span class=\"dashboard-overview__initials\">{{ sale.initials }}</span>\n          </template>\n        </Avatar>\n        <div class=\"dashboard-overview__sale-identity\">\n          <p class=\"dashboard-overview__sale-name\">\n            {{ sale.name }}\n          </p>\n          <p class=\"dashboard-overview__sale-email\">\n            {{ sale.email }}\n          </p>\n        </div>\n        <div class=\"dashboard-overview__sale-amount\">\n          {{ sale.amount }}\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.dashboard-overview__sales {\n  grid-column: span 3;\n}\n\n.dashboard-overview__sales-list {\n  display: grid;\n  gap: calc(var(--spacing) * 8);\n}\n\n.dashboard-overview__sale {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__initials {\n  color: color-mix(in srgb, var(--primary) 50%, transparent);\n}\n\n.dashboard-overview__sale-identity {\n  display: grid;\n  gap: calc(var(--spacing) * 1);\n}\n\n.dashboard-overview__sale-name,\n.dashboard-overview__sale-email {\n  margin: 0;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.dashboard-overview__sale-name {\n  font-weight: 500;\n  line-height: 1;\n}\n\n.dashboard-overview__sale-email {\n  color: var(--muted-foreground);\n}\n\n.dashboard-overview__sale-amount {\n  margin-left: auto;\n  font-weight: 500;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/StatCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { StatCardData } from '../data';\n\ndefineProps<StatCardData>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader class=\"dashboard-overview__stat-header\">\n      <CardTitle class=\"dashboard-overview__stat-title\">\n        {{ title }}\n      </CardTitle>\n      <component\n        :is=\"icon\"\n        class=\"dashboard-overview__stat-icon\"\n      />\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-overview__stat-value\">\n        {{ value }}\n      </div>\n      <p class=\"dashboard-overview__stat-change\">\n        {{ change }}\n      </p>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.dashboard-overview__stat-header.dashboard-overview__stat-header {\n  flex-direction: row;\n  align-items: center;\n  justify-content: space-between;\n  padding-bottom: calc(var(--spacing) * 2);\n  gap: 0;\n}\n\n.dashboard-overview__stat-title.dashboard-overview__stat-title {\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.25rem;\n}\n\n.dashboard-overview__stat-icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n  color: var(--muted-foreground);\n}\n\n.dashboard-overview__stat-value {\n  font-size: 1.5rem;\n  font-weight: 700;\n  line-height: 2rem;\n}\n\n.dashboard-overview__stat-change {\n  margin: 0;\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/TeamSwitcher.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { CheckIcon, ChevronsUpDownIcon, CirclePlusIcon } from '@lucide/vue';\nimport { Avatar } from '@/components/ui/avatar';\nimport { Button } from '@/components/ui/button';\nimport { Command, CommandEmpty, CommandGroup, CommandInput, CommandItem, CommandList, CommandSeparator } from '@/components/ui/command';\nimport { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport type { PlanOption, Team, TeamGroup } from '../data';\n\nconst props = defineProps<{\n  groups: TeamGroup[];\n  plans: PlanOption[];\n  searchPlaceholder: string;\n  emptyLabel: string;\n  createLabel: string;\n  dialogTitle: string;\n  dialogDescription: string;\n  nameLabel: string;\n  namePlaceholder: string;\n  planLabel: string;\n  planPlaceholder: string;\n  cancelLabel: string;\n  continueLabel: string;\n}>();\n\nconst open = ref(false);\nconst showNewTeamDialog = ref(false);\nconst selectedTeam = ref<Team>(props.groups[0]?.teams[0] ?? { label: '', value: '' });\nconst search = ref('');\n\nconst filteredGroups = computed(() => props.groups\n  .map(group => ({\n    ...group,\n    teams: group.teams.filter(team => team.label.toLowerCase().includes(search.value.toLowerCase())),\n  }))\n  .filter(group => group.label.toLowerCase().includes(search.value.toLowerCase()) || group.teams.length > 0));\n\nfunction selectTeam(team: Team) {\n  selectedTeam.value = team;\n  open.value = false;\n}\n\nfunction openCreateTeam() {\n  open.value = false;\n  showNewTeamDialog.value = true;\n}\n\nfunction closeCreateTeam() {\n  showNewTeamDialog.value = false;\n}\n</script>\n\n<template>\n  <Dialog v-model:open=\"showNewTeamDialog\">\n    <Popover v-model:open=\"open\">\n      <PopoverTrigger as-child>\n        <Button\n          variant=\"outline\"\n          role=\"combobox\"\n          :aria-expanded=\"open\"\n          aria-label=\"Select a team\"\n          class=\"dashboard-overview__team-button\"\n        >\n          <Avatar\n            size=\"xs\"\n            class=\"dashboard-overview__team-avatar\"\n          />\n          {{ selectedTeam.label }}\n          <ChevronsUpDownIcon class=\"dashboard-overview__team-chevron\" />\n        </Button>\n      </PopoverTrigger>\n      <PopoverContent class=\"dashboard-overview__team-popover\">\n        <Command>\n          <CommandList>\n            <CommandInput\n              v-model=\"search\"\n              :placeholder=\"searchPlaceholder\"\n            />\n            <CommandEmpty>{{ emptyLabel }}</CommandEmpty>\n            <CommandGroup\n              v-for=\"group in filteredGroups\"\n              :key=\"group.label\"\n              :heading=\"group.label\"\n            >\n              <CommandItem\n                v-for=\"team in group.teams\"\n                :key=\"team.value\"\n                :value=\"team.value\"\n                @select=\"selectTeam(team)\"\n              >\n                <Avatar\n                  size=\"xs\"\n                  class=\"dashboard-overview__team-avatar\"\n                />\n                {{ team.label }}\n                <CheckIcon\n                  class=\"dashboard-overview__team-check\"\n                  :class=\"{ 'dashboard-overview__team-check--active': selectedTeam.value === team.value }\"\n                />\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n          <CommandSeparator />\n          <CommandList>\n            <CommandGroup>\n              <DialogTrigger as-child>\n                <CommandItem\n                  value=\"create-team\"\n                  @select=\"openCreateTeam\"\n                >\n                  <CirclePlusIcon class=\"dashboard-overview__create-icon\" />\n                  {{ createLabel }}\n                </CommandItem>\n              </DialogTrigger>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </PopoverContent>\n    </Popover>\n    <DialogContent>\n      <DialogHeader>\n        <DialogTitle>{{ dialogTitle }}</DialogTitle>\n        <DialogDescription>\n          {{ dialogDescription }}\n        </DialogDescription>\n      </DialogHeader>\n      <div class=\"dashboard-overview__team-fields\">\n        <div class=\"dashboard-overview__team-field\">\n          <Label for=\"team-name\">{{ nameLabel }}</Label>\n          <Input\n            id=\"team-name\"\n            :placeholder=\"namePlaceholder\"\n          />\n        </div>\n        <div class=\"dashboard-overview__team-field\">\n          <Label for=\"team-plan\">{{ planLabel }}</Label>\n          <Select>\n            <SelectTrigger id=\"team-plan\">\n              <SelectValue :placeholder=\"planPlaceholder\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"plan in plans\"\n                :key=\"plan.value\"\n                :value=\"plan.value\"\n              >\n                <span class=\"dashboard-overview__plan-label\">{{ plan.label }}</span>\n                -\n                <span class=\"dashboard-overview__plan-detail\">{{ plan.detail }}</span>\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n      <DialogFooter>\n        <Button\n          variant=\"outline\"\n          @click=\"closeCreateTeam\"\n        >\n          {{ cancelLabel }}\n        </Button>\n        <Button\n          type=\"button\"\n          @click=\"closeCreateTeam\"\n        >\n          {{ continueLabel }}\n        </Button>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n\n<style>\n.dashboard-overview__team-button,\n.dashboard-overview__team-popover {\n  width: 200px;\n}\n\n.dashboard-overview__team-button {\n  justify-content: space-between;\n}\n\n.dashboard-overview__team-popover {\n  padding: 0;\n}\n\n.dashboard-overview__team-avatar {\n  margin-right: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__team-chevron,\n.dashboard-overview__team-check,\n.dashboard-overview__create-icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__team-chevron {\n  flex-shrink: 0;\n  margin-left: auto;\n  opacity: 0.5;\n}\n\n.dashboard-overview__team-check {\n  margin-left: auto;\n  opacity: 0;\n}\n\n.dashboard-overview__team-check--active {\n  opacity: 1;\n}\n\n.dashboard-overview__create-icon {\n  width: calc(var(--spacing) * 5);\n  height: calc(var(--spacing) * 5);\n  margin-right: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__team-fields {\n  display: grid;\n  padding: calc(var(--spacing) * 2) 0;\n  gap: calc(var(--spacing) * 4);\n}\n\n.dashboard-overview__team-field {\n  display: grid;\n  gap: calc(var(--spacing) * 2);\n}\n\n.dashboard-overview__plan-label {\n  font-weight: 500;\n}\n\n.dashboard-overview__plan-detail {\n  color: var(--muted-foreground);\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/components/UserMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { Avatar } from '@/components/ui/avatar';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport type { AccountMenuEntry } from '../data';\n\ndefineProps<{\n  entries: AccountMenuEntry[];\n  triggerLabel: string;\n}>();\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button\n        variant=\"ghost\"\n        class=\"dashboard-overview__user-button\"\n      >\n        <Avatar size=\"sm\" />\n        <span class=\"dashboard-overview__sr-only\">{{ triggerLabel }}</span>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent\n      class=\"dashboard-overview__user-menu\"\n      align=\"end\"\n    >\n      <template\n        v-for=\"entry in entries\"\n        :key=\"entry.id\"\n      >\n        <DropdownMenuLabel\n          v-if=\"entry.kind === 'label'\"\n          class=\"dashboard-overview__user-label\"\n        >\n          <div class=\"dashboard-overview__user-identity\">\n            <p class=\"dashboard-overview__user-name\">\n              {{ entry.label }}\n            </p>\n            <p\n              v-if=\"entry.detail\"\n              class=\"dashboard-overview__user-email\"\n            >\n              {{ entry.detail }}\n            </p>\n          </div>\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator v-else-if=\"entry.kind === 'separator'\" />\n        <DropdownMenuItem v-else-if=\"entry.kind === 'action'\">\n          {{ entry.label }}\n          <DropdownMenuShortcut v-if=\"entry.shortcut\">\n            {{ entry.shortcut }}\n          </DropdownMenuShortcut>\n        </DropdownMenuItem>\n      </template>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n\n<style>\n.dashboard-overview__user-button {\n  position: relative;\n  width: calc(var(--spacing) * 8);\n  height: calc(var(--spacing) * 8);\n  border-radius: 9999px;\n}\n\n.dashboard-overview__user-menu {\n  width: calc(var(--spacing) * 56);\n}\n\n.dashboard-overview__user-label {\n  font-weight: 400;\n}\n\n.dashboard-overview__user-identity {\n  display: flex;\n  flex-direction: column;\n  gap: calc(var(--spacing) * 1);\n}\n\n.dashboard-overview__user-name,\n.dashboard-overview__user-email {\n  margin: 0;\n  line-height: 1;\n}\n\n.dashboard-overview__user-name {\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.dashboard-overview__user-email {\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n}\n\n.dashboard-overview__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-overview/data.ts",
