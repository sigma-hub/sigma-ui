{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "app-shell",
  "type": "registry:block",
  "title": "Application shell",
  "description": "An application shell built with the Sidebar component. The sidebar collapses to icons and contains a workspace switcher, grouped navigation, and a user footer. The main area has a header with a sidebar trigger and an overview of stats and recent activity.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "collapsible",
    "separator",
    "sidebar"
  ],
  "files": [
    {
      "path": "blocks/app-shell/AppShell.vue",
      "content": "<script setup lang=\"ts\">\nimport { SidebarInset, SidebarProvider } from '@/components/ui/sidebar';\nimport OverviewPanel from './components/OverviewPanel.vue';\nimport ShellHeader from './components/ShellHeader.vue';\nimport ShellSidebar from './components/ShellSidebar.vue';\nimport {\n  activity,\n  activityTitle,\n  groupLabel,\n  highlights,\n  moreLabel,\n  pageTitle,\n  sections,\n  userEmail,\n  userInitials,\n  userName,\n  workspaceName,\n  workspacePlan,\n} from './data';\n</script>\n\n<template>\n  <SidebarProvider\n    cookie-name=\"sidebar_app_shell\"\n    class=\"app-shell\"\n  >\n    <ShellSidebar\n      :workspace-name=\"workspaceName\"\n      :workspace-plan=\"workspacePlan\"\n      :group-label=\"groupLabel\"\n      :sections=\"sections\"\n      :user-name=\"userName\"\n      :user-email=\"userEmail\"\n      :user-initials=\"userInitials\"\n      :more-label=\"moreLabel\"\n    />\n    <SidebarInset>\n      <ShellHeader :title=\"pageTitle\" />\n      <OverviewPanel\n        :highlights=\"highlights\"\n        :activity-title=\"activityTitle\"\n        :activity=\"activity\"\n      />\n    </SidebarInset>\n  </SidebarProvider>\n</template>\n\n<style>\n.app-shell.app-shell {\n  width: 100%;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/app-shell/components/OverviewPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { ActivityItem, Highlight } from '../data';\n\ndefineProps<{\n  highlights: Highlight[];\n  activityTitle: string;\n  activity: ActivityItem[];\n}>();\n</script>\n\n<template>\n  <div class=\"app-shell__body\">\n    <div class=\"app-shell__grid\">\n      <section\n        v-for=\"highlight in highlights\"\n        :key=\"highlight.label\"\n        class=\"app-shell__card\"\n      >\n        <p class=\"app-shell__card-label\">\n          {{ highlight.label }}\n        </p>\n        <p class=\"app-shell__card-value\">\n          {{ highlight.value }}\n        </p>\n        <p class=\"app-shell__card-detail\">\n          {{ highlight.detail }}\n        </p>\n      </section>\n    </div>\n    <section class=\"app-shell__activity\">\n      <h2 class=\"app-shell__activity-title\">\n        {{ activityTitle }}\n      </h2>\n      <ul class=\"app-shell__activity-list\">\n        <li\n          v-for=\"item in activity\"\n          :key=\"item.title\"\n          class=\"app-shell__activity-item\"\n        >\n          <span>{{ item.title }}</span>\n          <span class=\"app-shell__activity-detail\">{{ item.detail }}</span>\n        </li>\n      </ul>\n    </section>\n  </div>\n</template>\n\n<style>\n.app-shell__body {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 1rem;\n  gap: 1rem;\n}\n\n.app-shell__grid {\n  display: grid;\n  gap: 1rem;\n}\n\n.app-shell__card,\n.app-shell__activity {\n  border: 1px solid var(--border);\n  border-radius: calc(var(--radius) + 4px);\n  background-color: var(--card);\n  color: var(--card-foreground);\n  padding: 1rem;\n}\n\n.app-shell__card-label,\n.app-shell__card-detail,\n.app-shell__activity-detail {\n  color: var(--muted-foreground);\n}\n\n.app-shell__card-label,\n.app-shell__activity-title {\n  margin: 0;\n  font-size: 0.875rem;\n}\n\n.app-shell__card-value {\n  margin: 0.5rem 0 0;\n  font-size: 1.5rem;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n}\n\n.app-shell__card-detail {\n  margin: 0.25rem 0 0;\n  font-size: 0.75rem;\n}\n\n.app-shell__activity {\n  flex: 1;\n}\n\n.app-shell__activity-title {\n  font-weight: 500;\n}\n\n.app-shell__activity-list {\n  display: grid;\n  margin: 1rem 0 0;\n  padding: 0;\n  list-style: none;\n  gap: 0.75rem;\n}\n\n.app-shell__activity-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  font-size: 0.875rem;\n}\n\n@media (width >= 768px) {\n  .app-shell__grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/app-shell/components/ShellHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { Separator } from '@/components/ui/separator';\nimport { SidebarTrigger } from '@/components/ui/sidebar';\n\ndefineProps<{\n  title: string;\n}>();\n</script>\n\n<template>\n  <header class=\"app-shell__header\">\n    <SidebarTrigger />\n    <Separator\n      orientation=\"vertical\"\n      class=\"app-shell__separator\"\n    />\n    <span class=\"app-shell__page-title\">{{ title }}</span>\n  </header>\n</template>\n\n<style>\n.app-shell__header {\n  display: flex;\n  height: 3.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  padding: 0 1rem;\n  border-bottom: 1px solid var(--border);\n  gap: 0.5rem;\n}\n\n.app-shell__separator.app-shell__separator {\n  height: 1rem;\n}\n\n.app-shell__page-title {\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/app-shell/components/ShellSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  ChevronsUpDownIcon,\n  ChevronRightIcon,\n  GalleryVerticalEndIcon,\n  MoreHorizontalIcon,\n} from 'lucide-vue-next';\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarMenu,\n  SidebarMenuAction,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarRail,\n} from '@/components/ui/sidebar';\nimport type { ShellSection } from '../data';\n\ndefineProps<{\n  workspaceName: string;\n  workspacePlan: string;\n  groupLabel: string;\n  sections: ShellSection[];\n  userName: string;\n  userEmail: string;\n  userInitials: string;\n  moreLabel: string;\n}>();\n</script>\n\n<template>\n  <Sidebar collapsible=\"icon\">\n    <SidebarHeader>\n      <SidebarMenu>\n        <SidebarMenuItem>\n          <SidebarMenuButton\n            size=\"lg\"\n            :tooltip=\"workspaceName\"\n          >\n            <div class=\"app-shell__logo\">\n              <GalleryVerticalEndIcon class=\"app-shell__icon\" />\n            </div>\n            <div class=\"app-shell__label\">\n              <span class=\"app-shell__title\">{{ workspaceName }}</span>\n              <span class=\"app-shell__subtitle\">{{ workspacePlan }}</span>\n            </div>\n            <ChevronsUpDownIcon class=\"app-shell__icon\" />\n          </SidebarMenuButton>\n        </SidebarMenuItem>\n      </SidebarMenu>\n    </SidebarHeader>\n    <SidebarContent>\n      <SidebarGroup>\n        <SidebarGroupLabel>{{ groupLabel }}</SidebarGroupLabel>\n        <SidebarMenu>\n          <Collapsible\n            v-for=\"section in sections\"\n            :key=\"section.title\"\n            as-child\n            :default-open=\"section.isActive\"\n            class=\"app-shell__section\"\n          >\n            <SidebarMenuItem>\n              <CollapsibleTrigger as-child>\n                <SidebarMenuButton :tooltip=\"section.title\">\n                  <component :is=\"section.icon\" />\n                  <span>{{ section.title }}</span>\n                  <ChevronRightIcon class=\"app-shell__chevron\" />\n                </SidebarMenuButton>\n              </CollapsibleTrigger>\n              <CollapsibleContent>\n                <SidebarMenuSub>\n                  <SidebarMenuSubItem\n                    v-for=\"link in section.links\"\n                    :key=\"link.title\"\n                  >\n                    <SidebarMenuSubButton\n                      href=\"#\"\n                      :is-active=\"link.isActive\"\n                      @click.prevent\n                    >\n                      <span>{{ link.title }}</span>\n                    </SidebarMenuSubButton>\n                  </SidebarMenuSubItem>\n                </SidebarMenuSub>\n              </CollapsibleContent>\n            </SidebarMenuItem>\n          </Collapsible>\n        </SidebarMenu>\n      </SidebarGroup>\n    </SidebarContent>\n    <SidebarFooter>\n      <SidebarMenu>\n        <SidebarMenuItem>\n          <SidebarMenuButton\n            size=\"lg\"\n            :tooltip=\"userName\"\n          >\n            <div class=\"app-shell__avatar\">\n              {{ userInitials }}\n            </div>\n            <div class=\"app-shell__label\">\n              <span class=\"app-shell__title\">{{ userName }}</span>\n              <span class=\"app-shell__subtitle\">{{ userEmail }}</span>\n            </div>\n          </SidebarMenuButton>\n          <SidebarMenuAction show-on-hover>\n            <MoreHorizontalIcon />\n            <span class=\"app-shell__sr-only\">{{ moreLabel }}</span>\n          </SidebarMenuAction>\n        </SidebarMenuItem>\n      </SidebarMenu>\n    </SidebarFooter>\n    <SidebarRail />\n  </Sidebar>\n</template>\n\n<style>\n.app-shell__logo {\n  display: flex;\n  width: 2rem;\n  height: 2rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  background-color: var(--primary);\n  color: var(--primary-foreground);\n}\n\n.app-shell__icon {\n  width: 1rem;\n  height: 1rem;\n  margin-left: auto;\n}\n\n.app-shell__logo .app-shell__icon {\n  margin-left: 0;\n}\n\n.app-shell__label {\n  display: grid;\n  flex: 1;\n  font-size: 0.875rem;\n  line-height: 1.25;\n  text-align: left;\n}\n\n.app-shell__title {\n  overflow: hidden;\n  font-weight: 500;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.app-shell__subtitle {\n  overflow: hidden;\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.app-shell__chevron {\n  width: 1rem;\n  height: 1rem;\n  margin-left: auto;\n  transition: transform 200ms;\n}\n\n.sigma-ui-sidebar-menu-item[data-state=\"open\"] .app-shell__chevron {\n  transform: rotate(90deg);\n}\n\n.app-shell__avatar {\n  display: flex;\n  width: 2rem;\n  height: 2rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  background-color: var(--secondary);\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.app-shell__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/app-shell/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  BookOpenIcon,\n  LayoutDashboardIcon,\n  Settings2Icon,\n  SquareTerminalIcon,\n} from 'lucide-vue-next';\n\nexport interface ShellLink {\n  title: string;\n  isActive?: boolean;\n}\n\nexport interface ShellSection {\n  title: string;\n  icon: Component;\n  isActive?: boolean;\n  links: ShellLink[];\n}\n\nexport interface Highlight {\n  label: string;\n  value: string;\n  detail: string;\n}\n\nexport interface ActivityItem {\n  title: string;\n  detail: string;\n}\n\nexport const workspaceName = 'Acme Inc';\nexport const workspacePlan = 'Enterprise';\nexport const groupLabel = 'Platform';\nexport const pageTitle = 'Overview';\nexport const userName = 'Jane Doe';\nexport const userEmail = 'jane@example.com';\nexport const userInitials = 'JD';\nexport const moreLabel = 'More';\nexport const activityTitle = 'Recent activity';\n\nexport const sections: ShellSection[] = [\n  {\n    title: 'Dashboard',\n    icon: LayoutDashboardIcon,\n    isActive: true,\n    links: [\n      { title: 'Overview', isActive: true },\n      { title: 'Analytics' },\n      { title: 'Reports' },\n    ],\n  },\n  {\n    title: 'Playground',\n    icon: SquareTerminalIcon,\n    links: [\n      { title: 'History' },\n      { title: 'Starred' },\n    ],\n  },\n  {\n    title: 'Documentation',\n    icon: BookOpenIcon,\n    links: [\n      { title: 'Introduction' },\n      { title: 'Get started' },\n      { title: 'Changelog' },\n    ],\n  },\n  {\n    title: 'Settings',\n    icon: Settings2Icon,\n    links: [\n      { title: 'General' },\n      { title: 'Team' },\n      { title: 'Billing' },\n    ],\n  },\n];\n\nexport const highlights: Highlight[] = [\n  { label: 'Open orders', value: '128', detail: '12 waiting on fulfillment' },\n  { label: 'Revenue', value: '$24.8k', detail: 'Up 8% from last week' },\n  { label: 'Active users', value: '1,204', detail: '32 signed in today' },\n];\n\nexport const activity: ActivityItem[] = [\n  { title: 'Order #1042 shipped', detail: '2 hours ago' },\n  { title: 'New team member invited', detail: 'Yesterday' },\n  { title: 'Billing plan renewed', detail: '3 days ago' },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard",
    "sidebar"
  ]
}
