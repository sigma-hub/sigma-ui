{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-dialog",
  "type": "registry:example",
  "title": "DrawerDialog",
  "dependencies": [
    "@vueuse/core@^14.4.0"
  ],
  "registryDependencies": [
    "button",
    "dialog",
    "drawer",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "example/DrawerDialog.vue",
      "content": "<script lang=\"ts\" setup>\nimport { ref } from 'vue';\nimport { createReusableTemplate, useMediaQuery } from '@vueuse/core';\nimport { Button } from '@/components/ui/button';\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\nimport {\n  Drawer,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from '@/components/ui/drawer';\nimport { Label } from '@/components/ui/label';\nimport { Input } from '@/components/ui/input';\n\nconst [UseTemplate, GridForm] = createReusableTemplate();\nconst isDesktop = useMediaQuery('(width >= 48rem)');\n\nconst isOpen = ref(false);\n</script>\n\n<template>\n  <UseTemplate>\n    <form class=\"example-sigma-ui-drawer-dialog__form\">\n      <div class=\"example-sigma-ui-drawer-dialog__field\">\n        <Label html-for=\"email\">Email</Label>\n        <Input\n          id=\"email\"\n          autocomplete=\"email\"\n          type=\"email\"\n          model-value=\"sigma-ui@example.com\"\n        />\n      </div>\n      <div class=\"example-sigma-ui-drawer-dialog__field\">\n        <Label html-for=\"username\">Username</Label>\n        <Input\n          id=\"username\"\n          autocomplete=\"username\"\n          model-value=\"sigma-ui\"\n        />\n      </div>\n      <Button type=\"submit\">\n        Save changes\n      </Button>\n    </form>\n  </UseTemplate>\n\n  <Dialog\n    v-if=\"isDesktop\"\n    v-model:open=\"isOpen\"\n  >\n    <DialogTrigger as-child>\n      <Button variant=\"outline\">\n        Edit Profile\n      </Button>\n    </DialogTrigger>\n    <DialogContent class=\"example-sigma-ui-drawer-dialog__content\">\n      <DialogHeader>\n        <DialogTitle>Edit profile</DialogTitle>\n        <DialogDescription>\n          Make changes to your profile here. Click save when you're done.\n        </DialogDescription>\n      </DialogHeader>\n      <GridForm />\n    </DialogContent>\n  </Dialog>\n\n  <Drawer\n    v-else\n    v-model:open=\"isOpen\"\n  >\n    <DrawerTrigger as-child>\n      <Button variant=\"outline\">\n        Edit Profile\n      </Button>\n    </DrawerTrigger>\n    <DrawerContent>\n      <DrawerHeader class=\"example-sigma-ui-drawer-dialog__header\">\n        <DrawerTitle>Edit profile</DrawerTitle>\n        <DrawerDescription>\n          Make changes to your profile here. Click save when you're done.\n        </DrawerDescription>\n      </DrawerHeader>\n      <GridForm />\n      <DrawerFooter class=\"example-sigma-ui-drawer-dialog__footer\">\n        <DrawerClose as-child>\n          <Button variant=\"outline\">\n            Cancel\n          </Button>\n        </DrawerClose>\n      </DrawerFooter>\n    </DrawerContent>\n  </Drawer>\n</template>\n\n<style>\n@layer components {\n  .example-sigma-ui-drawer-dialog__form {\n    display: grid;\n    align-items: start;\n    padding: 0 calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .example-sigma-ui-drawer-dialog__field {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .example-sigma-ui-drawer-dialog__content {\n    max-width: 425px;\n  }\n\n  @media (width >= 40rem) {\n    .example-sigma-ui-drawer-dialog__content {\n      max-width: 425px;\n    }\n  }\n\n  .example-sigma-ui-drawer-dialog__header {\n    text-align: left;\n  }\n\n  .example-sigma-ui-drawer-dialog__footer {\n    padding-top: calc(var(--spacing) * 2);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
