  "files": [
    {
      "path": "example/PinInputSeparator.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport {\n  PinInput,\n  PinInputGroup,\n  PinInputInput,\n  PinInputSeparator,\n} from '@/components/ui/pin-input';\n\nconst value = ref<string[]>([]);\nconst handleComplete = (e: string[]) => alert(e.join(''));\n</script>\n\n<template>\n  <div>\n    <PinInput\n      id=\"pin-input\"\n      v-model=\"value\"\n      placeholder=\"○\"\n      @complete=\"handleComplete\"\n    >\n      <PinInputGroup class=\"example-sigma-ui-pin-input-separator__group\">\n        <template\n          v-for=\"(id, index) in 5\"\n          :key=\"id\"\n        >\n          <PinInputInput\n            class=\"example-sigma-ui-pin-input-separator__input\"\n            :index=\"index\"\n          />\n          <template v-if=\"index !== 4\">\n            <PinInputSeparator />\n          </template>\n        </template>\n      </PinInputGroup>\n    </PinInput>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-sigma-ui-pin-input-separator__group {\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .example-sigma-ui-pin-input-separator__input {\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
