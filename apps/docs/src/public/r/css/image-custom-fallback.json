      "path": "example/ImageCustomFallback.vue",
      "content": "<script setup lang=\"ts\">\nimport { ImageIcon } from '@lucide/vue';\nimport { Image } from '@/components/ui/image';\n</script>\n\n<template>\n  <div class=\"example-image-container\">\n    <Image\n      class=\"example-image\"\n      alt=\"Image\"\n    >\n      <template #fallback>\n        <div class=\"example-image-fallback-icon-container\">\n          <ImageIcon class=\"example-image-fallback-icon\" />\n          no photo\n        </div>\n      </template>\n    </Image>\n  </div>\n</template>\n\n<style scoped>\n.example-image-container {\n  display: flex;\n  width: 250px;\n  height: 300px;\n  align-items: center;\n  justify-content: center;\n}\n\n.example-image-fallback-icon-container {\n  display: flex;\n  width: 100%;\n  height: 100%;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  background-image:\n    linear-gradient(90deg, transparent 95%, color-mix(in oklch, var(--foreground) 10%, transparent) 95%),\n    linear-gradient(0deg, transparent 95%, color-mix(in oklch, var(--foreground) 10%, transparent) 95%);\n  background-size: 16px 16px;\n  color: var(--muted-foreground);\n  gap: calc(var(--spacing) * 1);\n}\n\n.example-image-fallback-icon {\n  width: 50%;\n  max-width: 50px;\n  height: 50%;\n  max-height: 50px;\n}\n</style>\n",
