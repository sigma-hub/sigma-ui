{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-split-image",
  "type": "registry:block",
  "title": "Login with cover image",
  "description": "A login page with two columns. The first column has the login form with email and password. There's a Forgot your password link and a link to sign up if you do not have an account. The second column has a cover image.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-split-image/LoginSplitImage.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <div class=\"login-split-image\">\n    <div class=\"login-split-image__form-side\">\n      <div class=\"login-split-image__form-container\">\n        <div class=\"login-split-image__header\">\n          <h1 class=\"login-split-image__title\">\n            Login\n          </h1>\n          <p class=\"login-split-image__description\">\n            Enter your credentials below to login to your account\n          </p>\n        </div>\n        <div class=\"login-split-image__form\">\n          <div class=\"login-split-image__field\">\n            <Label for=\"email\">Email</Label>\n            <Input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"m@example.com\"\n              required\n            />\n          </div>\n          <div class=\"login-split-image__field\">\n            <div class=\"login-split-image__label-row\">\n              <Label for=\"password\">Password</Label>\n              <a\n                href=\"/forgot-password\"\n                class=\"login-split-image__forgot-link\"\n              >\n                Forgot your password?\n              </a>\n            </div>\n            <Input\n              id=\"password\"\n              type=\"password\"\n              required\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            class=\"login-split-image__button\"\n          >\n            Login\n          </Button>\n          <Button\n            variant=\"outline\"\n            class=\"login-split-image__button\"\n          >\n            Login with Google\n          </Button>\n        </div>\n        <div class=\"login-split-image__footer\">\n          Don't have an account?\n          <a\n            href=\"#\"\n            class=\"login-split-image__link\"\n          >\n            Sign up\n          </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"login-split-image__image-side\">\n      <img\n        src=\"/placeholder.svg\"\n        alt=\"Image\"\n        width=\"1920\"\n        height=\"1080\"\n        class=\"login-split-image__image\"\n      >\n    </div>\n  </div>\n</template>\n\n<style>\n.login-split-image {\n  display: flex;\n  width: 100%;\n  height: 100vh;\n}\n\n.login-split-image__form-side {\n  display: flex;\n  flex: 1 1 0%;\n  align-items: center;\n  justify-content: center;\n  padding: 3rem 0;\n}\n\n.login-split-image__form-container {\n  width: 350px;\n  max-width: 100%;\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.login-split-image__header {\n  display: grid;\n  gap: 0.5rem;\n  text-align: center;\n}\n\n.login-split-image__title {\n  margin: 0;\n  font-size: 1.875rem;\n  font-weight: 700;\n  line-height: 2.25rem;\n}\n\n.login-split-image__description {\n  margin: 0 0 2rem;\n  color: var(--muted-foreground);\n  text-wrap: pretty;\n}\n\n.login-split-image__form {\n  display: grid;\n  gap: 1rem;\n}\n\n.login-split-image__field {\n  display: grid;\n  gap: 0.5rem;\n}\n\n.login-split-image__label-row {\n  display: flex;\n  align-items: center;\n}\n\n.login-split-image__forgot-link {\n  display: inline-block;\n  margin-left: auto;\n  color: inherit;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-decoration: underline;\n}\n\n.login-split-image__button {\n  width: 100%;\n}\n\n.login-split-image__footer {\n  margin-top: 1rem;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-align: center;\n}\n\n.login-split-image__link {\n  color: inherit;\n  text-decoration: underline;\n}\n\n.login-split-image__image-side {\n  display: none;\n  background-color: var(--muted);\n}\n\n.login-split-image__image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  user-select: none;\n}\n\n.dark .login-split-image__image {\n  filter: hue-rotate(180deg) invert(100%);\n}\n\n@media (width >= 1024px) {\n  .login-split-image {\n    min-height: 600px;\n  }\n\n  .login-split-image__image-side {\n    display: flex;\n    flex: 1 1 0%;\n  }\n}\n\n@media (width >= 1280px) {\n  .login-split-image {\n    min-height: 800px;\n  }\n}\n</style>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full p-4 lg:p-0"
  },
  "categories": [
    "authentication",
    "login"
  ]
}
