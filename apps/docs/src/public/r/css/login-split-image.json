{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-split-image",
  "type": "registry:block",
  "title": "Login with cover image",
  "description": "A login page with two columns. The first column has the login form with email and password. There's a Forgot your password link and a link to sign up if you do not have an account. The second column has a cover image.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-split-image/LoginSplitImage.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <div class=\"w-full h-[100vh] flex lg:min-h-[600px] xl:min-h-[800px]\">\n    <div class=\"flex-1 flex items-center justify-center py-12\">\n      <div class=\"mx-auto w-[350px] max-w-full\">\n        <div class=\"grid gap-2 text-center\">\n          <h1 class=\"text-3xl font-bold\">\n            Login\n          </h1>\n          <p class=\"mb-8 text-pretty text-muted-foreground\">\n            Enter your credentials below to login to your account\n          </p>\n        </div>\n        <div class=\"grid gap-4\">\n          <div class=\"grid gap-2\">\n            <Label for=\"email\">Email</Label>\n            <Input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"m@example.com\"\n              required\n            />\n          </div>\n          <div class=\"grid gap-2\">\n            <div class=\"flex items-center\">\n              <Label for=\"password\">Password</Label>\n              <a\n                href=\"/forgot-password\"\n                class=\"ml-auto inline-block text-sm underline\"\n              >\n                Forgot your password?\n              </a>\n            </div>\n            <Input\n              id=\"password\"\n              type=\"password\"\n              required\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            class=\"w-full\"\n          >\n            Login\n          </Button>\n          <Button\n            variant=\"outline\"\n            class=\"w-full\"\n          >\n            Login with Google\n          </Button>\n        </div>\n        <div class=\"mt-4 text-center text-sm\">\n          Don't have an account?\n          <a\n            href=\"#\"\n            class=\"underline\"\n          >\n            Sign up\n          </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"hidden lg:flex lg:flex-1 bg-muted\">\n      <img\n        src=\"/placeholder.svg\"\n        alt=\"Image\"\n        width=\"1920\"\n        height=\"1080\"\n        class=\"h-full w-full object-cover dark:invert dark:hue-rotate-180 select-none\"\n      >\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full p-4 lg:p-0"
  },
  "categories": [
    "authentication",
    "login"
  ]
}
