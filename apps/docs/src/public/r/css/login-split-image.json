{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-split-image",
  "type": "registry:block",
  "title": "Login with cover image",
  "description": "A login page with two columns. The first column has the login form with email and password. There's a Forgot your password link and a link to sign up if you do not have an account. The second column has a cover image.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-split-image/LoginSplitImage.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { placeholderImage } from './placeholder';\n</script>\n\n<template>\n  <div class=\"login-split-image\">\n    <div class=\"login-split-image__form-side\">\n      <div class=\"login-split-image__form-container\">\n        <div class=\"login-split-image__header\">\n          <h1 class=\"login-split-image__title\">\n            Login\n          </h1>\n          <p class=\"login-split-image__description\">\n            Enter your credentials below to login to your account\n          </p>\n        </div>\n        <div class=\"login-split-image__form\">\n          <div class=\"login-split-image__field\">\n            <Label for=\"email\">Email</Label>\n            <Input\n              id=\"email\"\n              autocomplete=\"username\"\n              type=\"email\"\n              placeholder=\"m@example.com\"\n              required\n            />\n          </div>\n          <div class=\"login-split-image__field\">\n            <div class=\"login-split-image__label-row\">\n              <Label for=\"password\">Password</Label>\n              <a\n                href=\"/forgot-password\"\n                class=\"login-split-image__forgot-link\"\n              >\n                Forgot your password?\n              </a>\n            </div>\n            <Input\n              id=\"password\"\n              autocomplete=\"current-password\"\n              type=\"password\"\n              required\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            class=\"login-split-image__button\"\n          >\n            Login\n          </Button>\n          <Button\n            variant=\"outline\"\n            type=\"button\"\n            class=\"login-split-image__button\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              class=\"login-split-image__icon\"\n              aria-hidden=\"true\"\n            >\n              <path\n                fill=\"#4285F4\"\n                d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z\"\n              />\n              <path\n                fill=\"#34A853\"\n                d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z\"\n              />\n              <path\n                fill=\"#FBBC05\"\n                d=\"M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84Z\"\n              />\n              <path\n                fill=\"#EA4335\"\n                d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z\"\n              />\n            </svg>\n            Login with Google\n          </Button>\n        </div>\n        <div class=\"login-split-image__footer\">\n          Don't have an account?\n          <a\n            href=\"#\"\n            class=\"login-split-image__link\"\n          >\n            Sign up\n          </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"login-split-image__image-side\">\n      <img\n        :src=\"placeholderImage\"\n        alt=\"Image\"\n        width=\"1920\"\n        height=\"1080\"\n        class=\"login-split-image__image\"\n      >\n    </div>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .login-split-image {\n    display: flex;\n    width: 100%;\n    height: 100vh;\n  }\n\n  .login-split-image__form-side {\n    display: flex;\n    flex: 1 1 0%;\n    align-items: center;\n    justify-content: center;\n    padding: calc(var(--spacing) * 12) 0;\n  }\n\n  .login-split-image__form-container {\n    width: 350px;\n    max-width: 100%;\n    margin-right: auto;\n    margin-left: auto;\n  }\n\n  .login-split-image__header {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n    text-align: center;\n  }\n\n  .login-split-image__title {\n    margin: 0;\n    font-size: 1.875rem;\n    font-weight: 700;\n    line-height: 2.25rem;\n  }\n\n  .login-split-image__description {\n    margin: 0 0 calc(var(--spacing) * 8);\n    color: var(--muted-foreground);\n    text-wrap: pretty;\n  }\n\n  .login-split-image__form {\n    display: grid;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .login-split-image__field {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .login-split-image__label-row {\n    display: flex;\n    align-items: center;\n  }\n\n  .login-split-image__forgot-link {\n    display: inline-block;\n    margin-left: auto;\n    color: inherit;\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n    text-decoration: underline;\n  }\n\n  .login-split-image__button {\n    width: 100%;\n  }\n\n  .login-split-image__icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .login-split-image__footer {\n    margin-top: calc(var(--spacing) * 4);\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n    text-align: center;\n  }\n\n  .login-split-image__link {\n    color: inherit;\n    text-decoration: underline;\n  }\n\n  .login-split-image__image-side {\n    display: none;\n    background-color: var(--muted);\n  }\n\n  .login-split-image__image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    user-select: none;\n  }\n\n  .dark .login-split-image__image {\n    filter: hue-rotate(180deg) invert(100%);\n  }\n\n  @media (width >= 64rem) {\n    .login-split-image {\n      min-height: 600px;\n    }\n\n    .login-split-image__image-side {\n      display: flex;\n      flex: 1 1 0%;\n    }\n  }\n\n  @media (width >= 80rem) {\n    .login-split-image {\n      min-height: 800px;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
