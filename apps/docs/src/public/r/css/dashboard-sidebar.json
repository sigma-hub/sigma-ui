{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-sidebar",
  "type": "registry:block",
  "title": "Dashboard with sidebar",
  "description": "A products dashboard with a sidebar navigation and a main content area. The dashboard has a header with a search input and a user menu. The sidebar has a logo, navigation links, and a card with a call to action. The main content area shows an empty state with a call to action.",
  "dependencies": [
    "lucide-vue-next@^0.475.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "sheet"
  ],
  "files": [
    {
      "path": "blocks/dashboard-sidebar/DashboardSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport DesktopSidebar from './components/DesktopSidebar.vue';\nimport EmptyState from './components/EmptyState.vue';\nimport {\n  accountMenu,\n  desktopBrand,\n  desktopLinks,\n  emptyState,\n  inventoryTitle,\n  mobileBrand,\n  mobileLinks,\n  navigationLabel,\n  notificationsLabel,\n  searchPlaceholder,\n  upgradeCard,\n  userMenuLabel,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-sidebar\">\n    <DesktopSidebar\n      :brand-name=\"desktopBrand.name\"\n      :brand-href=\"desktopBrand.href\"\n      :links=\"desktopLinks\"\n      :notifications-label=\"notificationsLabel\"\n      :upgrade-title=\"upgradeCard.title\"\n      :upgrade-description=\"upgradeCard.description\"\n      :upgrade-action-label=\"upgradeCard.actionLabel\"\n    />\n    <div class=\"dashboard-sidebar__body\">\n      <AppHeader\n        :brand-name=\"mobileBrand.name\"\n        :brand-href=\"mobileBrand.href\"\n        :links=\"mobileLinks\"\n        :navigation-label=\"navigationLabel\"\n        :search-placeholder=\"searchPlaceholder\"\n        :menu-entries=\"accountMenu\"\n        :user-menu-label=\"userMenuLabel\"\n        :upgrade-title=\"upgradeCard.title\"\n        :upgrade-description=\"upgradeCard.description\"\n        :upgrade-action-label=\"upgradeCard.actionLabel\"\n      />\n      <main class=\"dashboard-sidebar__main\">\n        <div class=\"dashboard-sidebar__heading-row\">\n          <h1 class=\"dashboard-sidebar__heading\">\n            {{ inventoryTitle }}\n          </h1>\n        </div>\n        <EmptyState\n          :title=\"emptyState.title\"\n          :description=\"emptyState.description\"\n          :action-label=\"emptyState.actionLabel\"\n        />\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-sidebar {\n  display: grid;\n  width: 100%;\n  min-height: 100vh;\n}\n\n.dashboard-sidebar__body {\n  display: flex;\n  flex-direction: column;\n}\n\n.dashboard-sidebar__main {\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  gap: 1rem;\n  padding: 1rem;\n}\n\n.dashboard-sidebar__heading-row {\n  display: flex;\n  align-items: center;\n}\n\n.dashboard-sidebar__heading {\n  margin: 0;\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-sidebar {\n    grid-template-columns: 220px 1fr;\n  }\n\n  .dashboard-sidebar__heading {\n    font-size: 1.5rem;\n    line-height: 2rem;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-sidebar {\n    grid-template-columns: 280px 1fr;\n  }\n\n  .dashboard-sidebar__main {\n    gap: 1.5rem;\n    padding: 1.5rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AccountMenuEntry, NavLink } from '../data';\nimport MobileNav from './MobileNav.vue';\nimport SearchForm from './SearchForm.vue';\nimport UserMenu from './UserMenu.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  navigationLabel: string;\n  searchPlaceholder: string;\n  menuEntries: AccountMenuEntry[];\n  userMenuLabel: string;\n  upgradeTitle: string;\n  upgradeDescription: string;\n  upgradeActionLabel: string;\n}>();\n</script>\n\n<template>\n  <header class=\"dashboard-sidebar__header\">\n    <MobileNav\n      :brand-name=\"brandName\"\n      :brand-href=\"brandHref\"\n      :links=\"links\"\n      :navigation-label=\"navigationLabel\"\n      :upgrade-title=\"upgradeTitle\"\n      :upgrade-description=\"upgradeDescription\"\n      :upgrade-action-label=\"upgradeActionLabel\"\n    />\n    <SearchForm :placeholder=\"searchPlaceholder\" />\n    <UserMenu\n      :entries=\"menuEntries\"\n      :trigger-label=\"userMenuLabel\"\n    />\n  </header>\n</template>\n\n<style>\n.dashboard-sidebar__header {\n  display: flex;\n  height: 3.5rem;\n  align-items: center;\n  gap: 1rem;\n  border-bottom: 1px solid hsl(var(--border));\n  background-color: hsl(var(--muted) / 40%);\n  padding: 0 1rem;\n}\n\n@media (width >= 1024px) {\n  .dashboard-sidebar__header {\n    height: 60px;\n    padding: 0 1.5rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/DesktopSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { BellIcon, Package2Icon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport type { NavLink } from '../data';\nimport UpgradeCard from './UpgradeCard.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  notificationsLabel: string;\n  upgradeTitle: string;\n  upgradeDescription: string;\n  upgradeActionLabel: string;\n}>();\n</script>\n\n<template>\n  <div class=\"dashboard-sidebar__panel\">\n    <div class=\"dashboard-sidebar__panel-inner\">\n      <div class=\"dashboard-sidebar__brand-bar\">\n        <a\n          :href=\"brandHref\"\n          class=\"dashboard-sidebar__brand\"\n        >\n          <Package2Icon class=\"dashboard-sidebar__icon-lg\" />\n          <span>{{ brandName }}</span>\n        </a>\n        <Button\n          variant=\"outline\"\n          size=\"icon\"\n          class=\"dashboard-sidebar__bell\"\n        >\n          <BellIcon class=\"dashboard-sidebar__icon-sm\" />\n          <span class=\"dashboard-sidebar__sr-only\">{{ notificationsLabel }}</span>\n        </Button>\n      </div>\n      <div class=\"dashboard-sidebar__nav-wrap\">\n        <nav class=\"dashboard-sidebar__nav\">\n          <a\n            v-for=\"link in links\"\n            :key=\"link.label\"\n            :href=\"link.href\"\n            class=\"dashboard-sidebar__link\"\n            :class=\"{ 'dashboard-sidebar__link--active': link.isActive }\"\n          >\n            <component\n              :is=\"link.icon\"\n              class=\"dashboard-sidebar__icon-sm\"\n            />\n            {{ link.label }}\n            <Badge\n              v-if=\"link.badge\"\n              class=\"dashboard-sidebar__badge\"\n            >\n              {{ link.badge }}\n            </Badge>\n          </a>\n        </nav>\n      </div>\n      <div class=\"dashboard-sidebar__upgrade\">\n        <UpgradeCard\n          compact\n          :title=\"upgradeTitle\"\n          :description=\"upgradeDescription\"\n          :action-label=\"upgradeActionLabel\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-sidebar__panel {\n  display: none;\n  border-right: 1px solid hsl(var(--border));\n  background-color: hsl(var(--muted) / 40%);\n}\n\n.dashboard-sidebar__panel-inner {\n  display: flex;\n  height: 100%;\n  max-height: 100vh;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.dashboard-sidebar__brand-bar {\n  display: flex;\n  height: 3.5rem;\n  align-items: center;\n  border-bottom: 1px solid hsl(var(--border));\n  padding: 0 1rem;\n}\n\n.dashboard-sidebar__brand {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: inherit;\n  font-weight: 600;\n  text-decoration: none;\n}\n\n.dashboard-sidebar__bell.dashboard-sidebar__bell {\n  width: 2rem;\n  height: 2rem;\n  margin-left: auto;\n}\n\n.dashboard-sidebar__nav-wrap {\n  flex: 1 1 0%;\n}\n\n.dashboard-sidebar__nav {\n  display: grid;\n  align-items: start;\n  padding: 0 0.5rem;\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.25rem;\n}\n\n.dashboard-sidebar__link {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  border-radius: var(--radius);\n  padding: 0.5rem 0.75rem;\n  color: hsl(var(--muted-foreground));\n  text-decoration: none;\n  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-sidebar__link:hover,\n.dashboard-sidebar__link--active:hover {\n  color: hsl(var(--primary));\n}\n\n.dashboard-sidebar__link--active {\n  background-color: hsl(var(--muted));\n  color: hsl(var(--primary));\n}\n\n.dashboard-sidebar__badge.dashboard-sidebar__badge {\n  display: flex;\n  width: 1.5rem;\n  height: 1.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  margin-left: auto;\n  padding: 0;\n  border-radius: 9999px;\n}\n\n.dashboard-sidebar__upgrade {\n  margin-top: auto;\n  padding: 1rem;\n}\n\n.dashboard-sidebar__icon-lg {\n  width: 1.5rem;\n  height: 1.5rem;\n}\n\n.dashboard-sidebar__icon-sm {\n  width: 1rem;\n  height: 1rem;\n}\n\n.dashboard-sidebar__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n@media (width >= 768px) {\n  .dashboard-sidebar__panel {\n    display: block;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-sidebar__brand-bar {\n    height: 60px;\n    padding: 0 1.5rem;\n  }\n\n  .dashboard-sidebar__nav {\n    padding: 0 1rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/EmptyState.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport type { EmptyStateData } from '../data';\n\ndefineProps<EmptyStateData>();\n</script>\n\n<template>\n  <div class=\"dashboard-sidebar__empty\">\n    <div class=\"dashboard-sidebar__empty-body\">\n      <h3 class=\"dashboard-sidebar__empty-title\">\n        {{ title }}\n      </h3>\n      <p class=\"dashboard-sidebar__empty-description\">\n        {{ description }}\n      </p>\n      <Button class=\"dashboard-sidebar__empty-action\">\n        {{ actionLabel }}\n      </Button>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-sidebar__empty {\n  display: flex;\n  flex: 1 1 0%;\n  align-items: center;\n  justify-content: center;\n  border: 1px dashed hsl(var(--border));\n  border-radius: var(--radius);\n  box-shadow: 0 1px 2px 0 rgb(0 0 0 / 5%);\n}\n\n.dashboard-sidebar__empty-body {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.25rem;\n  text-align: center;\n}\n\n.dashboard-sidebar__empty-title {\n  margin: 0;\n  font-size: 1.5rem;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  line-height: 2rem;\n}\n\n.dashboard-sidebar__empty-description {\n  margin: 0;\n  color: hsl(var(--muted-foreground));\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.dashboard-sidebar__empty-action {\n  margin-top: 1rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/MobileNav.vue",
      "content": "<script setup lang=\"ts\">\nimport { MenuIcon, Package2Icon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { NavLink } from '../data';\nimport UpgradeCard from './UpgradeCard.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  navigationLabel: string;\n  upgradeTitle: string;\n  upgradeDescription: string;\n  upgradeActionLabel: string;\n}>();\n</script>\n\n<template>\n  <Sheet>\n    <SheetTrigger as-child>\n      <Button\n        variant=\"outline\"\n        size=\"icon\"\n        class=\"dashboard-sidebar__menu-button\"\n      >\n        <MenuIcon class=\"dashboard-sidebar__icon-md\" />\n        <span class=\"dashboard-sidebar__sr-only\">{{ navigationLabel }}</span>\n      </Button>\n    </SheetTrigger>\n    <SheetContent\n      side=\"left\"\n      class=\"dashboard-sidebar__sheet\"\n    >\n      <nav class=\"dashboard-sidebar__mobile-nav\">\n        <a\n          :href=\"brandHref\"\n          class=\"dashboard-sidebar__mobile-brand\"\n        >\n          <Package2Icon class=\"dashboard-sidebar__icon-lg\" />\n          <span class=\"dashboard-sidebar__sr-only\">{{ brandName }}</span>\n        </a>\n        <a\n          v-for=\"link in links\"\n          :key=\"link.label\"\n          :href=\"link.href\"\n          class=\"dashboard-sidebar__mobile-link\"\n          :class=\"{ 'dashboard-sidebar__mobile-link--active': link.isActive }\"\n        >\n          <component\n            :is=\"link.icon\"\n            class=\"dashboard-sidebar__icon-md\"\n          />\n          {{ link.label }}\n          <Badge\n            v-if=\"link.badge\"\n            class=\"dashboard-sidebar__badge\"\n          >\n            {{ link.badge }}\n          </Badge>\n        </a>\n      </nav>\n      <div class=\"dashboard-sidebar__sheet-upgrade\">\n        <UpgradeCard\n          :title=\"upgradeTitle\"\n          :description=\"upgradeDescription\"\n          :action-label=\"upgradeActionLabel\"\n        />\n      </div>\n    </SheetContent>\n  </Sheet>\n</template>\n\n<style>\n.dashboard-sidebar__menu-button {\n  flex-shrink: 0;\n}\n\n.dashboard-sidebar__sheet.dashboard-sidebar__sheet {\n  display: flex;\n  flex-direction: column;\n}\n\n.dashboard-sidebar__mobile-nav {\n  display: grid;\n  gap: 0.5rem;\n  font-size: 1.125rem;\n  font-weight: 500;\n  line-height: 1.75rem;\n}\n\n.dashboard-sidebar__mobile-brand {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: inherit;\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n  text-decoration: none;\n}\n\n.dashboard-sidebar__mobile-link {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-right: -0.65rem;\n  margin-left: -0.65rem;\n  border-radius: calc(var(--radius) + 4px);\n  padding: 0.5rem 0.75rem;\n  color: hsl(var(--muted-foreground));\n  text-decoration: none;\n}\n\n.dashboard-sidebar__mobile-link:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-sidebar__mobile-link--active {\n  background-color: hsl(var(--muted));\n  color: hsl(var(--foreground));\n}\n\n.dashboard-sidebar__mobile-link--active:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-sidebar__badge.dashboard-sidebar__badge {\n  display: flex;\n  width: 1.5rem;\n  height: 1.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  margin-left: auto;\n  padding: 0;\n  border-radius: 9999px;\n}\n\n.dashboard-sidebar__sheet-upgrade {\n  margin-top: auto;\n}\n\n.dashboard-sidebar__icon-lg {\n  width: 1.5rem;\n  height: 1.5rem;\n}\n\n.dashboard-sidebar__icon-md {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-sidebar__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n@media (width >= 768px) {\n  .dashboard-sidebar__menu-button.dashboard-sidebar__menu-button {\n    display: none;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/SearchForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { SearchIcon } from 'lucide-vue-next';\nimport { Input } from '@/components/ui/input';\n\ndefineProps<{\n  placeholder: string;\n}>();\n</script>\n\n<template>\n  <div class=\"dashboard-sidebar__search\">\n    <form>\n      <div class=\"dashboard-sidebar__search-field\">\n        <SearchIcon class=\"dashboard-sidebar__search-icon\" />\n        <Input\n          type=\"search\"\n          :placeholder=\"placeholder\"\n          class=\"dashboard-sidebar__search-input\"\n        />\n      </div>\n    </form>\n  </div>\n</template>\n\n<style>\n.dashboard-sidebar__search {\n  width: 100%;\n  flex: 1 1 0%;\n}\n\n.dashboard-sidebar__search-field {\n  position: relative;\n}\n\n.dashboard-sidebar__search-icon {\n  position: absolute;\n  top: 0.625rem;\n  left: 0.625rem;\n  width: 1rem;\n  height: 1rem;\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-sidebar__search-input.dashboard-sidebar__search-input {\n  width: 100%;\n  padding-left: 2rem;\n  background-color: hsl(var(--background));\n  box-shadow: none;\n  appearance: none;\n}\n\n@media (width >= 768px) {\n  .dashboard-sidebar__search-input.dashboard-sidebar__search-input {\n    width: 66.666667%;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-sidebar__search-input.dashboard-sidebar__search-input {\n    width: 33.333333%;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/UpgradeCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n\nwithDefaults(defineProps<{\n  title: string;\n  description: string;\n  actionLabel: string;\n  compact?: boolean;\n}>(), {\n  compact: false,\n});\n</script>\n\n<template>\n  <Card>\n    <CardHeader\n      class=\"dashboard-sidebar__upgrade-header\"\n      :class=\"{ 'dashboard-sidebar__upgrade-header--compact': compact }\"\n    >\n      <CardTitle>{{ title }}</CardTitle>\n      <CardDescription>\n        {{ description }}\n      </CardDescription>\n    </CardHeader>\n    <CardContent\n      class=\"dashboard-sidebar__upgrade-content\"\n      :class=\"{ 'dashboard-sidebar__upgrade-content--compact': compact }\"\n    >\n      <Button\n        size=\"sm\"\n        class=\"dashboard-sidebar__upgrade-button\"\n      >\n        {{ actionLabel }}\n      </Button>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.dashboard-sidebar__upgrade-header--compact.dashboard-sidebar__upgrade-header--compact {\n  padding: 0 0.5rem 0.5rem;\n}\n\n.dashboard-sidebar__upgrade-content--compact.dashboard-sidebar__upgrade-content--compact {\n  padding: 0 0.5rem 0.5rem;\n}\n\n.dashboard-sidebar__upgrade-button.dashboard-sidebar__upgrade-button {\n  width: 100%;\n}\n\n@media (width >= 768px) {\n  .dashboard-sidebar__upgrade-header--compact.dashboard-sidebar__upgrade-header--compact {\n    padding: 1rem;\n  }\n\n  .dashboard-sidebar__upgrade-content--compact.dashboard-sidebar__upgrade-content--compact {\n    padding: 0 1rem 1rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/components/UserMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { CircleUserIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport type { AccountMenuEntry } from '../data';\n\ndefineProps<{\n  entries: AccountMenuEntry[];\n  triggerLabel: string;\n}>();\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button\n        variant=\"secondary\"\n        size=\"icon\"\n        class=\"dashboard-sidebar__user-button\"\n      >\n        <CircleUserIcon class=\"dashboard-sidebar__icon-md\" />\n        <span class=\"dashboard-sidebar__sr-only\">{{ triggerLabel }}</span>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\">\n      <template\n        v-for=\"entry in entries\"\n        :key=\"entry.id\"\n      >\n        <DropdownMenuLabel v-if=\"entry.kind === 'label'\">\n          {{ entry.label }}\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator v-else-if=\"entry.kind === 'separator'\" />\n        <DropdownMenuItem v-else-if=\"entry.kind === 'action'\">\n          {{ entry.label }}\n        </DropdownMenuItem>\n      </template>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n\n<style>\n.dashboard-sidebar__user-button.dashboard-sidebar__user-button {\n  border-radius: 9999px;\n}\n\n.dashboard-sidebar__icon-md {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-sidebar__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sidebar/data.ts",
      "content": "import type { Component } from 'vue';\nimport { HomeIcon, LineChartIcon, PackageIcon, ShoppingCartIcon, UsersIcon } from 'lucide-vue-next';\n\nexport interface NavLink {\n  label: string;\n  href: string;\n  icon: Component;\n  isActive?: boolean;\n  badge?: string;\n}\n\nexport interface BrandLink {\n  name: string;\n  href: string;\n}\n\nexport type AccountMenuEntry =\n  | { id: string; kind: 'label'; label: string }\n  | { id: string; kind: 'separator' }\n  | { id: string; kind: 'action'; label: string };\n\nexport interface UpgradeCardData {\n  title: string;\n  description: string;\n  actionLabel: string;\n}\n\nexport interface EmptyStateData {\n  title: string;\n  description: string;\n  actionLabel: string;\n}\n\nexport const desktopBrand: BrandLink = {\n  name: 'Acme Inc',\n  href: '/',\n};\n\nexport const mobileBrand: BrandLink = {\n  name: 'Acme Inc',\n  href: '#',\n};\n\nexport const searchPlaceholder = 'Search products...';\n\nexport const navigationLabel = 'Toggle navigation menu';\n\nexport const notificationsLabel = 'Toggle notifications';\n\nexport const userMenuLabel = 'Toggle user menu';\n\nexport const inventoryTitle = 'Inventory';\n\nexport const desktopLinks: NavLink[] = [\n  { label: 'Dashboard', href: '/', icon: HomeIcon },\n  { label: 'Orders', href: '#', icon: ShoppingCartIcon, badge: '6' },\n  { label: 'Products', href: '#', icon: PackageIcon, isActive: true },\n  { label: 'Customers', href: '#', icon: UsersIcon },\n  { label: 'Analytics', href: '#', icon: LineChartIcon },\n];\n\nexport const mobileLinks: NavLink[] = [\n  { label: 'Dashboard', href: '#', icon: HomeIcon },\n  { label: 'Orders', href: '#', icon: ShoppingCartIcon, badge: '6', isActive: true },\n  { label: 'Products', href: '#', icon: PackageIcon },\n  { label: 'Customers', href: '#', icon: UsersIcon },\n  { label: 'Analytics', href: '#', icon: LineChartIcon },\n];\n\nexport const accountMenu: AccountMenuEntry[] = [\n  { id: 'account-label', kind: 'label', label: 'My Account' },\n  { id: 'account-separator', kind: 'separator' },\n  { id: 'settings', kind: 'action', label: 'Settings' },\n  { id: 'support', kind: 'action', label: 'Support' },\n  { id: 'logout-separator', kind: 'separator' },\n  { id: 'logout', kind: 'action', label: 'Logout' },\n];\n\nexport const upgradeCard: UpgradeCardData = {\n  title: 'Upgrade to Pro',\n  description: 'Unlock all features and get unlimited access to our support team.',\n  actionLabel: 'Upgrade',\n};\n\nexport const emptyState: EmptyStateData = {\n  title: 'You have no products',\n  description: 'You can start selling as soon as you add a product.',\n  actionLabel: 'Add Product',\n};\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard",
    "sidebar"
  ]
}
