{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dropdown-menu-demo",
  "type": "registry:example",
  "title": "DropdownMenu",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button",
    "dropdown-menu"
  ],
  "files": [
    {
      "path": "example/DropdownMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CloudIcon,\n  CreditCardIcon,\n  GithubIcon,\n  KeyboardIcon,\n  LifeBuoyIcon,\n  LogOutIcon,\n  MailIcon,\n  MessageSquareIcon,\n  PlusCircleIcon,\n  PlusIcon,\n  SettingsIcon,\n  UserIcon,\n  UserPlusIcon,\n  UsersIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuPortal,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuSub,\n  DropdownMenuSubContent,\n  DropdownMenuSubTrigger,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button variant=\"outline\">\n        Open\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent class=\"example-sigma-ui-dropdown__content\">\n      <DropdownMenuLabel>My Account</DropdownMenuLabel>\n      <DropdownMenuSeparator />\n      <DropdownMenuGroup>\n        <DropdownMenuItem>\n          <UserIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>Profile</span>\n          <DropdownMenuShortcut>⇧⌘P</DropdownMenuShortcut>\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <CreditCardIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>Billing</span>\n          <DropdownMenuShortcut>⌘B</DropdownMenuShortcut>\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <SettingsIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>Settings</span>\n          <DropdownMenuShortcut>⌘S</DropdownMenuShortcut>\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n          <KeyboardIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>Keyboard shortcuts</span>\n          <DropdownMenuShortcut>⌘K</DropdownMenuShortcut>\n        </DropdownMenuItem>\n      </DropdownMenuGroup>\n      <DropdownMenuSeparator />\n      <DropdownMenuGroup>\n        <DropdownMenuItem>\n          <UsersIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>Team</span>\n        </DropdownMenuItem>\n        <DropdownMenuSub>\n          <DropdownMenuSubTrigger>\n            <UserPlusIcon class=\"example-sigma-ui-dropdown__icon\" />\n            <span>Invite users</span>\n          </DropdownMenuSubTrigger>\n          <DropdownMenuPortal>\n            <DropdownMenuSubContent class=\"example-sigma-ui-dropdown__subcontent\">\n              <DropdownMenuItem>\n                <MailIcon class=\"example-sigma-ui-dropdown__icon\" />\n                <span>Email</span>\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <MessageSquareIcon class=\"example-sigma-ui-dropdown__icon\" />\n                <span>Message</span>\n              </DropdownMenuItem>\n              <DropdownMenuSeparator />\n              <DropdownMenuItem>\n                <PlusCircleIcon class=\"example-sigma-ui-dropdown__icon\" />\n                <span>More...</span>\n              </DropdownMenuItem>\n            </DropdownMenuSubContent>\n          </DropdownMenuPortal>\n        </DropdownMenuSub>\n        <DropdownMenuItem>\n          <PlusIcon class=\"example-sigma-ui-dropdown__icon\" />\n          <span>New Team</span>\n          <DropdownMenuShortcut>⌘+T</DropdownMenuShortcut>\n        </DropdownMenuItem>\n      </DropdownMenuGroup>\n      <DropdownMenuSeparator />\n      <DropdownMenuItem>\n        <GithubIcon class=\"example-sigma-ui-dropdown__icon\" />\n        <span>GitHub</span>\n      </DropdownMenuItem>\n      <DropdownMenuItem>\n        <LifeBuoyIcon class=\"example-sigma-ui-dropdown__icon\" />\n        <span>Support</span>\n      </DropdownMenuItem>\n      <DropdownMenuItem disabled>\n        <CloudIcon class=\"example-sigma-ui-dropdown__icon\" />\n        <span>API</span>\n      </DropdownMenuItem>\n      <DropdownMenuSeparator />\n      <DropdownMenuItem>\n        <LogOutIcon class=\"example-sigma-ui-dropdown__icon\" />\n        <span>Log out</span>\n        <DropdownMenuShortcut>⇧⌘Q</DropdownMenuShortcut>\n      </DropdownMenuItem>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n\n<style>\n.example-sigma-ui-dropdown__content {\n  width: calc(var(--spacing) * 56);\n}\n\n.example-sigma-ui-dropdown__subcontent {\n  width: calc(var(--spacing) * 48);\n}\n\n.example-sigma-ui-dropdown__icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n  margin-right: calc(var(--spacing) * 2);\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
