{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "badge",
  "type": "registry:ui",
  "title": "Badge",
  "description": "Displays a badge or a component that looks like a badge.",
  "dependencies": [
    "class-variance-authority@^0.7.1"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "ui/badge/Badge.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { type BadgeVariants, badgeVariants } from '.';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ndefineProps<{\n  /** Visual style of the badge. */\n  variant?: BadgeVariants['variant'];\n\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"badge\"\n    v-bind=\"delegatedAttrs()\"\n    :class=\"[badgeVariants({ variant }), $attrs.class]\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n.sigma-ui-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: calc(var(--spacing) * 0.5) calc(var(--spacing) * 2.5);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-full);\n  font-size: 0.75rem;\n  font-weight: 600;\n  transition-duration: 150ms;\n  transition-property: color, background-color, border-color;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.sigma-ui-badge:focus {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.sigma-ui-badge--default {\n  border-color: transparent;\n  background-color: var(--primary);\n  color: var(--primary-foreground);\n}\n\n.sigma-ui-badge--default:hover {\n  background-color: color-mix(in oklch, var(--primary) 80%, transparent);\n}\n\n.sigma-ui-badge--secondary {\n  border-color: transparent;\n  background-color: var(--secondary);\n  color: var(--secondary-foreground);\n}\n\n.sigma-ui-badge--secondary:hover {\n  background-color: color-mix(in oklch, var(--secondary) 80%, transparent);\n}\n\n.sigma-ui-badge--destructive {\n  border-color: transparent;\n  background-color: var(--destructive);\n  color: var(--destructive-foreground);\n}\n\n.sigma-ui-badge--destructive:hover {\n  background-color: color-mix(in oklch, var(--destructive) 80%, transparent);\n}\n\n.sigma-ui-badge--outline {\n  color: var(--foreground);\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/badge/index.ts",
      "content": "import { type VariantProps, cva } from 'class-variance-authority';\n\nexport { default as Badge } from './Badge.vue';\n\nexport const badgeVariants = cva(\n  'sigma-ui-badge',\n  {\n    variants: {\n      variant: {\n        default: 'sigma-ui-badge--default',\n        secondary: 'sigma-ui-badge--secondary',\n        destructive: 'sigma-ui-badge--destructive',\n        outline: 'sigma-ui-badge--outline',\n      },\n    },\n    defaultVariants: {\n      variant: 'default',\n    },\n  },\n);\n\nexport type BadgeVariants = VariantProps<typeof badgeVariants>;\n",
      "type": "registry:ui"
    }
  ]
}
