{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "time-range-field",
  "type": "registry:ui",
  "title": "Time Range Field",
  "description": "A field for a start time and an end time.",
  "dependencies": [
    "reka-ui@^2.11.0"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "ui/time-range-field/TimeRangeField.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { TimeRangeFieldRoot, type TimeRangeFieldRootEmits, type TimeRangeFieldRootProps, type SegmentPart, useForwardPropsEmits } from 'reka-ui';\nimport { TimeRangeFieldInput } from '.';\n\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\nconst props = defineProps<TimeRangeFieldRootProps>();\nconst emits = defineEmits<TimeRangeFieldRootEmits>();\nconst forwarded = useForwardPropsEmits(props, emits);\n\ndefineSlots<{\n  /**\n   * The start and end segments. Each one renders in a `TimeRangeFieldInput`, with a dash between the two times, unless you pass your own content.\n   */\n  default?: (props: {\n    modelValue: TimeRangeFieldRootProps['modelValue'];\n    segments: {\n      start: { part: SegmentPart; value: string }[];\n      end: { part: SegmentPart; value: string }[];\n    };\n    isInvalid: boolean;\n  }) => unknown;\n}>();\n</script>\n\n<template>\n  <TimeRangeFieldRoot\n    v-slot=\"slotProps\"\n    data-slot=\"time-range-field\"\n    v-bind=\"{ ...forwarded, ...delegatedAttrs() }\"\n    class=\"sigma-ui-time-range-field\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot v-bind=\"slotProps\">\n      <TimeRangeFieldInput\n        v-for=\"(item, index) in slotProps.segments.start\"\n        :key=\"`start-${item.part}-${index}`\"\n        :part=\"item.part\"\n        type=\"start\"\n      >\n        {{ item.value }}\n      </TimeRangeFieldInput>\n      <span\n        data-slot=\"time-range-field-separator\"\n        aria-hidden=\"true\"\n        class=\"sigma-ui-time-range-field__separator\"\n      >–</span>\n      <TimeRangeFieldInput\n        v-for=\"(item, index) in slotProps.segments.end\"\n        :key=\"`end-${item.part}-${index}`\"\n        :part=\"item.part\"\n        type=\"end\"\n      >\n        {{ item.value }}\n      </TimeRangeFieldInput>\n    </slot>\n  </TimeRangeFieldRoot>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-time-range-field {\n    display: inline-flex;\n    height: calc(var(--spacing) * 9);\n    align-items: center;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    background-color: var(--input);\n    font-size: 1rem;\n    padding-inline: calc(var(--spacing) * 3);\n  }\n\n  @media (width >= 48rem) {\n    .sigma-ui-time-range-field {\n      font-size: 0.875rem;\n    }\n  }\n\n  .sigma-ui-time-range-field:focus-within {\n    outline: 2px solid var(--ring);\n    outline-offset: 2px;\n  }\n\n  .sigma-ui-time-range-field[data-invalid],\n  .sigma-ui-time-range-field[aria-invalid=\"true\"] {\n    border-color: var(--destructive);\n  }\n\n  .sigma-ui-time-range-field[data-disabled] {\n    cursor: not-allowed;\n    opacity: 0.5;\n  }\n\n  .sigma-ui-time-range-field__separator {\n    color: var(--muted-foreground);\n    padding-inline: calc(var(--spacing) * 1.5);\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/time-range-field/TimeRangeFieldInput.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { TimeRangeFieldInput, type TimeRangeFieldInputProps, useForwardProps } from 'reka-ui';\n\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\nconst props = defineProps<TimeRangeFieldInputProps>();\nconst forwarded = useForwardProps(props);\n</script>\n\n<template>\n  <TimeRangeFieldInput\n    data-slot=\"time-range-field-input\"\n    v-bind=\"{ ...forwarded, ...delegatedAttrs() }\"\n    :data-part=\"props.part\"\n    class=\"sigma-ui-time-range-field-input\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot />\n  </TimeRangeFieldInput>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-time-range-field-input {\n    border-radius: var(--radius-sm);\n    font-variant-numeric: tabular-nums;\n    outline: none;\n    padding-inline: calc(var(--spacing) * 0.5);\n  }\n\n  .sigma-ui-time-range-field-input:focus {\n    background-color: var(--accent);\n    color: var(--accent-foreground);\n  }\n\n  .sigma-ui-time-range-field-input[data-part=\"literal\"] {\n    padding-inline: 0;\n  }\n\n  .sigma-ui-time-range-field-input[data-disabled] {\n    cursor: not-allowed;\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/time-range-field/index.ts",
      "content": "export { default as TimeRangeField } from './TimeRangeField.vue';\nexport { default as TimeRangeFieldInput } from './TimeRangeFieldInput.vue';\n",
      "type": "registry:ui"
    }
  ]
}
