{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-sizes",
  "type": "registry:example",
  "title": "ButtonSizes",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "path": "example/ButtonSizes.vue",
      "content": "<script setup lang=\"ts\">\nimport { PlusIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\n</script>\n\n<template>\n  <div class=\"example-button-sizes\">\n    <Button size=\"xs\">\n      Extra small\n    </Button>\n    <Button size=\"sm\">\n      Small\n    </Button>\n    <Button>Default</Button>\n    <Button size=\"lg\">\n      Large\n    </Button>\n    <Button\n      size=\"icon-xs\"\n      variant=\"outline\"\n      aria-label=\"Extra small icon\"\n    >\n      <PlusIcon />\n    </Button>\n    <Button\n      size=\"icon-sm\"\n      variant=\"outline\"\n      aria-label=\"Small icon\"\n    >\n      <PlusIcon />\n    </Button>\n    <Button\n      size=\"icon\"\n      variant=\"outline\"\n      aria-label=\"Icon\"\n    >\n      <PlusIcon />\n    </Button>\n    <Button\n      size=\"icon-lg\"\n      variant=\"outline\"\n      aria-label=\"Large icon\"\n    >\n      <PlusIcon />\n    </Button>\n  </div>\n</template>\n\n<style>\n.example-button-sizes {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: calc(var(--spacing) * 3);\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
