{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "breadcrumb-dynamic-with-ellipsis",
  "type": "registry:example",
  "title": "BreadcrumbDynamicWithEllipsis",
  "dependencies": [],
  "registryDependencies": [
    "breadcrumb",
    "dropdown-menu"
  ],
  "files": [
    {
      "path": "example/BreadcrumbDynamicWithEllipsis.vue",
      "content": "<script lang=\"ts\" setup>\nimport { computed, ref } from 'vue';\nimport {\n  Breadcrumb,\n  BreadcrumbEllipsis,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\n\ninterface BreadcrumbItemType {\n  href?: string;\n  label: string;\n}\n\nconst maxVisibleItems = ref(3);\n\nconst items = ref<BreadcrumbItemType[]>([\n  { href: '/', label: 'Home' },\n  { href: '/docs/components/breadcrumb.html', label: 'Nesting level 1' },\n  { href: '/docs/components/breadcrumb.html', label: 'Nesting level 2' },\n  { href: '/docs/components/breadcrumb.html', label: 'Nesting level 3' },\n  { href: '/docs/components/breadcrumb.html', label: 'Nesting level 4' },\n  { href: '/docs/components/breadcrumb.html', label: 'Nesting level 5' },\n]);\n\nconst visibleItems = computed(() => {\n  if (items.value.length <= maxVisibleItems.value) {\n    return items.value;\n  }\n\n  return [\n    items.value[0],\n    ...items.value.slice(-2),\n  ];\n});\n\nconst hiddenItems = computed(() => {\n  if (items.value.length <= maxVisibleItems.value) {\n    return [];\n  }\n\n  return items.value.slice(1, -2);\n});\n\nconst showEllipsis = computed(() => items.value.length > maxVisibleItems.value);\n</script>\n\n<template>\n  <Breadcrumb>\n    <BreadcrumbList>\n      <template v-if=\"items.length > 0\">\n        <BreadcrumbItem>\n          <BreadcrumbLink\n            v-if=\"items[0].href\"\n            :href=\"items[0].href\"\n          >\n            {{ items[0].label }}\n          </BreadcrumbLink>\n          <BreadcrumbPage v-else>\n            {{ items[0].label }}\n          </BreadcrumbPage>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator v-if=\"items.length > 1\" />\n      </template>\n\n      <template v-if=\"showEllipsis\">\n        <BreadcrumbItem>\n          <DropdownMenu>\n            <DropdownMenuTrigger class=\"example-sigma-ui-breadcrumb__trigger\">\n              <BreadcrumbEllipsis />\n              <span class=\"sigma-ui-sr-only\">Toggle menu</span>\n            </DropdownMenuTrigger>\n            <DropdownMenuContent align=\"start\">\n              <DropdownMenuItem\n                v-for=\"item in hiddenItems\"\n                :key=\"item.label\"\n              >\n                <a\n                  v-if=\"item.href\"\n                  :href=\"item.href\"\n                >{{ item.label }}\n                </a>\n                <span v-else>{{ item.label }}</span>\n              </DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator />\n      </template>\n\n      <template\n        v-for=\"(item, index) in visibleItems.slice(1)\"\n        :key=\"item.label\"\n      >\n        <BreadcrumbItem>\n          <template v-if=\"item.href && index !== visibleItems.length - 2\">\n            <BreadcrumbLink :href=\"item.href\">\n              {{ item.label }}\n            </BreadcrumbLink>\n          </template>\n          <template v-else>\n            <BreadcrumbPage>{{ item.label }}</BreadcrumbPage>\n          </template>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator v-if=\"index < visibleItems.length - 2\" />\n      </template>\n    </BreadcrumbList>\n  </Breadcrumb>\n</template>\n\n<style>\n.example-sigma-ui-breadcrumb__trigger {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--spacing) * 1);\n}\n\n.sigma-ui-sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
