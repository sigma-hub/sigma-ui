{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-social",
  "type": "registry:block",
  "title": "Login with social provider",
  "description": "A login form with email and password. There's an option to login with Google and a link to sign up if you don't have an account.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-social/LoginSocial.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Card class=\"login-social__card\">\n    <CardHeader>\n      <CardTitle class=\"login-social__title\">\n        Login\n      </CardTitle>\n      <CardDescription>\n        Enter your email below to login to your account\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"login-social__form\">\n        <div class=\"login-social__field\">\n          <Label for=\"email\">Email</Label>\n          <Input\n            id=\"email\"\n            autocomplete=\"username\"\n            type=\"email\"\n            placeholder=\"m@example.com\"\n            required\n          />\n        </div>\n        <div class=\"login-social__field\">\n          <div class=\"login-social__label-row\">\n            <Label for=\"password\">Password</Label>\n            <a\n              href=\"#\"\n              class=\"login-social__forgot-link\"\n            >\n              Forgot your password?\n            </a>\n          </div>\n          <Input\n            id=\"password\"\n            autocomplete=\"current-password\"\n            type=\"password\"\n            required\n          />\n        </div>\n        <Button\n          type=\"submit\"\n          class=\"login-social__button\"\n        >\n          Login\n        </Button>\n        <Button\n          variant=\"outline\"\n          type=\"button\"\n          class=\"login-social__button\"\n        >\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 0 24 24\"\n            class=\"login-social__icon\"\n            aria-hidden=\"true\"\n          >\n            <path\n              fill=\"#4285F4\"\n              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z\"\n            />\n            <path\n              fill=\"#34A853\"\n              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z\"\n            />\n            <path\n              fill=\"#FBBC05\"\n              d=\"M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84Z\"\n            />\n            <path\n              fill=\"#EA4335\"\n              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z\"\n            />\n          </svg>\n          Login with Google\n        </Button>\n      </div>\n      <div class=\"login-social__footer\">\n        Don't have an account?\n        <a\n          href=\"#\"\n          class=\"login-social__link\"\n        >\n          Sign up\n        </a>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.login-social__card {\n  max-width: 24rem;\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.login-social__title {\n  font-size: 1.5rem;\n  line-height: 2rem;\n}\n\n.login-social__form {\n  display: grid;\n  gap: calc(var(--spacing) * 4);\n}\n\n.login-social__field {\n  display: grid;\n  gap: calc(var(--spacing) * 2);\n}\n\n.login-social__label-row {\n  display: flex;\n  align-items: center;\n}\n\n.login-social__forgot-link {\n  display: inline-block;\n  margin-left: auto;\n  color: inherit;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-decoration: underline;\n}\n\n.login-social__button {\n  width: 100%;\n}\n\n.login-social__icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n}\n\n.login-social__footer {\n  margin-top: calc(var(--spacing) * 4);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-align: center;\n}\n\n.login-social__link {\n  color: inherit;\n  text-decoration: underline;\n}\n</style>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "600px",
    "containerClass": "w-full h-screen flex items-center justify-center px-4"
  },
  "categories": [
    "authentication",
    "login"
  ]
}
