{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-social",
  "type": "registry:block",
  "title": "Login with social provider",
  "description": "A login form with email and password. There's an option to login with Google and a link to sign up if you don't have an account.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-social/LoginSocial.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Card class=\"login-social__card\">\n    <CardHeader>\n      <CardTitle class=\"login-social__title\">\n        Login\n      </CardTitle>\n      <CardDescription>\n        Enter your email below to login to your account\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"login-social__form\">\n        <div class=\"login-social__field\">\n          <Label for=\"email\">Email</Label>\n          <Input\n            id=\"email\"\n            type=\"email\"\n            placeholder=\"m@example.com\"\n            required\n          />\n        </div>\n        <div class=\"login-social__field\">\n          <div class=\"login-social__label-row\">\n            <Label for=\"password\">Password</Label>\n            <a\n              href=\"#\"\n              class=\"login-social__forgot-link\"\n            >\n              Forgot your password?\n            </a>\n          </div>\n          <Input\n            id=\"password\"\n            type=\"password\"\n            required\n          />\n        </div>\n        <Button\n          type=\"submit\"\n          class=\"login-social__button\"\n        >\n          Login\n        </Button>\n        <Button\n          variant=\"outline\"\n          class=\"login-social__button\"\n        >\n          Login with Google\n        </Button>\n      </div>\n      <div class=\"login-social__footer\">\n        Don't have an account?\n        <a\n          href=\"#\"\n          class=\"login-social__link\"\n        >\n          Sign up\n        </a>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.login-social__card {\n  max-width: 24rem;\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.login-social__title {\n  font-size: 1.5rem;\n  line-height: 2rem;\n}\n\n.login-social__form {\n  display: grid;\n  gap: 1rem;\n}\n\n.login-social__field {\n  display: grid;\n  gap: 0.5rem;\n}\n\n.login-social__label-row {\n  display: flex;\n  align-items: center;\n}\n\n.login-social__forgot-link {\n  display: inline-block;\n  margin-left: auto;\n  color: inherit;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-decoration: underline;\n}\n\n.login-social__button {\n  width: 100%;\n}\n\n.login-social__footer {\n  margin-top: 1rem;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-align: center;\n}\n\n.login-social__link {\n  color: inherit;\n  text-decoration: underline;\n}\n</style>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "600px",
    "containerClass": "w-full h-screen flex items-center justify-center px-4"
  },
  "categories": [
    "authentication",
    "login"
  ]
}
