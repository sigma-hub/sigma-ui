      "content": "<script setup lang=\"ts\">\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from '@/components/ui/resizable';\n</script>\n\n<template>\n  <ResizablePanelGroup\n    id=\"demo-group-1\"\n    direction=\"horizontal\"\n    class=\"example-sigma-ui-resizable\"\n  >\n    <ResizablePanel\n      id=\"demo-panel-1\"\n      :default-size=\"50\"\n    >\n      <div class=\"example-sigma-ui-resizable__panel\">\n        <span class=\"example-sigma-ui-resizable__text\">One</span>\n      </div>\n    </ResizablePanel>\n    <ResizableHandle id=\"demo-handle-1\" />\n    <ResizablePanel\n      id=\"demo-panel-2\"\n      :default-size=\"50\"\n    >\n      <ResizablePanelGroup\n        id=\"demo-group-2\"\n        direction=\"vertical\"\n        class=\"example-sigma-ui-resizable__nested-group\"\n      >\n        <ResizablePanel\n          id=\"demo-panel-3\"\n          :default-size=\"25\"\n        >\n          <div class=\"example-sigma-ui-resizable__panel\">\n            <span class=\"example-sigma-ui-resizable__text\">Two</span>\n          </div>\n        </ResizablePanel>\n        <ResizableHandle id=\"demo-handle-2\" />\n        <ResizablePanel\n          id=\"demo-panel-4\"\n          :default-size=\"75\"\n        >\n          <div class=\"example-sigma-ui-resizable__panel\">\n            <span class=\"example-sigma-ui-resizable__text\">Three</span>\n          </div>\n        </ResizablePanel>\n      </ResizablePanelGroup>\n    </ResizablePanel>\n  </ResizablePanelGroup>\n</template>\n\n<style>\n@layer components {\n  .example-sigma-ui-resizable {\n    max-width: 28rem;\n    min-height: 200px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n  }\n\n  .example-sigma-ui-resizable__nested-group {\n    height: 100%;\n  }\n\n  .example-sigma-ui-resizable__panel {\n    display: flex;\n    height: 100%;\n    align-items: center;\n    justify-content: center;\n    padding: calc(var(--spacing) * 6);\n  }\n\n  .example-sigma-ui-resizable__text {\n    font-weight: 600;\n  }\n}\n</style>\n",
