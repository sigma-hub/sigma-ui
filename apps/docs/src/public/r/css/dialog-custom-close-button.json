{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-custom-close-button",
  "type": "registry:example",
  "title": "DialogCustomCloseButton",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "button",
    "dialog",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "example/DialogCustomCloseButton.vue",
      "content": "<script setup lang=\"ts\">\nimport { CopyIcon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Dialog>\n    <DialogTrigger as-child>\n      <Button variant=\"outline\">\n        Share\n      </Button>\n    </DialogTrigger>\n    <DialogContent class=\"example-sigma-ui-dialog__content\">\n      <DialogHeader>\n        <DialogTitle>Share link</DialogTitle>\n        <DialogDescription>\n          Anyone who has this link will be able to view this.\n        </DialogDescription>\n      </DialogHeader>\n      <div class=\"example-sigma-ui-dialog__share\">\n        <div class=\"example-sigma-ui-dialog__share-input\">\n          <Label\n            for=\"link\"\n            class=\"sigma-ui-sr-only\"\n          >\n            Link\n          </Label>\n          <Input\n            id=\"link\"\n            model-value=\"https://sigma-ui.dev/docs/installation\"\n            read-only\n          />\n        </div>\n        <Button\n          type=\"submit\"\n          size=\"sm\"\n          class=\"example-sigma-ui-dialog__share-button\"\n        >\n          <span class=\"sigma-ui-sr-only\">Copy</span>\n          <CopyIcon class=\"example-sigma-ui-dialog__share-icon\" />\n        </Button>\n      </div>\n      <DialogFooter class=\"example-sigma-ui-dialog__footer\">\n        <DialogClose as-child>\n          <Button\n            type=\"button\"\n            variant=\"secondary\"\n          >\n            Close\n          </Button>\n        </DialogClose>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n\n<style>\n@layer components {\n  .example-sigma-ui-dialog__content {\n    max-width: 425px;\n  }\n\n  @media (width >= 40rem) {\n    .example-sigma-ui-dialog__content {\n      max-width: 425px;\n    }\n  }\n\n  .example-sigma-ui-dialog__share {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .example-sigma-ui-dialog__share-input {\n    display: grid;\n    flex: 1;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .example-sigma-ui-dialog__share-button {\n    padding-right: calc(var(--spacing) * 3);\n    padding-left: calc(var(--spacing) * 3);\n  }\n\n  .example-sigma-ui-dialog__share-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .example-sigma-ui-dialog__footer {\n    justify-content: flex-start;\n  }\n\n  @media (width >= 40rem) {\n    .example-sigma-ui-dialog__footer.sigma-ui-dialog-footer {\n      justify-content: flex-start;\n    }\n  }\n\n  .sigma-ui-sr-only {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
