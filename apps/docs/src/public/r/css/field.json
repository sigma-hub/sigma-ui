{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field",
  "type": "registry:ui",
  "dependencies": [
    "class-variance-authority@^0.7.1",
    "reka-ui@^2.11.0"
  ],
  "registryDependencies": [
    "label",
    "separator"
  ],
  "files": [
    {
      "path": "ui/field/Field.vue",
      "content": "<script setup lang=\"ts\">\nimport { type FieldVariants, fieldVariants } from '.';\n\ninterface FieldProps {\n  /**\n   * Layout of the label and the control. `responsive` switches from vertical to horizontal when the parent `FieldGroup` is wide enough.\n   */\n  orientation?: FieldVariants['orientation'];\n  /**\n   * Marks the field as invalid and colors its label and description.\n   */\n  invalid?: boolean;\n  /**\n   * Dims the label to match a disabled control.\n   */\n  disabled?: boolean;\n}\n\nconst props = withDefaults(defineProps<FieldProps>(), {\n  orientation: 'vertical',\n  invalid: false,\n  disabled: false,\n});\n\ndefineSlots<{\n  /**\n   * Field parts: `FieldLabel`, the control, `FieldDescription`, and `FieldError`.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    role=\"group\"\n    data-slot=\"field\"\n    :data-orientation=\"props.orientation\"\n    :data-invalid=\"props.invalid || undefined\"\n    :data-disabled=\"props.disabled || undefined\"\n    :class=\"[fieldVariants({ orientation: props.orientation }), $attrs.class]\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n.sigma-ui-field {\n  display: flex;\n  width: 100%;\n  gap: 0.75rem;\n}\n\n.sigma-ui-field[data-invalid=\"true\"] {\n  color: var(--destructive);\n}\n\n.sigma-ui-field--vertical,\n.sigma-ui-field--responsive {\n  flex-direction: column;\n}\n\n.sigma-ui-field--vertical > *,\n.sigma-ui-field--responsive > * {\n  width: 100%;\n}\n\n.sigma-ui-field--horizontal {\n  flex-direction: row;\n  align-items: center;\n}\n\n.sigma-ui-field--horizontal > [data-slot=\"field-label\"] {\n  flex: auto;\n}\n\n.sigma-ui-field--horizontal:has(> [data-slot=\"field-content\"]) {\n  align-items: flex-start;\n}\n\n.sigma-ui-field--horizontal:has(> [data-slot=\"field-content\"]) > :is([role=\"checkbox\"], [role=\"radio\"], .sigma-ui-checkbox-wrapper) {\n  margin-top: 1px;\n}\n\n@container field-group (width >= 28rem) {\n  .sigma-ui-field.sigma-ui-field--responsive {\n    flex-direction: row;\n    align-items: center;\n  }\n\n  .sigma-ui-field.sigma-ui-field--responsive > * {\n    width: auto;\n  }\n\n  .sigma-ui-field.sigma-ui-field--responsive > [data-slot=\"field-label\"] {\n    flex: auto;\n  }\n\n  .sigma-ui-field.sigma-ui-field--responsive:has(> [data-slot=\"field-content\"]) {\n    align-items: flex-start;\n  }\n\n  .sigma-ui-field.sigma-ui-field--responsive:has(> [data-slot=\"field-content\"]) > :is([role=\"checkbox\"], [role=\"radio\"], .sigma-ui-checkbox-wrapper) {\n    margin-top: 1px;\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldContent.vue",
      "content": "<script setup lang=\"ts\">\ndefineSlots<{\n  /**\n   * `FieldLabel` or `FieldTitle` with a `FieldDescription`, placed next to a checkbox, radio, or switch.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"field-content\"\n    class=\"sigma-ui-field-content\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n.sigma-ui-field-content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: 0.375rem;\n  line-height: 1.375;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldDescription.vue",
      "content": "<script setup lang=\"ts\">\ndefineSlots<{\n  /**\n   * Helper text. Links inside it are underlined.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <p\n    data-slot=\"field-description\"\n    class=\"sigma-ui-field-description\"\n  >\n    <slot />\n  </p>\n</template>\n\n<style>\n.sigma-ui-field-description {\n  margin: 0;\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  font-weight: 400;\n  line-height: 1.5;\n}\n\n.sigma-ui-field-description:nth-last-child(2) {\n  margin-top: -0.25rem;\n}\n\n.sigma-ui-field-description:last-child {\n  margin-top: 0;\n}\n\n[data-variant=\"legend\"] + .sigma-ui-field-description {\n  margin-top: -0.375rem;\n}\n\n.sigma-ui-field--horizontal .sigma-ui-field-description {\n  text-wrap: balance;\n}\n\n.sigma-ui-field-description > a {\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n.sigma-ui-field-description > a:hover {\n  color: var(--primary);\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldError.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport type { FieldErrorItem } from '.';\n\ninterface FieldErrorProps {\n  /**\n   * Error messages to show. Accepts strings or objects with a `message`, such as validation library issues. Duplicates are removed.\n   */\n  errors?: FieldErrorItem[];\n}\n\nconst props = defineProps<FieldErrorProps>();\n\nconst slots = defineSlots<{\n  /**\n   * Custom error content. Replaces the `errors` list.\n   */\n  default?: () => unknown;\n}>();\n\nconst messages = computed(() => {\n  const uniqueMessages = new Set<string>();\n\n  for (const error of props.errors ?? []) {\n    const message = typeof error === 'string' ? error : error?.message;\n\n    if (message) {\n      uniqueMessages.add(message);\n    }\n  }\n\n  return [...uniqueMessages];\n});\n</script>\n\n<template>\n  <div\n    v-if=\"slots.default || messages.length\"\n    role=\"alert\"\n    data-slot=\"field-error\"\n    class=\"sigma-ui-field-error\"\n  >\n    <slot v-if=\"slots.default\" />\n    <template v-else-if=\"messages.length === 1\">\n      {{ messages[0] }}\n    </template>\n    <ul\n      v-else\n      class=\"sigma-ui-field-error__list\"\n    >\n      <li\n        v-for=\"message in messages\"\n        :key=\"message\"\n      >\n        {{ message }}\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style>\n.sigma-ui-field-error {\n  color: var(--destructive);\n  font-size: 0.875rem;\n  font-weight: 400;\n}\n\n.sigma-ui-field-error__list {\n  display: flex;\n  flex-direction: column;\n  padding: 0;\n  margin: 0 0 0 1rem;\n  gap: 0.25rem;\n  list-style: disc;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldGroup.vue",
      "content": "<script setup lang=\"ts\">\ndefineSlots<{\n  /**\n   * `Field`, `FieldSet`, and `FieldSeparator` components.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"field-group\"\n    class=\"sigma-ui-field-group\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n.sigma-ui-field-group {\n  display: flex;\n  width: 100%;\n  flex-direction: column;\n  container: field-group / inline-size;\n  gap: 1.75rem;\n}\n\n.sigma-ui-field-group[data-slot=\"checkbox-group\"] {\n  gap: 0.75rem;\n}\n\n.sigma-ui-field-group > .sigma-ui-field-group {\n  gap: 1rem;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldLabel.vue",
      "content": "<script setup lang=\"ts\">\nimport type { LabelProps } from 'reka-ui';\nimport { Label } from '@/components/ui/label';\n\nconst props = defineProps<LabelProps>();\n\ndefineSlots<{\n  /**\n   * Label text. Wrap a whole `Field` to turn it into a selectable card.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <Label\n    v-bind=\"props\"\n    data-slot=\"field-label\"\n    class=\"sigma-ui-field-label\"\n  >\n    <slot />\n  </Label>\n</template>\n\n<style>\n.sigma-ui-label.sigma-ui-field-label {\n  display: flex;\n  width: fit-content;\n  gap: 0.5rem;\n  line-height: 1.375;\n}\n\n.sigma-ui-field[data-disabled=\"true\"] .sigma-ui-field-label {\n  opacity: 0.5;\n}\n\n.sigma-ui-label.sigma-ui-field-label:has(> [data-slot=\"field\"]) {\n  width: 100%;\n  flex-direction: column;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n}\n\n.sigma-ui-field-label > [data-slot=\"field\"] {\n  padding: 1rem;\n}\n\n.sigma-ui-label.sigma-ui-field-label:has([data-state=\"checked\"]) {\n  border-color: var(--primary);\n  background-color: color-mix(in oklch, var(--primary) 5%, transparent);\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldLegend.vue",
      "content": "<script setup lang=\"ts\">\ninterface FieldLegendProps {\n  /**\n   * `legend` renders a section heading, `label` matches the size of a field label.\n   */\n  variant?: 'legend' | 'label';\n}\n\nconst props = withDefaults(defineProps<FieldLegendProps>(), {\n  variant: 'legend',\n});\n\ndefineSlots<{\n  /**\n   * Legend text of the `FieldSet`.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <legend\n    data-slot=\"field-legend\"\n    :data-variant=\"props.variant\"\n    class=\"sigma-ui-field-legend\"\n  >\n    <slot />\n  </legend>\n</template>\n\n<style>\n.sigma-ui-field-legend {\n  padding: 0;\n  margin-bottom: 0.75rem;\n  font-size: 1rem;\n  font-weight: 500;\n}\n\n.sigma-ui-field-legend[data-variant=\"label\"] {\n  font-size: 0.875rem;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldSeparator.vue",
      "content": "<script setup lang=\"ts\">\nimport { Separator } from '@/components/ui/separator';\n\nconst slots = defineSlots<{\n  /**\n   * Optional text shown in the middle of the line, such as \"Or continue with\".\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"field-separator\"\n    :data-content=\"!!slots.default\"\n    class=\"sigma-ui-field-separator\"\n  >\n    <Separator class=\"sigma-ui-field-separator__line\" />\n    <span\n      v-if=\"slots.default\"\n      class=\"sigma-ui-field-separator__content\"\n      data-slot=\"field-separator-content\"\n    >\n      <slot />\n    </span>\n  </div>\n</template>\n\n<style>\n.sigma-ui-field-separator {\n  position: relative;\n  height: 1.25rem;\n  margin: -0.5rem 0;\n  font-size: 0.875rem;\n}\n\n.sigma-ui-separator.sigma-ui-field-separator__line {\n  position: absolute;\n  top: 50%;\n  inset-inline: 0;\n}\n\n.sigma-ui-field-separator__content {\n  position: relative;\n  display: block;\n  width: fit-content;\n  padding: 0 0.5rem;\n  margin: 0 auto;\n  background-color: var(--background);\n  color: var(--muted-foreground);\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldSet.vue",
      "content": "<script setup lang=\"ts\">\ndefineSlots<{\n  /**\n   * A `FieldLegend`, an optional `FieldDescription`, and a `FieldGroup`.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <fieldset\n    data-slot=\"field-set\"\n    class=\"sigma-ui-field-set\"\n  >\n    <slot />\n  </fieldset>\n</template>\n\n<style>\n.sigma-ui-field-set {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  padding: 0;\n  border: none;\n  margin: 0;\n  gap: 1.5rem;\n}\n\n.sigma-ui-field-set:has(> [data-slot=\"checkbox-group\"]),\n.sigma-ui-field-set:has(> [data-slot=\"radio-group\"]) {\n  gap: 0.75rem;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/FieldTitle.vue",
      "content": "<script setup lang=\"ts\">\ndefineSlots<{\n  /**\n   * Title text. Use instead of `FieldLabel` when the title is not tied to a single control.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"field-label\"\n    class=\"sigma-ui-field-title\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n.sigma-ui-field-title {\n  display: flex;\n  width: fit-content;\n  align-items: center;\n  font-size: 0.875rem;\n  font-weight: 500;\n  gap: 0.5rem;\n  line-height: 1.375;\n}\n\n.sigma-ui-field[data-disabled=\"true\"] .sigma-ui-field-title {\n  opacity: 0.5;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/field/index.ts",
      "content": "import { type VariantProps, cva } from 'class-variance-authority';\n\nexport { default as Field } from './Field.vue';\nexport { default as FieldContent } from './FieldContent.vue';\nexport { default as FieldDescription } from './FieldDescription.vue';\nexport { default as FieldError } from './FieldError.vue';\nexport { default as FieldGroup } from './FieldGroup.vue';\nexport { default as FieldLabel } from './FieldLabel.vue';\nexport { default as FieldLegend } from './FieldLegend.vue';\nexport { default as FieldSeparator } from './FieldSeparator.vue';\nexport { default as FieldSet } from './FieldSet.vue';\nexport { default as FieldTitle } from './FieldTitle.vue';\n\nexport const fieldVariants = cva(\n  'sigma-ui-field',\n  {\n    variants: {\n      orientation: {\n        vertical: 'sigma-ui-field--vertical',\n        horizontal: 'sigma-ui-field--horizontal',\n        responsive: 'sigma-ui-field--responsive',\n      },\n    },\n    defaultVariants: {\n      orientation: 'vertical',\n    },\n  },\n);\n\nexport type FieldVariants = VariantProps<typeof fieldVariants>;\n\nexport type FieldErrorItem = string | { message?: string } | undefined;\n",
      "type": "registry:ui"
    }
  ]
}
