a-ui-resizable-handle__grip {\n  z-index: 10;\n  display: flex;\n  width: 0.75rem;\n  height: 1rem;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  background-color: var(--border);\n}\n\n.sigma-ui-resizable-handle__grip-icon {\n  width: 0.625rem;\n  height: 0.625rem;\n}\n</style>\n",
