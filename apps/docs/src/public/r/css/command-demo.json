{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-demo",
  "type": "registry:example",
  "title": "Command",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "command",
    "toaster"
  ],
  "files": [
    {
      "path": "example/Command.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CalculatorIcon,\n  CalendarIcon,\n  CreditCardIcon,\n  SettingsIcon,\n  SmileIcon,\n  UserIcon,\n} from '@lucide/vue';\nimport { toast } from '@/components/ui/toaster';\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut,\n} from '@/components/ui/command';\n\nfunction handleSelect(event: any) {\n  if (event.detail?.value) {\n    toast('Selected command', {\n      description: `You selected: ${event.detail.value}`,\n    });\n  }\n}\n</script>\n\n<template>\n  <Command class=\"example-sigma-ui-command\">\n    <CommandInput placeholder=\"Type a command or search...\" />\n    <CommandList>\n      <CommandEmpty>No results found.</CommandEmpty>\n      <CommandGroup heading=\"Suggestions\">\n        <CommandItem\n          value=\"Calendar\"\n          @select=\"handleSelect\"\n        >\n          <CalendarIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Calendar</span>\n        </CommandItem>\n        <CommandItem\n          value=\"Search Emoji\"\n          @select=\"handleSelect\"\n        >\n          <SmileIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Search Emoji</span>\n        </CommandItem>\n        <CommandItem\n          value=\"Calculator\"\n          @select=\"handleSelect\"\n        >\n          <CalculatorIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Calculator</span>\n        </CommandItem>\n      </CommandGroup>\n      <CommandSeparator />\n      <CommandGroup heading=\"Settings\">\n        <CommandItem\n          value=\"Profile\"\n          @select=\"handleSelect\"\n        >\n          <UserIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Profile</span>\n          <CommandShortcut>⌘P</CommandShortcut>\n        </CommandItem>\n        <CommandItem\n          value=\"Billing\"\n          @select=\"handleSelect\"\n        >\n          <CreditCardIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Billing</span>\n          <CommandShortcut>⌘B</CommandShortcut>\n        </CommandItem>\n        <CommandItem\n          value=\"Settings\"\n          @select=\"handleSelect\"\n        >\n          <SettingsIcon class=\"example-sigma-ui-command__icon\" />\n          <span>Settings</span>\n          <CommandShortcut>⌘S</CommandShortcut>\n        </CommandItem>\n      </CommandGroup>\n    </CommandList>\n  </Command>\n</template>\n\n<style>\n@layer components {\n  .example-sigma-ui-command {\n    max-width: 450px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-lg);\n    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%);\n  }\n\n  .example-sigma-ui-command__icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    margin-right: calc(var(--spacing) * 2);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
