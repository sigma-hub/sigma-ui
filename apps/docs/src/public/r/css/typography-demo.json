      "path": "example/TypographyDemo.vue",
      "content": "<script setup lang=\"ts\">\nimport { Typography } from '@/components/ui/typography';\n</script>\n\n<template>\n  <div class=\"example-typography\">\n    <Typography variant=\"h1\">\n      The Joke Tax Chronicles\n    </Typography>\n    <Typography variant=\"p\">\n      Once upon a time, in a far-off land, there was a very lazy king who spent all day lounging on his throne.\n    </Typography>\n    <Typography variant=\"h2\">\n      The King's Plan\n    </Typography>\n    <Typography variant=\"p\">\n      The king thought long and hard, and finally came up with\n      <Typography\n        variant=\"link\"\n        href=\"#\"\n      >\n        a brilliant plan\n      </Typography>: he would tax the jokes in the kingdom.\n    </Typography>\n    <Typography variant=\"blockquote\">\n      \"After all,\" he said, \"everyone enjoys a good joke, so it's only fair that they should pay for the privilege.\"\n    </Typography>\n    <Typography variant=\"h3\">\n      The Joke Tax\n    </Typography>\n    <Typography variant=\"list\">\n      <li>1st level of puns: 5 gold coins</li>\n      <li>2nd level of jokes: 10 gold coins</li>\n      <li>3rd level of one-liners: 20 gold coins</li>\n    </Typography>\n    <Typography variant=\"p\">\n      People stopped telling jokes. The court jester left notes written in\n      <Typography variant=\"code\">\n        gold\n      </Typography>\n      ink.\n    </Typography>\n    <Typography variant=\"lead\">\n      Laughter returned to the kingdom.\n    </Typography>\n    <Typography variant=\"large\">\n      The treasury\n    </Typography>\n    <div class=\"example-typography__table\">\n      <Typography variant=\"table\">\n        <thead>\n          <tr>\n            <th>King's Treasury</th>\n            <th>People's happiness</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Empty</td>\n            <td>Overflowing</td>\n          </tr>\n          <tr>\n            <td>Full</td>\n            <td>Ecstatic</td>\n          </tr>\n        </tbody>\n      </Typography>\n    </div>\n    <Typography variant=\"small\">\n      Repealed by royal decree.\n    </Typography>\n    <Typography variant=\"muted\">\n      The moral: never underestimate a good laugh.\n    </Typography>\n  </div>\n</template>\n\n<style>\n.example-typography {\n  max-width: 65ch;\n}\n\n.example-typography__table {\n  width: 100%;\n  margin: calc(var(--spacing) * 6) 0;\n  overflow-y: auto;\n}\n</style>\n",
      "type": "registry:example"
