{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-analytics",
  "type": "registry:block",
  "title": "Analytics dashboard",
  "description": "An application shell with a header and main content area. The header has a navbar, a search input and and a user nav dropdown. The user nav is toggled by a button with an avatar image. The main content area is divided into two rows. The first row has a grid of cards with statistics. The second row has a grid of cards with a table of recent transactions and a list of recent sales.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "avatar",
    "badge",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "sheet",
    "table"
  ],
  "files": [
    {
      "path": "blocks/dashboard-analytics/DashboardAnalytics.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport RecentSalesCard from './components/RecentSalesCard.vue';\nimport StatCard from './components/StatCard.vue';\nimport TransactionsCard from './components/TransactionsCard.vue';\nimport {\n  accountMenu,\n  brandHref,\n  brandName,\n  headerLinks,\n  navigationLabel,\n  recentSales,\n  recentSalesTitle,\n  searchPlaceholder,\n  statCards,\n  transactionColumnLabels,\n  transactions,\n  transactionsActionHref,\n  transactionsActionLabel,\n  transactionsDescription,\n  transactionsTitle,\n  userMenuLabel,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-analytics\">\n    <AppHeader\n      :brand-name=\"brandName\"\n      :brand-href=\"brandHref\"\n      :links=\"headerLinks\"\n      :search-placeholder=\"searchPlaceholder\"\n      :menu-entries=\"accountMenu\"\n      :user-menu-label=\"userMenuLabel\"\n      :navigation-label=\"navigationLabel\"\n    />\n    <main class=\"dashboard-analytics__main\">\n      <div class=\"dashboard-analytics__stats\">\n        <StatCard\n          v-for=\"stat in statCards\"\n          :key=\"stat.title\"\n          :title=\"stat.title\"\n          :value=\"stat.value\"\n          :change=\"stat.change\"\n          :icon=\"stat.icon\"\n        />\n      </div>\n      <div class=\"dashboard-analytics__panels\">\n        <TransactionsCard\n          class=\"dashboard-analytics__transactions\"\n          :title=\"transactionsTitle\"\n          :description=\"transactionsDescription\"\n          :action-label=\"transactionsActionLabel\"\n          :action-href=\"transactionsActionHref\"\n          :column-labels=\"transactionColumnLabels\"\n          :rows=\"transactions\"\n        />\n        <RecentSalesCard\n          :title=\"recentSalesTitle\"\n          :sales=\"recentSales\"\n        />\n      </div>\n    </main>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics {\n    display: flex;\n    width: 100%;\n    min-height: 100vh;\n    flex-direction: column;\n  }\n\n  .dashboard-analytics__main {\n    display: flex;\n    flex: 1 1 0%;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-analytics__stats,\n  .dashboard-analytics__panels {\n    display: grid;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-analytics__main {\n      padding: calc(var(--spacing) * 8);\n      gap: calc(var(--spacing) * 8);\n    }\n\n    .dashboard-analytics__stats {\n      gap: calc(var(--spacing) * 8);\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .dashboard-analytics__panels {\n      gap: calc(var(--spacing) * 8);\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-analytics__stats {\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n\n    .dashboard-analytics__panels {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media (width >= 80rem) {\n    .dashboard-analytics__panels {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n\n    .dashboard-analytics__transactions {\n      grid-column: span 2 / span 2;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { MenuIcon, Package2Icon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { AccountMenuEntry, NavLink } from '../data';\nimport SearchForm from './SearchForm.vue';\nimport UserMenu from './UserMenu.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  searchPlaceholder: string;\n  menuEntries: AccountMenuEntry[];\n  userMenuLabel: string;\n  navigationLabel: string;\n}>();\n</script>\n\n<template>\n  <header class=\"dashboard-analytics__header\">\n    <nav class=\"dashboard-analytics__desktop-nav\">\n      <a\n        :href=\"brandHref\"\n        class=\"dashboard-analytics__brand dashboard-analytics__brand--desktop\"\n      >\n        <Package2Icon class=\"dashboard-analytics__icon-lg\" />\n        <span class=\"dashboard-analytics__sr-only\">{{ brandName }}</span>\n      </a>\n      <a\n        v-for=\"link in links\"\n        :key=\"link.label\"\n        :href=\"link.href\"\n        class=\"dashboard-analytics__desktop-link\"\n        :class=\"{ 'dashboard-analytics__desktop-link--active': link.isActive }\"\n      >\n        {{ link.label }}\n      </a>\n    </nav>\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          variant=\"outline\"\n          size=\"icon\"\n          class=\"dashboard-analytics__menu-button\"\n        >\n          <MenuIcon class=\"dashboard-analytics__icon-md\" />\n          <span class=\"dashboard-analytics__sr-only\">{{ navigationLabel }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent side=\"left\">\n        <nav class=\"dashboard-analytics__mobile-nav\">\n          <a\n            :href=\"brandHref\"\n            class=\"dashboard-analytics__brand\"\n          >\n            <Package2Icon class=\"dashboard-analytics__icon-lg\" />\n            <span class=\"dashboard-analytics__sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"link in links\"\n            :key=\"link.label\"\n            :href=\"link.href\"\n            class=\"dashboard-analytics__mobile-link\"\n            :class=\"{ 'dashboard-analytics__mobile-link--muted': !link.isActive }\"\n          >\n            {{ link.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <div class=\"dashboard-analytics__tools\">\n      <SearchForm :placeholder=\"searchPlaceholder\" />\n      <UserMenu\n        :entries=\"menuEntries\"\n        :trigger-label=\"userMenuLabel\"\n      />\n    </div>\n  </header>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__header {\n    position: sticky;\n    top: 0;\n    display: flex;\n    height: calc(var(--spacing) * 16);\n    align-items: center;\n    padding: 0 calc(var(--spacing) * 4);\n    border-bottom: 1px solid var(--border);\n    background-color: var(--background);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-analytics__desktop-nav {\n    display: none;\n    font-weight: 500;\n  }\n\n  .dashboard-analytics__brand {\n    display: flex;\n    align-items: center;\n    color: inherit;\n    font-size: 1.125rem;\n    font-weight: 600;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1.75rem;\n    text-decoration: none;\n  }\n\n  .dashboard-analytics__desktop-link {\n    color: var(--muted-foreground);\n    text-decoration: none;\n    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .dashboard-analytics__desktop-link:hover,\n  .dashboard-analytics__desktop-link--active,\n  .dashboard-analytics__desktop-link--active:hover {\n    color: var(--foreground);\n  }\n\n  .dashboard-analytics__mobile-nav {\n    display: grid;\n    font-size: 1.125rem;\n    font-weight: 500;\n    gap: calc(var(--spacing) * 6);\n    line-height: 1.75rem;\n  }\n\n  .dashboard-analytics__mobile-link {\n    color: var(--foreground);\n    text-decoration: none;\n  }\n\n  .dashboard-analytics__mobile-link:hover,\n  .dashboard-analytics__mobile-link--muted:hover {\n    color: var(--foreground);\n  }\n\n  .dashboard-analytics__mobile-link--muted {\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-analytics__tools {\n    display: flex;\n    width: 100%;\n    align-items: center;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-analytics__menu-button {\n    flex-shrink: 0;\n  }\n\n  .dashboard-analytics__icon-lg {\n    width: calc(var(--spacing) * 6);\n    height: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-analytics__icon-md {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  .dashboard-analytics__sr-only {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-analytics__header {\n      padding: 0 calc(var(--spacing) * 6);\n    }\n\n    .dashboard-analytics__desktop-nav {\n      display: flex;\n      flex-direction: row;\n      align-items: center;\n      font-size: 0.875rem;\n      gap: calc(var(--spacing) * 5);\n      line-height: 1.25rem;\n    }\n\n    .dashboard-analytics__brand--desktop {\n      font-size: 1rem;\n      line-height: 1.5rem;\n    }\n\n    .dashboard-analytics__tools {\n      margin-left: auto;\n      gap: calc(var(--spacing) * 2);\n    }\n\n    .dashboard-analytics__menu-button.dashboard-analytics__menu-button {\n      display: none;\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-analytics__desktop-nav {\n      gap: calc(var(--spacing) * 6);\n    }\n\n    .dashboard-analytics__tools {\n      gap: calc(var(--spacing) * 4);\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/RecentSalesCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Avatar } from '@/components/ui/avatar';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { SaleRow } from '../data';\n\ndefineProps<{\n  title: string;\n  sales: SaleRow[];\n}>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n    </CardHeader>\n    <CardContent class=\"dashboard-analytics__sales\">\n      <div\n        v-for=\"sale in sales\"\n        :key=\"sale.id\"\n        class=\"dashboard-analytics__sale\"\n      >\n        <Avatar\n          size=\"sm\"\n          class=\"dashboard-analytics__avatar\"\n        />\n        <div class=\"dashboard-analytics__sale-body\">\n          <p class=\"dashboard-analytics__sale-name\">\n            {{ sale.name }}\n          </p>\n          <p class=\"dashboard-analytics__sale-email\">\n            {{ sale.email }}\n          </p>\n        </div>\n        <div class=\"dashboard-analytics__sale-amount\">\n          {{ sale.amount }}\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__sales.dashboard-analytics__sales {\n    display: grid;\n    gap: calc(var(--spacing) * 8);\n  }\n\n  .dashboard-analytics__sale {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-analytics__avatar.dashboard-analytics__avatar {\n    display: none;\n  }\n\n  .dashboard-analytics__sale-body {\n    display: grid;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-analytics__sale-name,\n  .dashboard-analytics__sale-email {\n    margin: 0;\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-analytics__sale-name {\n    font-weight: 500;\n    line-height: 1;\n  }\n\n  .dashboard-analytics__sale-email {\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-analytics__sale-amount {\n    margin-left: auto;\n    font-weight: 500;\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-analytics__avatar.dashboard-analytics__avatar {\n      display: flex;\n      width: calc(var(--spacing) * 9);\n      height: calc(var(--spacing) * 9);\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/SearchForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { SearchIcon } from '@lucide/vue';\nimport { Input } from '@/components/ui/input';\n\ndefineProps<{\n  placeholder: string;\n}>();\n</script>\n\n<template>\n  <form class=\"dashboard-analytics__search\">\n    <div class=\"dashboard-analytics__search-field\">\n      <SearchIcon class=\"dashboard-analytics__search-icon\" />\n      <Input\n        type=\"search\"\n        :placeholder=\"placeholder\"\n        class=\"dashboard-analytics__search-input\"\n      />\n    </div>\n  </form>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__search {\n    flex: 1 1 0%;\n    margin-left: auto;\n  }\n\n  .dashboard-analytics__search-field {\n    position: relative;\n  }\n\n  .dashboard-analytics__search-icon {\n    position: absolute;\n    top: calc(var(--spacing) * 2.5);\n    left: calc(var(--spacing) * 2.5);\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-analytics__search-input.dashboard-analytics__search-input {\n    padding-left: calc(var(--spacing) * 8);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-analytics__search {\n      flex: 0 1 auto;\n    }\n\n    .dashboard-analytics__search-input.dashboard-analytics__search-input {\n      width: 300px;\n    }\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-analytics__search-input.dashboard-analytics__search-input {\n      width: 200px;\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-analytics__search-input.dashboard-analytics__search-input {\n      width: 300px;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/StatCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { StatCardData } from '../data';\n\ndefineProps<StatCardData>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader class=\"dashboard-analytics__stat-header\">\n      <CardTitle class=\"dashboard-analytics__stat-title\">\n        {{ title }}\n      </CardTitle>\n      <component\n        :is=\"icon\"\n        class=\"dashboard-analytics__stat-icon\"\n      />\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-analytics__stat-value\">\n        {{ value }}\n      </div>\n      <p class=\"dashboard-analytics__stat-change\">\n        {{ change }}\n      </p>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__stat-header.dashboard-analytics__stat-header {\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n    padding-bottom: calc(var(--spacing) * 2);\n    gap: 0;\n  }\n\n  .dashboard-analytics__stat-title.dashboard-analytics__stat-title {\n    font-size: 0.875rem;\n    font-weight: 500;\n    letter-spacing: normal;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-analytics__stat-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-analytics__stat-value {\n    font-size: 1.5rem;\n    font-weight: 700;\n    line-height: 2rem;\n  }\n\n  .dashboard-analytics__stat-change {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    line-height: 1rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/TransactionsCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { ArrowUpRightIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';\nimport type { TransactionColumnLabels, TransactionRow } from '../data';\n\ndefineProps<{\n  title: string;\n  description: string;\n  actionLabel: string;\n  actionHref: string;\n  columnLabels: TransactionColumnLabels;\n  rows: TransactionRow[];\n}>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader class=\"dashboard-analytics__transactions-header\">\n      <div class=\"dashboard-analytics__transactions-heading\">\n        <CardTitle>{{ title }}</CardTitle>\n        <CardDescription>\n          {{ description }}\n        </CardDescription>\n      </div>\n      <Button\n        as-child\n        size=\"sm\"\n        class=\"dashboard-analytics__view-all\"\n      >\n        <a :href=\"actionHref\">\n          {{ actionLabel }}\n          <ArrowUpRightIcon class=\"dashboard-analytics__icon-sm\" />\n        </a>\n      </Button>\n    </CardHeader>\n    <CardContent>\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead>{{ columnLabels.customer }}</TableHead>\n            <TableHead class=\"dashboard-analytics__column--optional\">\n              {{ columnLabels.type }}\n            </TableHead>\n            <TableHead class=\"dashboard-analytics__column--optional\">\n              {{ columnLabels.status }}\n            </TableHead>\n            <TableHead class=\"dashboard-analytics__column--optional\">\n              {{ columnLabels.date }}\n            </TableHead>\n            <TableHead class=\"dashboard-analytics__amount\">\n              {{ columnLabels.amount }}\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <TableRow\n            v-for=\"row in rows\"\n            :key=\"row.id\"\n          >\n            <TableCell>\n              <div class=\"dashboard-analytics__customer\">\n                {{ row.customerName }}\n              </div>\n              <div class=\"dashboard-analytics__email\">\n                {{ row.email }}\n              </div>\n            </TableCell>\n            <TableCell class=\"dashboard-analytics__column--optional\">\n              {{ row.type }}\n            </TableCell>\n            <TableCell class=\"dashboard-analytics__column--optional\">\n              <Badge\n                class=\"dashboard-analytics__status\"\n                variant=\"outline\"\n              >\n                {{ row.status }}\n              </Badge>\n            </TableCell>\n            <TableCell class=\"dashboard-analytics__date\">\n              {{ row.date }}\n            </TableCell>\n            <TableCell class=\"dashboard-analytics__amount\">\n              {{ row.amount }}\n            </TableCell>\n          </TableRow>\n        </TableBody>\n      </Table>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__transactions-header.dashboard-analytics__transactions-header {\n    flex-direction: row;\n    align-items: center;\n  }\n\n  .dashboard-analytics__transactions-heading {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-analytics__view-all.dashboard-analytics__view-all {\n    margin-left: auto;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-analytics__icon-sm {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-analytics__customer {\n    font-weight: 500;\n  }\n\n  .dashboard-analytics__email {\n    display: none;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-analytics__column--optional {\n    display: none;\n  }\n\n  .dashboard-analytics__date {\n    display: none;\n  }\n\n  .dashboard-analytics__amount.dashboard-analytics__amount {\n    text-align: right;\n  }\n\n  .dashboard-analytics__status.dashboard-analytics__status {\n    font-size: 0.75rem;\n    line-height: 1rem;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-analytics__email {\n      display: inline;\n    }\n\n    .dashboard-analytics__date.dashboard-analytics__date {\n      display: table-cell;\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-analytics__date.dashboard-analytics__date {\n      display: none;\n    }\n  }\n\n  @media (width >= 80rem) {\n    .dashboard-analytics__column--optional.dashboard-analytics__column--optional,\n    .dashboard-analytics__date.dashboard-analytics__date {\n      display: table-column;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/UserMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { CircleUserIcon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport type { AccountMenuEntry } from '../data';\n\ndefineProps<{\n  entries: AccountMenuEntry[];\n  triggerLabel: string;\n}>();\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button\n        variant=\"secondary\"\n        size=\"icon\"\n        class=\"dashboard-analytics__user-button\"\n      >\n        <CircleUserIcon class=\"dashboard-analytics__icon-md\" />\n        <span class=\"dashboard-analytics__sr-only\">{{ triggerLabel }}</span>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\">\n      <template\n        v-for=\"entry in entries\"\n        :key=\"entry.id\"\n      >\n        <DropdownMenuLabel v-if=\"entry.kind === 'label'\">\n          {{ entry.label }}\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator v-else-if=\"entry.kind === 'separator'\" />\n        <DropdownMenuItem v-else-if=\"entry.kind === 'action'\">\n          {{ entry.label }}\n        </DropdownMenuItem>\n      </template>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-analytics__user-button.dashboard-analytics__user-button {\n    border-radius: 9999px;\n  }\n\n  .dashboard-analytics__icon-md {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  .dashboard-analytics__sr-only {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/data.ts",
