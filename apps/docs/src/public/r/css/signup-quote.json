{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "signup-quote",
  "type": "registry:block",
  "title": "Sign up with quote",
  "description": "A two-column sign up page. One column quotes a customer. The other collects an email, offers GitHub, and links to the terms and privacy policy.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/signup-quote/SignupQuote.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport SignupForm from './components/SignupForm.vue';\nimport {\n  brandName,\n  conjunctionLabel,\n  description,\n  dividerLabel,\n  emailLabel,\n  emailPlaceholder,\n  emailSubmitLabel,\n  githubLabel,\n  loginHref,\n  loginLabel,\n  privacyHref,\n  privacyLabel,\n  quote,\n  quoteAuthor,\n  termsHref,\n  termsLabel,\n  termsLead,\n  title,\n} from './data';\n</script>\n\n<template>\n  <div class=\"signup-quote\">\n    <Button\n      as=\"a\"\n      variant=\"ghost\"\n      :href=\"loginHref\"\n      class=\"signup-quote__login\"\n    >\n      {{ loginLabel }}\n    </Button>\n    <div class=\"signup-quote__panel\">\n      <div class=\"signup-quote__panel-backdrop\" />\n      <div class=\"signup-quote__brand\">\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"signup-quote__logo\"\n          aria-hidden=\"true\"\n        >\n          <path d=\"M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3\" />\n        </svg>\n        {{ brandName }}\n      </div>\n      <blockquote class=\"signup-quote__quote\">\n        <p class=\"signup-quote__quote-text\">\n          &ldquo;{{ quote }}&rdquo;\n        </p>\n        <footer class=\"signup-quote__quote-author\">\n          {{ quoteAuthor }}\n        </footer>\n      </blockquote>\n    </div>\n    <div class=\"signup-quote__content\">\n      <div class=\"signup-quote__content-inner\">\n        <div class=\"signup-quote__intro\">\n          <h1 class=\"signup-quote__title\">\n            {{ title }}\n          </h1>\n          <p class=\"signup-quote__description\">\n            {{ description }}\n          </p>\n        </div>\n        <SignupForm\n          :email-label=\"emailLabel\"\n          :email-placeholder=\"emailPlaceholder\"\n          :email-submit-label=\"emailSubmitLabel\"\n          :divider-label=\"dividerLabel\"\n          :github-label=\"githubLabel\"\n        />\n        <p class=\"signup-quote__terms\">\n          {{ termsLead }}\n          <a\n            :href=\"termsHref\"\n            class=\"signup-quote__terms-link\"\n          >\n            {{ termsLabel }}\n          </a>\n          {{ conjunctionLabel }}\n          <a\n            :href=\"privacyHref\"\n            class=\"signup-quote__terms-link\"\n          >\n            {{ privacyLabel }}\n          </a>\n          .\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n.signup-quote {\n  position: relative;\n  display: grid;\n  min-height: 100vh;\n  align-items: center;\n  justify-content: center;\n}\n\n.signup-quote__login {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n}\n\n.signup-quote__panel {\n  position: relative;\n  display: none;\n  height: 100%;\n  flex-direction: column;\n  padding: 2.5rem;\n  background: var(--muted);\n  color: #ffffff;\n}\n\n.signup-quote__panel-backdrop {\n  position: absolute;\n  background: #18181b;\n  inset: 0;\n}\n\n.signup-quote__brand,\n.signup-quote__quote {\n  position: relative;\n  z-index: 1;\n}\n\n.signup-quote__brand {\n  display: flex;\n  align-items: center;\n  font-size: 1.125rem;\n  font-weight: 500;\n}\n\n.signup-quote__logo {\n  width: 1.5rem;\n  height: 1.5rem;\n  margin-right: 0.5rem;\n}\n\n.signup-quote__quote {\n  margin: auto 0 0;\n}\n\n.signup-quote__quote-text,\n.signup-quote__quote-author {\n  margin: 0;\n}\n\n.signup-quote__quote-text {\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n}\n\n.signup-quote__quote-author {\n  margin-top: 0.5rem;\n  font-size: 0.875rem;\n}\n\n.signup-quote__content {\n  padding: 1rem;\n}\n\n.signup-quote__content-inner {\n  display: flex;\n  width: 100%;\n  max-width: 350px;\n  flex-direction: column;\n  justify-content: center;\n  margin: 0 auto;\n  gap: 1.5rem;\n}\n\n.signup-quote__intro {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  text-align: center;\n}\n\n.signup-quote__title {\n  margin: 0;\n  font-size: 1.5rem;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n  line-height: 2rem;\n}\n\n.signup-quote__description,\n.signup-quote__terms {\n  margin: 0;\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.signup-quote__terms {\n  padding: 0 2rem;\n  text-align: center;\n}\n\n.signup-quote__terms-link {\n  color: inherit;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n.signup-quote__terms-link:hover {\n  color: var(--primary);\n}\n\n@media (width >= 768px) {\n  .signup-quote__login {\n    top: 2rem;\n    right: 2rem;\n  }\n}\n\n@media (width >= 1024px) {\n  .signup-quote {\n    padding: 0;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .signup-quote__panel {\n    display: flex;\n  }\n\n  .dark .signup-quote__panel {\n    border-right: 1px solid var(--border);\n  }\n\n  .signup-quote__content {\n    padding: 2rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/components/SignupForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { GithubIcon, LoaderCircleIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n\ndefineProps<{\n  emailLabel: string;\n  emailPlaceholder: string;\n  emailSubmitLabel: string;\n  dividerLabel: string;\n  githubLabel: string;\n}>();\n\nconst isLoading = ref(false);\n\nfunction onSubmit(event: Event) {\n  event.preventDefault();\n  isLoading.value = true;\n\n  setTimeout(() => {\n    isLoading.value = false;\n  }, 3000);\n}\n</script>\n\n<template>\n  <div class=\"signup-quote__form\">\n    <form @submit=\"onSubmit\">\n      <div class=\"signup-quote__fields\">\n        <Label\n          class=\"signup-quote__sr-only\"\n          for=\"email\"\n        >\n          {{ emailLabel }}\n        </Label>\n        <Input\n          id=\"email\"\n          :placeholder=\"emailPlaceholder\"\n          type=\"email\"\n          auto-capitalize=\"none\"\n          auto-complete=\"email\"\n          auto-correct=\"off\"\n          :disabled=\"isLoading\"\n        />\n        <Button :disabled=\"isLoading\">\n          <LoaderCircleIcon\n            v-if=\"isLoading\"\n            class=\"signup-quote__spinner signup-quote__spinner--active\"\n          />\n          {{ emailSubmitLabel }}\n        </Button>\n      </div>\n    </form>\n    <div class=\"signup-quote__divider\">\n      <span class=\"signup-quote__divider-line\" />\n      <span class=\"signup-quote__divider-label\">\n        {{ dividerLabel }}\n      </span>\n    </div>\n    <Button\n      variant=\"outline\"\n      type=\"button\"\n      :disabled=\"isLoading\"\n    >\n      <LoaderCircleIcon\n        v-if=\"isLoading\"\n        class=\"signup-quote__spinner signup-quote__spinner--active\"\n      />\n      <GithubIcon\n        v-else\n        class=\"signup-quote__spinner\"\n      />\n      {{ githubLabel }}\n    </Button>\n  </div>\n</template>\n\n<style>\n.signup-quote__form,\n.signup-quote__fields {\n  display: grid;\n  gap: 1.5rem;\n}\n\n.signup-quote__fields {\n  gap: 0.5rem;\n}\n\n.signup-quote__spinner {\n  width: 1rem;\n  height: 1rem;\n  margin-right: 0.5rem;\n}\n\n.signup-quote__spinner--active {\n  animation: signup-quote-spin 1s linear infinite;\n}\n\n.signup-quote__divider {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.signup-quote__divider-line {\n  position: absolute;\n  width: 100%;\n  border-top: 1px solid var(--border);\n}\n\n.signup-quote__divider-label {\n  position: relative;\n  padding: 0 0.5rem;\n  background: var(--background);\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  letter-spacing: 0.05em;\n  line-height: 1rem;\n  text-transform: uppercase;\n}\n\n.signup-quote__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n\n@keyframes signup-quote-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/data.ts",
      "content": "export const loginLabel = 'Login';\nexport const loginHref = '#';\nexport const brandName = 'Acme Inc';\nexport const quote = 'This library has saved me countless hours of work and helped me deliver stunning designs to my clients faster than ever before.';\nexport const quoteAuthor = 'Sofia Davis';\nexport const title = 'Create an account';\nexport const description = 'Enter your email below to create your account';\nexport const termsLead = 'By clicking continue, you agree to our';\nexport const termsLabel = 'Terms of Service';\nexport const termsHref = '#';\nexport const privacyLabel = 'Privacy Policy';\nexport const privacyHref = '#';\nexport const conjunctionLabel = 'and';\nexport const emailLabel = 'Email';\nexport const emailPlaceholder = 'name@example.com';\nexport const emailSubmitLabel = 'Sign in with Email';\nexport const dividerLabel = 'Or continue with';\nexport const githubLabel = 'GitHub';\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "authentication",
    "signup",
    "signup-quote"
  ]
}
