{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "signup-quote",
  "type": "registry:block",
  "title": "Sign up with quote",
  "description": "A two-column sign up page. One column quotes a customer. The other collects an email, offers GitHub, and links to the terms and privacy policy.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label",
    "separator"
  ],
  "files": [
    {
      "path": "blocks/signup-quote/SignupQuote.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport SignupForm from './components/SignupForm.vue';\nimport {\n  brandName,\n  conjunctionLabel,\n  description,\n  dividerLabel,\n  emailLabel,\n  emailPlaceholder,\n  emailSubmitLabel,\n  githubLabel,\n  googleLabel,\n  loginHref,\n  loginLabel,\n  privacyHref,\n  privacyLabel,\n  quote,\n  quoteAuthor,\n  quoteAuthorRole,\n  termsHref,\n  termsLabel,\n  termsLead,\n  title,\n} from './data';\n\nconst quoteAuthorInitials = quoteAuthor\n  .split(' ')\n  .map(part => part.charAt(0))\n  .join('');\n</script>\n\n<template>\n  <div class=\"signup-quote\">\n    <div class=\"signup-quote__panel\">\n      <div\n        class=\"signup-quote__glow signup-quote__glow--top\"\n        aria-hidden=\"true\"\n      />\n      <div\n        class=\"signup-quote__glow signup-quote__glow--bottom\"\n        aria-hidden=\"true\"\n      />\n      <div class=\"signup-quote__brand\">\n        <span class=\"signup-quote__logo\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"signup-quote__logo-icon\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3\" />\n          </svg>\n        </span>\n        {{ brandName }}\n      </div>\n      <figure class=\"signup-quote__quote\">\n        <blockquote class=\"signup-quote__quote-text\">\n          &ldquo;{{ quote }}&rdquo;\n        </blockquote>\n        <figcaption class=\"signup-quote__author\">\n          <span\n            class=\"signup-quote__avatar\"\n            aria-hidden=\"true\"\n          >\n            {{ quoteAuthorInitials }}\n          </span>\n          <span class=\"signup-quote__author-details\">\n            <span class=\"signup-quote__author-name\">{{ quoteAuthor }}</span>\n            <span class=\"signup-quote__author-role\">{{ quoteAuthorRole }}</span>\n          </span>\n        </figcaption>\n      </figure>\n    </div>\n    <div class=\"signup-quote__content\">\n      <Button\n        as=\"a\"\n        variant=\"ghost\"\n        :href=\"loginHref\"\n        class=\"signup-quote__login\"\n      >\n        {{ loginLabel }}\n      </Button>\n      <div class=\"signup-quote__content-inner\">\n        <div class=\"signup-quote__intro\">\n          <h1 class=\"signup-quote__title\">\n            {{ title }}\n          </h1>\n          <p class=\"signup-quote__description\">\n            {{ description }}\n          </p>\n        </div>\n        <SignupForm\n          :email-label=\"emailLabel\"\n          :email-placeholder=\"emailPlaceholder\"\n          :email-submit-label=\"emailSubmitLabel\"\n          :divider-label=\"dividerLabel\"\n          :google-label=\"googleLabel\"\n          :github-label=\"githubLabel\"\n        />\n        <p class=\"signup-quote__terms\">\n          {{ termsLead }}\n          <a\n            :href=\"termsHref\"\n            class=\"signup-quote__terms-link\"\n          >{{ termsLabel }}</a>\n          {{ conjunctionLabel }}\n          <a\n            :href=\"privacyHref\"\n            class=\"signup-quote__terms-link\"\n          >{{ privacyLabel }}</a>.\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n.signup-quote {\n  position: relative;\n  display: grid;\n  min-height: 100vh;\n}\n\n.signup-quote__panel {\n  position: relative;\n  display: none;\n  overflow: hidden;\n  height: 100%;\n  flex-direction: column;\n  padding: 2.5rem;\n  border-right: 1px solid var(--border);\n  background: var(--muted);\n  color: var(--foreground);\n}\n\n.signup-quote__glow {\n  position: absolute;\n  width: 24rem;\n  height: 24rem;\n  border-radius: 9999px;\n  filter: blur(64px);\n  pointer-events: none;\n}\n\n.signup-quote__glow--top {\n  top: -8rem;\n  left: -8rem;\n  background: color-mix(in oklch, var(--primary) 10%, transparent);\n}\n\n.signup-quote__glow--bottom {\n  right: -6rem;\n  bottom: -10rem;\n  background: color-mix(in oklch, var(--primary) 5%, transparent);\n}\n\n.signup-quote__brand,\n.signup-quote__quote {\n  position: relative;\n}\n\n.signup-quote__brand {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 1.125rem;\n  font-weight: 500;\n}\n\n.signup-quote__logo {\n  display: flex;\n  width: 2rem;\n  height: 2rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: calc(var(--radius) - 2px);\n  background: var(--primary);\n  color: var(--primary-foreground);\n}\n\n.signup-quote__logo-icon {\n  width: 1rem;\n  height: 1rem;\n}\n\n.signup-quote__quote {\n  display: flex;\n  max-width: 28rem;\n  flex-direction: column;\n  margin: auto 0 0;\n  gap: 1.5rem;\n}\n\n.signup-quote__quote-text {\n  margin: 0;\n  font-size: 1.25rem;\n  font-weight: 500;\n  letter-spacing: -0.025em;\n  line-height: 1.625;\n}\n\n.signup-quote__author {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.signup-quote__avatar {\n  display: flex;\n  width: 2.5rem;\n  height: 2.5rem;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid var(--border);\n  border-radius: 9999px;\n  background: var(--background);\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.signup-quote__author-details {\n  display: flex;\n  flex-direction: column;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.signup-quote__author-name {\n  font-weight: 500;\n}\n\n.signup-quote__author-role {\n  color: var(--muted-foreground);\n}\n\n.signup-quote__content {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 4rem 1.5rem;\n}\n\n.signup-quote__login {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n}\n\n.signup-quote__content-inner {\n  display: flex;\n  width: 100%;\n  max-width: 24rem;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.signup-quote__intro {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  text-align: center;\n}\n\n.signup-quote__title {\n  margin: 0;\n  font-size: 1.5rem;\n  font-weight: 600;\n  letter-spacing: -0.025em;\n  line-height: 2rem;\n}\n\n.signup-quote__description,\n.signup-quote__terms {\n  margin: 0;\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.signup-quote__terms {\n  padding: 0 1.5rem;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.signup-quote__terms-link {\n  color: inherit;\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n\n.signup-quote__terms-link:hover {\n  color: var(--primary);\n}\n\n@media (width >= 768px) {\n  .signup-quote__login {\n    top: 2rem;\n    right: 2rem;\n  }\n}\n\n@media (width >= 1024px) {\n  .signup-quote {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .signup-quote__panel {\n    display: flex;\n  }\n\n  .signup-quote__content {\n    padding: 4rem 2.5rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/components/SignupForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Separator } from '@/components/ui/separator';\n\ndefineProps<{\n  emailLabel: string;\n  emailPlaceholder: string;\n  emailSubmitLabel: string;\n  dividerLabel: string;\n  googleLabel: string;\n  githubLabel: string;\n}>();\n\nconst isLoading = ref(false);\n\nfunction onSubmit(event: Event) {\n  event.preventDefault();\n  isLoading.value = true;\n\n  setTimeout(() => {\n    isLoading.value = false;\n  }, 3000);\n}\n</script>\n\n<template>\n  <div class=\"signup-quote__form\">\n    <form\n      class=\"signup-quote__fields\"\n      @submit=\"onSubmit\"\n    >\n      <Label\n        class=\"signup-quote__sr-only\"\n        for=\"email\"\n      >\n        {{ emailLabel }}\n      </Label>\n      <Input\n        id=\"email\"\n        :placeholder=\"emailPlaceholder\"\n        type=\"email\"\n        auto-capitalize=\"none\"\n        auto-complete=\"email\"\n        auto-correct=\"off\"\n        :disabled=\"isLoading\"\n      />\n      <Button\n        type=\"submit\"\n        class=\"signup-quote__button\"\n        :is-loading=\"isLoading\"\n      >\n        {{ emailSubmitLabel }}\n      </Button>\n    </form>\n    <div class=\"signup-quote__divider\">\n      <Separator class=\"signup-quote__divider-line\" />\n      <span class=\"signup-quote__divider-label\">\n        {{ dividerLabel }}\n      </span>\n      <Separator class=\"signup-quote__divider-line\" />\n    </div>\n    <div class=\"signup-quote__social\">\n      <Button\n        variant=\"outline\"\n        type=\"button\"\n        class=\"signup-quote__button\"\n        :disabled=\"isLoading\"\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          class=\"signup-quote__icon\"\n          aria-hidden=\"true\"\n        >\n          <path\n            fill=\"#4285F4\"\n            d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z\"\n          />\n          <path\n            fill=\"#34A853\"\n            d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z\"\n          />\n          <path\n            fill=\"#FBBC05\"\n            d=\"M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84Z\"\n          />\n          <path\n            fill=\"#EA4335\"\n            d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z\"\n          />\n        </svg>\n        {{ googleLabel }}\n      </Button>\n      <Button\n        variant=\"outline\"\n        type=\"button\"\n        class=\"signup-quote__button\"\n        :disabled=\"isLoading\"\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          fill=\"currentColor\"\n          class=\"signup-quote__icon\"\n          aria-hidden=\"true\"\n        >\n          <path d=\"M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z\" />\n        </svg>\n        {{ githubLabel }}\n      </Button>\n    </div>\n  </div>\n</template>\n\n<style>\n.signup-quote__form {\n  display: grid;\n  gap: 1.5rem;\n}\n\n.signup-quote__fields,\n.signup-quote__social {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.sigma-ui-button.signup-quote__button {\n  width: 100%;\n}\n\n.signup-quote__icon {\n  width: 1rem;\n  height: 1rem;\n}\n\n.signup-quote__divider {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.sigma-ui-separator.signup-quote__divider-line {\n  width: auto;\n  flex: 1;\n}\n\n.signup-quote__divider-label {\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  letter-spacing: 0.025em;\n  line-height: 1rem;\n  text-transform: uppercase;\n}\n\n.signup-quote__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n\n@media (width >= 640px) {\n  .signup-quote__social {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/data.ts",
      "content": "export const loginLabel = 'Login';\nexport const loginHref = '#';\nexport const brandName = 'Acme Inc';\nexport const quote = 'This library has saved me countless hours of work and helped me deliver stunning designs to my clients faster than ever before.';\nexport const quoteAuthor = 'Sofia Davis';\nexport const quoteAuthorRole = 'Founder, Northwind Studio';\nexport const title = 'Create an account';\nexport const description = 'Enter your email below to create your account';\nexport const termsLead = 'By clicking continue, you agree to our';\nexport const termsLabel = 'Terms of Service';\nexport const termsHref = '#';\nexport const privacyLabel = 'Privacy Policy';\nexport const privacyHref = '#';\nexport const conjunctionLabel = 'and';\nexport const emailLabel = 'Email';\nexport const emailPlaceholder = 'name@example.com';\nexport const emailSubmitLabel = 'Continue with email';\nexport const dividerLabel = 'Or continue with';\nexport const googleLabel = 'Google';\nexport const githubLabel = 'GitHub';\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "authentication",
    "signup",
    "signup-quote"
  ]
}
