      "path": "ui/empty/Empty.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ndefineSlots<{\n  /**\n   * `EmptyHeader`, `EmptyMedia`, and `EmptyContent`.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"empty\"\n    v-bind=\"delegatedAttrs()\"\n    class=\"sigma-ui-empty\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-empty {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: calc(var(--spacing) * 6);\n    border: 1px dashed var(--border);\n    border-radius: var(--radius-lg);\n    gap: calc(var(--spacing) * 6);\n    text-align: center;\n    text-wrap: balance;\n  }\n\n  @media (width >= 48rem) {\n    .sigma-ui-empty {\n      padding: calc(var(--spacing) * 12);\n    }\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/empty/EmptyContent.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ndefineSlots<{\n  /**\n   * Actions, such as a button, under the description.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"empty-content\"\n    v-bind=\"delegatedAttrs()\"\n    class=\"sigma-ui-empty-content\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-empty-content {\n    display: flex;\n    width: 100%;\n    min-width: 0;\n    max-width: 24rem;\n    flex-direction: column;\n    align-items: center;\n    font-size: 0.875rem;\n    gap: calc(var(--spacing) * 4);\n    text-wrap: balance;\n  }\n}\n</style>\n",
