      "path": "ui/empty/EmptyDescription.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ndefineSlots<{\n  /**\n   * Explanation of the empty state. Links inside it are underlined.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <p\n    data-slot=\"empty-description\"\n    v-bind=\"delegatedAttrs()\"\n    class=\"sigma-ui-empty-description\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot />\n  </p>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-empty-description {\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.625;\n  }\n\n  .sigma-ui-empty-description a {\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  .sigma-ui-empty-description a:hover {\n    color: var(--primary);\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/empty/EmptyHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ndefineSlots<{\n  /**\n   * `EmptyMedia`, `EmptyTitle`, and `EmptyDescription`.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"empty-header\"\n    v-bind=\"delegatedAttrs()\"\n    class=\"sigma-ui-empty-header\"\n    :class=\"[$attrs.class]\"\n  >\n    <slot />\n  </div>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-empty-header {\n    display: flex;\n    max-width: 24rem;\n    flex-direction: column;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n    text-align: center;\n  }\n}\n</style>\n",
