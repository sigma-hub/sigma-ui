{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-products",
  "type": "registry:block",
  "title": "Products dashboard",
  "description": "An products dashboard with a sidebar navigation. The sidebar has icon navigation. The content area has a breadcrumb and search in the header. It displays a list of products in a table with actions.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "sheet",
    "table",
    "tabs",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-products/DashboardProducts.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport ProductsPanel from './components/ProductsPanel.vue';\nimport {\n  accountMenuGroups,\n  brandName,\n  breadcrumbLinks,\n  currentBreadcrumb,\n  defaultProductTab,\n  filterOptions,\n  headerCopy,\n  mobileNavLinks,\n  productActions,\n  productDetailColumns,\n  productTabs,\n  products,\n  productsCopy,\n  productsSummary,\n  sidebarFooterLinks,\n  sidebarLinks,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-products\">\n    <AppSidebar\n      :nav-items=\"sidebarLinks\"\n      :footer-items=\"sidebarFooterLinks\"\n      :brand-name=\"brandName\"\n    />\n    <div class=\"dashboard-products__shell\">\n      <AppHeader\n        :mobile-nav-items=\"mobileNavLinks\"\n        :breadcrumb-links=\"breadcrumbLinks\"\n        :breadcrumb-page=\"currentBreadcrumb\"\n        :account-menu-groups=\"accountMenuGroups\"\n        :brand-name=\"brandName\"\n        :header=\"headerCopy\"\n      />\n      <main class=\"dashboard-products__main\">\n        <ProductsPanel\n          :tabs=\"productTabs\"\n          :active-tab=\"defaultProductTab\"\n          :filter-options=\"filterOptions\"\n          :products=\"products\"\n          :detail-columns=\"productDetailColumns\"\n          :actions=\"productActions\"\n          :summary=\"productsSummary\"\n          :copy=\"productsCopy\"\n        />\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-products {\n  display: flex;\n  width: 100%;\n  min-height: 100vh;\n  flex-direction: column;\n  background-color: color-mix(in oklch, var(--muted) 40%, transparent);\n}\n\n.dashboard-products__shell {\n  display: flex;\n  flex-direction: column;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__shell {\n    padding-top: 1rem;\n    padding-bottom: 1rem;\n    padding-left: 3.5rem;\n    gap: 1rem;\n  }\n}\n\n.dashboard-products__main {\n  display: grid;\n  flex: 1 1 0%;\n  align-items: flex-start;\n  padding: 1rem;\n  gap: 1rem;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__main {\n    padding: 0 1.5rem;\n  }\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__main {\n    gap: 2rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { HeaderCopy, MobileNavLink } from '../data';\n\ndefineProps<{\n  mobileNavItems: MobileNavLink[];\n  breadcrumbLinks: string[];\n  breadcrumbPage: string;\n  accountMenuGroups: string[][];\n  brandName: string;\n  header: HeaderCopy;\n}>();\n</script>\n\n<template>\n  <header class=\"dashboard-products__header\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"dashboard-products__menu-button\"\n        >\n          <PanelLeftIcon />\n          <span class=\"dashboard-products__sr-only\">{{ header.toggleMenu }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"dashboard-products__sheet\"\n      >\n        <nav class=\"dashboard-products__mobile-nav\">\n          <a\n            href=\"#\"\n            class=\"dashboard-products__mobile-brand\"\n          >\n            <Package2Icon />\n            <span class=\"dashboard-products__sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"dashboard-products__mobile-link\"\n            :class=\"{ 'dashboard-products__mobile-link--active': item.isActive }\"\n          >\n            <component :is=\"item.icon\" />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"dashboard-products__breadcrumb\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a href=\"#\">{{ link }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"dashboard-products__search\">\n      <SearchIcon />\n      <Input\n        type=\"search\"\n        :placeholder=\"header.searchPlaceholder\"\n        class=\"dashboard-products__search-input\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"dashboard-products__account-button\"\n        >\n          <CircleUserIcon />\n          <span class=\"dashboard-products__sr-only\">{{ header.toggleAccount }}</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>{{ header.accountLabel }}</DropdownMenuLabel>\n        <template\n          v-for=\"(group, groupIndex) in accountMenuGroups\"\n          :key=\"groupIndex\"\n        >\n          <DropdownMenuSeparator />\n          <DropdownMenuItem\n            v-for=\"item in group\"\n            :key=\"item\"\n          >\n            {{ item }}\n          </DropdownMenuItem>\n        </template>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n\n<style>\n.dashboard-products__header {\n  position: sticky;\n  z-index: 30;\n  top: 0;\n  display: flex;\n  height: 3.5rem;\n  align-items: center;\n  padding-right: 1rem;\n  padding-left: 1rem;\n  border-bottom: 1px solid var(--border);\n  background-color: var(--background);\n  gap: 1rem;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__header {\n    position: static;\n    height: auto;\n    padding-right: 1.5rem;\n    padding-left: 1.5rem;\n    border-bottom-width: 0;\n    background-color: transparent;\n  }\n}\n\n.dashboard-products .dashboard-products__menu-button svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products .dashboard-products__menu-button {\n    display: none;\n  }\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__sheet.dashboard-products__sheet {\n    max-width: 20rem;\n  }\n}\n\n.dashboard-products__mobile-nav {\n  display: grid;\n  font-size: 1.125rem;\n  font-weight: 500;\n  gap: 1.5rem;\n  line-height: 1.75rem;\n}\n\n.dashboard-products__mobile-brand {\n  display: flex;\n  width: 2.5rem;\n  height: 2.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: 9999px;\n  background-color: var(--primary);\n  color: var(--primary-foreground);\n  font-size: 1.125rem;\n  font-weight: 600;\n  gap: 0.5rem;\n  line-height: 1.75rem;\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__mobile-brand {\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n}\n\n.dashboard-products__mobile-brand svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-products__mobile-brand:hover svg {\n  transform: scale(1.1);\n}\n\n.dashboard-products__mobile-link {\n  display: flex;\n  align-items: center;\n  padding-right: 0.625rem;\n  padding-left: 0.625rem;\n  color: var(--muted-foreground);\n  gap: 1rem;\n}\n\n.dashboard-products__mobile-link:hover,\n.dashboard-products__mobile-link--active,\n.dashboard-products__mobile-link--active:hover {\n  color: var(--foreground);\n}\n\n.dashboard-products__mobile-link svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-products__breadcrumb {\n  display: none;\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__breadcrumb {\n    display: flex;\n  }\n}\n\n.dashboard-products__search {\n  position: relative;\n  flex: 1 1 0%;\n  margin-left: auto;\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__search {\n    flex-grow: 0;\n  }\n}\n\n.dashboard-products__search svg {\n  position: absolute;\n  top: 0.625rem;\n  left: 0.625rem;\n  width: 1rem;\n  height: 1rem;\n  color: var(--muted-foreground);\n}\n\n.dashboard-products .dashboard-products__search-input {\n  width: 100%;\n  padding-left: 2rem;\n  border-radius: var(--radius);\n  background-color: var(--background);\n}\n\n@media (width >= 48rem) {\n  .dashboard-products .dashboard-products__search-input {\n    width: 200px;\n  }\n}\n\n@media (width >= 64rem) {\n  .dashboard-products .dashboard-products__search-input {\n    width: 320px;\n  }\n}\n\n.dashboard-products .dashboard-products__account-button {\n  border-radius: 9999px;\n}\n\n.dashboard-products .dashboard-products__account-button svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-products__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from 'lucide-vue-next';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport type { SidebarLink, SidebarLinkTone } from '../data';\n\ndefineProps<{\n  navItems: SidebarLink[];\n  footerItems: SidebarLink[];\n  brandName: string;\n}>();\n\nfunction navLinkClass(tone: SidebarLinkTone) {\n  if (tone === 'active') {\n    return 'dashboard-products__nav-link--active';\n  }\n\n  if (tone === 'muted') {\n    return 'dashboard-products__nav-link--muted';\n  }\n\n  return undefined;\n}\n</script>\n\n<template>\n  <aside class=\"dashboard-products__sidebar\">\n    <nav class=\"dashboard-products__sidebar-nav\">\n      <a\n        href=\"#\"\n        class=\"dashboard-products__brand\"\n      >\n        <Package2Icon />\n        <span class=\"dashboard-products__sr-only\">{{ brandName }}</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in navItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-products__nav-link\"\n              :class=\"navLinkClass(item.tone)\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-products__sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"dashboard-products__sidebar-footer\">\n      <TooltipProvider\n        v-for=\"item in footerItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-products__nav-link\"\n              :class=\"navLinkClass(item.tone)\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-products__sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n\n<style>\n.dashboard-products__sidebar {\n  position: fixed;\n  z-index: 10;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  display: none;\n  width: 3.5rem;\n  flex-direction: column;\n  border-right: 1px solid var(--border);\n  background-color: var(--background);\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__sidebar {\n    display: flex;\n  }\n}\n\n.dashboard-products__sidebar-nav,\n.dashboard-products__sidebar-footer {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 1rem 0.5rem;\n  gap: 1rem;\n}\n\n.dashboard-products__sidebar-footer {\n  margin-top: auto;\n}\n\n.dashboard-products__brand {\n  display: flex;\n  width: 2.25rem;\n  height: 2.25rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: 9999px;\n  background-color: var(--primary);\n  color: var(--primary-foreground);\n  font-size: 1.125rem;\n  font-weight: 600;\n  gap: 0.5rem;\n  line-height: 1.75rem;\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__brand {\n    width: 2rem;\n    height: 2rem;\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n}\n\n.dashboard-products__brand svg {\n  width: 1rem;\n  height: 1rem;\n  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-products__brand:hover svg {\n  transform: scale(1.1);\n}\n\n.dashboard-products__nav-link {\n  display: flex;\n  width: 2.25rem;\n  height: 2.25rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  transition-duration: 150ms;\n  transition-property: color, background-color, border-color;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-products__nav-link:hover {\n  color: var(--foreground);\n}\n\n.dashboard-products__nav-link--muted {\n  color: var(--muted-foreground);\n}\n\n.dashboard-products__nav-link--active {\n  background-color: var(--secondary);\n  color: var(--secondary-foreground);\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__nav-link {\n    width: 2rem;\n    height: 2rem;\n  }\n}\n\n.dashboard-products__nav-link svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-products__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/ProductsPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport { FileIcon, ListFilterIcon, MoreHorizontalIcon, PlusCircleIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from '@/components/ui/tabs';\nimport type { FilterOption, Product, ProductTab, ProductsCopy } from '../data';\n\ndefineProps<{\n  tabs: ProductTab[];\n  activeTab: string;\n  filterOptions: FilterOption[];\n  products: Product[];\n  detailColumns: string[];\n  actions: string[];\n  summary: { range: string; total: number };\n  copy: ProductsCopy;\n}>();\n</script>\n\n<template>\n  <Tabs :default-value=\"activeTab\">\n    <div class=\"dashboard-products__toolbar\">\n      <TabsList>\n        <TabsTrigger\n          v-for=\"tab in tabs\"\n          :key=\"tab.value\"\n          :value=\"tab.value\"\n          :class=\"{ 'dashboard-products__tab--desktop': tab.isHiddenOnMobile }\"\n        >\n          {{ tab.label }}\n        </TabsTrigger>\n      </TabsList>\n      <div class=\"dashboard-products__toolbar-actions\">\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              class=\"dashboard-products__toolbar-button\"\n            >\n              <ListFilterIcon />\n              <span class=\"dashboard-products__action-label\">\n                {{ copy.filter }}\n              </span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <DropdownMenuLabel>{{ copy.filterBy }}</DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem\n              v-for=\"option in filterOptions\"\n              :key=\"option.label\"\n              v-bind=\"option.isSelected ? { modelValue: true } : {}\"\n            >\n              {{ option.label }}\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          class=\"dashboard-products__toolbar-button\"\n        >\n          <FileIcon />\n          <span class=\"dashboard-products__action-label\">\n            {{ copy.export }}\n          </span>\n        </Button>\n        <Button\n          size=\"sm\"\n          class=\"dashboard-products__toolbar-button\"\n        >\n          <PlusCircleIcon />\n          <span class=\"dashboard-products__action-label\">\n            {{ copy.addProduct }}\n          </span>\n        </Button>\n      </div>\n    </div>\n    <TabsContent :value=\"activeTab\">\n      <Card>\n        <CardHeader>\n          <CardTitle>{{ copy.title }}</CardTitle>\n          <CardDescription>\n            {{ copy.description }}\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <Table>\n            <TableHeader>\n              <TableRow>\n                <TableHead class=\"dashboard-products__image-head\">\n                  <span class=\"dashboard-products__sr-only\">{{ copy.imageColumn }}</span>\n                </TableHead>\n                <TableHead>{{ copy.nameColumn }}</TableHead>\n                <TableHead>{{ copy.statusColumn }}</TableHead>\n                <TableHead\n                  v-for=\"column in detailColumns\"\n                  :key=\"column\"\n                  class=\"dashboard-products__detail-cell\"\n                >\n                  {{ column }}\n                </TableHead>\n                <TableHead>\n                  <span class=\"dashboard-products__sr-only\">{{ copy.actionsColumn }}</span>\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              <TableRow\n                v-for=\"product in products\"\n                :key=\"product.name\"\n              >\n                <TableCell class=\"dashboard-products__image-cell\">\n                  <img\n                    :alt=\"copy.imageAlt\"\n                    class=\"dashboard-products__image\"\n                    height=\"64\"\n                    :src=\"product.imageUrl\"\n                    width=\"64\"\n                  >\n                </TableCell>\n                <TableCell class=\"dashboard-products__name\">\n                  {{ product.name }}\n                </TableCell>\n                <TableCell>\n                  <Badge :variant=\"product.badgeVariant\">\n                    {{ product.status }}\n                  </Badge>\n                </TableCell>\n                <TableCell class=\"dashboard-products__detail-cell\">\n                  {{ product.price }}\n                </TableCell>\n                <TableCell class=\"dashboard-products__detail-cell\">\n                  {{ product.totalSales }}\n                </TableCell>\n                <TableCell class=\"dashboard-products__detail-cell\">\n                  {{ product.createdAt }}\n                </TableCell>\n                <TableCell>\n                  <DropdownMenu>\n                    <DropdownMenuTrigger as-child>\n                      <Button\n                        aria-haspopup=\"true\"\n                        size=\"icon\"\n                        variant=\"ghost\"\n                        class=\"dashboard-products__row-button\"\n                      >\n                        <MoreHorizontalIcon />\n                        <span class=\"dashboard-products__sr-only\">{{ copy.rowMenu }}</span>\n                      </Button>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent align=\"end\">\n                      <DropdownMenuLabel>{{ copy.actionsMenu }}</DropdownMenuLabel>\n                      <DropdownMenuItem\n                        v-for=\"action in actions\"\n                        :key=\"action\"\n                      >\n                        {{ action }}\n                      </DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </TableCell>\n              </TableRow>\n            </TableBody>\n          </Table>\n        </CardContent>\n        <CardFooter>\n          <div class=\"dashboard-products__summary\">\n            {{ copy.showing }} <strong>{{ summary.range }}</strong> {{ copy.of }} <strong>{{ summary.total }}</strong>\n            {{ copy.products }}\n          </div>\n        </CardFooter>\n      </Card>\n    </TabsContent>\n  </Tabs>\n</template>\n\n<style>\n.dashboard-products__toolbar {\n  display: flex;\n  align-items: center;\n}\n\n.dashboard-products__toolbar-actions {\n  display: flex;\n  align-items: center;\n  margin-left: auto;\n  gap: 0.5rem;\n}\n\n.dashboard-products .dashboard-products__tab--desktop {\n  display: none;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products .dashboard-products__tab--desktop {\n    display: flex;\n  }\n}\n\n.dashboard-products .dashboard-products__toolbar-button {\n  height: 1.75rem;\n  gap: 0.25rem;\n}\n\n.dashboard-products .dashboard-products__toolbar-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n.dashboard-products .dashboard-products__row-button svg {\n  width: 1rem;\n  height: 1rem;\n}\n\n.dashboard-products__action-label {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__action-label {\n    position: static;\n    overflow: visible;\n    width: auto;\n    height: auto;\n    margin: 0;\n    clip: auto;\n    white-space: nowrap;\n  }\n}\n\n.dashboard-products__image-head,\n.dashboard-products__image-cell,\n.dashboard-products__detail-cell {\n  display: none;\n}\n\n.dashboard-products__image-head {\n  width: 100px;\n}\n\n@media (width >= 40rem) {\n  .dashboard-products__image-head,\n  .dashboard-products__image-cell {\n    display: table-cell;\n  }\n}\n\n@media (width >= 48rem) {\n  .dashboard-products__detail-cell {\n    display: table-cell;\n  }\n}\n\n.dashboard-products__image {\n  border-radius: calc(var(--radius) - 2px);\n  aspect-ratio: 1 / 1;\n  object-fit: cover;\n}\n\n.dashboard-products__name {\n  font-weight: 500;\n}\n\n.dashboard-products__summary {\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n\n.dashboard-products__sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/data.ts",
