{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "direction-demo",
  "type": "registry:example",
  "title": "Direction",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "direction"
  ],
  "files": [
    {
      "path": "example/Direction.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport { Direction } from '@/components/ui/direction';\n\nconst dir = ref<'ltr' | 'rtl'>('rtl');\n\nfunction toggleDirection() {\n  dir.value = dir.value === 'rtl' ? 'ltr' : 'rtl';\n}\n</script>\n\n<template>\n  <Direction\n    :dir=\"dir\"\n    class=\"example-direction\"\n  >\n    <div class=\"example-direction__panel\">\n      <p class=\"example-direction__label\">\n        Reading direction: {{ dir }}\n      </p>\n      <Button\n        variant=\"outline\"\n        @click=\"toggleDirection\"\n      >\n        Switch to {{ dir === 'rtl' ? 'LTR' : 'RTL' }}\n      </Button>\n    </div>\n  </Direction>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-direction {\n    width: 100%;\n    max-width: 24rem;\n  }\n\n  .example-direction__panel {\n    display: flex;\n    width: 100%;\n    max-width: 24rem;\n    flex-direction: column;\n    align-items: flex-start;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    gap: calc(var(--spacing) * 3);\n    text-align: start;\n  }\n\n  .example-direction__label {\n    font-size: 0.875rem;\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
