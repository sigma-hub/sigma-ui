{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-demo",
  "type": "registry:example",
  "title": "Sidebar",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "collapsible",
    "separator",
    "sidebar"
  ],
  "files": [
    {
      "path": "example/Sidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Component } from 'vue';\nimport {\n  BookOpenIcon,\n  ChevronRightIcon,\n  ChevronsUpDownIcon,\n  GalleryVerticalEndIcon,\n  LayoutDashboardIcon,\n  MoreHorizontalIcon,\n  Settings2Icon,\n  SquareTerminalIcon,\n} from 'lucide-vue-next';\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible';\nimport { Separator } from '@/components/ui/separator';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuAction,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarProvider,\n  SidebarRail,\n  SidebarTrigger,\n} from '@/components/ui/sidebar';\n\ninterface NavigationItem {\n  title: string;\n  icon: Component;\n  isActive?: boolean;\n  items: { title: string; isActive?: boolean }[];\n}\n\nconst navigation: NavigationItem[] = [\n  {\n    title: 'Dashboard',\n    icon: LayoutDashboardIcon,\n    isActive: true,\n    items: [\n      { title: 'Overview', isActive: true },\n      { title: 'Analytics' },\n      { title: 'Reports' },\n    ],\n  },\n  {\n    title: 'Playground',\n    icon: SquareTerminalIcon,\n    items: [\n      { title: 'History' },\n      { title: 'Starred' },\n    ],\n  },\n  {\n    title: 'Documentation',\n    icon: BookOpenIcon,\n    items: [\n      { title: 'Introduction' },\n      { title: 'Get started' },\n      { title: 'Changelog' },\n    ],\n  },\n  {\n    title: 'Settings',\n    icon: Settings2Icon,\n    items: [\n      { title: 'General' },\n      { title: 'Team' },\n      { title: 'Billing' },\n    ],\n  },\n];\n</script>\n\n<template>\n  <div class=\"example-sidebar-frame\">\n    <SidebarProvider\n      cookie-name=\"sidebar_example_state\"\n      class=\"example-sidebar-frame__provider\"\n    >\n      <Sidebar\n        collapsible=\"icon\"\n        class=\"example-sidebar-frame__sidebar\"\n      >\n        <SidebarHeader>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton\n                size=\"lg\"\n                tooltip=\"Acme Inc\"\n              >\n                <div class=\"example-sidebar-frame__logo\">\n                  <GalleryVerticalEndIcon class=\"example-sidebar-frame__icon\" />\n                </div>\n                <div class=\"example-sidebar-frame__label\">\n                  <span class=\"example-sidebar-frame__title\">Acme Inc</span>\n                  <span class=\"example-sidebar-frame__subtitle\">Enterprise</span>\n                </div>\n                <ChevronsUpDownIcon class=\"example-sidebar-frame__end-icon\" />\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Platform</SidebarGroupLabel>\n            <SidebarMenu>\n              <Collapsible\n                v-for=\"item in navigation\"\n                :key=\"item.title\"\n                as-child\n                :default-open=\"item.isActive\"\n              >\n                <SidebarMenuItem>\n                  <CollapsibleTrigger as-child>\n                    <SidebarMenuButton :tooltip=\"item.title\">\n                      <component :is=\"item.icon\" />\n                      <span>{{ item.title }}</span>\n                      <ChevronRightIcon class=\"example-sidebar-frame__chevron\" />\n                    </SidebarMenuButton>\n                  </CollapsibleTrigger>\n                  <CollapsibleContent>\n                    <SidebarMenuSub>\n                      <SidebarMenuSubItem\n                        v-for=\"subItem in item.items\"\n                        :key=\"subItem.title\"\n                      >\n                        <SidebarMenuSubButton\n                          href=\"#\"\n                          :is-active=\"subItem.isActive\"\n                          @click.prevent\n                        >\n                          <span>{{ subItem.title }}</span>\n                        </SidebarMenuSubButton>\n                      </SidebarMenuSubItem>\n                    </SidebarMenuSub>\n                  </CollapsibleContent>\n                </SidebarMenuItem>\n              </Collapsible>\n            </SidebarMenu>\n          </SidebarGroup>\n        </SidebarContent>\n        <SidebarFooter>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton\n                size=\"lg\"\n                tooltip=\"Jane Doe\"\n              >\n                <div class=\"example-sidebar-frame__avatar\">\n                  JD\n                </div>\n                <div class=\"example-sidebar-frame__label\">\n                  <span class=\"example-sidebar-frame__title\">Jane Doe</span>\n                  <span class=\"example-sidebar-frame__subtitle\">jane@example.com</span>\n                </div>\n              </SidebarMenuButton>\n              <SidebarMenuAction\n                show-on-hover\n                aria-label=\"More\"\n              >\n                <MoreHorizontalIcon />\n              </SidebarMenuAction>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarFooter>\n        <SidebarRail />\n      </Sidebar>\n      <SidebarInset>\n        <header class=\"example-sidebar-frame__header\">\n          <SidebarTrigger />\n          <Separator\n            orientation=\"vertical\"\n            class=\"example-sidebar-frame__separator\"\n          />\n          <span class=\"example-sidebar-frame__page-title\">Overview</span>\n        </header>\n        <div class=\"example-sidebar-frame__body\">\n          <div class=\"example-sidebar-frame__grid\">\n            <div class=\"example-sidebar-frame__card\" />\n            <div class=\"example-sidebar-frame__card\" />\n            <div class=\"example-sidebar-frame__card\" />\n          </div>\n          <div class=\"example-sidebar-frame__panel\" />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  </div>\n</template>\n\n<style>\n.example-sidebar-frame {\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  height: 520px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  transform: translateZ(0);\n}\n\n.example-sidebar-frame .example-sidebar-frame__provider {\n  height: 100%;\n  min-height: 100%;\n}\n\n.example-sidebar-frame .example-sidebar-frame__sidebar {\n  height: 100%;\n}\n\n.example-sidebar-frame__logo {\n  display: flex;\n  width: calc(var(--spacing) * 8);\n  height: calc(var(--spacing) * 8);\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  background-color: var(--primary);\n  color: var(--primary-foreground);\n}\n\n.example-sidebar-frame__avatar {\n  display: flex;\n  width: calc(var(--spacing) * 8);\n  height: calc(var(--spacing) * 8);\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  background-color: var(--secondary);\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.example-sidebar-frame__icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n}\n\n.example-sidebar-frame__label {\n  display: grid;\n  flex: 1;\n  font-size: 0.875rem;\n  line-height: 1.25;\n  text-align: left;\n}\n\n.example-sidebar-frame__title {\n  overflow: hidden;\n  font-weight: 500;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.example-sidebar-frame__subtitle {\n  overflow: hidden;\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.example-sidebar-frame__end-icon {\n  margin-left: auto;\n}\n\n.example-sidebar-frame__chevron {\n  margin-left: auto;\n  transition: transform 200ms;\n}\n\n.sigma-ui-sidebar-menu-item[data-state=\"open\"] .example-sidebar-frame__chevron {\n  transform: rotate(90deg);\n}\n\n.example-sidebar-frame__header {\n  display: flex;\n  height: calc(var(--spacing) * 14);\n  flex-shrink: 0;\n  align-items: center;\n  padding: 0 calc(var(--spacing) * 4);\n  border-bottom: 1px solid var(--border);\n  gap: calc(var(--spacing) * 2);\n}\n\n.example-sidebar-frame .example-sidebar-frame__separator {\n  height: calc(var(--spacing) * 4);\n  margin-right: calc(var(--spacing) * 2);\n}\n\n.example-sidebar-frame__page-title {\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.example-sidebar-frame__body {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: calc(var(--spacing) * 4);\n  gap: calc(var(--spacing) * 4);\n}\n\n.example-sidebar-frame__grid {\n  display: grid;\n  gap: calc(var(--spacing) * 4);\n  grid-auto-rows: min-content;\n}\n\n@media (width >= 48rem) {\n  .example-sidebar-frame__grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n.example-sidebar-frame__card {\n  border-radius: calc(var(--radius) + 4px);\n  aspect-ratio: 16 / 9;\n  background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n}\n\n.example-sidebar-frame__panel {\n  min-height: calc(var(--spacing) * 24);\n  flex: 1;\n  border-radius: calc(var(--radius) + 4px);\n  background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
