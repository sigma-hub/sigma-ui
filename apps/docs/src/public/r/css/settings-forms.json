{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "settings-forms",
  "type": "registry:block",
  "title": "Settings forms",
  "description": "A settings page with a section nav and forms for profile, account, appearance, notifications, and display.",
  "dependencies": [
    "@internationalized/date@^3.12.4",
    "@lucide/vue@^1.59.0",
    "reka-ui@^2.11.0",
    "vee-validate@^4.15.1",
    "zod@^4.6.7"
  ],
  "registryDependencies": [
    "button",
    "calendar",
    "card",
    "checkbox",
    "command",
    "form",
    "input",
    "popover",
    "radio-group",
    "select",
    "separator",
    "switch",
    "textarea",
    "toaster"
  ],
  "files": [
    {
      "path": "blocks/settings-forms/SettingsForms.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Component } from 'vue';\nimport { ref } from 'vue';\nimport { Card } from '@/components/ui/card';\nimport { Separator } from '@/components/ui/separator';\nimport AccountForm from './components/AccountForm.vue';\nimport AppearanceForm from './components/AppearanceForm.vue';\nimport DisplayForm from './components/DisplayForm.vue';\nimport NotificationsForm from './components/NotificationsForm.vue';\nimport ProfileForm from './components/ProfileForm.vue';\nimport SettingsNav from './components/SettingsNav.vue';\n\ntype FormType = 'profile' | 'account' | 'appearance' | 'notifications' | 'display';\n\nconst selectedForm = ref<FormType>('profile');\n\nconst formComponents: Record<FormType, Component> = {\n  profile: ProfileForm,\n  account: AccountForm,\n  appearance: AppearanceForm,\n  notifications: NotificationsForm,\n  display: DisplayForm,\n};\n</script>\n\n<template>\n  <Card class=\"settings-forms\">\n    <div class=\"settings-forms__body\">\n      <div class=\"settings-forms__intro\">\n        <h2 class=\"settings-forms__title\">\n          Settings\n        </h2>\n        <p class=\"settings-forms__description\">\n          Manage your account settings and set e-mail preferences.\n        </p>\n      </div>\n      <Separator class=\"settings-forms__separator\" />\n      <div class=\"settings-forms__layout\">\n        <aside class=\"settings-forms__nav\">\n          <SettingsNav v-model=\"selectedForm\" />\n        </aside>\n        <div class=\"settings-forms__content\">\n          <div class=\"settings-forms__panel\">\n            <component :is=\"formComponents[selectedForm]\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  </Card>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__body {\n    display: flex;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 10) calc(var(--spacing) * 10) calc(var(--spacing) * 16);\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .settings-forms__intro {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 0.5);\n  }\n\n  .settings-forms__title {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.025em;\n    line-height: 2rem;\n  }\n\n  .settings-forms__description,\n  .settings-forms__section-description {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n\n  .settings-forms__separator {\n    margin: calc(var(--spacing) * 6) 0;\n  }\n\n  .settings-forms__layout,\n  .settings-forms__panel,\n  .settings-forms__section {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .settings-forms__layout {\n    gap: calc(var(--spacing) * 8);\n  }\n\n  .settings-forms__content {\n    flex: 1;\n  }\n\n  .settings-forms__panel,\n  .settings-forms__section {\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .settings-forms__section-title {\n    margin: 0;\n    font-size: 1.125rem;\n    font-weight: 500;\n    line-height: 1.75rem;\n  }\n\n  .settings-forms__section-description {\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .settings-forms__form {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 8);\n  }\n\n  .settings-forms__actions {\n    display: flex;\n    justify-content: flex-start;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__sr-only {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  .settings-forms__toast {\n    padding: calc(var(--spacing) * 4);\n    border-radius: var(--radius);\n    margin-top: calc(var(--spacing) * 2);\n    background: color-mix(in oklch, var(--muted) 50%, transparent);\n  }\n\n  @media (width >= 64rem) {\n    .settings-forms__layout {\n      flex-direction: row;\n      gap: calc(var(--spacing) * 12);\n    }\n\n    .settings-forms__nav {\n      width: 20%;\n    }\n\n    .settings-forms__content {\n      max-width: 42rem;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/AccountForm.vue",
      "content": "<script setup lang=\"ts\">\nimport type { DateValue } from '@internationalized/date';\nimport { h, ref } from 'vue';\nimport * as z from 'zod';\nimport { toDate } from 'reka-ui/date';\nimport { CalendarDate, DateFormatter, getLocalTimeZone, today } from '@internationalized/date';\nimport { CalendarIcon, CheckIcon, ChevronsUpDownIcon } from '@lucide/vue';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { Calendar } from '@/components/ui/calendar';\nimport { Command, CommandEmpty, CommandGroup, CommandInput, CommandItem, CommandList } from '@/components/ui/command';\nimport { Form, FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { Input } from '@/components/ui/input';\nimport { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';\nimport { Separator } from '@/components/ui/separator';\n\nconst open = ref(false);\nconst dateValue = ref<DateValue>();\nconst placeholder = ref<DateValue>();\n\nconst languages = [\n  { label: 'English', value: 'en' },\n  { label: 'French', value: 'fr' },\n  { label: 'German', value: 'de' },\n  { label: 'Spanish', value: 'es' },\n  { label: 'Portuguese', value: 'pt' },\n  { label: 'Russian', value: 'ru' },\n  { label: 'Japanese', value: 'ja' },\n  { label: 'Korean', value: 'ko' },\n  { label: 'Chinese', value: 'zh' },\n] as const;\n\nconst formatter = new DateFormatter('en-US', {\n  dateStyle: 'long',\n});\n\nconst accountFormSchema = toTypedSchema(z.object({\n  name: z\n    .string({\n      error: 'Required.',\n    })\n    .min(2, {\n      error: 'Name must be at least 2 characters.',\n    })\n    .max(30, {\n      error: 'Name must not be longer than 30 characters.',\n    }),\n  dob: z.iso.datetime().optional().refine(date => date !== undefined, 'Please select a valid date.'),\n  language: z.string({ error: 'Please select a language.' }).min(1, 'Please select a language.'),\n}));\n\nfunction formatDob(date: DateValue | undefined) {\n  if (!date) {\n    return 'Pick a date';\n  }\n\n  return formatter.format(toDate(date, getLocalTimeZone()));\n}\n\nfunction applyDob(setFieldValue: (field: string, value: string | undefined) => void, next?: DateValue) {\n  dateValue.value = next;\n  setFieldValue('dob', next ? toDate(next).toISOString() : undefined);\n}\n\nfunction applyLanguage(setFieldValue: (field: string, value: string) => void, language: string) {\n  setFieldValue('language', language);\n  open.value = false;\n}\n\nfunction onSubmit(values: Record<string, unknown>) {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'settings-forms__toast' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n}\n</script>\n\n<template>\n  <div class=\"settings-forms__section\">\n    <h3 class=\"settings-forms__section-title\">\n      Account\n    </h3>\n    <p class=\"settings-forms__section-description\">\n      Update your account settings. Set your preferred language and timezone.\n    </p>\n  </div>\n  <Separator />\n  <Form\n    v-slot=\"{ setFieldValue }\"\n    :validation-schema=\"accountFormSchema\"\n    class=\"settings-forms__form\"\n    @submit=\"onSubmit\"\n  >\n    <FormField\n      v-slot=\"{ componentField }\"\n      name=\"name\"\n    >\n      <FormItem>\n        <FormLabel>Name</FormLabel>\n        <FormControl>\n          <Input\n            type=\"text\"\n            placeholder=\"Your name\"\n            autocomplete=\"name\"\n            v-bind=\"componentField\"\n          />\n        </FormControl>\n        <FormDescription>\n          This is the name that will be displayed on your profile and in emails.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <FormField\n      v-slot=\"{ field, value }\"\n      name=\"dob\"\n    >\n      <FormItem class=\"settings-forms__stack\">\n        <FormLabel>Date of birth</FormLabel>\n        <Popover>\n          <PopoverTrigger as-child>\n            <FormControl>\n              <Button\n                variant=\"outline\"\n                class=\"settings-forms__date-button\"\n                :class=\"{ 'settings-forms__date-button--empty': !value }\"\n              >\n                <CalendarIcon class=\"settings-forms__field-icon\" />\n                <span>{{ value ? formatDob(dateValue) : 'Pick a date' }}</span>\n              </Button>\n            </FormControl>\n          </PopoverTrigger>\n          <PopoverContent class=\"settings-forms__date-popover\">\n            <Calendar\n              v-model:placeholder=\"placeholder\"\n              v-model=\"dateValue\"\n              calendar-label=\"Date of birth\"\n              initial-focus\n              :min-value=\"new CalendarDate(1900, 1, 1)\"\n              :max-value=\"today(getLocalTimeZone())\"\n              @update:model-value=\"(next) => applyDob(setFieldValue, next)\"\n            />\n          </PopoverContent>\n        </Popover>\n        <FormDescription>\n          Your date of birth is used to calculate your age.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n      <input\n        type=\"hidden\"\n        v-bind=\"field\"\n      >\n    </FormField>\n\n    <FormField\n      v-slot=\"{ value }\"\n      name=\"language\"\n    >\n      <FormItem class=\"settings-forms__stack\">\n        <FormLabel>Language</FormLabel>\n        <Popover v-model:open=\"open\">\n          <PopoverTrigger as-child>\n            <FormControl>\n              <Button\n                variant=\"outline\"\n                role=\"combobox\"\n                class=\"settings-forms__language-button\"\n                :class=\"{ 'settings-forms__language-button--empty': !value }\"\n                :aria-expanded=\"open\"\n              >\n                {{ value ? languages.find(language => language.value === value)?.label : 'Select language...' }}\n                <ChevronsUpDownIcon class=\"settings-forms__language-icon\" />\n              </Button>\n            </FormControl>\n          </PopoverTrigger>\n          <PopoverContent class=\"settings-forms__language-popover\">\n            <Command>\n              <CommandInput placeholder=\"Search language...\" />\n              <CommandEmpty>No language found.</CommandEmpty>\n              <CommandList>\n                <CommandGroup>\n                  <CommandItem\n                    v-for=\"language in languages\"\n                    :key=\"language.value\"\n                    :value=\"language.label\"\n                    @select=\"applyLanguage(setFieldValue, language.value)\"\n                  >\n                    <CheckIcon\n                      class=\"settings-forms__check\"\n                      :class=\"{ 'settings-forms__check--active': value === language.value }\"\n                    />\n                    {{ language.label }}\n                  </CommandItem>\n                </CommandGroup>\n              </CommandList>\n            </Command>\n          </PopoverContent>\n        </Popover>\n        <FormDescription>\n          This is the language that will be used in the dashboard.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <div class=\"settings-forms__actions\">\n      <Button type=\"submit\">\n        Update account\n      </Button>\n    </div>\n  </Form>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__stack {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .settings-forms__date-button.settings-forms__date-button {\n    width: 240px;\n    justify-content: flex-start;\n    font-weight: 400;\n    text-align: left;\n  }\n\n  .settings-forms__date-button--empty,\n  .settings-forms__language-button--empty {\n    color: var(--muted-foreground);\n  }\n\n  .settings-forms__field-icon,\n  .settings-forms__check {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    margin-right: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__field-icon {\n    opacity: 0.5;\n  }\n\n  .settings-forms__date-popover,\n  .settings-forms__language-popover {\n    padding: 0;\n  }\n\n  .settings-forms__language-button.settings-forms__language-button,\n  .settings-forms__language-popover {\n    width: 200px;\n  }\n\n  .settings-forms__language-button.settings-forms__language-button {\n    justify-content: space-between;\n  }\n\n  .settings-forms__language-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    flex-shrink: 0;\n    margin-left: calc(var(--spacing) * 2);\n    opacity: 0.5;\n  }\n\n  .settings-forms__check {\n    opacity: 0;\n  }\n\n  .settings-forms__check--active {\n    opacity: 1;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/AppearanceForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { h } from 'vue';\nimport { useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';\nimport { Separator } from '@/components/ui/separator';\n\nconst appearanceFormSchema = toTypedSchema(z.object({\n  theme: z.enum(['light', 'dark'], {\n    error: 'Please select a theme.',\n  }),\n}));\n\nconst { handleSubmit } = useForm({\n  validationSchema: appearanceFormSchema,\n  initialValues: {\n    theme: 'light' as const,\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'settings-forms__toast' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n</script>\n\n<template>\n  <div class=\"settings-forms__section\">\n    <h3 class=\"settings-forms__section-title\">\n      Appearance\n    </h3>\n    <p class=\"settings-forms__section-description\">\n      Customize the appearance of the app. Automatically switch between day and night themes.\n    </p>\n  </div>\n  <Separator />\n  <form\n    class=\"settings-forms__form\"\n    @submit=\"onSubmit\"\n  >\n    <FormField\n      v-slot=\"{ componentField }\"\n      type=\"radio\"\n      name=\"theme\"\n    >\n      <FormItem class=\"settings-forms__theme\">\n        <FormLabel>Theme</FormLabel>\n        <FormDescription>\n          Select the theme for the dashboard.\n        </FormDescription>\n        <FormMessage />\n        <RadioGroup\n          class=\"settings-forms__theme-grid\"\n          v-bind=\"componentField\"\n        >\n          <FormItem>\n            <FormLabel class=\"settings-forms__theme-label\">\n              <FormControl>\n                <RadioGroupItem\n                  value=\"light\"\n                  class=\"settings-forms__sr-only\"\n                />\n              </FormControl>\n              <div class=\"settings-forms__theme-frame\">\n                <div class=\"settings-forms__theme-canvas settings-forms__theme-canvas--light\">\n                  <div class=\"settings-forms__theme-card settings-forms__theme-card--light\">\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--short settings-forms__theme-line--light\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--light\" />\n                  </div>\n                  <div class=\"settings-forms__theme-row settings-forms__theme-card--light\">\n                    <div class=\"settings-forms__theme-dot settings-forms__theme-dot--light\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--light\" />\n                  </div>\n                  <div class=\"settings-forms__theme-row settings-forms__theme-card--light\">\n                    <div class=\"settings-forms__theme-dot settings-forms__theme-dot--light\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--light\" />\n                  </div>\n                </div>\n              </div>\n              <span class=\"settings-forms__theme-caption\">\n                Light\n              </span>\n            </FormLabel>\n          </FormItem>\n          <FormItem>\n            <FormLabel class=\"settings-forms__theme-label\">\n              <FormControl>\n                <RadioGroupItem\n                  value=\"dark\"\n                  class=\"settings-forms__sr-only\"\n                />\n              </FormControl>\n              <div class=\"settings-forms__theme-frame settings-forms__theme-frame--dark\">\n                <div class=\"settings-forms__theme-canvas settings-forms__theme-canvas--dark\">\n                  <div class=\"settings-forms__theme-card settings-forms__theme-card--dark\">\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--short settings-forms__theme-line--dark\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--dark\" />\n                  </div>\n                  <div class=\"settings-forms__theme-row settings-forms__theme-card--dark\">\n                    <div class=\"settings-forms__theme-dot settings-forms__theme-dot--dark\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--dark\" />\n                  </div>\n                  <div class=\"settings-forms__theme-row settings-forms__theme-card--dark\">\n                    <div class=\"settings-forms__theme-dot settings-forms__theme-dot--dark\" />\n                    <div class=\"settings-forms__theme-line settings-forms__theme-line--long settings-forms__theme-line--dark\" />\n                  </div>\n                </div>\n              </div>\n              <span class=\"settings-forms__theme-caption\">\n                Dark\n              </span>\n            </FormLabel>\n          </FormItem>\n        </RadioGroup>\n      </FormItem>\n    </FormField>\n\n    <div class=\"settings-forms__actions\">\n      <Button type=\"submit\">\n        Update preferences\n      </Button>\n    </div>\n  </form>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__theme {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .settings-forms__theme-grid {\n    display: grid;\n    max-width: 28rem;\n    padding-top: calc(var(--spacing) * 2);\n    gap: calc(var(--spacing) * 8);\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .settings-forms__theme-label:has([data-state=\"checked\"]) .settings-forms__theme-frame {\n    border-color: var(--primary);\n  }\n\n  .settings-forms__theme-frame {\n    padding: calc(var(--spacing) * 1);\n    border: 2px solid var(--muted);\n    border-radius: var(--radius);\n  }\n\n  .settings-forms__theme-frame:hover {\n    border-color: var(--secondary);\n  }\n\n  .settings-forms__theme-frame--dark {\n    background: var(--popover);\n  }\n\n  .settings-forms__theme-frame--dark:hover {\n    background: var(--secondary);\n    color: var(--secondary-foreground);\n  }\n\n  .settings-forms__theme-canvas,\n  .settings-forms__theme-card {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__theme-canvas {\n    padding: calc(var(--spacing) * 2);\n    border-radius: calc(var(--radius) - 4px);\n  }\n\n  .settings-forms__theme-canvas--light {\n    background: #ecedef;\n  }\n\n  .settings-forms__theme-canvas--dark {\n    background: #020617;\n  }\n\n  .settings-forms__theme-card,\n  .settings-forms__theme-row {\n    padding: calc(var(--spacing) * 2);\n    border-radius: var(--radius);\n    box-shadow: 0 1px 2px rgb(0 0 0 / 5%);\n  }\n\n  .settings-forms__theme-card--light,\n  .settings-forms__theme-row.settings-forms__theme-card--light {\n    background: #ffffff;\n  }\n\n  .settings-forms__theme-card--dark,\n  .settings-forms__theme-row.settings-forms__theme-card--dark {\n    background: #1e293b;\n  }\n\n  .settings-forms__theme-row {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__theme-line,\n  .settings-forms__theme-dot {\n    border-radius: 9999px;\n  }\n\n  .settings-forms__theme-line {\n    height: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__theme-line--short {\n    width: calc(var(--spacing) * 20);\n  }\n\n  .settings-forms__theme-line--long {\n    width: 100px;\n  }\n\n  .settings-forms__theme-line--light,\n  .settings-forms__theme-dot--light {\n    background: #ecedef;\n  }\n\n  .settings-forms__theme-line--dark,\n  .settings-forms__theme-dot--dark {\n    background: #94a3b8;\n  }\n\n  .settings-forms__theme-dot {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .settings-forms__theme-caption {\n    display: block;\n    width: 100%;\n    padding: calc(var(--spacing) * 2);\n    font-weight: 400;\n    text-align: center;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/DisplayForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { h } from 'vue';\nimport { useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { Separator } from '@/components/ui/separator';\n\nconst items = [\n  { id: 'recents', label: 'Recents' },\n  { id: 'home', label: 'Home' },\n  { id: 'applications', label: 'Applications' },\n  { id: 'desktop', label: 'Desktop' },\n  { id: 'downloads', label: 'Downloads' },\n  { id: 'documents', label: 'Documents' },\n] as const;\n\nconst displayFormSchema = toTypedSchema(z.object({\n  items: z.array(z.string()).refine(value => value.some(item => item), {\n    error: 'You have to select at least one item.',\n  }),\n}));\n\nconst { handleSubmit } = useForm({\n  validationSchema: displayFormSchema,\n  initialValues: {\n    items: ['recents', 'home'],\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'settings-forms__toast' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n\nfunction toggleItem(handleChange: (next: string[]) => void, value: string[], itemId: string, checked: boolean | 'indeterminate') {\n  handleChange(checked ? [...value, itemId] : value.filter(id => id !== itemId));\n}\n</script>\n\n<template>\n  <div class=\"settings-forms__section\">\n    <h3 class=\"settings-forms__section-title\">\n      Display\n    </h3>\n    <p class=\"settings-forms__section-description\">\n      Turn items on or off to control what's displayed in the app.\n    </p>\n  </div>\n  <Separator />\n  <form @submit=\"onSubmit\">\n    <FormField name=\"items\">\n      <FormItem>\n        <div class=\"settings-forms__display-intro\">\n          <FormLabel class=\"settings-forms__switch-label\">\n            Sidebar\n          </FormLabel>\n          <FormDescription>\n            Select the items you want to display in the sidebar.\n          </FormDescription>\n        </div>\n        <FormField\n          v-for=\"item in items\"\n          v-slot=\"{ value, handleChange }\"\n          :key=\"item.id\"\n          name=\"items\"\n        >\n          <FormItem class=\"settings-forms__checkbox-row\">\n            <FormControl>\n              <Checkbox\n                :model-value=\"value.includes(item.id)\"\n                @update:model-value=\"(checked) => toggleItem(handleChange, value, item.id, checked)\"\n              />\n            </FormControl>\n            <FormLabel class=\"settings-forms__choice\">\n              {{ item.label }}\n            </FormLabel>\n          </FormItem>\n        </FormField>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n    <div class=\"settings-forms__display-actions\">\n      <Button type=\"submit\">\n        Update display\n      </Button>\n    </div>\n  </form>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__display-intro {\n    margin-bottom: calc(var(--spacing) * 4);\n  }\n\n  .settings-forms__display-actions {\n    display: flex;\n    justify-content: flex-start;\n    margin-top: calc(var(--spacing) * 4);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/NotificationsForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { h } from 'vue';\nimport { useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';\nimport { Separator } from '@/components/ui/separator';\nimport { Switch } from '@/components/ui/switch';\n\nconst notificationsFormSchema = toTypedSchema(z.object({\n  type: z.enum(['all', 'mentions', 'none'], {\n    error: 'You need to select a notification type.',\n  }),\n  mobile: z.boolean().default(false).optional(),\n  communication_emails: z.boolean().default(false).optional(),\n  social_emails: z.boolean().default(false).optional(),\n  marketing_emails: z.boolean().default(false).optional(),\n  security_emails: z.boolean(),\n}));\n\nconst { handleSubmit } = useForm({\n  validationSchema: notificationsFormSchema,\n  initialValues: {\n    communication_emails: false,\n    marketing_emails: false,\n    social_emails: true,\n    security_emails: true,\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'settings-forms__toast' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n</script>\n\n<template>\n  <div class=\"settings-forms__section\">\n    <h3 class=\"settings-forms__section-title\">\n      Notifications\n    </h3>\n    <p class=\"settings-forms__section-description\">\n      Configure how you receive notifications.\n    </p>\n  </div>\n  <Separator />\n  <form\n    class=\"settings-forms__form\"\n    @submit=\"onSubmit\"\n  >\n    <FormField\n      v-slot=\"{ componentField }\"\n      type=\"radio\"\n      name=\"type\"\n    >\n      <FormItem class=\"settings-forms__notify\">\n        <FormLabel>Notify me about...</FormLabel>\n        <FormControl>\n          <RadioGroup\n            class=\"settings-forms__radio-list\"\n            v-bind=\"componentField\"\n          >\n            <FormItem class=\"settings-forms__radio-row\">\n              <FormControl>\n                <RadioGroupItem value=\"all\" />\n              </FormControl>\n              <FormLabel class=\"settings-forms__choice\">\n                All new messages\n              </FormLabel>\n            </FormItem>\n            <FormItem class=\"settings-forms__radio-row\">\n              <FormControl>\n                <RadioGroupItem value=\"mentions\" />\n              </FormControl>\n              <FormLabel class=\"settings-forms__choice\">\n                Direct messages and mentions\n              </FormLabel>\n            </FormItem>\n            <FormItem class=\"settings-forms__radio-row\">\n              <FormControl>\n                <RadioGroupItem value=\"none\" />\n              </FormControl>\n              <FormLabel class=\"settings-forms__choice\">\n                Nothing\n              </FormLabel>\n            </FormItem>\n          </RadioGroup>\n        </FormControl>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <div>\n      <h3 class=\"settings-forms__email-title\">\n        Email Notifications\n      </h3>\n      <div class=\"settings-forms__email-list\">\n        <FormField\n          v-slot=\"{ handleChange, value }\"\n          type=\"checkbox\"\n          name=\"communication_emails\"\n        >\n          <FormItem class=\"settings-forms__switch-row\">\n            <div class=\"settings-forms__switch-copy\">\n              <FormLabel class=\"settings-forms__switch-label\">\n                Communication emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails about your account activity.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n        <FormField\n          v-slot=\"{ handleChange, value }\"\n          type=\"checkbox\"\n          name=\"marketing_emails\"\n        >\n          <FormItem class=\"settings-forms__switch-row\">\n            <div class=\"settings-forms__switch-copy\">\n              <FormLabel class=\"settings-forms__switch-label\">\n                Marketing emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails about new products, features, and more.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n        <FormField\n          v-slot=\"{ handleChange, value }\"\n          type=\"checkbox\"\n          name=\"social_emails\"\n        >\n          <FormItem class=\"settings-forms__switch-row\">\n            <div class=\"settings-forms__switch-copy\">\n              <FormLabel class=\"settings-forms__switch-label\">\n                Social emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails for friend requests, follows, and more.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n        <FormField\n          v-slot=\"{ handleChange, value }\"\n          type=\"checkbox\"\n          name=\"security_emails\"\n        >\n          <FormItem class=\"settings-forms__switch-row\">\n            <div class=\"settings-forms__switch-copy\">\n              <FormLabel class=\"settings-forms__switch-label\">\n                Security emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails about your account activity and security.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n      </div>\n    </div>\n\n    <FormField\n      v-slot=\"{ handleChange, value }\"\n      type=\"checkbox\"\n      name=\"mobile\"\n    >\n      <FormItem class=\"settings-forms__checkbox-row\">\n        <FormControl>\n          <Checkbox\n            :model-value=\"value\"\n            @update:model-value=\"handleChange\"\n          />\n        </FormControl>\n        <div class=\"settings-forms__checkbox-copy\">\n          <FormLabel>\n            Use different settings for my mobile devices\n          </FormLabel>\n          <FormDescription>\n            You can manage your mobile notifications in the\n            <a\n              href=\"#\"\n              class=\"settings-forms__link\"\n            >\n              mobile settings\n            </a>\n            page.\n          </FormDescription>\n        </div>\n      </FormItem>\n    </FormField>\n\n    <div class=\"settings-forms__actions\">\n      <Button type=\"submit\">\n        Update notifications\n      </Button>\n    </div>\n  </form>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__notify {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .settings-forms__radio-list,\n  .settings-forms__email-list {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .settings-forms__radio-list {\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .settings-forms__radio-row,\n  .settings-forms__checkbox-row {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .settings-forms__choice.settings-forms__choice {\n    font-weight: 400;\n  }\n\n  .settings-forms__email-title {\n    margin: 0 0 calc(var(--spacing) * 4);\n    font-size: 1.125rem;\n    font-weight: 500;\n    line-height: 1.75rem;\n  }\n\n  .settings-forms__email-list {\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .settings-forms__switch-row {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n  }\n\n  .settings-forms__switch-copy,\n  .settings-forms__checkbox-copy {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .settings-forms__switch-copy {\n    gap: calc(var(--spacing) * 0.5);\n  }\n\n  .settings-forms__checkbox-copy {\n    gap: calc(var(--spacing) * 1);\n    line-height: 1;\n  }\n\n  .settings-forms__switch-label.settings-forms__switch-label {\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n\n  .settings-forms__checkbox-row {\n    align-items: flex-start;\n  }\n\n  .settings-forms__link {\n    color: inherit;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/ProfileForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { h, ref } from 'vue';\nimport { FieldArray, useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { XIcon } from '@lucide/vue';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { Input } from '@/components/ui/input';\nimport { Select, SelectContent, SelectGroup, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Separator } from '@/components/ui/separator';\nimport { Textarea } from '@/components/ui/textarea';\n\nconst verifiedEmails = ref(['m@example.com', 'm@google.com', 'm@support.com']);\n\nconst profileFormSchema = toTypedSchema(z.object({\n  username: z\n    .string({ error: 'Username is required.' })\n    .min(2, {\n      error: 'Username must be at least 2 characters.',\n    })\n    .max(30, {\n      error: 'Username must not be longer than 30 characters.',\n    }),\n  email: z.email({ error: 'Please select an email to display.' }),\n  bio: z.string({ error: 'Bio is required.' }).max(160, { error: 'Bio must not be longer than 160 characters.' }).min(4, { error: 'Bio must be at least 4 characters.' }),\n  urls: z\n    .array(\n      z.object({\n        value: z.url({ error: 'Please enter a valid URL.' }),\n      }),\n    )\n    .optional(),\n}));\n\nconst { handleSubmit, resetForm } = useForm({\n  validationSchema: profileFormSchema,\n  initialValues: {\n    bio: 'I own a computer.',\n    urls: [\n      { value: 'https://sigma-ui.dev' },\n      { value: 'https://twitter.com/sigma__dev' },\n    ],\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'settings-forms__toast' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n</script>\n\n<template>\n  <div class=\"settings-forms__section\">\n    <h3 class=\"settings-forms__section-title\">\n      Profile\n    </h3>\n    <p class=\"settings-forms__section-description\">\n      This is how others will see you on the site.\n    </p>\n  </div>\n  <Separator />\n  <form\n    class=\"settings-forms__form\"\n    @submit=\"onSubmit\"\n  >\n    <FormField\n      v-slot=\"{ componentField }\"\n      name=\"username\"\n    >\n      <FormItem>\n        <FormLabel>Username</FormLabel>\n        <FormControl>\n          <Input\n            type=\"text\"\n            placeholder=\"sigma-ui\"\n            v-bind=\"componentField\"\n          />\n        </FormControl>\n        <FormDescription>\n          This is your public display name. It can be your real name or a pseudonym. You can only change this once every 30 days.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <FormField\n      v-slot=\"{ componentField }\"\n      name=\"email\"\n    >\n      <FormItem>\n        <FormLabel>Email</FormLabel>\n        <Select v-bind=\"componentField\">\n          <FormControl>\n            <SelectTrigger>\n              <SelectValue placeholder=\"Select an email\" />\n            </SelectTrigger>\n          </FormControl>\n          <SelectContent>\n            <SelectGroup>\n              <SelectItem\n                v-for=\"email in verifiedEmails\"\n                :key=\"email\"\n                :value=\"email\"\n              >\n                {{ email }}\n              </SelectItem>\n            </SelectGroup>\n          </SelectContent>\n        </Select>\n        <FormDescription>\n          You can manage verified email addresses in your email settings.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <FormField\n      v-slot=\"{ componentField }\"\n      name=\"bio\"\n    >\n      <FormItem>\n        <FormLabel>Bio</FormLabel>\n        <FormControl>\n          <Textarea\n            placeholder=\"Tell us a little bit about yourself\"\n            v-bind=\"componentField\"\n          />\n        </FormControl>\n        <FormDescription>\n          You can <span>@mention</span> other users and organizations to link to them.\n        </FormDescription>\n        <FormMessage />\n      </FormItem>\n    </FormField>\n\n    <div>\n      <FieldArray\n        v-slot=\"{ fields, push, remove }\"\n        name=\"urls\"\n      >\n        <div\n          v-for=\"(field, index) in fields\"\n          :key=\"`urls-${field.key}`\"\n        >\n          <FormField\n            v-slot=\"{ componentField }\"\n            :name=\"`urls[${index}].value`\"\n          >\n            <FormItem>\n              <FormLabel :class=\"{ 'settings-forms__sr-only': index !== 0 }\">\n                URLs\n              </FormLabel>\n              <FormDescription :class=\"{ 'settings-forms__sr-only': index !== 0 }\">\n                Add links to your website, blog, or social media profiles.\n              </FormDescription>\n              <div class=\"settings-forms__url-row\">\n                <FormControl>\n                  <Input\n                    type=\"url\"\n                    v-bind=\"componentField\"\n                  />\n                </FormControl>\n                <button\n                  type=\"button\"\n                  class=\"settings-forms__url-remove\"\n                  @click=\"remove(index)\"\n                >\n                  <XIcon class=\"settings-forms__url-icon\" />\n                </button>\n              </div>\n              <FormMessage />\n            </FormItem>\n          </FormField>\n        </div>\n        <Button\n          type=\"button\"\n          variant=\"outline\"\n          size=\"sm\"\n          class=\"settings-forms__add-url\"\n          @click=\"push({ value: '' })\"\n        >\n          Add URL\n        </Button>\n      </FieldArray>\n    </div>\n\n    <div class=\"settings-forms__actions\">\n      <Button type=\"submit\">\n        Update profile\n      </Button>\n      <Button\n        type=\"button\"\n        variant=\"outline\"\n        @click=\"resetForm\"\n      >\n        Reset form\n      </Button>\n    </div>\n  </form>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__url-row {\n    position: relative;\n    display: flex;\n    align-items: center;\n  }\n\n  .settings-forms__url-remove {\n    position: absolute;\n    right: 0;\n    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);\n    border: 0;\n    background: transparent;\n    color: var(--muted-foreground);\n  }\n\n  .settings-forms__url-icon {\n    width: calc(var(--spacing) * 3);\n    height: calc(var(--spacing) * 3);\n  }\n\n  .settings-forms__add-url.settings-forms__add-url {\n    width: calc(var(--spacing) * 20);\n    margin-top: calc(var(--spacing) * 2);\n    font-size: 0.75rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-forms/components/SettingsNav.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\n\ninterface Item {\n  title: string;\n  id: string;\n}\n\nconst modelValue = defineModel<string>({ default: 'profile' });\n\nconst sidebarNavItems: Item[] = [\n  { title: 'Profile', id: 'profile' },\n  { title: 'Account', id: 'account' },\n  { title: 'Appearance', id: 'appearance' },\n  { title: 'Notifications', id: 'notifications' },\n  { title: 'Display', id: 'display' },\n];\n\nfunction selectItem(itemId: string) {\n  modelValue.value = itemId;\n}\n</script>\n\n<template>\n  <nav class=\"settings-forms__nav-list\">\n    <Button\n      v-for=\"item in sidebarNavItems\"\n      :key=\"item.id\"\n      variant=\"ghost\"\n      class=\"settings-forms__nav-button\"\n      :class=\"{ 'settings-forms__nav-button--active': modelValue === item.id }\"\n      @click=\"selectItem(item.id)\"\n    >\n      {{ item.title }}\n    </Button>\n  </nav>\n</template>\n\n<style>\n@layer components {\n  .settings-forms__nav-list {\n    display: flex;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .settings-forms__nav-button.settings-forms__nav-button {\n    width: 100%;\n    justify-content: flex-start;\n    text-align: left;\n  }\n\n  .settings-forms__nav-button--active.settings-forms__nav-button--active,\n  .settings-forms__nav-button--active.settings-forms__nav-button--active:hover {\n    background: var(--muted);\n  }\n\n  @media (width >= 64rem) {\n    .settings-forms__nav-list {\n      flex-direction: column;\n      gap: calc(var(--spacing) * 1);\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "1100px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "settings"
  ]
}
