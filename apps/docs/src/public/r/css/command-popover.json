{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-popover",
  "type": "registry:example",
  "title": "CommandPopover",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button",
    "command",
    "popover"
  ],
  "files": [
    {
      "path": "example/CommandPopover.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport {\n  ArrowUpCircleIcon,\n  CheckCircle2Icon,\n  CircleIcon,\n  HelpCircleIcon,\n  XCircleIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n} from '@/components/ui/command';\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from '@/components/ui/popover';\n\ninterface Status {\n  value: string;\n  label: string;\n  icon: typeof HelpCircleIcon;\n}\n\nconst statuses: Status[] = [\n  {\n    value: 'backlog',\n    label: 'Backlog',\n    icon: HelpCircleIcon,\n  },\n  {\n    value: 'todo',\n    label: 'Todo',\n    icon: CircleIcon,\n  },\n  {\n    value: 'in progress',\n    label: 'In Progress',\n    icon: ArrowUpCircleIcon,\n  },\n  {\n    value: 'done',\n    label: 'Done',\n    icon: CheckCircle2Icon,\n  },\n  {\n    value: 'canceled',\n    label: 'Canceled',\n    icon: XCircleIcon,\n  },\n];\n\nconst open = ref(false);\nconst selectedStatus = ref<Status>();\n</script>\n\n<template>\n  <div class=\"example-sigma-ui-command-popover\">\n    <p class=\"example-sigma-ui-command-popover__label\">\n      Status\n    </p>\n    <Popover v-model:open=\"open\">\n      <PopoverTrigger as-child>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          class=\"example-sigma-ui-command-popover__trigger\"\n        >\n          <template v-if=\"selectedStatus\">\n            <component\n              :is=\"selectedStatus?.icon\"\n              class=\"example-sigma-ui-command-popover__icon\"\n            />\n            {{ selectedStatus?.label }}\n          </template>\n          <template v-else>\n            + Set status\n          </template>\n        </Button>\n      </PopoverTrigger>\n      <PopoverContent\n        class=\"example-sigma-ui-command-popover__content\"\n        side=\"bottom\"\n        align=\"start\"\n      >\n        <Command>\n          <CommandInput placeholder=\"Change status...\" />\n          <CommandList>\n            <CommandEmpty>No results found.</CommandEmpty>\n            <CommandGroup>\n              <CommandItem\n                v-for=\"status in statuses\"\n                :key=\"status.value\"\n                :value=\"status.value\"\n                @select=\"(value) => {\n                  selectedStatus = status\n                  open = false\n                }\"\n              >\n                <component\n                  :is=\"status.icon\"\n                  :key=\"status.value\"\n                  class=\"example-sigma-ui-command-popover__status-icon\"\n                  :class=\"{ 'example-sigma-ui-command-popover__status-icon--selected': status.value === selectedStatus?.value }\"\n                />\n                <span>{{ status.label }}</span>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </PopoverContent>\n    </Popover>\n  </div>\n</template>\n\n<style>\n.example-sigma-ui-command-popover {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--spacing) * 4);\n}\n\n.example-sigma-ui-command-popover__label {\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n}\n\n.example-sigma-ui-command-popover__trigger {\n  width: 150px;\n  justify-content: flex-start;\n}\n\n.example-sigma-ui-command-popover__icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n  flex-shrink: 0;\n  margin-right: calc(var(--spacing) * 2);\n}\n\n.example-sigma-ui-command-popover__content {\n  padding: 0;\n}\n\n.example-sigma-ui-command-popover__status-icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n  margin-right: calc(var(--spacing) * 2);\n  opacity: 0.4;\n}\n\n.example-sigma-ui-command-popover__status-icon--selected {\n  opacity: 1;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
