{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "switch-form",
  "type": "registry:example",
  "title": "SwitchForm",
  "dependencies": [
    "vee-validate@^4.15.1",
    "zod@^4.6.7"
  ],
  "registryDependencies": [
    "button",
    "form",
    "switch",
    "toaster"
  ],
  "files": [
    {
      "path": "example/SwitchForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { h } from 'vue';\nimport { useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, toTypedSchema } from '@/components/ui/form';\nimport { Switch } from '@/components/ui/switch';\n\nconst formSchema = toTypedSchema(z.object({\n  marketing_emails: z.boolean().default(false).optional(),\n  security_emails: z.boolean(),\n}));\n\nconst { handleSubmit } = useForm({\n  validationSchema: formSchema,\n  initialValues: {\n    security_emails: true,\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'example-sigma-ui-switch-form__toast-pre' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n</script>\n\n<template>\n  <form\n    class=\"example-sigma-ui-switch-form\"\n    @submit=\"onSubmit\"\n  >\n    <div class=\"example-sigma-ui-switch-form__section\">\n      <h3 class=\"example-sigma-ui-switch-form__title\">\n        Email Notifications\n      </h3>\n\n      <div class=\"example-sigma-ui-switch-form__fields\">\n        <FormField\n          v-slot=\"{ value, handleChange }\"\n          name=\"marketing_emails\"\n        >\n          <FormItem class=\"example-sigma-ui-switch-form__field-item\">\n            <div class=\"example-sigma-ui-switch-form__field-content\">\n              <FormLabel class=\"example-sigma-ui-switch-form__label\">\n                Marketing emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails about new products, features, and more.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n        <FormField\n          v-slot=\"{ value, handleChange }\"\n          name=\"security_emails\"\n        >\n          <FormItem class=\"example-sigma-ui-switch-form__field-item\">\n            <div class=\"example-sigma-ui-switch-form__field-content\">\n              <FormLabel class=\"example-sigma-ui-switch-form__label\">\n                Security emails\n              </FormLabel>\n              <FormDescription>\n                Receive emails about your account security.\n              </FormDescription>\n            </div>\n            <FormControl>\n              <Switch\n                :model-value=\"value\"\n                disabled\n                aria-readonly\n                @update:model-value=\"handleChange\"\n              />\n            </FormControl>\n          </FormItem>\n        </FormField>\n      </div>\n    </div>\n    <Button\n      type=\"submit\"\n      class=\"example-sigma-ui-switch-form__submit\"\n    >\n      Submit\n    </Button>\n  </form>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-sigma-ui-switch-form {\n    display: flex;\n    width: 100%;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .example-sigma-ui-switch-form__title {\n    margin-bottom: calc(var(--spacing) * 4);\n    font-size: 1.125rem;\n    font-weight: 500;\n  }\n\n  .example-sigma-ui-switch-form__fields {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .example-sigma-ui-switch-form__field-item {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n  }\n\n  .example-sigma-ui-switch-form__field-content {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 0.5);\n  }\n\n  .example-sigma-ui-switch-form__label {\n    font-size: 1rem;\n  }\n\n  .example-sigma-ui-switch-form__submit {\n    width: fit-content;\n  }\n\n  .example-sigma-ui-switch-form__toast-pre {\n    padding: calc(var(--spacing) * 4);\n    border-radius: var(--radius);\n    margin-top: calc(var(--spacing) * 2);\n    background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
