{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkbox-form-single",
  "type": "registry:example",
  "title": "CheckboxFormSingle",
  "dependencies": [
    "vee-validate@^4.15.1",
    "zod@^4.6.7"
  ],
  "registryDependencies": [
    "button",
    "checkbox",
    "form",
    "toaster"
  ],
  "files": [
    {
      "path": "example/CheckboxFormSingle.vue",
      "content": "<script setup lang=\"ts\">\nimport { h } from 'vue';\nimport { useForm } from 'vee-validate';\nimport * as z from 'zod';\nimport { toast } from '@/components/ui/toaster';\nimport { Button } from '@/components/ui/button';\nimport { FormControl, FormDescription, FormField, FormItem, FormLabel, FormMessage, toTypedSchema } from '@/components/ui/form';\nimport { Checkbox } from '@/components/ui/checkbox';\n\nconst formSchema = toTypedSchema(z.object({\n  mobile: z.boolean().refine(val => val === true, {\n    error: 'You must check this checkbox to proceed',\n  }),\n}));\n\nconst { handleSubmit } = useForm({\n  validationSchema: formSchema,\n  initialValues: {\n    mobile: false,\n  },\n});\n\nconst onSubmit = handleSubmit((values) => {\n  toast('You submitted the following values:', {\n    description: h('pre', { class: 'example-sigma-ui-checkbox-form__toast-pre' }, h('code', {}, JSON.stringify(values, null, 2))),\n  });\n});\n</script>\n\n<template>\n  <form\n    class=\"example-sigma-ui-checkbox-form\"\n    @submit=\"onSubmit\"\n  >\n    <FormField\n      v-slot=\"{ value, handleChange, errorMessage }\"\n      type=\"checkbox\"\n      name=\"mobile\"\n    >\n      <FormItem class=\"example-sigma-ui-checkbox-form__item\">\n        <FormControl>\n          <Checkbox\n            :model-value=\"value\"\n            @update:model-value=\"handleChange\"\n          />\n        </FormControl>\n        <div class=\"example-sigma-ui-checkbox-form__content\">\n          <FormLabel>I accept the terms and conditions</FormLabel>\n          <FormDescription>\n            You must accept our terms and conditions before proceeding with your submission.\n          </FormDescription>\n          <FormMessage>\n            {{ errorMessage }}\n          </FormMessage>\n        </div>\n      </FormItem>\n    </FormField>\n    <Button type=\"submit\">\n      Submit\n    </Button>\n  </form>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-sigma-ui-checkbox-form {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .example-sigma-ui-checkbox-form__item {\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .example-sigma-ui-checkbox-form__content {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n    line-height: 1;\n  }\n\n  .example-sigma-ui-checkbox-form__toast-pre {\n    padding: calc(var(--spacing) * 2);\n    border-radius: var(--radius-md);\n    margin-top: calc(var(--spacing) * 2);\n    background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
