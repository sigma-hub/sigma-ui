{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "carousel-plugin",
  "type": "registry:example",
  "title": "CarouselPlugin",
  "dependencies": [
    "embla-carousel-autoplay@^8.6.0"
  ],
  "registryDependencies": [
    "carousel"
  ],
  "files": [
    {
      "path": "example/CarouselPlugin.vue",
      "content": "<script setup lang=\"ts\">\nimport Autoplay from 'embla-carousel-autoplay';\nimport { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel';\n\nconst plugin = Autoplay({\n  delay: 2000,\n  stopOnMouseEnter: true,\n  stopOnInteraction: false,\n});\n</script>\n\n<template>\n  <Carousel\n    class=\"example-sigma-ui-carousel-plugin\"\n    :plugins=\"[plugin]\"\n    @mouseenter=\"plugin.stop\"\n    @mouseleave=\"[plugin.reset(), plugin.play()];\"\n  >\n    <CarouselContent>\n      <CarouselItem\n        v-for=\"(_, index) in 5\"\n        :key=\"index\"\n      >\n        <div class=\"example-sigma-ui-carousel-plugin__slide\">\n          <div class=\"example-sigma-ui-carousel-plugin__item\">\n            {{ index + 1 }}\n          </div>\n        </div>\n      </CarouselItem>\n    </CarouselContent>\n    <CarouselPrevious />\n    <CarouselNext />\n  </Carousel>\n</template>\n\n<style>\n.example-sigma-ui-carousel-plugin {\n  position: relative;\n  width: 100%;\n  max-width: 20rem;\n}\n\n.example-sigma-ui-carousel-plugin__slide {\n  padding: calc(var(--spacing) * 1);\n}\n\n.example-sigma-ui-carousel-plugin__content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: calc(var(--spacing) * 6);\n  aspect-ratio: 1;\n}\n\n.example-sigma-ui-carousel-plugin__number {\n  font-size: 2.25rem;\n  font-weight: 600;\n}\n\n.example-sigma-ui-carousel-plugin__item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: calc(var(--spacing) * 6);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  aspect-ratio: 1;\n  font-size: 2.25rem;\n  font-weight: 600;\n  user-select: none;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
