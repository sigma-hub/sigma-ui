{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-changelog",
  "type": "registry:block",
  "title": "What's new dialog",
  "description": "A release notes dialog with a version list, highlights, notes grouped by new, improved and fixed changes, and a preference to show it after updates.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "alert",
    "badge",
    "button",
    "dialog",
    "label",
    "switch"
  ],
  "files": [
    {
      "path": "blocks/dashboard-changelog/DashboardChangelog.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { MegaphoneIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport ChangelogDialog from './components/ChangelogDialog.vue';\nimport { currentVersion, pageDescription, pageTitle, releases } from './data';\n\nconst isDialogOpen = ref(false);\nconst showOnUpdate = ref(true);\nconst latestRelease = releases[0];\n</script>\n\n<template>\n  <div class=\"dashboard-changelog\">\n    <header class=\"dashboard-changelog__header\">\n      <h2 class=\"dashboard-changelog__title\">\n        {{ pageTitle }}\n      </h2>\n      <p class=\"dashboard-changelog__description\">\n        {{ pageDescription }}\n      </p>\n    </header>\n\n    <section\n      class=\"dashboard-changelog__summary\"\n      aria-label=\"Latest release\"\n    >\n      <span class=\"dashboard-changelog__summary-icon\">\n        <MegaphoneIcon class=\"dashboard-changelog__summary-glyph\" />\n      </span>\n      <div class=\"dashboard-changelog__summary-text\">\n        <div class=\"dashboard-changelog__summary-heading\">\n          <span class=\"dashboard-changelog__summary-version\">Version {{ currentVersion }}</span>\n          <Badge>New</Badge>\n          <span class=\"dashboard-changelog__summary-date\">{{ latestRelease.date }}</span>\n        </div>\n        <p class=\"dashboard-changelog__summary-highlight\">\n          {{ latestRelease.highlight }}\n        </p>\n      </div>\n      <Button @click=\"isDialogOpen = true\">\n        See what's new\n      </Button>\n    </section>\n\n    <ChangelogDialog\n      v-model:open=\"isDialogOpen\"\n      v-model:show-on-update=\"showOnUpdate\"\n      :releases=\"releases\"\n      :current-version=\"currentVersion\"\n    />\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-changelog {\n    display: flex;\n    width: 100%;\n    max-width: 48rem;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    margin-inline: auto;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-changelog__header {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-changelog__title {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.025em;\n    line-height: 2rem;\n  }\n\n  .dashboard-changelog__description {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-changelog__summary {\n    display: flex;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-changelog__summary-icon {\n    display: flex;\n    width: calc(var(--spacing) * 10);\n    height: calc(var(--spacing) * 10);\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    border-radius: var(--radius-md);\n    background-color: var(--muted);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-changelog__summary-glyph {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  .dashboard-changelog__summary-text {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-changelog__summary-heading {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-changelog__summary-version {\n    font-weight: 500;\n  }\n\n  .dashboard-changelog__summary-date {\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n\n  .dashboard-changelog__summary-highlight {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-changelog {\n      padding: calc(var(--spacing) * 6);\n    }\n\n    .dashboard-changelog__summary {\n      flex-direction: row;\n      align-items: center;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-changelog/components/ChangelogDialog.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref, watch } from 'vue';\nimport { BugIcon, InfoIcon, SparklesIcon, WrenchIcon } from '@lucide/vue';\nimport { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog';\nimport { Label } from '@/components/ui/label';\nimport { Switch } from '@/components/ui/switch';\nimport { changeTypeLabels } from '../data';\nimport type { ChangeType, Release } from '../data';\n\nconst props = defineProps<{\n  releases: Release[];\n  currentVersion: string;\n}>();\n\nconst open = defineModel<boolean>('open', { default: false });\nconst showOnUpdate = defineModel<boolean>('showOnUpdate', { default: true });\n\nconst selectedVersion = ref(props.currentVersion);\n\nconst changeIcons = {\n  added: SparklesIcon,\n  improved: WrenchIcon,\n  fixed: BugIcon,\n};\n\nwatch(open, (isOpen) => {\n  if (isOpen) {\n    selectedVersion.value = props.currentVersion;\n  }\n});\n\nfunction getRelease(version: string) {\n  return props.releases.find(release => release.version === version) ?? props.releases[0];\n}\n\nfunction getChangeLabel(type: ChangeType) {\n  return changeTypeLabels[type];\n}\n</script>\n\n<template>\n  <Dialog v-model:open=\"open\">\n    <DialogContent class=\"dashboard-changelog__dialog\">\n      <DialogHeader>\n        <DialogTitle>What's new</DialogTitle>\n        <DialogDescription>\n          Release notes for every version, newest first.\n        </DialogDescription>\n      </DialogHeader>\n\n      <div class=\"dashboard-changelog__body\">\n        <nav\n          aria-label=\"Releases\"\n          class=\"dashboard-changelog__releases\"\n        >\n          <button\n            v-for=\"release in releases\"\n            :key=\"release.version\"\n            type=\"button\"\n            class=\"dashboard-changelog__release-button\"\n            :data-active=\"release.version === selectedVersion\"\n            :aria-current=\"release.version === selectedVersion ? 'true' : undefined\"\n            @click=\"selectedVersion = release.version\"\n          >\n            <span class=\"dashboard-changelog__release-text\">\n              <span>{{ release.version }}</span>\n              <span class=\"dashboard-changelog__release-date\">{{ release.date }}</span>\n            </span>\n            <Badge\n              v-if=\"release.version === currentVersion\"\n              variant=\"outline\"\n            >\n              Current\n            </Badge>\n          </button>\n        </nav>\n\n        <article\n          class=\"dashboard-changelog__notes\"\n          :aria-label=\"`Version ${getRelease(selectedVersion).version} release notes`\"\n        >\n          <div class=\"dashboard-changelog__notes-heading\">\n            <h3 class=\"dashboard-changelog__notes-title\">\n              Version {{ getRelease(selectedVersion).version }}\n            </h3>\n            <p class=\"dashboard-changelog__notes-date\">\n              {{ getRelease(selectedVersion).date }}\n            </p>\n          </div>\n\n          <Alert>\n            <InfoIcon />\n            <AlertTitle>Highlights</AlertTitle>\n            <AlertDescription>{{ getRelease(selectedVersion).highlight }}</AlertDescription>\n          </Alert>\n\n          <section\n            v-for=\"section in getRelease(selectedVersion).sections\"\n            :key=\"section.type\"\n            class=\"dashboard-changelog__section\"\n          >\n            <h4 class=\"dashboard-changelog__section-title\">\n              <component\n                :is=\"changeIcons[section.type]\"\n                class=\"dashboard-changelog__section-icon\"\n              />\n              {{ getChangeLabel(section.type) }}\n            </h4>\n            <ul class=\"dashboard-changelog__items\">\n              <li\n                v-for=\"item in section.items\"\n                :key=\"item\"\n              >\n                {{ item }}\n              </li>\n            </ul>\n          </section>\n        </article>\n      </div>\n\n      <DialogFooter class=\"dashboard-changelog__footer\">\n        <div class=\"dashboard-changelog__preference\">\n          <Switch\n            id=\"dashboard-changelog-show-on-update\"\n            v-model=\"showOnUpdate\"\n          />\n          <Label for=\"dashboard-changelog-show-on-update\">\n            Show after each update\n          </Label>\n        </div>\n        <Button\n          variant=\"outline\"\n          @click=\"open = false\"\n        >\n          Close\n        </Button>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-changelog__body {\n    display: flex;\n    min-width: 0;\n    height: min(26rem, 60dvh);\n    flex-direction: column;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-changelog__releases {\n    display: flex;\n    max-width: 100%;\n    min-width: 0;\n    flex-shrink: 0;\n    overflow-x: auto;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-changelog__release-button {\n    display: flex;\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);\n    border: 0;\n    background: transparent;\n    border-radius: var(--radius-md);\n    color: inherit;\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 0.875rem;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1.25rem;\n    outline: none;\n    text-align: left;\n  }\n\n  .dashboard-changelog__release-button:hover {\n    background-color: var(--muted);\n  }\n\n  .dashboard-changelog__release-button:focus-visible {\n    box-shadow: 0 0 0 3px color-mix(in oklch, var(--ring) 50%, transparent);\n  }\n\n  .dashboard-changelog__release-button[data-active=\"true\"] {\n    background-color: var(--secondary);\n    font-weight: 500;\n  }\n\n  .dashboard-changelog__release-text {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .dashboard-changelog__release-date {\n    display: none;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    font-weight: 400;\n  }\n\n  .dashboard-changelog__notes {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n    overflow-y: auto;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-changelog__notes-heading {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 0.5);\n  }\n\n  .dashboard-changelog__notes-title {\n    margin: 0;\n    font-size: 1.125rem;\n    font-weight: 600;\n    line-height: 1.75rem;\n  }\n\n  .dashboard-changelog__notes-date {\n    margin: 0;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n\n  .dashboard-changelog__section {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-changelog__section-title {\n    display: flex;\n    align-items: center;\n    margin: 0;\n    font-size: 0.875rem;\n    font-weight: 600;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-changelog__section-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-changelog__items {\n    display: flex;\n    flex-direction: column;\n    padding: 0 0 0 calc(var(--spacing) * 9);\n    margin: 0;\n    font-size: 0.875rem;\n    gap: calc(var(--spacing) * 1.5);\n    list-style: disc;\n  }\n\n  .dashboard-changelog__items li::marker {\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-changelog__footer.dashboard-changelog__footer {\n    align-items: center;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-changelog__preference {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-changelog__dialog.dashboard-changelog__dialog {\n      max-width: 48rem;\n    }\n\n    .dashboard-changelog__body {\n      flex-direction: row;\n    }\n\n    .dashboard-changelog__releases {\n      width: 12rem;\n      flex-direction: column;\n      overflow: visible auto;\n    }\n\n    .dashboard-changelog__release-date {\n      display: inline;\n    }\n\n    .dashboard-changelog__notes {\n      padding-right: calc(var(--spacing) * 1);\n    }\n\n    .dashboard-changelog__footer.dashboard-changelog__footer {\n      justify-content: space-between;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-changelog/data.ts",
      "content": "export type ChangeType = 'added' | 'improved' | 'fixed';\n\nexport interface ChangeSection {\n  type: ChangeType;\n  items: string[];\n}\n\nexport interface Release {\n  version: string;\n  /** Display date, already formatted. */\n  date: string;\n  highlight: string;\n  sections: ChangeSection[];\n}\n\nexport const pageTitle = 'Product updates';\nexport const pageDescription = 'See what changed in each release and decide how you hear about new ones.';\nexport const currentVersion = '2.4.0';\n\nexport const changeTypeLabels: Record<ChangeType, string> = {\n  added: 'New',\n  improved: 'Improved',\n  fixed: 'Fixed',\n};\n\nexport const releases: Release[] = [\n  {\n    version: '2.4.0',\n    date: 'October 14, 2026',\n    highlight: 'Saved views let you keep your favorite filters one click away, and exports are now twice as fast.',\n    sections: [\n      {\n        type: 'added',\n        items: [\n          'Saved views for tables, with sharing links for your team.',\n          'Bulk edit for up to 500 items at once.',\n          'Keyboard shortcut cheat sheet, opened with the question mark key.',\n        ],\n      },\n      {\n        type: 'improved',\n        items: [\n          'CSV and PDF exports finish about twice as fast on large workspaces.',\n          'Search results now highlight the matching words.',\n        ],\n      },\n      {\n        type: 'fixed',\n        items: [\n          'Dates in the activity list no longer shift by a day in some time zones.',\n          'The sidebar stays collapsed after a reload when you collapse it.',\n        ],\n      },\n    ],\n  },\n  {\n    version: '2.3.2',\n    date: 'September 29, 2026',\n    highlight: 'A small maintenance release that fixes sign-in and notification issues.',\n    sections: [\n      {\n        type: 'fixed',\n        items: [\n          'Single sign-on no longer asks twice for a verification code.',\n          'Email digests are sent at the time chosen in settings.',\n          'Long project names are truncated instead of overlapping the menu.',\n        ],\n      },\n    ],\n  },\n  {\n    version: '2.3.0',\n    date: 'September 8, 2026',\n    highlight: 'Teams can now work in dark mode, and the new audit log tracks every change in your workspace.',\n    sections: [\n      {\n        type: 'added',\n        items: [\n          'Dark mode with an automatic option that follows your system.',\n          'Audit log with filters for people, actions and dates.',\n        ],\n      },\n      {\n        type: 'improved',\n        items: [\n          'Notifications are grouped by project to reduce noise.',\n          'Faster loading of the dashboard on slow connections.',\n        ],\n      },\n    ],\n  },\n  {\n    version: '2.2.0',\n    date: 'August 11, 2026',\n    highlight: 'Comments and mentions arrive, along with a refreshed onboarding flow.',\n    sections: [\n      {\n        type: 'added',\n        items: [\n          'Comments with mentions on every item.',\n          'A guided checklist for new workspaces.',\n        ],\n      },\n      {\n        type: 'fixed',\n        items: [\n          'Attachments larger than 20 MB upload reliably.',\n        ],\n      },\n    ],\n  },\n  {\n    version: '2.1.0',\n    date: 'July 7, 2026',\n    highlight: 'Roles and permissions give admins finer control over who can change what.',\n    sections: [\n      {\n        type: 'added',\n        items: [\n          'Custom roles with per-project permissions.',\n          'Invite links that expire after a chosen time.',\n        ],\n      },\n      {\n        type: 'improved',\n        items: [\n          'The member list supports sorting and bulk removal.',\n        ],\n      },\n    ],\n  },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "900px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
