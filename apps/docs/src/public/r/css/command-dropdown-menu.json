{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-dropdown-menu",
  "type": "registry:example",
  "title": "CommandDropdownMenu",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "button",
    "command",
    "dropdown-menu"
  ],
  "files": [
    {
      "path": "example/CommandDropdownMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { CalendarIcon, MoreHorizontalIcon, TagsIcon, TrashIcon, UserIcon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport {\n  Command,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n} from '@/components/ui/command';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuShortcut,\n  DropdownMenuSub,\n  DropdownMenuSubContent,\n  DropdownMenuSubTrigger,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\n\nconst labels = [\n  'feature',\n  'bug',\n  'enhancement',\n  'documentation',\n  'design',\n  'question',\n  'maintenance',\n];\n\nconst labelRef = ref('feature');\nconst open = ref(false);\n</script>\n\n<template>\n  <div class=\"example-sigma-ui-command-dropdown\">\n    <p class=\"example-sigma-ui-command-dropdown__text\">\n      <span class=\"example-sigma-ui-command-dropdown__label\">\n        {{ labelRef }}\n      </span>\n      <span class=\"example-sigma-ui-command-dropdown__description\">Create a new project</span>\n    </p>\n    <DropdownMenu v-model:open=\"open\">\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n        >\n          <MoreHorizontalIcon />\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent\n        align=\"end\"\n        class=\"example-sigma-ui-command-dropdown__content\"\n      >\n        <DropdownMenuLabel>Actions</DropdownMenuLabel>\n        <DropdownMenuGroup>\n          <DropdownMenuItem>\n            <UserIcon class=\"example-sigma-ui-command-dropdown__icon\" />\n            Assign to...\n          </DropdownMenuItem>\n          <DropdownMenuItem>\n            <CalendarIcon class=\"example-sigma-ui-command-dropdown__icon\" />\n            Set due date...\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuSub>\n            <DropdownMenuSubTrigger>\n              <TagsIcon class=\"example-sigma-ui-command-dropdown__icon\" />\n              Apply label\n            </DropdownMenuSubTrigger>\n            <DropdownMenuSubContent class=\"example-sigma-ui-command-dropdown__sub-content\">\n              <Command>\n                <CommandInput\n                  placeholder=\"Filter label...\"\n                  auto-focus\n                />\n                <CommandList>\n                  <CommandEmpty>No label found.</CommandEmpty>\n                  <CommandGroup>\n                    <CommandItem\n                      v-for=\"label in labels\"\n                      :key=\"label\"\n                      :value=\"label\"\n                      @select=\"(event) => {\n                        labelRef = event.detail.value as string\n                        open = false\n                      }\"\n                    >\n                      {{ label }}\n                    </CommandItem>\n                  </CommandGroup>\n                </CommandList>\n              </Command>\n            </DropdownMenuSubContent>\n          </DropdownMenuSub>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem class=\"example-sigma-ui-command-dropdown__delete\">\n            <TrashIcon class=\"example-sigma-ui-command-dropdown__icon\" />\n            Delete\n            <DropdownMenuShortcut>⌘⌫</DropdownMenuShortcut>\n          </DropdownMenuItem>\n        </DropdownMenuGroup>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .example-sigma-ui-command-dropdown {\n    display: flex;\n    width: 100%;\n    flex-direction: column;\n    align-items: flex-start;\n    justify-content: space-between;\n    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n  }\n\n  @media (width >= 40rem) {\n    .example-sigma-ui-command-dropdown {\n      flex-direction: row;\n      align-items: center;\n    }\n  }\n\n  .example-sigma-ui-command-dropdown__text {\n    font-size: 0.875rem;\n    font-weight: 500;\n    line-height: 1;\n  }\n\n  .example-sigma-ui-command-dropdown__label {\n    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);\n    border-radius: var(--radius-lg);\n    margin-right: calc(var(--spacing) * 2);\n    background-color: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 0.75rem;\n  }\n\n  .example-sigma-ui-command-dropdown__description {\n    color: var(--muted-foreground);\n  }\n\n  .example-sigma-ui-command-dropdown__content {\n    width: 200px;\n  }\n\n  .example-sigma-ui-command-dropdown__icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    margin-right: calc(var(--spacing) * 2);\n  }\n\n  .example-sigma-ui-command-dropdown__sub-content {\n    padding: 0;\n  }\n\n  .example-sigma-ui-command-dropdown__delete {\n    color: var(--destructive);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
