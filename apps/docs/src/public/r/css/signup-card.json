{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "signup-card",
  "type": "registry:block",
  "title": "Sign up card",
  "description": "A sign up form with first name, last name, email and password inside a card. There's an option to sign up with GitHub and a link to login if you already have an account",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/signup-card/SignupCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Card class=\"signup-card__card\">\n    <CardHeader>\n      <CardTitle class=\"signup-card__title\">\n        Sign Up\n      </CardTitle>\n      <CardDescription>\n        Enter your information to create an account\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"signup-card__form\">\n        <div class=\"signup-card__name-row\">\n          <div class=\"signup-card__field\">\n            <Label for=\"first-name\">First name</Label>\n            <Input\n              id=\"first-name\"\n              autocomplete=\"given-name\"\n              placeholder=\"Max\"\n              required\n            />\n          </div>\n          <div class=\"signup-card__field\">\n            <Label for=\"last-name\">Last name</Label>\n            <Input\n              id=\"last-name\"\n              autocomplete=\"family-name\"\n              placeholder=\"Robinson\"\n              required\n            />\n          </div>\n        </div>\n        <div class=\"signup-card__field\">\n          <Label for=\"email\">Email</Label>\n          <Input\n            id=\"email\"\n            autocomplete=\"email\"\n            type=\"email\"\n            placeholder=\"m@example.com\"\n            required\n          />\n        </div>\n        <div class=\"signup-card__field\">\n          <Label for=\"password\">Password</Label>\n          <Input\n            id=\"password\"\n            autocomplete=\"new-password\"\n            type=\"password\"\n          />\n        </div>\n        <Button\n          type=\"submit\"\n          class=\"signup-card__button\"\n        >\n          Create an account\n        </Button>\n        <Button\n          variant=\"outline\"\n          class=\"signup-card__button\"\n        >\n          Sign up with GitHub\n        </Button>\n      </div>\n      <div class=\"signup-card__footer\">\n        Already have an account?\n        <a\n          href=\"#\"\n          class=\"signup-card__link\"\n        >\n          Sign in\n        </a>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n.signup-card__card {\n  max-width: 24rem;\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.signup-card__title {\n  font-size: 1.25rem;\n  line-height: 1.75rem;\n}\n\n.signup-card__form {\n  display: grid;\n  gap: calc(var(--spacing) * 4);\n}\n\n.signup-card__name-row {\n  display: grid;\n  gap: calc(var(--spacing) * 4);\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.signup-card__field {\n  display: grid;\n  gap: calc(var(--spacing) * 2);\n}\n\n.signup-card__button {\n  width: 100%;\n}\n\n.signup-card__footer {\n  margin-top: calc(var(--spacing) * 4);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  text-align: center;\n}\n\n.signup-card__link {\n  color: inherit;\n  text-decoration: underline;\n}\n</style>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "600px",
    "containerClass": "w-full h-screen flex items-center justify-center px-4"
  },
  "categories": [
    "authentication",
    "signup"
  ]
}
