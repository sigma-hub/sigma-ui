      "path": "blocks/dashboard-orders/components/OrdersTable.vue",
      "content": "<script setup lang=\"ts\">\nimport { FileIcon, ListFilterIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from '@/components/ui/tabs';\nimport type { Order, OrderColumns, OrderTab, OrdersTableCopy } from '../data';\n\ndefineProps<{\n  tabs: OrderTab[];\n  activeTab: string;\n  filters: string[];\n  orders: Order[];\n  columns: OrderColumns;\n  copy: OrdersTableCopy;\n}>();\n</script>\n\n<template>\n  <Tabs :default-value=\"activeTab\">\n    <div class=\"dashboard-orders__toolbar\">\n      <TabsList>\n        <TabsTrigger\n          v-for=\"tab in tabs\"\n          :key=\"tab.value\"\n          :value=\"tab.value\"\n        >\n          {{ tab.label }}\n        </TabsTrigger>\n      </TabsList>\n      <div class=\"dashboard-orders__toolbar-actions\">\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              class=\"dashboard-orders__toolbar-button\"\n            >\n              <ListFilterIcon />\n              <span class=\"dashboard-orders__action-label\">{{ copy.filter }}</span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <DropdownMenuLabel>{{ copy.filterBy }}</DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem\n              v-for=\"filter in filters\"\n              :key=\"filter\"\n            >\n              <div class=\"dashboard-orders__filter-option\">\n                <Checkbox id=\"terms1\" />\n                <label\n                  for=\"terms2\"\n                  class=\"dashboard-orders__filter-label\"\n                >\n                  {{ filter }}\n                </label>\n              </div>\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          class=\"dashboard-orders__toolbar-button\"\n        >\n          <FileIcon />\n          <span class=\"dashboard-orders__action-label\">{{ copy.export }}</span>\n        </Button>\n      </div>\n    </div>\n    <TabsContent :value=\"activeTab\">\n      <Card>\n        <CardHeader class=\"dashboard-orders__table-header\">\n          <CardTitle>{{ copy.title }}</CardTitle>\n          <CardDescription>\n            {{ copy.description }}\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <Table>\n            <TableHeader>\n              <TableRow>\n                <TableHead>{{ columns.customer }}</TableHead>\n                <TableHead class=\"dashboard-orders__cell--from-sm\">\n                  {{ columns.type }}\n                </TableHead>\n                <TableHead class=\"dashboard-orders__cell--from-sm\">\n                  {{ columns.status }}\n                </TableHead>\n                <TableHead class=\"dashboard-orders__cell--from-md\">\n                  {{ columns.date }}\n                </TableHead>\n                <TableHead class=\"dashboard-orders__cell--end\">\n                  {{ columns.amount }}\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              <TableRow\n                v-for=\"(order, orderIndex) in orders\"\n                :key=\"orderIndex\"\n                :class=\"{ 'dashboard-orders__row--selected': order.isSelected }\"\n              >\n                <TableCell>\n                  <div class=\"dashboard-orders__customer-name\">\n                    {{ order.customer }}\n                  </div>\n                  <div class=\"dashboard-orders__email\">\n                    {{ order.email }}\n                  </div>\n                </TableCell>\n                <TableCell class=\"dashboard-orders__cell--from-sm\">\n                  {{ order.type }}\n                </TableCell>\n                <TableCell class=\"dashboard-orders__cell--from-sm\">\n                  <Badge :variant=\"order.badgeVariant\">\n                    {{ order.status }}\n                  </Badge>\n                </TableCell>\n                <TableCell class=\"dashboard-orders__cell--from-md\">\n                  {{ order.date }}\n                </TableCell>\n                <TableCell class=\"dashboard-orders__cell--end\">\n                  {{ order.amount }}\n                </TableCell>\n              </TableRow>\n            </TableBody>\n          </Table>\n        </CardContent>\n      </Card>\n    </TabsContent>\n  </Tabs>\n</template>\n\n<style>\n.dashboard-orders__toolbar {\n  display: flex;\n  align-items: center;\n}\n\n.dashboard-orders__toolbar-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-left: auto;\n}\n\n.dashboard-orders .dashboard-orders__toolbar-button {\n  height: 1.75rem;\n  gap: 0.25rem;\n  border-radius: calc(var(--radius) - 2px);\n  padding-right: 0.75rem;\n  padding-left: 0.75rem;\n}\n\n.dashboard-orders .dashboard-orders__toolbar-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n.dashboard-orders__action-label {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__action-label {\n    position: static;\n    width: auto;\n    height: auto;\n    margin: 0;\n    overflow: visible;\n    clip: auto;\n    white-space: normal;\n  }\n}\n\n.dashboard-orders__filter-option {\n  display: flex;\n}\n\n.dashboard-orders__filter-option > * + * {\n  margin-left: 0.5rem;\n}\n\n.dashboard-orders__filter-label {\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1;\n}\n\n.dashboard-orders .dashboard-orders__table-header {\n  padding-right: 1.75rem;\n  padding-left: 1.75rem;\n}\n\n.dashboard-orders__cell--from-sm,\n.dashboard-orders__cell--from-md {\n  display: none;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__cell--from-sm {\n    display: table-cell;\n  }\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__cell--from-md {\n    display: table-cell;\n  }\n}\n\n.dashboard-orders .dashboard-orders__cell--end {\n  text-align: right;\n}\n\n.dashboard-orders__customer-name {\n  font-weight: 500;\n}\n\n.dashboard-orders__email {\n  display: none;\n  color: hsl(var(--muted-foreground));\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__email {\n    display: inline;\n  }\n}\n\n.dashboard-orders__row--selected {\n  background-color: hsl(var(--secondary));\n}\n</style>\n",
      "type": "registry:component"
    },
