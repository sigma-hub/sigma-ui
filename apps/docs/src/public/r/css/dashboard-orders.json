      "path": "blocks/dashboard-orders/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  HomeIcon,\n  LineChartIcon,\n  PackageIcon,\n  SettingsIcon,\n  ShoppingCartIcon,\n  Users2Icon,\n} from 'lucide-vue-next';\n\nexport interface NavItem {\n  label: string;\n  icon: Component;\n  isActive?: boolean;\n}\n\nexport interface StatCard {\n  description: string;\n  value: string;\n  valueSize: 'large' | 'default';\n  change: string;\n  progress: number;\n  progressLabel: string;\n}\n\nexport type OrderStatus = 'Fulfilled' | 'Declined';\n\nexport interface Order {\n  customer: string;\n  email: string;\n  type: string;\n  status: OrderStatus;\n  badgeVariant: 'outline' | 'secondary';\n  date: string;\n  amount: string;\n  isSelected?: boolean;\n}\n\nexport interface OrderTab {\n  value: string;\n  label: string;\n}\n\nexport interface HeaderCopy {\n  toggleMenu: string;\n  searchPlaceholder: string;\n  toggleAccount: string;\n  accountLabel: string;\n}\n\nexport interface OrdersIntro {\n  title: string;\n  description: string;\n  action: string;\n}\n\nexport interface OrdersTableCopy {\n  title: string;\n  description: string;\n  filter: string;\n  filterBy: string;\n  export: string;\n}\n\nexport interface OrderColumns {\n  customer: string;\n  type: string;\n  status: string;\n  date: string;\n  amount: string;\n}\n\nexport interface OrderDetailCopy {\n  id: string;\n  date: string;\n  copyId: string;\n  trackOrder: string;\n  more: string;\n  details: string;\n  shipping: string;\n  billing: string;\n  customer: string;\n  payment: string;\n  updated: string;\n}\n\nexport interface SelectedOrder {\n  id: string;\n  date: string;\n  updatedAt: {\n    dateTime: string;\n    label: string;\n  };\n}\n\nexport interface PaymentMethod {\n  brand: string;\n  maskedNumber: string;\n}\n\nexport interface OrderLineItem {\n  name: string;\n  quantity: number;\n  price: string;\n}\n\nexport interface OrderSummaryLine {\n  label: string;\n  value: string;\n  isTotal?: boolean;\n}\n\nexport interface