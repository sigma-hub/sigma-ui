{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-orders",
  "type": "registry:block",
  "title": "Orders dashboard",
  "description": "An orders dashboard with a sidebar navigation. The sidebar has icon navigation. The content area has a breadcrumb and search in the header. The main area has a list of recent orders with a filter and export button. The main area also has a detailed view of a single order with order details, shipping information, billing information, customer information, and payment information.",
  "dependencies": [
    "lucide-vue-next@^0.475.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "checkbox",
    "dropdown-menu",
    "input",
    "pagination",
    "progress",
    "separator",
    "sheet",
    "table",
    "tabs",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-orders/DashboardOrders.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport OrderDetails from './components/OrderDetails.vue';\nimport OrdersSummary from './components/OrdersSummary.vue';\nimport OrdersTable from './components/OrdersTable.vue';\nimport {\n  accountMenuGroups,\n  billingInformation,\n  brandName,\n  breadcrumbLinks,\n  breadcrumbPage,\n  customerFields,\n  defaultOrderTab,\n  headerCopy,\n  mobileNavItems,\n  orderActionGroups,\n  orderColumns,\n  orderDetailCopy,\n  orderFilters,\n  orderLineItems,\n  orderSummaryLines,\n  orderTabs,\n  orders,\n  ordersIntro,\n  ordersTableCopy,\n  paginationPageSize,\n  paymentMethod,\n  selectedOrder,\n  shippingAddressLines,\n  sidebarFooterItems,\n  sidebarNavItems,\n  statCards,\n} from './data';\n</script>\n\n<template>\n  <div class=\"dashboard-orders\">\n    <AppSidebar\n      :nav-items=\"sidebarNavItems\"\n      :footer-items=\"sidebarFooterItems\"\n      :brand-name=\"brandName\"\n    />\n    <div class=\"dashboard-orders__shell\">\n      <AppHeader\n        :mobile-nav-items=\"mobileNavItems\"\n        :breadcrumb-links=\"breadcrumbLinks\"\n        :breadcrumb-page=\"breadcrumbPage\"\n        :account-menu-groups=\"accountMenuGroups\"\n        :brand-name=\"brandName\"\n        :header=\"headerCopy\"\n      />\n      <main class=\"dashboard-orders__main\">\n        <div class=\"dashboard-orders__primary\">\n          <OrdersSummary\n            :intro=\"ordersIntro\"\n            :stat-cards=\"statCards\"\n          />\n          <OrdersTable\n            :tabs=\"orderTabs\"\n            :active-tab=\"defaultOrderTab\"\n            :filters=\"orderFilters\"\n            :orders=\"orders\"\n            :columns=\"orderColumns\"\n            :copy=\"ordersTableCopy\"\n          />\n        </div>\n        <div>\n          <OrderDetails\n            :order=\"selectedOrder\"\n            :action-groups=\"orderActionGroups\"\n            :line-items=\"orderLineItems\"\n            :summary-lines=\"orderSummaryLines\"\n            :shipping-address-lines=\"shippingAddressLines\"\n            :billing-information=\"billingInformation\"\n            :customer-fields=\"customerFields\"\n            :payment-method=\"paymentMethod\"\n            :page-size=\"paginationPageSize\"\n            :copy=\"orderDetailCopy\"\n          />\n        </div>\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-orders {\n  display: flex;\n  min-height: 100vh;\n  width: 100%;\n  flex-direction: column;\n  background-color: hsl(var(--muted) / 40%);\n}\n\n.dashboard-orders__shell {\n  display: flex;\n  flex-direction: column;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__shell {\n    gap: 1rem;\n    padding-top: 1rem;\n    padding-bottom: 1rem;\n    padding-left: 3.5rem;\n  }\n}\n\n.dashboard-orders__main {\n  display: grid;\n  flex: 1 1 0%;\n  align-items: flex-start;\n  gap: 1rem;\n  padding: 1rem;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__main {\n    padding-top: 0;\n    padding-right: 1.5rem;\n    padding-bottom: 0;\n    padding-left: 1.5rem;\n  }\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__main {\n    gap: 2rem;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-orders__main {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n\n.dashboard-orders__primary {\n  display: grid;\n  grid-auto-rows: max-content;\n  align-items: flex-start;\n  gap: 1rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__primary {\n    gap: 2rem;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-orders__primary {\n    grid-column: span 2 / span 2;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { HeaderCopy, NavItem } from '../data';\n\ndefineProps<{\n  mobileNavItems: NavItem[];\n  breadcrumbLinks: string[];\n  breadcrumbPage: string;\n  accountMenuGroups: string[][];\n  brandName: string;\n  header: HeaderCopy;\n}>();\n</script>\n\n<template>\n  <header class=\"dashboard-orders__header\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"dashboard-orders__menu-button\"\n        >\n          <PanelLeftIcon />\n          <span class=\"dashboard-orders__sr-only\">{{ header.toggleMenu }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"dashboard-orders__sheet\"\n      >\n        <nav class=\"dashboard-orders__mobile-nav\">\n          <a\n            href=\"#\"\n            class=\"dashboard-orders__mobile-brand\"\n          >\n            <Package2Icon />\n            <span class=\"dashboard-orders__sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"dashboard-orders__mobile-link\"\n            :class=\"{ 'dashboard-orders__mobile-link--active': item.isActive }\"\n          >\n            <component :is=\"item.icon\" />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"dashboard-orders__breadcrumb\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a href=\"#\">{{ link }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"dashboard-orders__search\">\n      <SearchIcon />\n      <Input\n        type=\"search\"\n        :placeholder=\"header.searchPlaceholder\"\n        class=\"dashboard-orders__search-input\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"dashboard-orders__account-button\"\n        >\n          <CircleUserIcon />\n          <span class=\"dashboard-orders__sr-only\">{{ header.toggleAccount }}</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>{{ header.accountLabel }}</DropdownMenuLabel>\n        <template\n          v-for=\"(group, groupIndex) in accountMenuGroups\"\n          :key=\"groupIndex\"\n        >\n          <DropdownMenuSeparator />\n          <DropdownMenuItem\n            v-for=\"item in group\"\n            :key=\"item\"\n          >\n            {{ item }}\n          </DropdownMenuItem>\n        </template>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n\n<style>\n.dashboard-orders__header {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  display: flex;\n  height: 3.5rem;\n  align-items: center;\n  gap: 1rem;\n  border-bottom: 1px solid hsl(var(--border));\n  background-color: hsl(var(--background));\n  padding-right: 1rem;\n  padding-left: 1rem;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__header {\n    position: static;\n    height: auto;\n    border-bottom-width: 0;\n    background-color: transparent;\n    padding-right: 1.5rem;\n    padding-left: 1.5rem;\n  }\n}\n\n.dashboard-orders .dashboard-orders__menu-button svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders .dashboard-orders__menu-button {\n    display: none;\n  }\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__sheet.dashboard-orders__sheet {\n    max-width: 20rem;\n  }\n}\n\n.dashboard-orders__mobile-nav {\n  display: grid;\n  gap: 1.5rem;\n  font-size: 1.125rem;\n  font-weight: 500;\n  line-height: 1.75rem;\n}\n\n.dashboard-orders__mobile-brand {\n  display: flex;\n  width: 2.5rem;\n  height: 2.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  border-radius: 9999px;\n  background-color: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__mobile-brand {\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n}\n\n.dashboard-orders__mobile-brand svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-orders__mobile-brand:hover svg {\n  transform: scale(1.1);\n}\n\n.dashboard-orders__mobile-link {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding-right: 0.625rem;\n  padding-left: 0.625rem;\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-orders__mobile-link:hover,\n.dashboard-orders__mobile-link--active,\n.dashboard-orders__mobile-link--active:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-orders__mobile-link svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-orders__breadcrumb {\n  display: none;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__breadcrumb {\n    display: flex;\n  }\n}\n\n.dashboard-orders__search {\n  position: relative;\n  margin-left: auto;\n  flex: 1 1 0%;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__search {\n    flex-grow: 0;\n  }\n}\n\n.dashboard-orders__search svg {\n  position: absolute;\n  top: 0.625rem;\n  left: 0.625rem;\n  width: 1rem;\n  height: 1rem;\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-orders .dashboard-orders__search-input {\n  width: 100%;\n  border-radius: var(--radius);\n  background-color: hsl(var(--background));\n  padding-left: 2rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders .dashboard-orders__search-input {\n    width: 200px;\n  }\n}\n\n@media (width >= 1024px) {\n  .dashboard-orders .dashboard-orders__search-input {\n    width: 336px;\n  }\n}\n\n.dashboard-orders .dashboard-orders__account-button {\n  border-radius: 9999px;\n}\n\n.dashboard-orders .dashboard-orders__account-button svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-orders__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from 'lucide-vue-next';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport type { NavItem } from '../data';\n\ndefineProps<{\n  navItems: NavItem[];\n  footerItems: NavItem[];\n  brandName: string;\n}>();\n</script>\n\n<template>\n  <aside class=\"dashboard-orders__sidebar\">\n    <nav class=\"dashboard-orders__sidebar-nav\">\n      <a\n        href=\"#\"\n        class=\"dashboard-orders__brand\"\n      >\n        <Package2Icon />\n        <span class=\"dashboard-orders__sr-only\">{{ brandName }}</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in navItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-orders__nav-link\"\n              :class=\"{ 'dashboard-orders__nav-link--active': item.isActive }\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-orders__sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"dashboard-orders__sidebar-footer\">\n      <TooltipProvider\n        v-for=\"item in footerItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-orders__nav-link\"\n              :class=\"{ 'dashboard-orders__nav-link--active': item.isActive }\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-orders__sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n\n<style>\n.dashboard-orders__sidebar {\n  position: fixed;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  z-index: 10;\n  display: none;\n  width: 3.5rem;\n  flex-direction: column;\n  border-right: 1px solid hsl(var(--border));\n  background-color: hsl(var(--background));\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__sidebar {\n    display: flex;\n  }\n}\n\n.dashboard-orders__sidebar-nav,\n.dashboard-orders__sidebar-footer {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 1rem;\n  padding-right: 0.5rem;\n  padding-left: 0.5rem;\n}\n\n.dashboard-orders__sidebar-footer {\n  margin-top: auto;\n}\n\n@media (width >= 640px) {\n  .dashboard-orders__sidebar-nav,\n  .dashboard-orders__sidebar-footer {\n    padding-top: 1.25rem;\n    padding-bottom: 1.25rem;\n  }\n}\n\n.dashboard-orders__brand {\n  display: flex;\n  width: 2.25rem;\n  height: 2.25rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  border-radius: 9999px;\n  background-color: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n  font-size: 1.125rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__brand {\n    width: 2rem;\n    height: 2rem;\n    font-size: 1rem;\n    line-height: 1.5rem;\n  }\n}\n\n.dashboard-orders__brand svg {\n  width: 1rem;\n  height: 1rem;\n  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-orders__brand:hover svg {\n  transform: scale(1.1);\n}\n\n.dashboard-orders__nav-link {\n  display: flex;\n  width: 2.25rem;\n  height: 2.25rem;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius);\n  color: hsl(var(--muted-foreground));\n  transition-duration: 150ms;\n  transition-property: color, background-color, border-color;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-orders__nav-link:hover {\n  color: hsl(var(--foreground));\n}\n\n.dashboard-orders__nav-link--active {\n  background-color: hsl(var(--secondary));\n  color: hsl(var(--secondary-foreground));\n}\n\n@media (width >= 768px) {\n  .dashboard-orders__nav-link {\n    width: 2rem;\n    height: 2rem;\n  }\n}\n\n.dashboard-orders__nav-link svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n.dashboard-orders__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/OrderDetails.vue",
      "content": "<script setup lang=\"ts\">\nimport { CopyIcon, CreditCardIcon, MoreVerticalIcon, TruckIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Pagination,\n  PaginationList,\n  PaginationNext,\n  PaginationPrev,\n} from '@/components/ui/pagination';\nimport { Separator } from '@/components/ui/separator';\nimport type { CustomerField, OrderDetailCopy, OrderLineItem, OrderSummaryLine, PaymentMethod, SelectedOrder } from '../data';\n\ndefineProps<{\n  order: SelectedOrder;\n  actionGroups: string[][];\n  lineItems: OrderLineItem[];\n  summaryLines: OrderSummaryLine[];\n  shippingAddressLines: string[];\n  billingInformation: string;\n  customerFields: CustomerField[];\n  paymentMethod: PaymentMethod;\n  pageSize: number;\n  copy: OrderDetailCopy;\n}>();\n</script>\n\n<template>\n  <Card class=\"dashboard-orders__detail-card\">\n    <CardHeader class=\"dashboard-orders__detail-header\">\n      <div class=\"dashboard-orders__detail-heading\">\n        <CardTitle class=\"dashboard-orders__detail-title\">\n          {{ copy.id }} {{ order.id }}\n          <Button\n            size=\"icon\"\n            variant=\"outline\"\n            class=\"dashboard-orders__copy-button\"\n          >\n            <CopyIcon />\n            <span class=\"dashboard-orders__sr-only\">{{ copy.copyId }}</span>\n          </Button>\n        </CardTitle>\n        <CardDescription>{{ copy.date }} {{ order.date }}</CardDescription>\n      </div>\n      <div class=\"dashboard-orders__detail-actions\">\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          class=\"dashboard-orders__track-button\"\n        >\n          <TruckIcon />\n          <span class=\"dashboard-orders__track-label\">\n            {{ copy.trackOrder }}\n          </span>\n        </Button>\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              size=\"icon\"\n              variant=\"outline\"\n              class=\"dashboard-orders__more-button\"\n            >\n              <MoreVerticalIcon />\n              <span class=\"dashboard-orders__sr-only\">{{ copy.more }}</span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <template\n              v-for=\"(group, groupIndex) in actionGroups\"\n              :key=\"groupIndex\"\n            >\n              <DropdownMenuSeparator v-if=\"groupIndex > 0\" />\n              <DropdownMenuItem\n                v-for=\"item in group\"\n                :key=\"item\"\n              >\n                {{ item }}\n              </DropdownMenuItem>\n            </template>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </div>\n    </CardHeader>\n    <CardContent class=\"dashboard-orders__detail-content\">\n      <div class=\"dashboard-orders__stack\">\n        <div class=\"dashboard-orders__section-title\">\n          {{ copy.details }}\n        </div>\n        <ul class=\"dashboard-orders__lines\">\n          <li\n            v-for=\"item in lineItems\"\n            :key=\"item.name\"\n            class=\"dashboard-orders__line\"\n          >\n            <span class=\"dashboard-orders__muted\">\n              {{ item.name }} x <span>{{ item.quantity }}</span>\n            </span>\n            <span>{{ item.price }}</span>\n          </li>\n        </ul>\n        <Separator class=\"dashboard-orders__separator--tight\" />\n        <ul class=\"dashboard-orders__lines\">\n          <li\n            v-for=\"line in summaryLines\"\n            :key=\"line.label\"\n            class=\"dashboard-orders__line\"\n            :class=\"{ 'dashboard-orders__line--total': line.isTotal }\"\n          >\n            <span class=\"dashboard-orders__muted\">{{ line.label }}</span>\n            <span>{{ line.value }}</span>\n          </li>\n        </ul>\n      </div>\n      <Separator class=\"dashboard-orders__separator\" />\n      <div class=\"dashboard-orders__split\">\n        <div class=\"dashboard-orders__stack\">\n          <div class=\"dashboard-orders__section-title\">\n            {{ copy.shipping }}\n          </div>\n          <address class=\"dashboard-orders__address\">\n            <span\n              v-for=\"line in shippingAddressLines\"\n              :key=\"line\"\n            >{{ line }}</span>\n          </address>\n        </div>\n        <div class=\"dashboard-orders__billing\">\n          <div class=\"dashboard-orders__section-title\">\n            {{ copy.billing }}\n          </div>\n          <div class=\"dashboard-orders__muted\">\n            {{ billingInformation }}\n          </div>\n        </div>\n      </div>\n      <Separator class=\"dashboard-orders__separator\" />\n      <div class=\"dashboard-orders__stack\">\n        <div class=\"dashboard-orders__section-title\">\n          {{ copy.customer }}\n        </div>\n        <dl class=\"dashboard-orders__lines\">\n          <div\n            v-for=\"field in customerFields\"\n            :key=\"field.label\"\n            class=\"dashboard-orders__line\"\n          >\n            <dt class=\"dashboard-orders__muted\">\n              {{ field.label }}\n            </dt>\n            <dd>\n              <a\n                v-if=\"field.href\"\n                :href=\"field.href\"\n              >{{ field.value }}</a>\n              <template v-else>\n                {{ field.value }}\n              </template>\n            </dd>\n          </div>\n        </dl>\n      </div>\n      <Separator class=\"dashboard-orders__separator\" />\n      <div class=\"dashboard-orders__stack\">\n        <div class=\"dashboard-orders__section-title\">\n          {{ copy.payment }}\n        </div>\n        <dl class=\"dashboard-orders__lines\">\n          <div class=\"dashboard-orders__line\">\n            <dt class=\"dashboard-orders__payment-brand\">\n              <CreditCardIcon />\n              {{ paymentMethod.brand }}\n            </dt>\n            <dd>{{ paymentMethod.maskedNumber }}</dd>\n          </div>\n        </dl>\n      </div>\n    </CardContent>\n    <CardFooter class=\"dashboard-orders__detail-footer\">\n      <div class=\"dashboard-orders__updated\">\n        {{ copy.updated }} <time :datetime=\"order.updatedAt.dateTime\">{{ order.updatedAt.label }}</time>\n      </div>\n      <Pagination\n        class=\"dashboard-orders__pagination\"\n        :items-per-page=\"pageSize\"\n      >\n        <PaginationList class=\"dashboard-orders__pagination-list\">\n          <PaginationPrev\n            variant=\"outline\"\n            class=\"dashboard-orders__page-button\"\n          />\n          <PaginationNext\n            variant=\"outline\"\n            class=\"dashboard-orders__page-button\"\n          />\n        </PaginationList>\n      </Pagination>\n    </CardFooter>\n  </Card>\n</template>\n\n<style>\n.dashboard-orders__detail-card {\n  overflow: hidden;\n}\n\n.dashboard-orders .dashboard-orders__detail-header {\n  flex-direction: row;\n  align-items: flex-start;\n  background-color: hsl(var(--muted) / 50%);\n}\n\n.dashboard-orders__detail-heading {\n  display: grid;\n  gap: 0.125rem;\n}\n\n.dashboard-orders .dashboard-orders__detail-title {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n}\n\n.dashboard-orders .dashboard-orders__copy-button {\n  width: 1.5rem;\n  height: 1.5rem;\n  opacity: 0;\n  transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.dashboard-orders .dashboard-orders__detail-title:hover .dashboard-orders__copy-button {\n  opacity: 1;\n}\n\n.dashboard-orders .dashboard-orders__copy-button svg {\n  width: 0.75rem;\n  height: 0.75rem;\n}\n\n.dashboard-orders__detail-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  margin-left: auto;\n}\n\n.dashboard-orders .dashboard-orders__track-button {\n  height: 2rem;\n  gap: 0.25rem;\n}\n\n.dashboard-orders .dashboard-orders__more-button {\n  width: 2rem;\n  height: 2rem;\n}\n\n.dashboard-orders .dashboard-orders__track-button svg,\n.dashboard-orders .dashboard-orders__more-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n@media (width >= 1024px) {\n  .dashboard-orders__track-label {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border-width: 0;\n  }\n}\n\n@media (width >= 1280px) {\n  .dashboard-orders__track-label {\n    position: static;\n    width: auto;\n    height: auto;\n    padding: 0;\n    margin: 0;\n    overflow: visible;\n    clip: auto;\n    white-space: nowrap;\n  }\n}\n\n.dashboard-orders .dashboard-orders__detail-content {\n  padding: 1.5rem;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n.dashboard-orders__stack,\n.dashboard-orders__lines {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.dashboard-orders__section-title,\n.dashboard-orders__line--total {\n  font-weight: 600;\n}\n\n.dashboard-orders__line {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.dashboard-orders__muted,\n.dashboard-orders__address,\n.dashboard-orders__payment-brand {\n  color: hsl(var(--muted-foreground));\n}\n\n.dashboard-orders .dashboard-orders__separator--tight {\n  margin-top: 0.5rem;\n  margin-bottom: 0.5rem;\n}\n\n.dashboard-orders .dashboard-orders__separator {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n}\n\n.dashboard-orders__split {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1rem;\n}\n\n.dashboard-orders__address {\n  display: grid;\n  gap: 0.125rem;\n  font-style: normal;\n}\n\n.dashboard-orders__billing {\n  display: grid;\n  grid-auto-rows: max-content;\n  gap: 0.75rem;\n}\n\n.dashboard-orders__payment-brand {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.dashboard-orders__payment-brand svg {\n  width: 1rem;\n  height: 1rem;\n}\n\n.dashboard-orders .dashboard-orders__detail-footer {\n  flex-direction: row;\n  align-items: center;\n  border-top: 1px solid hsl(var(--border));\n  background-color: hsl(var(--muted) / 50%);\n  padding: 0.75rem 1.5rem;\n}\n\n.dashboard-orders__updated {\n  color: hsl(var(--muted-foreground));\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n\n.dashboard-orders__pagination {\n  width: auto;\n  margin-right: 0;\n  margin-left: auto;\n}\n\n.dashboard-orders__pagination-list {\n  gap: 0.25rem;\n}\n\n.dashboard-orders .dashboard-orders__page-button {\n  width: 1.5rem;\n  height: 1.5rem;\n}\n\n.dashboard-orders__sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n</style>\n",
