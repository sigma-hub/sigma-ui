{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-sfm-marketplace",
  "type": "registry:block",
  "title": "Integrations marketplace",
  "description": "A browse, installed, and updates gallery for integrations or plugins with search, category filters, featured cards, install and update progress with cancel, and empty states. Derived from patterns in Sigma File Manager.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "card",
    "empty",
    "input-group",
    "progress",
    "skeleton",
    "spinner",
    "tabs"
  ],
  "files": [
    {
      "path": "blocks/dashboard-sfm-marketplace/DashboardSfmMarketplace.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, ref } from 'vue';\nimport { PackageSearchIcon, RefreshCwIcon, SearchIcon, XIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';\nimport { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from '@/components/ui/input-group';\nimport { Skeleton } from '@/components/ui/skeleton';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport MarketplaceCard from './components/MarketplaceCard.vue';\nimport { categories, initialApps, pageDescription, pageTitle, searchPlaceholder } from './data';\nimport type { MarketplaceApp, MarketplaceTab } from './data';\n\nconst apps = ref<MarketplaceApp[]>(initialApps.map(app => ({ ...app })));\nconst activeTab = ref<MarketplaceTab>('browse');\nconst category = ref('all');\nconst searchQuery = ref('');\nconst isRefreshing = ref(false);\n\nconst timers = new Map<string, ReturnType<typeof setInterval>>();\nlet refreshTimer: ReturnType<typeof setTimeout> | undefined;\n\nconst normalizedQuery = computed(() => searchQuery.value.trim().toLowerCase());\nconst isFiltering = computed(() => normalizedQuery.value.length > 0 || category.value !== 'all');\n\nconst matchingApps = computed(() => {\n  return apps.value.filter((app) => {\n    const matchesCategory = category.value === 'all' || app.category === category.value;\n    const matchesQuery = normalizedQuery.value.length === 0\n      || [app.name, app.publisher, app.description, app.category].some(value => value.toLowerCase().includes(normalizedQuery.value));\n\n    return matchesCategory && matchesQuery;\n  });\n});\n\nfunction hasUpdate(app: MarketplaceApp) {\n  return app.installed && app.installedVersion !== app.version;\n}\n\nconst installedCount = computed(() => apps.value.filter(app => app.installed).length);\nconst updateCount = computed(() => apps.value.filter(hasUpdate).length);\n\nconst tabs = computed(() => [\n  { value: 'browse' as const, label: 'Browse', count: undefined },\n  { value: 'installed' as const, label: 'Installed', count: installedCount.value },\n  { value: 'updates' as const, label: 'Updates', count: updateCount.value },\n]);\n\nconst visibleApps = computed(() => {\n  if (activeTab.value === 'installed') {\n    return matchingApps.value.filter(app => app.installed);\n  }\n\n  if (activeTab.value === 'updates') {\n    return matchingApps.value.filter(hasUpdate);\n  }\n\n  return matchingApps.value;\n});\n\nconst featuredApps = computed(() => {\n  return activeTab.value === 'browse' && !isFiltering.value ? apps.value.filter(app => app.featured) : [];\n});\n\nconst emptyState = computed(() => {\n  if (isFiltering.value) {\n    return {\n      title: 'No integrations found',\n      description: 'Try a different keyword or category.',\n      action: 'Clear filters',\n    };\n  }\n\n  if (activeTab.value === 'installed') {\n    return {\n      title: 'Nothing installed yet',\n      description: 'Installed integrations will show up here.',\n      action: 'Browse integrations',\n    };\n  }\n\n  return {\n    title: 'Everything is up to date',\n    description: 'You are running the latest version of every integration.',\n    action: 'Browse integrations',\n  };\n});\n\nfunction findApp(id: string) {\n  return apps.value.find(app => app.id === id);\n}\n\nfunction stopTimer(id: string) {\n  const timer = timers.get(id);\n\n  if (timer !== undefined) {\n    clearInterval(timer);\n  }\n\n  timers.delete(id);\n}\n\n// Simulates a download. Replace this with your real install or update request.\nfunction startOperation(id: string) {\n  const app = findApp(id);\n\n  if (!app || app.progress !== null) {\n    return;\n  }\n\n  app.progress = 0;\n  timers.set(id, setInterval(() => {\n    app.progress = Math.min(100, (app.progress ?? 0) + 20);\n\n    if (app.progress >= 100) {\n      stopTimer(id);\n      Object.assign(app, { installed: true, installedVersion: app.version, progress: null });\n    }\n  }, 450));\n}\n\nfunction cancelOperation(id: string) {\n  const app = findApp(id);\n  stopTimer(id);\n\n  if (app) {\n    app.progress = null;\n  }\n}\n\nfunction uninstall(id: string) {\n  const app = findApp(id);\n\n  if (app) {\n    Object.assign(app, { installed: false, installedVersion: undefined });\n  }\n}\n\nfunction updateAll() {\n  apps.value.filter(hasUpdate).forEach(app => startOperation(app.id));\n}\n\nfunction refresh() {\n  isRefreshing.value = true;\n  clearTimeout(refreshTimer);\n  refreshTimer = setTimeout(() => {\n    isRefreshing.value = false;\n  }, 900);\n}\n\nfunction clearFilters() {\n  searchQuery.value = '';\n  category.value = 'all';\n}\n\nfunction handleEmptyAction() {\n  if (isFiltering.value) {\n    clearFilters();\n    return;\n  }\n\n  activeTab.value = 'browse';\n}\n\nonBeforeUnmount(() => {\n  timers.forEach(timer => clearInterval(timer));\n  timers.clear();\n  clearTimeout(refreshTimer);\n});\n</script>\n\n<template>\n  <div class=\"dashboard-sfm-marketplace\">\n    <header class=\"dashboard-sfm-marketplace__header\">\n      <h2 class=\"dashboard-sfm-marketplace__title\">\n        {{ pageTitle }}\n      </h2>\n      <p class=\"dashboard-sfm-marketplace__description\">\n        {{ pageDescription }}\n      </p>\n    </header>\n\n    <Tabs\n      v-model=\"activeTab\"\n      class=\"dashboard-sfm-marketplace__tabs\"\n    >\n      <div class=\"dashboard-sfm-marketplace__toolbar\">\n        <TabsList class=\"dashboard-sfm-marketplace__tabs-list\">\n          <TabsTrigger\n            v-for=\"tab in tabs\"\n            :key=\"tab.value\"\n            :value=\"tab.value\"\n          >\n            {{ tab.label }}\n            <Badge\n              v-if=\"tab.count\"\n              variant=\"secondary\"\n            >\n              {{ tab.count }}\n            </Badge>\n          </TabsTrigger>\n        </TabsList>\n\n        <div class=\"dashboard-sfm-marketplace__search-row\">\n          <InputGroup class=\"dashboard-sfm-marketplace__search\">\n            <InputGroupAddon>\n              <SearchIcon />\n            </InputGroupAddon>\n            <InputGroupInput\n              v-model=\"searchQuery\"\n              type=\"text\"\n              :placeholder=\"searchPlaceholder\"\n              :aria-label=\"searchPlaceholder\"\n            />\n            <InputGroupAddon\n              v-if=\"searchQuery\"\n              align=\"inline-end\"\n            >\n              <InputGroupButton\n                size=\"icon-xs\"\n                aria-label=\"Clear search\"\n                @click=\"searchQuery = ''\"\n              >\n                <XIcon />\n              </InputGroupButton>\n            </InputGroupAddon>\n          </InputGroup>\n          <Button\n            variant=\"outline\"\n            size=\"icon\"\n            aria-label=\"Refresh integrations\"\n            :disabled=\"isRefreshing\"\n            @click=\"refresh\"\n          >\n            <RefreshCwIcon :class=\"{ 'dashboard-sfm-marketplace__refresh-icon--spinning': isRefreshing }\" />\n          </Button>\n        </div>\n      </div>\n\n      <div\n        class=\"dashboard-sfm-marketplace__categories\"\n        role=\"group\"\n        aria-label=\"Categories\"\n      >\n        <Button\n          v-for=\"item in categories\"\n          :key=\"item.value\"\n          :variant=\"category === item.value ? 'secondary' : 'outline'\"\n          size=\"sm\"\n          :aria-pressed=\"category === item.value\"\n          @click=\"category = item.value\"\n        >\n          {{ item.label }}\n        </Button>\n      </div>\n\n      <TabsContent\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n        class=\"dashboard-sfm-marketplace__panel\"\n      >\n        <div\n          v-if=\"isRefreshing && activeTab === tab.value\"\n          class=\"dashboard-sfm-marketplace__grid\"\n          aria-busy=\"true\"\n        >\n          <Skeleton\n            v-for=\"index in 6\"\n            :key=\"index\"\n            class=\"dashboard-sfm-marketplace__skeleton\"\n          />\n        </div>\n\n        <template v-else-if=\"activeTab === tab.value\">\n          <section\n            v-if=\"featuredApps.length > 0\"\n            class=\"dashboard-sfm-marketplace__section\"\n          >\n            <h3 class=\"dashboard-sfm-marketplace__section-title\">\n              Featured\n            </h3>\n            <ul class=\"dashboard-sfm-marketplace__grid\">\n              <li\n                v-for=\"app in featuredApps\"\n                :key=\"app.id\"\n              >\n                <MarketplaceCard\n                  :app=\"app\"\n                  @install=\"startOperation\"\n                  @update=\"startOperation\"\n                  @cancel=\"cancelOperation\"\n                />\n              </li>\n            </ul>\n          </section>\n\n          <section\n            v-if=\"visibleApps.length > 0\"\n            class=\"dashboard-sfm-marketplace__section\"\n          >\n            <div class=\"dashboard-sfm-marketplace__section-header\">\n              <h3 class=\"dashboard-sfm-marketplace__section-title\">\n                {{ tab.value === 'browse' ? (featuredApps.length > 0 ? 'All integrations' : 'Integrations') : tab.label }}\n              </h3>\n              <Button\n                v-if=\"tab.value === 'updates' && updateCount > 1\"\n                variant=\"outline\"\n                size=\"sm\"\n                @click=\"updateAll\"\n              >\n                Update all\n              </Button>\n            </div>\n            <ul class=\"dashboard-sfm-marketplace__grid\">\n              <li\n                v-for=\"app in visibleApps\"\n                :key=\"app.id\"\n              >\n                <MarketplaceCard\n                  :app=\"app\"\n                  :manage=\"tab.value === 'installed'\"\n                  @install=\"startOperation\"\n                  @update=\"startOperation\"\n                  @uninstall=\"uninstall\"\n                  @cancel=\"cancelOperation\"\n                />\n              </li>\n            </ul>\n          </section>\n\n          <Empty\n            v-else\n            class=\"dashboard-sfm-marketplace__empty\"\n          >\n            <EmptyHeader>\n              <EmptyMedia variant=\"icon\">\n                <PackageSearchIcon />\n              </EmptyMedia>\n              <EmptyTitle>{{ emptyState.title }}</EmptyTitle>\n              <EmptyDescription>{{ emptyState.description }}</EmptyDescription>\n            </EmptyHeader>\n            <EmptyContent>\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                @click=\"handleEmptyAction\"\n              >\n                {{ emptyState.action }}\n              </Button>\n            </EmptyContent>\n          </Empty>\n        </template>\n      </TabsContent>\n    </Tabs>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-sfm-marketplace {\n    display: flex;\n    width: 100%;\n    max-width: 72rem;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    margin-inline: auto;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-sfm-marketplace__header {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-sfm-marketplace__title {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.025em;\n    line-height: 2rem;\n  }\n\n  .dashboard-sfm-marketplace__description {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-sfm-marketplace__tabs {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-sfm-marketplace__toolbar {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-marketplace__tabs-list.dashboard-sfm-marketplace__tabs-list {\n    width: 100%;\n    justify-content: flex-start;\n  }\n\n  .dashboard-sfm-marketplace__search-row {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-sfm-marketplace__search {\n    flex: 1;\n  }\n\n  .dashboard-sfm-marketplace__refresh-icon--spinning {\n    animation: dashboard-sfm-marketplace-spin 1s linear infinite;\n  }\n\n  @keyframes dashboard-sfm-marketplace-spin {\n    to {\n      transform: rotate(360deg);\n    }\n  }\n\n  .dashboard-sfm-marketplace__categories {\n    display: flex;\n    padding-inline: calc(var(--spacing) * 4);\n    padding-bottom: calc(var(--spacing) * 1);\n    margin-inline: calc(var(--spacing) * -4);\n    gap: calc(var(--spacing) * 2);\n    overflow-x: auto;\n  }\n\n  .dashboard-sfm-marketplace__panel {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 8);\n  }\n\n  .dashboard-sfm-marketplace__section {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-marketplace__section-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-marketplace__section-title {\n    margin: 0;\n    font-size: 1.125rem;\n    font-weight: 600;\n    line-height: 1.75rem;\n  }\n\n  .dashboard-sfm-marketplace__grid {\n    display: grid;\n    padding: 0;\n    margin: 0;\n    gap: calc(var(--spacing) * 4);\n    list-style: none;\n  }\n\n  .dashboard-sfm-marketplace__skeleton.dashboard-sfm-marketplace__skeleton {\n    height: calc(var(--spacing) * 48);\n  }\n\n  .dashboard-sfm-marketplace__empty.dashboard-sfm-marketplace__empty {\n    border: 1px dashed var(--border);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-sfm-marketplace {\n      padding: calc(var(--spacing) * 6);\n    }\n\n    .dashboard-sfm-marketplace__toolbar {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .dashboard-sfm-marketplace__tabs-list.dashboard-sfm-marketplace__tabs-list {\n      width: auto;\n    }\n\n    .dashboard-sfm-marketplace__search {\n      width: calc(var(--spacing) * 64);\n      flex: none;\n    }\n\n    .dashboard-sfm-marketplace__categories {\n      padding-inline: 0;\n      margin-inline: 0;\n      flex-wrap: wrap;\n    }\n\n    .dashboard-sfm-marketplace__grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-sfm-marketplace__grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sfm-marketplace/components/MarketplaceCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport { CheckIcon, TriangleAlertIcon, XIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card } from '@/components/ui/card';\nimport { Progress } from '@/components/ui/progress';\nimport { Spinner } from '@/components/ui/spinner';\nimport type { MarketplaceApp } from '../data';\n\nconst props = withDefaults(defineProps<{\n  app: MarketplaceApp;\n  /** Show the uninstall action for installed apps. */\n  manage?: boolean;\n  featured?: boolean;\n}>(), {\n  manage: false,\n  featured: false,\n});\n\nconst emit = defineEmits<{\n  install: [id: string];\n  update: [id: string];\n  uninstall: [id: string];\n  cancel: [id: string];\n}>();\n\nconst isBusy = computed(() => props.app.progress !== null);\nconst hasUpdate = computed(() => props.app.installed && props.app.installedVersion !== props.app.version);\nconst busyLabel = computed(() => (props.app.installed ? 'Updating…' : 'Installing…'));\nconst versionLabel = computed(() => `v${props.app.installedVersion ?? props.app.version}`);\nconst badgeLabel = computed(() => (props.app.badge === 'official' ? 'Official' : 'Community'));\n</script>\n\n<template>\n  <Card class=\"dashboard-sfm-marketplace__card\">\n    <div class=\"dashboard-sfm-marketplace__top\">\n      <div\n        class=\"dashboard-sfm-marketplace__icon\"\n        aria-hidden=\"true\"\n      >\n        <component :is=\"app.icon\" />\n      </div>\n      <div class=\"dashboard-sfm-marketplace__heading\">\n        <h3 class=\"dashboard-sfm-marketplace__name\">\n          {{ app.name }}\n        </h3>\n        <p class=\"dashboard-sfm-marketplace__publisher\">\n          by {{ app.publisher }}\n        </p>\n      </div>\n      <Badge :variant=\"app.badge === 'official' ? 'default' : 'secondary'\">\n        {{ badgeLabel }}\n      </Badge>\n    </div>\n\n    <p class=\"dashboard-sfm-marketplace__card-description\">\n      {{ app.description }}\n    </p>\n\n    <div class=\"dashboard-sfm-marketplace__meta\">\n      <Badge variant=\"outline\">\n        {{ app.category }}\n      </Badge>\n      <span>{{ versionLabel }}</span>\n      <span\n        v-if=\"hasUpdate\"\n        class=\"dashboard-sfm-marketplace__update-hint\"\n      >\n        v{{ app.version }} available\n      </span>\n    </div>\n\n    <p\n      v-if=\"app.incompatibleReason && !app.installed\"\n      class=\"dashboard-sfm-marketplace__warning\"\n      role=\"note\"\n    >\n      <TriangleAlertIcon\n        class=\"dashboard-sfm-marketplace__warning-icon\"\n        aria-hidden=\"true\"\n      />\n      {{ app.incompatibleReason }}\n    </p>\n\n    <Progress\n      v-if=\"isBusy\"\n      :model-value=\"app.progress ?? 0\"\n      :aria-label=\"`${busyLabel} ${app.name}`\"\n    />\n\n    <div class=\"dashboard-sfm-marketplace__actions\">\n      <template v-if=\"isBusy\">\n        <Button\n          class=\"dashboard-sfm-marketplace__action\"\n          variant=\"secondary\"\n          disabled\n        >\n          <Spinner />\n          {{ busyLabel }}\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"icon\"\n          :aria-label=\"`Cancel ${busyLabel.toLowerCase()} ${app.name}`\"\n          @click=\"emit('cancel', app.id)\"\n        >\n          <XIcon />\n        </Button>\n      </template>\n      <template v-else-if=\"app.installed\">\n        <Button\n          v-if=\"hasUpdate\"\n          class=\"dashboard-sfm-marketplace__action\"\n          @click=\"emit('update', app.id)\"\n        >\n          Update\n        </Button>\n        <Button\n          v-if=\"manage\"\n          class=\"dashboard-sfm-marketplace__action\"\n          variant=\"outline\"\n          @click=\"emit('uninstall', app.id)\"\n        >\n          Uninstall\n        </Button>\n        <Button\n          v-else-if=\"!hasUpdate\"\n          class=\"dashboard-sfm-marketplace__action\"\n          variant=\"secondary\"\n          disabled\n        >\n          <CheckIcon />\n          Installed\n        </Button>\n      </template>\n      <Button\n        v-else\n        class=\"dashboard-sfm-marketplace__action\"\n        :disabled=\"Boolean(app.incompatibleReason)\"\n        @click=\"emit('install', app.id)\"\n      >\n        Install\n      </Button>\n    </div>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-sfm-marketplace__card {\n    display: flex;\n    height: 100%;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-sfm-marketplace__top {\n    display: flex;\n    align-items: flex-start;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-sfm-marketplace__icon {\n    display: flex;\n    width: calc(var(--spacing) * 10);\n    height: calc(var(--spacing) * 10);\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    border-radius: var(--radius);\n    background-color: var(--muted);\n    color: var(--foreground);\n  }\n\n  .dashboard-sfm-marketplace__icon svg {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  .dashboard-sfm-marketplace__heading {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n  }\n\n  .dashboard-sfm-marketplace__name,\n  .dashboard-sfm-marketplace__publisher {\n    overflow: hidden;\n    margin: 0;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .dashboard-sfm-marketplace__name {\n    font-size: 0.875rem;\n    font-weight: 600;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-sfm-marketplace__publisher {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    line-height: 1rem;\n  }\n\n  .dashboard-sfm-marketplace__card-description {\n    display: -webkit-box;\n    overflow: hidden;\n    flex: 1;\n    margin: 0;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  .dashboard-sfm-marketplace__meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1rem;\n  }\n\n  .dashboard-sfm-marketplace__update-hint {\n    color: var(--foreground);\n  }\n\n  .dashboard-sfm-marketplace__warning {\n    display: flex;\n    align-items: center;\n    margin: 0;\n    color: var(--destructive);\n    font-size: 0.75rem;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1rem;\n  }\n\n  .dashboard-sfm-marketplace__warning-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    flex-shrink: 0;\n  }\n\n  .dashboard-sfm-marketplace__actions {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-sfm-marketplace__action.dashboard-sfm-marketplace__action {\n    flex: 1;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-sfm-marketplace/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  BellRingIcon,\n  CalendarIcon,\n  ChartLineIcon,\n  CloudIcon,\n  DatabaseIcon,\n  FileTextIcon,\n  GitBranchIcon,\n  MailIcon,\n  MessageSquareIcon,\n  ShieldCheckIcon,\n  WorkflowIcon,\n} from '@lucide/vue';\n\nexport type MarketplaceTab = 'browse' | 'installed' | 'updates';\nexport type MarketplaceBadge = 'official' | 'community';\n\nexport interface MarketplaceCategory {\n  value: string;\n  label: string;\n}\n\nexport interface MarketplaceApp {\n  id: string;\n  name: string;\n  publisher: string;\n  description: string;\n  icon: Component;\n  category: string;\n  badge: MarketplaceBadge;\n  /** Latest published version. */\n  version: string;\n  featured?: boolean;\n  /** When set, the app cannot be installed and this text explains why. */\n  incompatibleReason?: string;\n  installed: boolean;\n  installedVersion?: string;\n  /** 0-100 while an install or update is running, otherwise null. */\n  progress: number | null;\n}\n\nexport const pageTitle = 'Integrations';\nexport const pageDescription = 'Connect your workspace to the tools your team already uses.';\nexport const searchPlaceholder = 'Search integrations';\n\nexport const categories: MarketplaceCategory[] = [\n  { value: 'all', label: 'All' },\n  { value: 'productivity', label: 'Productivity' },\n  { value: 'developer', label: 'Developer' },\n  { value: 'analytics', label: 'Analytics' },\n  { value: 'communication', label: 'Communication' },\n  { value: 'security', label: 'Security' },\n];\n\nexport const initialApps: MarketplaceApp[] = [\n  {\n    id: 'git-sync',\n    name: 'Git Sync',\n    publisher: 'Northwind',\n    description: 'Mirror repositories and keep branches in sync across every workspace automatically.',\n    icon: GitBranchIcon,\n    category: 'developer',\n    badge: 'official',\n    version: '2.5.0',\n    installed: true,\n    installedVersion: '2.4.0',\n    progress: null,\n  },\n  {\n    id: 'pulse-analytics',\n    name: 'Pulse Analytics',\n    publisher: 'Northwind',\n    description: 'Track product usage with ready-made dashboards, funnels and weekly reports.',\n    icon: ChartLineIcon,\n    category: 'analytics',\n    badge: 'official',\n    version: '1.8.2',\n    featured: true,\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'relay-chat',\n    name: 'Relay Chat',\n    publisher: 'Open Relay',\n    description: 'Post updates, alerts and daily summaries to your team channels.',\n    icon: MessageSquareIcon,\n    category: 'communication',\n    badge: 'community',\n    version: '3.1.0',\n    installed: true,\n    installedVersion: '3.1.0',\n    progress: null,\n  },\n  {\n    id: 'calendar-bridge',\n    name: 'Calendar Bridge',\n    publisher: 'Northwind',\n    description: 'Show deadlines and releases in your calendar and block focus time for reviews.',\n    icon: CalendarIcon,\n    category: 'productivity',\n    badge: 'official',\n    version: '1.2.4',\n    featured: true,\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'inbox-digest',\n    name: 'Inbox Digest',\n    publisher: 'Mailroom Labs',\n    description: 'Collect notifications into one digest email instead of dozens of separate messages.',\n    icon: MailIcon,\n    category: 'communication',\n    badge: 'community',\n    version: '0.9.3',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'cloud-backup',\n    name: 'Cloud Backup',\n    publisher: 'Northwind',\n    description: 'Schedule encrypted backups of your data to the storage provider of your choice.',\n    icon: CloudIcon,\n    category: 'developer',\n    badge: 'official',\n    version: '2.0.1',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'access-guard',\n    name: 'Access Guard',\n    publisher: 'Northwind',\n    description: 'Single sign-on, session policies and audit logs for larger teams.',\n    icon: ShieldCheckIcon,\n    category: 'security',\n    badge: 'official',\n    version: '4.0.