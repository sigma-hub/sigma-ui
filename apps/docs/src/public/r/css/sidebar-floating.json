{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-floating",
  "type": "registry:example",
  "title": "SidebarFloating",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "sidebar"
  ],
  "files": [
    {
      "path": "example/SidebarFloating.vue",
      "content": "<script setup lang=\"ts\">\nimport { CalendarIcon, HomeIcon, InboxIcon, SearchIcon, SettingsIcon } from '@lucide/vue';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarTrigger,\n} from '@/components/ui/sidebar';\n\nconst items = [\n  { title: 'Home', icon: HomeIcon, isActive: true },\n  { title: 'Inbox', icon: InboxIcon },\n  { title: 'Calendar', icon: CalendarIcon },\n  { title: 'Search', icon: SearchIcon },\n  { title: 'Settings', icon: SettingsIcon },\n];\n</script>\n\n<template>\n  <div class=\"example-sidebar-floating\">\n    <SidebarProvider\n      cookie-name=\"\"\n      class=\"example-sidebar-floating__provider\"\n    >\n      <Sidebar\n        variant=\"floating\"\n        collapsible=\"icon\"\n        class=\"example-sidebar-floating__sidebar\"\n      >\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Application</SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem\n                  v-for=\"item in items\"\n                  :key=\"item.title\"\n                >\n                  <SidebarMenuButton\n                    :is-active=\"item.isActive\"\n                    :tooltip=\"item.title\"\n                  >\n                    <component :is=\"item.icon\" />\n                    <span>{{ item.title }}</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n      </Sidebar>\n      <main class=\"example-sidebar-floating__main\">\n        <SidebarTrigger />\n        <div class=\"example-sidebar-floating__placeholder\" />\n      </main>\n    </SidebarProvider>\n  </div>\n</template>\n\n<style>\n.example-sidebar-floating {\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  height: 420px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background-color: color-mix(in oklch, var(--secondary) 50%, transparent);\n  transform: translateZ(0);\n}\n\n.example-sidebar-floating .example-sidebar-floating__provider {\n  height: 100%;\n  min-height: 100%;\n}\n\n.example-sidebar-floating .example-sidebar-floating__sidebar {\n  height: 100%;\n}\n\n.example-sidebar-floating__main {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: calc(var(--spacing) * 4);\n  gap: calc(var(--spacing) * 4);\n}\n\n.example-sidebar-floating__placeholder {\n  flex: 1;\n  border: 1px dashed var(--border);\n  border-radius: calc(var(--radius) + 4px);\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
