{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog-demo",
  "type": "registry:example",
  "title": "Dialog",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "dialog",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "example/Dialog.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Dialog>\n    <DialogTrigger as-child>\n      <Button variant=\"outline\">\n        Edit Profile\n      </Button>\n    </DialogTrigger>\n    <DialogContent class=\"example-sigma-ui-dialog__content\">\n      <DialogHeader>\n        <DialogTitle>Edit profile</DialogTitle>\n        <DialogDescription>\n          Make changes to your profile here. Click save when you're done.\n        </DialogDescription>\n      </DialogHeader>\n      <div class=\"example-sigma-ui-dialog__form\">\n        <div class=\"example-sigma-ui-dialog__form-row\">\n          <Label\n            for=\"name\"\n            class=\"example-sigma-ui-dialog__label\"\n          >\n            Name\n          </Label>\n          <Input\n            id=\"name\"\n            value=\"Pedro Duarte\"\n            class=\"example-sigma-ui-dialog__input\"\n          />\n        </div>\n        <div class=\"example-sigma-ui-dialog__form-row\">\n          <Label\n            for=\"username\"\n            class=\"example-sigma-ui-dialog__label\"\n          >\n            Username\n          </Label>\n          <Input\n            id=\"username\"\n            value=\"@peduarte\"\n            class=\"example-sigma-ui-dialog__input\"\n          />\n        </div>\n      </div>\n      <DialogFooter>\n        <Button type=\"submit\">\n          Save changes\n        </Button>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n\n<style>\n.example-sigma-ui-dialog__content {\n  max-width: 425px;\n}\n\n@media (width >= 40rem) {\n  .example-sigma-ui-dialog__content {\n    max-width: 425px;\n  }\n}\n\n.example-sigma-ui-dialog__form {\n  display: grid;\n  padding: calc(var(--spacing) * 4) 0;\n  gap: calc(var(--spacing) * 4);\n}\n\n.example-sigma-ui-dialog__form-row {\n  display: grid;\n  align-items: center;\n  gap: calc(var(--spacing) * 4);\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.example-sigma-ui-dialog__label {\n  text-align: right;\n}\n\n.example-sigma-ui-dialog__input {\n  grid-column: span 3 / span 3;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
