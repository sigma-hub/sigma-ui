{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-product-edit",
  "type": "registry:block",
  "title": "Product edit page",
  "description": "A product edit page. The product edit page has a form to edit the product details, stock, product category, product status, and product images. The product edit page has a sidebar navigation and a main content area. The main content area has a form to edit the product details, stock, product category, product status, and product images. The sidebar navigation has links to product details, stock, product category, product status, and product images.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "label",
    "select",
    "sheet",
    "table",
    "textarea",
    "toggle-group",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-product-edit/DashboardProductEdit.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport ArchiveProductCard from './components/ArchiveProductCard.vue';\nimport ProductCategoryCard from './components/ProductCategoryCard.vue';\nimport ProductDetailsCard from './components/ProductDetailsCard.vue';\nimport ProductImagesCard from './components/ProductImagesCard.vue';\nimport ProductStatusCard from './components/ProductStatusCard.vue';\nimport ProductStockCard from './components/ProductStockCard.vue';\nimport ProductToolbar from './components/ProductToolbar.vue';\n</script>\n\n<template>\n  <div class=\"dashboard-product-edit\">\n    <AppSidebar />\n    <div class=\"dashboard-product-edit__content\">\n      <AppHeader />\n      <main class=\"dashboard-product-edit__main\">\n        <div class=\"dashboard-product-edit__panel\">\n          <ProductToolbar />\n          <div class=\"dashboard-product-edit__columns\">\n            <div class=\"dashboard-product-edit__primary\">\n              <ProductDetailsCard />\n              <ProductStockCard />\n              <ProductCategoryCard />\n            </div>\n            <div class=\"dashboard-product-edit__secondary\">\n              <ProductStatusCard />\n              <ProductImagesCard />\n              <ArchiveProductCard />\n            </div>\n          </div>\n          <div class=\"dashboard-product-edit__mobile-actions\">\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n            >\n              Discard\n            </Button>\n            <Button size=\"sm\">\n              Save Product\n            </Button>\n          </div>\n        </div>\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit {\n    display: flex;\n    width: 100%;\n    min-height: 100vh;\n    flex-direction: column;\n    background-color: color-mix(in oklch, var(--muted) 40%, transparent);\n  }\n\n  .dashboard-product-edit__content {\n    display: flex;\n    flex-direction: column;\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__content {\n      padding-top: calc(var(--spacing) * 4);\n      padding-bottom: calc(var(--spacing) * 4);\n      padding-left: calc(var(--spacing) * 14);\n      gap: calc(var(--spacing) * 4);\n    }\n  }\n\n  .dashboard-product-edit__main {\n    display: grid;\n    flex: 1 1 0%;\n    align-items: start;\n    padding: calc(var(--spacing) * 4);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__main {\n      padding: 0 calc(var(--spacing) * 6);\n    }\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__main {\n      gap: calc(var(--spacing) * 8);\n    }\n  }\n\n  .dashboard-product-edit__panel {\n    display: grid;\n    width: 100%;\n    max-width: calc(var(--spacing) * 236);\n    flex: 1 1 0%;\n    margin-right: auto;\n    margin-left: auto;\n    gap: calc(var(--spacing) * 4);\n    grid-auto-rows: max-content;\n  }\n\n  .dashboard-product-edit__columns {\n    display: grid;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__columns {\n      grid-template-columns: 1fr 250px;\n    }\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-product-edit__columns {\n      gap: calc(var(--spacing) * 8);\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  .dashboard-product-edit__primary,\n  .dashboard-product-edit__secondary {\n    display: grid;\n    align-items: start;\n    gap: calc(var(--spacing) * 4);\n    grid-auto-rows: max-content;\n  }\n\n  @media (width >= 64rem) {\n    .dashboard-product-edit__primary {\n      gap: calc(var(--spacing) * 8);\n      grid-column: span 2 / span 2;\n    }\n\n    .dashboard-product-edit__secondary {\n      gap: calc(var(--spacing) * 8);\n    }\n  }\n\n  .dashboard-product-edit__mobile-actions {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__mobile-actions {\n      display: none;\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport { breadcrumbLinks, breadcrumbPage, mobileNavItems } from '../data';\n</script>\n\n<template>\n  <header class=\"dashboard-product-edit__header\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"dashboard-product-edit__menu-button\"\n        >\n          <PanelLeftIcon />\n          <span class=\"dashboard-product-edit__visually-hidden\">Toggle Menu</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"dashboard-product-edit__sheet\"\n      >\n        <nav class=\"dashboard-product-edit__sheet-nav\">\n          <a\n            href=\"#\"\n            class=\"dashboard-product-edit__sheet-logo\"\n          >\n            <Package2Icon />\n            <span class=\"dashboard-product-edit__visually-hidden\">Acme Inc</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"dashboard-product-edit__sheet-link\"\n            :class=\"{ 'dashboard-product-edit__sheet-link--active': item.isActive }\"\n          >\n            <component :is=\"item.icon\" />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"dashboard-product-edit__breadcrumb\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link.label\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a :href=\"link.href\">{{ link.label }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"dashboard-product-edit__search\">\n      <SearchIcon class=\"dashboard-product-edit__search-icon\" />\n      <Input\n        type=\"search\"\n        placeholder=\"Search...\"\n        class=\"dashboard-product-edit__search-input\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"dashboard-product-edit__account-button\"\n        >\n          <CircleUserIcon />\n          <span class=\"dashboard-product-edit__visually-hidden\">Toggle user menu</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>My Account</DropdownMenuLabel>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>Settings</DropdownMenuItem>\n        <DropdownMenuItem>Support</DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>Logout</DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__header {\n    position: sticky;\n    z-index: 30;\n    top: 0;\n    display: flex;\n    height: calc(var(--spacing) * 14);\n    align-items: center;\n    padding-right: calc(var(--spacing) * 4);\n    padding-left: calc(var(--spacing) * 4);\n    border-bottom: 1px solid var(--border);\n    background-color: var(--background);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__header {\n      position: static;\n      height: auto;\n      padding-right: calc(var(--spacing) * 6);\n      padding-left: calc(var(--spacing) * 6);\n      border-bottom-width: 0;\n      background-color: transparent;\n    }\n\n    button.dashboard-product-edit__menu-button {\n      display: none;\n    }\n\n    .dashboard-product-edit__sheet.sigma-ui-sheet-content--left {\n      max-width: 20rem;\n    }\n  }\n\n  button.dashboard-product-edit__menu-button svg,\n  button.dashboard-product-edit__account-button svg {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  button.dashboard-product-edit__account-button {\n    border-radius: var(--radius-full);\n  }\n\n  .dashboard-product-edit__sheet-nav {\n    display: grid;\n    font-size: 1.125rem;\n    font-weight: 500;\n    gap: calc(var(--spacing) * 6);\n    line-height: 1.75rem;\n  }\n\n  .dashboard-product-edit__sheet-logo {\n    display: flex;\n    width: calc(var(--spacing) * 10);\n    height: calc(var(--spacing) * 10);\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    border-radius: var(--radius-full);\n    background-color: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 1.125rem;\n    font-weight: 600;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1.75rem;\n    text-decoration: none;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__sheet-logo {\n      font-size: 1rem;\n      line-height: 1.5rem;\n    }\n  }\n\n  .dashboard-product-edit__sheet-logo svg {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n    transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .dashboard-product-edit__sheet-logo:hover svg {\n    transform: scale(1.1);\n  }\n\n  .dashboard-product-edit__sheet-link {\n    display: flex;\n    align-items: center;\n    padding-right: calc(var(--spacing) * 2.5);\n    padding-left: calc(var(--spacing) * 2.5);\n    color: var(--muted-foreground);\n    gap: calc(var(--spacing) * 4);\n    text-decoration: none;\n  }\n\n  .dashboard-product-edit__sheet-link:hover,\n  .dashboard-product-edit__sheet-link--active {\n    color: var(--foreground);\n  }\n\n  .dashboard-product-edit__sheet-link svg {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n    flex-shrink: 0;\n  }\n\n  .dashboard-product-edit__breadcrumb {\n    display: none;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__breadcrumb {\n      display: flex;\n    }\n  }\n\n  .dashboard-product-edit__search {\n    position: relative;\n    flex: 1 1 0%;\n    margin-left: auto;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__search {\n      flex-grow: 0;\n    }\n  }\n\n  .dashboard-product-edit__search-icon {\n    position: absolute;\n    top: calc(var(--spacing) * 2.5);\n    left: calc(var(--spacing) * 2.5);\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    color: var(--muted-foreground);\n  }\n\n  input.dashboard-product-edit__search-input {\n    width: 100%;\n    padding-left: calc(var(--spacing) * 8);\n    border-radius: var(--radius-lg);\n    background-color: var(--background);\n  }\n\n  @media (width >= 48rem) {\n    input.dashboard-product-edit__search-input {\n      width: 200px;\n    }\n  }\n\n  @media (width >= 64rem) {\n    input.dashboard-product-edit__search-input {\n      width: 336px;\n    }\n  }\n\n  .dashboard-product-edit__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from '@lucide/vue';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport { sidebarFooterNavItems, sidebarNavItems } from '../data';\n</script>\n\n<template>\n  <aside class=\"dashboard-product-edit__sidebar\">\n    <nav class=\"dashboard-product-edit__sidebar-nav\">\n      <a\n        href=\"#\"\n        class=\"dashboard-product-edit__logo\"\n      >\n        <Package2Icon />\n        <span class=\"dashboard-product-edit__visually-hidden\">Acme Inc</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in sidebarNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-product-edit__nav-link\"\n              :class=\"{ 'dashboard-product-edit__nav-link--active': item.isActive }\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-product-edit__visually-hidden\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"dashboard-product-edit__sidebar-nav dashboard-product-edit__sidebar-nav--end\">\n      <TooltipProvider\n        v-for=\"item in sidebarFooterNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"dashboard-product-edit__nav-link\"\n            >\n              <component :is=\"item.icon\" />\n              <span class=\"dashboard-product-edit__visually-hidden\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__sidebar {\n    position: fixed;\n    z-index: 10;\n    top: 0;\n    bottom: 0;\n    left: 0;\n    display: none;\n    width: calc(var(--spacing) * 14);\n    flex-direction: column;\n    border-right: 1px solid var(--border);\n    background-color: var(--background);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__sidebar {\n      display: flex;\n    }\n  }\n\n  .dashboard-product-edit__sidebar-nav {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding-right: calc(var(--spacing) * 2);\n    padding-left: calc(var(--spacing) * 2);\n    gap: calc(var(--spacing) * 4);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__sidebar-nav {\n      padding-top: calc(var(--spacing) * 5);\n      padding-bottom: calc(var(--spacing) * 5);\n    }\n  }\n\n  .dashboard-product-edit__sidebar-nav--end {\n    margin-top: auto;\n  }\n\n  .dashboard-product-edit__logo {\n    display: flex;\n    width: calc(var(--spacing) * 9);\n    height: calc(var(--spacing) * 9);\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    border-radius: var(--radius-full);\n    background-color: var(--primary);\n    color: var(--primary-foreground);\n    font-size: 1.125rem;\n    font-weight: 600;\n    gap: calc(var(--spacing) * 2);\n    line-height: 1.75rem;\n    text-decoration: none;\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__logo {\n      width: calc(var(--spacing) * 8);\n      height: calc(var(--spacing) * 8);\n      font-size: 1rem;\n      line-height: 1.5rem;\n    }\n  }\n\n  .dashboard-product-edit__logo svg {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .dashboard-product-edit__logo:hover svg {\n    transform: scale(1.1);\n  }\n\n  .dashboard-product-edit__nav-link {\n    display: flex;\n    width: calc(var(--spacing) * 9);\n    height: calc(var(--spacing) * 9);\n    align-items: center;\n    justify-content: center;\n    border-radius: var(--radius-lg);\n    color: var(--muted-foreground);\n    text-decoration: none;\n    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .dashboard-product-edit__nav-link:hover {\n    color: var(--foreground);\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__nav-link {\n      width: calc(var(--spacing) * 8);\n      height: calc(var(--spacing) * 8);\n    }\n  }\n\n  .dashboard-product-edit__nav-link--active {\n    background-color: var(--secondary);\n    color: var(--secondary-foreground);\n  }\n\n  .dashboard-product-edit__nav-link svg {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n  }\n\n  .dashboard-product-edit__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ArchiveProductCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Archive Product</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit.\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div />\n      <Button\n        size=\"sm\"\n        variant=\"secondary\"\n      >\n        Archive Product\n      </Button>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductCategoryCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Label } from '@/components/ui/label';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { categoryOptions, subcategoryOptions } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Category</CardTitle>\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-product-edit__category-grid\">\n        <div class=\"dashboard-product-edit__field\">\n          <Label for=\"category\">Category</Label>\n          <Select>\n            <SelectTrigger\n              id=\"category\"\n              aria-label=\"Select category\"\n            >\n              <SelectValue placeholder=\"Select category\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in categoryOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n        <div class=\"dashboard-product-edit__field\">\n          <Label for=\"subcategory\">\n            Subcategory (optional)\n          </Label>\n          <Select>\n            <SelectTrigger\n              id=\"subcategory\"\n              aria-label=\"Select subcategory\"\n            >\n              <SelectValue placeholder=\"Select subcategory\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in subcategoryOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__category-grid {\n    display: grid;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__category-grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  .dashboard-product-edit__field {\n    display: grid;\n    gap: calc(var(--spacing) * 3);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductDetailsCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Textarea } from '@/components/ui/textarea';\nimport { Label } from '@/components/ui/label';\nimport { productDescription, productName } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Details</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-product-edit__stack\">\n        <div class=\"dashboard-product-edit__field\">\n          <Label for=\"name\">Name</Label>\n          <Input\n            id=\"name\"\n            type=\"text\"\n            class=\"dashboard-product-edit__full-input\"\n            :model-value=\"productName\"\n          />\n        </div>\n        <div class=\"dashboard-product-edit__field\">\n          <Label for=\"description\">Description</Label>\n          <Textarea\n            id=\"description\"\n            :model-value=\"productDescription\"\n            class=\"dashboard-product-edit__description\"\n          />\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__stack {\n    display: grid;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-product-edit__field {\n    display: grid;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  input.dashboard-product-edit__full-input {\n    width: 100%;\n  }\n\n  textarea.dashboard-product-edit__description {\n    min-height: calc(var(--spacing) * 32);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductImagesCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { UploadIcon } from '@lucide/vue';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { mainProductImage, productThumbnails } from '../data';\n</script>\n\n<template>\n  <Card class=\"dashboard-product-edit__images-card\">\n    <CardHeader>\n      <CardTitle>Product imgs</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-product-edit__image-grid\">\n        <img\n          :alt=\"mainProductImage.alt\"\n          class=\"dashboard-product-edit__image\"\n          :height=\"mainProductImage.size\"\n          :src=\"mainProductImage.src\"\n          :width=\"mainProductImage.size\"\n        >\n        <div class=\"dashboard-product-edit__thumbnails\">\n          <button\n            v-for=\"(thumbnail, thumbnailIndex) in productThumbnails\"\n            :key=\"thumbnailIndex\"\n            class=\"dashboard-product-edit__thumbnail\"\n          >\n            <img\n              :alt=\"thumbnail.alt\"\n              class=\"dashboard-product-edit__image\"\n              :height=\"thumbnail.size\"\n              :src=\"thumbnail.src\"\n              :width=\"thumbnail.size\"\n            >\n          </button>\n          <button class=\"dashboard-product-edit__upload\">\n            <UploadIcon />\n            <span class=\"dashboard-product-edit__visually-hidden\">Upload</span>\n          </button>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__images-card {\n    overflow: hidden;\n  }\n\n  .dashboard-product-edit__image-grid {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-product-edit__image {\n    display: block;\n    width: 100%;\n    border-radius: var(--radius-md);\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n  }\n\n  .dashboard-product-edit__thumbnails {\n    display: grid;\n    gap: calc(var(--spacing) * 2);\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .dashboard-product-edit__thumbnail,\n  .dashboard-product-edit__upload {\n    display: block;\n    width: 100%;\n    padding: 0;\n    border: 0;\n    background-color: transparent;\n    cursor: pointer;\n  }\n\n  .dashboard-product-edit__upload {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    border: 1px dashed var(--border);\n    border-radius: var(--radius-md);\n    aspect-ratio: 1 / 1;\n  }\n\n  .dashboard-product-edit__upload svg {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-product-edit__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductStatusCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Label } from '@/components/ui/label';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { statusOptions } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Status</CardTitle>\n    </CardHeader>\n    <CardContent>\n      <div class=\"dashboard-product-edit__stack\">\n        <div class=\"dashboard-product-edit__field\">\n          <Label for=\"status\">Status</Label>\n          <Select>\n            <SelectTrigger\n              id=\"status\"\n              aria-label=\"Select status\"\n            >\n              <SelectValue placeholder=\"Select status\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in statusOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__stack {\n    display: grid;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-product-edit__field {\n    display: grid;\n    gap: calc(var(--spacing) * 3);\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductStockCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { PlusCircleIcon } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport { sizeOptions, stockVariants } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Stock</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead class=\"dashboard-product-edit__column-sku\">\n              SKU\n            </TableHead>\n            <TableHead>Stock</TableHead>\n            <TableHead>Price</TableHead>\n            <TableHead class=\"dashboard-product-edit__column-size\">\n              Size\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <TableRow\n            v-for=\"variant in stockVariants\"\n            :key=\"variant.sku\"\n          >\n            <TableCell class=\"dashboard-product-edit__sku\">\n              {{ variant.sku }}\n            </TableCell>\n            <TableCell>\n              <Label\n                :for=\"`stock-${variant.id}`\"\n                class=\"dashboard-product-edit__visually-hidden\"\n              >\n                Stock\n              </Label>\n              <Input\n                :id=\"`stock-${variant.id}`\"\n                type=\"number\"\n                :model-value=\"variant.stock\"\n              />\n            </TableCell>\n            <TableCell>\n              <Label\n                :for=\"`price-${variant.id}`\"\n                class=\"dashboard-product-edit__visually-hidden\"\n              >\n                {{ variant.priceLabel }}\n              </Label>\n              <Input\n                :id=\"`price-${variant.id}`\"\n                type=\"number\"\n                :model-value=\"variant.price\"\n              />\n            </TableCell>\n            <TableCell>\n              <ToggleGroup\n                type=\"single\"\n                :default-value=\"variant.defaultSize\"\n                variant=\"outline\"\n              >\n                <ToggleGroupItem\n                  v-for=\"size in sizeOptions\"\n                  :key=\"size.value\"\n                  :value=\"size.value\"\n                >\n                  {{ size.label }}\n                </ToggleGroupItem>\n              </ToggleGroup>\n            </TableCell>\n          </TableRow>\n        </TableBody>\n      </Table>\n    </CardContent>\n    <CardFooter class=\"dashboard-product-edit__stock-footer\">\n      <Button\n        size=\"sm\"\n        variant=\"ghost\"\n        class=\"dashboard-product-edit__add-variant\"\n      >\n        <PlusCircleIcon />\n        Add Variant\n      </Button>\n    </CardFooter>\n  </Card>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__column-sku,\n  .dashboard-product-edit__column-size {\n    width: 100px;\n  }\n\n  .dashboard-product-edit__sku {\n    font-weight: 600;\n  }\n\n  .sigma-ui-card__footer.dashboard-product-edit__stock-footer {\n    justify-content: center;\n    padding: calc(var(--spacing) * 4);\n    border-top: 1px solid var(--border);\n  }\n\n  button.dashboard-product-edit__add-variant {\n    gap: calc(var(--spacing) * 1);\n  }\n\n  button.dashboard-product-edit__add-variant svg {\n    width: calc(var(--spacing) * 3.5);\n    height: calc(var(--spacing) * 3.5);\n  }\n\n  .dashboard-product-edit__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductToolbar.vue",
      "content": "<script setup lang=\"ts\">\nimport { ChevronLeftIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\n</script>\n\n<template>\n  <div class=\"dashboard-product-edit__toolbar\">\n    <Button\n      variant=\"outline\"\n      size=\"icon\"\n      class=\"dashboard-product-edit__back-button\"\n    >\n      <ChevronLeftIcon />\n      <span class=\"dashboard-product-edit__visually-hidden\">Back</span>\n    </Button>\n    <h1 class=\"dashboard-product-edit__product-title\">\n      Pro Controller\n    </h1>\n    <Badge\n      variant=\"outline\"\n      class=\"dashboard-product-edit__stock-badge\"\n    >\n      In stock\n    </Badge>\n    <div class=\"dashboard-product-edit__toolbar-actions\">\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n      >\n        Discard\n      </Button>\n      <Button size=\"sm\">\n        Save Product\n      </Button>\n    </div>\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-product-edit__toolbar {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 4);\n  }\n\n  button.dashboard-product-edit__back-button {\n    width: calc(var(--spacing) * 7);\n    height: calc(var(--spacing) * 7);\n  }\n\n  button.dashboard-product-edit__back-button svg {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n  }\n\n  .dashboard-product-edit__product-title {\n    flex: 1 0 0%;\n    margin: 0;\n    font-size: 1.25rem;\n    font-weight: 600;\n    letter-spacing: -0.025em;\n    line-height: 1.75rem;\n    white-space: nowrap;\n  }\n\n  .dashboard-product-edit__stock-badge {\n    margin-left: auto;\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-product-edit__product-title {\n      flex-grow: 0;\n    }\n\n    .dashboard-product-edit__stock-badge {\n      margin-left: 0;\n    }\n  }\n\n  .dashboard-product-edit__toolbar-actions {\n    display: none;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  @media (width >= 48rem) {\n    .dashboard-product-edit__toolbar-actions {\n      display: flex;\n      margin-left: auto;\n    }\n  }\n\n  .dashboard-product-edit__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    border-width: 0;\n    margin: -1px;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  HomeIcon,\n  LineChartIcon,\n  PackageIcon,\n  SettingsIcon,\n  ShoppingCartIcon,\n  Users2Icon,\n} from '@lucide/vue';\n\nexport interface NavItem {\n  label: string;\n  icon: Component;\n  isActive?: boolean;\n}\n\nexport interface BreadcrumbLinkItem {\n  label: string;\n  href: string;\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport interface StockVariant {\n  id: number;\n  sku: string;\n  stock: string;\n  price: string;\n  priceLabel: string;\n  defaultSize: string;\n}\n\nexport interface ProductImage {\n  alt: string;\n  src: string;\n  size: number;\n}\n\nexport const sidebarNavItems: NavItem[] = [\n  { label: 'Dashboard', icon: HomeIcon },\n  { label: 'Orders', icon: ShoppingCartIcon, isActive: true },\n  { label: 'Products', icon: PackageIcon },\n  { label: 'Customers', icon: Users2Icon },\n  { label: 'Analytics', icon: LineChartIcon },\n];\n\nexport const sidebarFooterNavItems: NavItem[] = [\n  { label: 'Settings', icon: SettingsIcon },\n];\n\nexport const mobileNavItems: NavItem[] = [\n  { label: 'Dashboard', icon: HomeIcon },\n  { label: 'Orders', icon: ShoppingCartIcon },\n  { label: 'Products', icon: PackageIcon, isActive: true },\n  { label: 'Customers', icon: Users2Icon },\n  { label: 'Settings', icon: LineChartIcon },\n];\n\nexport const breadcrumbLinks: BreadcrumbLinkItem[] = [\n  { label: 'Dashboard', href: '#' },\n  { label: 'Products', href: '#' },\n];\n\nexport const breadcrumbPage = 'Edit Product';\n\nexport const productName = 'Gamer Gear Pro Controller';\n\nexport const productDescription = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam auctor, nisl nec ultricies ultricies, nunc nisl ultricies nunc, nec ultricies nunc nisl nec nunc.';\n\nexport const sizeOptions: SelectOption[] = [\n  { value: 's', label: 'S' },\n  { value: 'm', label: 'M' },\n  { value: 'l', label: 'L' },\n];\n\nexport const stockVariants: StockVariant[] = [\n  { id: 1, sku: 'GGPC-001', stock: '100', price: '99.99', priceLabel: 'Price', defaultSize: 's' },\n  { id: 2, sku: 'GGPC-002', stock: '143', price: '99.99', priceLabel: 'Price', defaultSize: 'm' },\n  { id: 3, sku: 'GGPC-003', stock: '32', price: '99.99', priceLabel: 'Stock', defaultSize: 's' },\n];\n\nexport const categoryOptions: SelectOption[] = [\n  { value: 'clothing', label: 'Clothing' },\n  { value: 'electronics', label: 'Electronics' },\n  { value: 'accessories', label: 'Accessories' },\n];\n\nexport const subcategoryOptions: SelectOption[] = [\n  { value: 't-shirts', label: 'T-Shirts' },\n  { value: 'hoodies', label: 'Hoodies' },\n  { value: 'sweatshirts', label: 'Sweatshirts' },\n];\n\nexport const statusOptions: SelectOption[] = [\n  { value: 'draft', label: 'Draft' },\n  { value: 'published', label: 'Active' },\n  { value: 'archived', label: 'Archived' },\n];\n\nexport const mainProductImage: ProductImage = { alt: 'Product image', src: '/placeholder.svg', size: 300 };\n\nexport const productThumbnails: ProductImage[] = [\n  { alt: 'Product image', src: '/placeholder.svg', size: 84 },\n  { alt: 'Product image', src: '/placeholder.svg', size: 84 },\n];\n",
      "type": "registry:lib"
    }
  ],
