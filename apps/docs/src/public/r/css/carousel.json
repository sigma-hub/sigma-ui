      "path": "ui/carousel/CarouselNext.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { ArrowRightIcon } from 'lucide-vue-next';\nimport { useCarousel } from './useCarousel';\nimport { Button } from '@/components/ui/button';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\nconst props = withDefaults(defineProps<{\n  label?: string;\n}>(), {\n  label: 'Next Slide',\n});\n\nconst { orientation, canScrollNext, scrollNext } = useCarousel();\n</script>\n\n<template>\n  <Button\n    v-bind=\"delegatedAttrs()\"\n    :disabled=\"!canScrollNext\"\n    class=\"sigma-ui-carousel-next\"\n    :class=\"[\n      orientation === 'horizontal' ? 'sigma-ui-carousel-next--horizontal' : 'sigma-ui-carousel-next--vertical',\n      $attrs.class ?? '',\n    ]\"\n    variant=\"outline\"\n    data-slot=\"carousel-next\"\n    @click=\"scrollNext\"\n  >\n    <slot>\n      <ArrowRightIcon class=\"sigma-ui-carousel-next__icon\" />\n      <span class=\"sigma-ui-sr-only\">{{ props.label }}</span>\n    </slot>\n  </Button>\n</template>\n\n<style>\n.sigma-ui-carousel-next {\n  position: absolute;\n  width: 2rem;\n  height: 2rem;\n  padding: 0;\n  border-radius: var(--radius);\n  touch-action: manipulation;\n}\n\n.sigma-ui-carousel-next--horizontal {\n  top: 50%;\n  right: -3rem;\n  transform: translateY(-50%);\n}\n\n.sigma-ui-carousel-next--vertical {\n  bottom: -3rem;\n  left: 50%;\n  transform: translateX(-50%) rotate(90deg);\n}\n\n.sigma-ui-carousel-next__icon {\n  width: 1rem;\n  height: 1rem;\n}\n\n.sigma-ui-sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/carousel/CarouselPrevious.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { ArrowLeftIcon } from 'lucide-vue-next';\nimport { useCarousel } from './useCarousel';\nimport { Button } from '@/components/ui/button';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\nconst props = withDefaults(defineProps<{\n  label?: string;\n}>(), {\n  label: 'Previous Slide',\n});\n\nconst { orientation, canScrollPrev, scrollPrev } = useCarousel();\n</script>\n\n<template>\n  <Button\n    v-bind=\"delegatedAttrs()\"\n    :disabled=\"!canScrollPrev\"\n    class=\"sigma-ui-carousel-previous\"\n    :class=\"[\n      orientation === 'horizontal' ? 'sigma-ui-carousel-previous--horizontal' : 'sigma-ui-carousel-previous--vertical',\n      $attrs.class ?? '',\n    ]\"\n    variant=\"outline\"\n    data-slot=\"carousel-previous\"\n    @click=\"scrollPrev\"\n  >\n    <slot>\n      <ArrowLeftIcon class=\"sigma-ui-carousel-previous__icon\" />\n      <span class=\"sigma-ui-sr-only\">{{ props.label }}</span>\n    </slot>\n  </Button>\n</template>\n\n<style>\n.sigma-ui-carousel-previous {\n  position: absolute;\n  width: 2rem;\n  height: 2rem;\n  padding: 0;\n  border-radius: var(--radius);\n  touch-action: manipulation;\n}\n\n.sigma-ui-carousel-previous--horizontal {\n  top: 50%;\n  left: -3rem;\n  transform: translateY(-50%);\n}\n\n.sigma-ui-carousel-previous--vertical {\n  top: -3rem;\n  left: 50%;\n  transform: translateX(-50%) rotate(90deg);\n}\n\n.sigma-ui-carousel-previous__icon {\n  width: 1rem;\n  height: 1rem;\n}\n\n.sigma-ui-sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
