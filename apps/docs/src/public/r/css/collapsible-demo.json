{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "collapsible-demo",
  "type": "registry:example",
  "title": "Collapsible",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "button",
    "collapsible"
  ],
  "files": [
    {
      "path": "example/Collapsible.vue",
      "content": "<script setup lang=\"ts\">\nimport { MinusIcon, PlusIcon } from '@lucide/vue';\nimport { ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from '@/components/ui/collapsible';\n\nconst isOpen = ref(false);\n</script>\n\n<template>\n  <Collapsible\n    v-model:open=\"isOpen\"\n    class=\"example-sigma-ui-collapsible\"\n  >\n    <div class=\"example-sigma-ui-collapsible__header\">\n      <h4 class=\"example-sigma-ui-collapsible__title\">\n        Header\n      </h4>\n      <CollapsibleTrigger as-child>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          class=\"example-sigma-ui-collapsible__trigger\"\n        >\n          <MinusIcon\n            v-if=\"isOpen\"\n            class=\"example-sigma-ui-collapsible__icon\"\n          />\n          <PlusIcon\n            v-else\n            class=\"example-sigma-ui-collapsible__icon\"\n          />\n          <span class=\"sigma-ui-sr-only\">Toggle</span>\n        </Button>\n      </CollapsibleTrigger>\n    </div>\n    <div class=\"example-sigma-ui-collapsible__component\">\n      Component 1\n    </div>\n    <CollapsibleContent class=\"example-sigma-ui-collapsible__content\">\n      <div class=\"example-sigma-ui-collapsible__component\">\n        Component 2\n      </div>\n      <div class=\"example-sigma-ui-collapsible__component\">\n        Component 3\n      </div>\n    </CollapsibleContent>\n  </Collapsible>\n</template>\n\n<style>\n.example-sigma-ui-collapsible {\n  display: flex;\n  width: 350px;\n  flex-direction: column;\n  gap: calc(var(--spacing) * 2);\n}\n\n.example-sigma-ui-collapsible__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 calc(var(--spacing) * 4);\n}\n\n.example-sigma-ui-collapsible__title {\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.example-sigma-ui-collapsible__trigger {\n  width: calc(var(--spacing) * 9);\n  padding: 0;\n}\n\n.example-sigma-ui-collapsible__icon {\n  width: calc(var(--spacing) * 4);\n  height: calc(var(--spacing) * 4);\n}\n\n.example-sigma-ui-collapsible__component {\n  padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  font-family: var(--font-mono);\n  font-size: 0.875rem;\n}\n\n.example-sigma-ui-collapsible__content {\n  display: flex;\n  flex-direction: column;\n  gap: calc(var(--spacing) * 2);\n}\n\n.sigma-ui-sr-only {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
