{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-simple",
  "type": "registry:block",
  "title": "Simple login",
  "description": "A simple login form with email and password. The submit button says 'Sign in'.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "blocks/login-simple/LoginSimple.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <Card class=\"css-class-name w-full max-w-sm\">\n    <CardHeader>\n      <CardTitle class=\"text-2xl\">\n        Login\n      </CardTitle>\n      <CardDescription>\n        Enter your email below to login to your account.\n      </CardDescription>\n    </CardHeader>\n    <CardContent class=\"grid gap-4\">\n      <div class=\"grid gap-2\">\n        <Label for=\"email\">Email</Label>\n        <Input\n          id=\"email\"\n          type=\"email\"\n          placeholder=\"m@example.com\"\n          required\n        />\n      </div>\n      <div class=\"grid gap-2\">\n        <Label for=\"password\">Password</Label>\n        <Input\n          id=\"password\"\n          type=\"password\"\n          required\n        />\n      </div>\n    </CardContent>\n    <CardFooter>\n      <Button class=\"w-full\">\n        Sign in\n      </Button>\n    </CardFooter>\n  </Card>\n</template>\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "600px",
    "containerClass": "w-full h-screen flex items-center justify-center px-4"
  },
  "categories": [
    "authentication",
    "login"
  ]
}
