{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar",
  "type": "registry:ui",
  "title": "Avatar",
  "description": "An image element with a fallback for representing the user.",
  "dependencies": [
    "@lucide/vue@^1.59.0",
    "class-variance-authority@^0.7.1"
  ],
  "registryDependencies": [
    "image"
  ],
  "files": [
    {
      "path": "ui/avatar/Avatar.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { UserIcon } from '@lucide/vue';\nimport { avatarVariants } from '.';\nimport { Image, type ImageVariants } from '@/components/ui/image';\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\nconst props = withDefaults(defineProps<{\n  /** URL of the avatar image. */\n  src?: string;\n  /** Alternative text for the image. */\n  alt?: string;\n  /** Renders a blurred, saturated copy of the image behind it as a glow. */\n  glow?: boolean;\n  /** Size of the avatar. */\n  size?: 'xs' | 'sm' | 'base' | 'lg';\n  /** Corner style of the avatar: circle or rounded. */\n  shape?: ImageVariants['shape'];\n}>(), {\n  size: 'base',\n  shape: 'circle',\n});\n\ndefineSlots<{\n  /** Content shown when there is no image or it fails to load; defaults to a user icon. */\n  fallback?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"avatar\"\n    v-bind=\"delegatedAttrs()\"\n    :class=\"[avatarVariants({ size }), $attrs.class]\"\n  >\n    <Image\n      v-bind=\"props\"\n    >\n      <template #fallback>\n        <slot name=\"fallback\">\n          <UserIcon class=\"sigma-ui-avatar__fallback-icon\" />\n        </slot>\n      </template>\n    </Image>\n  </div>\n</template>\n\n<style>\n@layer components {\n  .sigma-ui-avatar {\n    display: inline-flex;\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    color: var(--foreground);\n    font-weight: normal;\n    user-select: none;\n  }\n\n  .sigma-ui-avatar__fallback-icon {\n    width: 40%;\n    height: 40%;\n    color: color-mix(in oklch, var(--primary) 50%, transparent);\n  }\n\n  .sigma-ui-avatar--xs {\n    width: calc(var(--spacing) * 6);\n    height: calc(var(--spacing) * 6);\n    font-size: 0.75rem;\n  }\n\n  .sigma-ui-avatar--sm {\n    width: calc(var(--spacing) * 10);\n    height: calc(var(--spacing) * 10);\n    font-size: 0.75rem;\n  }\n\n  .sigma-ui-avatar--base {\n    width: calc(var(--spacing) * 16);\n    height: calc(var(--spacing) * 16);\n    font-size: 1.5rem;\n  }\n\n  .sigma-ui-avatar--lg {\n    width: calc(var(--spacing) * 32);\n    height: calc(var(--spacing) * 32);\n    font-size: 3rem;\n  }\n}\n</style>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/avatar/index.ts",
      "content": "import { type VariantProps, cva } from 'class-variance-authority';\n\nexport { default as Avatar } from './Avatar.vue';\n\nexport const avatarVariants = cva(\n  'sigma-ui-avatar',\n  {\n    variants: {\n      size: {\n        xs: 'sigma-ui-avatar--xs',\n        sm: 'sigma-ui-avatar--sm',\n        base: 'sigma-ui-avatar--base',\n        lg: 'sigma-ui-avatar--lg',\n      },\n    },\n  },\n);\n\nexport type AvatarVariants = VariantProps<typeof avatarVariants>;\n",
      "type": "registry:ui"
    }
  ]
}
