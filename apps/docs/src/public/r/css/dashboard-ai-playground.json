{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-ai-playground",
  "type": "registry:block",
  "title": "AI playground",
  "description": "An AI playground with a sidebar navigation and a main content area. The playground has a header with a settings drawer and a share button. The sidebar has navigation links and a user menu. The main content area shows a form to configure the model and messages.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "drawer",
    "input",
    "label",
    "select",
    "textarea",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-ai-playground/DashboardAiPlayground.vue",
      "content": "<script setup lang=\"ts\">\nimport AppSidebar from './components/AppSidebar.vue';\nimport ChatPanel from './components/ChatPanel.vue';\nimport ConfigurationForm from './components/ConfigurationForm.vue';\nimport PlaygroundHeader from './components/PlaygroundHeader.vue';\n</script>\n\n<template>\n  <div class=\"dashboard-ai-playground\">\n    <AppSidebar />\n    <div class=\"dashboard-ai-playground__column\">\n      <PlaygroundHeader />\n      <main class=\"dashboard-ai-playground__main\">\n        <ConfigurationForm />\n        <ChatPanel />\n      </main>\n    </div>\n  </div>\n</template>\n\n<style>\n.dashboard-ai-playground {\n  display: grid;\n  width: 100%;\n  height: 100vh;\n  padding-left: 56px;\n}\n\n.dashboard-ai-playground__column {\n  display: flex;\n  min-width: 0;\n  min-height: 0;\n  flex-direction: column;\n}\n\n.dashboard-ai-playground__main {\n  display: grid;\n  overflow: auto;\n  min-height: 0;\n  flex: 1 1 0%;\n  padding: 1rem;\n  gap: 1rem;\n}\n\n@media (width >= 48rem) {\n  .dashboard-ai-playground__main {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (width >= 64rem) {\n  .dashboard-ai-playground__main {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { TriangleIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';\nimport { primaryNavItems, secondaryNavItems } from '../data';\n</script>\n\n<template>\n  <aside class=\"dashboard-ai-playground__sidebar\">\n    <div class=\"dashboard-ai-playground__brand\">\n      <Button\n        variant=\"outline\"\n        size=\"icon\"\n        aria-label=\"Home\"\n      >\n        <TriangleIcon />\n      </Button>\n    </div>\n    <nav class=\"dashboard-ai-playground__nav\">\n      <TooltipProvider\n        v-for=\"item in primaryNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              class=\"dashboard-ai-playground__nav-button\"\n              :class=\"{ 'dashboard-ai-playground__nav-button--active': item.isActive }\"\n              :aria-label=\"item.label\"\n            >\n              <component :is=\"item.icon\" />\n            </Button>\n          </TooltipTrigger>\n          <TooltipContent\n            side=\"right\"\n            :side-offset=\"5\"\n          >\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"dashboard-ai-playground__nav dashboard-ai-playground__nav--end\">\n      <TooltipProvider\n        v-for=\"item in secondaryNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              class=\"dashboard-ai-playground__nav-button dashboard-ai-playground__nav-button--pinned\"\n              :aria-label=\"item.label\"\n            >\n              <component :is=\"item.icon\" />\n            </Button>\n          </TooltipTrigger>\n          <TooltipContent\n            side=\"right\"\n            :side-offset=\"5\"\n          >\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n\n<style>\n.dashboard-ai-playground__sidebar {\n  position: fixed;\n  z-index: 20;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  display: flex;\n  height: 100%;\n  flex-direction: column;\n  border-right: 1px solid var(--border);\n}\n\n.dashboard-ai-playground__brand {\n  padding: 0.5rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.dashboard-ai-playground__brand svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  fill: var(--foreground);\n}\n\n.dashboard-ai-playground__nav {\n  display: grid;\n  padding: 0.5rem;\n  gap: 0.25rem;\n}\n\n.dashboard-ai-playground__nav--end {\n  margin-top: auto;\n}\n\nbutton.dashboard-ai-playground__nav-button--pinned {\n  margin-top: auto;\n}\n\nbutton.dashboard-ai-playground__nav-button svg {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\nbutton.dashboard-ai-playground__nav-button--active {\n  background-color: var(--muted);\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/ChatPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport { CornerDownLeftIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Label } from '@/components/ui/label';\nimport { Textarea } from '@/components/ui/textarea';\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';\nimport { chatActions } from '../data';\n</script>\n\n<template>\n  <div class=\"dashboard-ai-playground__chat\">\n    <Badge\n      variant=\"outline\"\n      class=\"dashboard-ai-playground__output-badge\"\n    >\n      Output\n    </Badge>\n    <div class=\"dashboard-ai-playground__chat-spacer\" />\n    <form class=\"dashboard-ai-playground__composer\">\n      <Label\n        for=\"message\"\n        class=\"dashboard-ai-playground__visually-hidden\"\n      >\n        Message\n      </Label>\n      <Textarea\n        id=\"message\"\n        placeholder=\"Type your message here...\"\n        class=\"dashboard-ai-playground__message-input\"\n      />\n      <div class=\"dashboard-ai-playground__composer-actions\">\n        <TooltipProvider\n          v-for=\"action in chatActions\"\n          :key=\"action.label\"\n        >\n          <Tooltip>\n            <TooltipTrigger as-child>\n              <Button\n                variant=\"ghost\"\n                size=\"icon\"\n                class=\"dashboard-ai-playground__action-button\"\n              >\n                <component :is=\"action.icon\" />\n                <span class=\"dashboard-ai-playground__visually-hidden\">{{ action.label }}</span>\n              </Button>\n            </TooltipTrigger>\n            <TooltipContent side=\"top\">\n              {{ action.tooltip }}\n            </TooltipContent>\n          </Tooltip>\n        </TooltipProvider>\n        <Button\n          type=\"submit\"\n          size=\"sm\"\n          class=\"dashboard-ai-playground__send-button\"\n        >\n          Send Message\n          <CornerDownLeftIcon />\n        </Button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<style>\n.dashboard-ai-playground__chat {\n  position: relative;\n  display: flex;\n  height: 100%;\n  min-height: 50vh;\n  flex-direction: column;\n  padding: 1rem;\n  border-radius: var(--radius-xl);\n  background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n}\n\n@media (width >= 64rem) {\n  .dashboard-ai-playground__chat {\n    grid-column: span 2 / span 2;\n  }\n}\n\n.dashboard-ai-playground__output-badge {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n}\n\n.dashboard-ai-playground__chat-spacer {\n  flex: 1 1 0%;\n}\n\n.dashboard-ai-playground__composer {\n  position: relative;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  background-color: var(--background);\n}\n\n.dashboard-ai-playground__composer:focus-within {\n  box-shadow: 0 0 0 1px var(--ring);\n}\n\ntextarea.dashboard-ai-playground__message-input {\n  min-height: 3rem;\n  padding: 0.75rem;\n  border-width: 0;\n  box-shadow: none;\n  resize: none;\n}\n\ntextarea.dashboard-ai-playground__message-input:focus-visible {\n  outline: none;\n}\n\n.dashboard-ai-playground__composer-actions {\n  display: flex;\n  align-items: center;\n  padding: 0 0.75rem 0.75rem;\n}\n\nbutton.dashboard-ai-playground__action-button svg {\n  width: 1rem;\n  height: 1rem;\n}\n\nbutton.dashboard-ai-playground__send-button {\n  margin-left: auto;\n  gap: 0.375rem;\n}\n\nbutton.dashboard-ai-playground__send-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n.dashboard-ai-playground__visually-hidden {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/ConfigurationDrawer.vue",
      "content": "<script setup lang=\"ts\">\nimport { Settings2Icon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Drawer, DrawerContent, DrawerDescription, DrawerHeader, DrawerTitle, DrawerTrigger } from '@/components/ui/drawer';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Textarea } from '@/components/ui/textarea';\nimport { samplingFields, temperatureField } from '../data';\nimport ModelSelect from './ModelSelect.vue';\nimport RoleSelect from './RoleSelect.vue';\n\nconst parameterFields = [temperatureField, ...samplingFields];\n</script>\n\n<template>\n  <Drawer>\n    <DrawerTrigger as-child>\n      <Button\n        variant=\"ghost\"\n        size=\"icon\"\n        class=\"dashboard-ai-playground__settings-button\"\n      >\n        <Settings2Icon />\n        <span class=\"dashboard-ai-playground__visually-hidden\">Settings</span>\n      </Button>\n    </DrawerTrigger>\n    <DrawerContent class=\"dashboard-ai-playground__drawer\">\n      <DrawerHeader>\n        <DrawerTitle>Configuration</DrawerTitle>\n        <DrawerDescription>\n          Configure the settings for the model and messages.\n        </DrawerDescription>\n      </DrawerHeader>\n      <form class=\"dashboard-ai-playground__drawer-form\">\n        <fieldset class=\"dashboard-ai-playground__fieldset\">\n          <legend class=\"dashboard-ai-playground__legend\">\n            Settings\n          </legend>\n          <div class=\"dashboard-ai-playground__field\">\n            <Label for=\"model\">Model</Label>\n            <ModelSelect />\n          </div>\n          <div\n            v-for=\"field in parameterFields\"\n            :key=\"field.id\"\n            class=\"dashboard-ai-playground__field\"\n          >\n            <Label :for=\"field.id\">{{ field.label }}</Label>\n            <Input\n              :id=\"field.id\"\n              type=\"number\"\n              :placeholder=\"field.placeholder\"\n            />\n          </div>\n        </fieldset>\n        <fieldset class=\"dashboard-ai-playground__fieldset\">\n          <legend class=\"dashboard-ai-playground__legend\">\n            Messages\n          </legend>\n          <div class=\"dashboard-ai-playground__field\">\n            <Label for=\"role\">Role</Label>\n            <RoleSelect />\n          </div>\n          <div class=\"dashboard-ai-playground__field\">\n            <Label for=\"content\">Content</Label>\n            <Textarea\n              id=\"content\"\n              placeholder=\"You are a...\"\n            />\n          </div>\n        </fieldset>\n      </form>\n    </DrawerContent>\n  </Drawer>\n</template>\n\n<style>\n@media (width >= 48rem) {\n  button.dashboard-ai-playground__settings-button {\n    display: none;\n  }\n}\n\nbutton.dashboard-ai-playground__settings-button svg {\n  width: 1rem;\n  height: 1rem;\n}\n\n.dashboard-ai-playground__drawer {\n  max-height: 80vh;\n}\n\n.dashboard-ai-playground__drawer-form {\n  display: grid;\n  overflow: auto;\n  width: 100%;\n  align-items: start;\n  padding: 0 1rem 1rem;\n  gap: 1.5rem;\n}\n\n.dashboard-ai-playground__fieldset {\n  display: grid;\n  min-width: 0;\n  padding: 1rem;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  gap: 1.5rem;\n}\n\n.dashboard-ai-playground__legend {\n  padding-right: 0.25rem;\n  padding-left: 0.25rem;\n  margin-left: -0.25rem;\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.25rem;\n}\n\n.dashboard-ai-playground__field {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.dashboard-ai-playground__visually-hidden {\n  position: absolute;\n  overflow: hidden;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  border-width: 0;\n  margin: -1px;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/ConfigurationForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Textarea } from '@/components/ui/textarea';\nimport { samplingFields, temperatureField } from '../data';\nimport ModelSelect from './ModelSelect.vue';\nimport RoleSelect from './RoleSelect.vue';\n</script>\n\n<template>\n  <div class=\"dashboard-ai-playground__configuration\">\n    <form class=\"dashboard-ai-playground__form\">\n      <fieldset class=\"dashboard-ai-playground__fieldset\">\n        <legend class=\"dashboard-ai-playground__legend\">\n          Settings\n        </legend>\n        <div class=\"dashboard-ai-playground__field\">\n          <Label for=\"model\">Model</Label>\n          <ModelSelect />\n        </div>\n        <div class=\"dashboard-ai-playground__field\">\n          <Label :for=\"temperatureField.id\">{{ temperatureField.label }}</Label>\n          <Input\n            :id=\"temperatureField.id\"\n            type=\"number\"\n            :placeholder=\"temperatureField.placeholder\"\n          />\n        </div>\n        <div class=\"dashboard-ai-playground__sampling\">\n          <div\n            v-for=\"field in samplingFields\"\n            :key=\"field.id\"\n            class=\"dashboard-ai-playground__field\"\n          >\n            <Label :for=\"field.id\">{{ field.label }}</Label>\n            <Input\n              :id=\"field.id\"\n              type=\"number\"\n              :placeholder=\"field.placeholder\"\n            />\n          </div>\n        </div>\n      </fieldset>\n      <fieldset class=\"dashboard-ai-playground__fieldset\">\n        <legend class=\"dashboard-ai-playground__legend\">\n          Messages\n        </legend>\n        <div class=\"dashboard-ai-playground__field\">\n          <Label for=\"role\">Role</Label>\n          <RoleSelect />\n        </div>\n        <div class=\"dashboard-ai-playground__field\">\n          <Label for=\"content\">Content</Label>\n          <Textarea\n            id=\"content\"\n            placeholder=\"You are a...\"\n            class=\"dashboard-ai-playground__content-input\"\n          />\n        </div>\n      </fieldset>\n    </form>\n  </div>\n</template>\n\n<style>\n.dashboard-ai-playground__configuration {\n  position: relative;\n  display: none;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 2rem;\n}\n\n@media (width >= 48rem) {\n  .dashboard-ai-playground__configuration {\n    display: flex;\n  }\n}\n\n.dashboard-ai-playground__form {\n  display: grid;\n  width: 100%;\n  align-items: start;\n  gap: 1.5rem;\n}\n\n.dashboard-ai-playground__fieldset {\n  display: grid;\n  min-width: 0;\n  padding: 1rem;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  gap: 1.5rem;\n}\n\n.dashboard-ai-playground__legend {\n  padding-right: 0.25rem;\n  padding-left: 0.25rem;\n  margin-left: -0.25rem;\n  font-size: 0.875rem;\n  font-weight: 500;\n  line-height: 1.25rem;\n}\n\n.dashboard-ai-playground__field {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.dashboard-ai-playground__sampling {\n  display: grid;\n  gap: 1rem;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\ntextarea.dashboard-ai-playground__content-input {\n  min-height: 9.5rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/ModelSelect.vue",
      "content": "<script setup lang=\"ts\">\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { modelOptions } from '../data';\n</script>\n\n<template>\n  <Select>\n    <SelectTrigger\n      id=\"model\"\n      class=\"dashboard-ai-playground__model-trigger\"\n    >\n      <SelectValue placeholder=\"Select a model\" />\n    </SelectTrigger>\n    <SelectContent>\n      <SelectItem\n        v-for=\"option in modelOptions\"\n        :key=\"option.value\"\n        :value=\"option.value\"\n      >\n        <div class=\"dashboard-ai-playground__model-option\">\n          <component :is=\"option.icon\" />\n          <div class=\"dashboard-ai-playground__model-copy\">\n            <p class=\"dashboard-ai-playground__model-line\">\n              Neural\n              <span class=\"dashboard-ai-playground__model-name\">\n                {{ option.name }}\n              </span>\n            </p>\n            <p\n              class=\"dashboard-ai-playground__model-description\"\n              data-description\n            >\n              {{ option.description }}\n            </p>\n          </div>\n        </div>\n      </SelectItem>\n    </SelectContent>\n  </Select>\n</template>\n\n<style>\n.sigma-ui-select-trigger.dashboard-ai-playground__model-trigger {\n  align-items: flex-start;\n}\n\n.dashboard-ai-playground__model-trigger [data-description] {\n  display: none;\n}\n\n.dashboard-ai-playground__model-option {\n  display: flex;\n  align-items: flex-start;\n  color: var(--muted-foreground);\n  gap: 0.75rem;\n}\n\n.dashboard-ai-playground__model-option svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  flex-shrink: 0;\n}\n\n.dashboard-ai-playground__model-copy {\n  display: grid;\n  gap: 0.125rem;\n}\n\n.dashboard-ai-playground__model-line {\n  margin: 0;\n}\n\n.dashboard-ai-playground__model-name {\n  color: var(--foreground);\n  font-weight: 500;\n}\n\n.dashboard-ai-playground__model-description {\n  margin: 0;\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/PlaygroundHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { ShareIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport ConfigurationDrawer from './ConfigurationDrawer.vue';\n</script>\n\n<template>\n  <header class=\"dashboard-ai-playground__header\">\n    <h1 class=\"dashboard-ai-playground__title\">\n      Playground\n    </h1>\n    <ConfigurationDrawer />\n    <Button\n      variant=\"outline\"\n      size=\"sm\"\n      class=\"dashboard-ai-playground__share-button\"\n    >\n      <ShareIcon />\n      Share\n    </Button>\n  </header>\n</template>\n\n<style>\n.dashboard-ai-playground__header {\n  position: sticky;\n  z-index: 10;\n  top: 0;\n  display: flex;\n  height: 57px;\n  align-items: center;\n  padding-right: 1rem;\n  padding-left: 1rem;\n  border-bottom: 1px solid var(--border);\n  background-color: var(--background);\n  gap: 0.25rem;\n}\n\n.dashboard-ai-playground__title {\n  margin: 0;\n  font-size: 1.25rem;\n  font-weight: 600;\n  line-height: 1.75rem;\n}\n\nbutton.dashboard-ai-playground__share-button {\n  margin-left: auto;\n  font-size: 0.875rem;\n  gap: 0.375rem;\n}\n\nbutton.dashboard-ai-playground__share-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/components/RoleSelect.vue",
      "content": "<script setup lang=\"ts\">\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { roleOptions } from '../data';\n</script>\n\n<template>\n  <Select default-value=\"system\">\n    <SelectTrigger>\n      <SelectValue placeholder=\"Select a role\" />\n    </SelectTrigger>\n    <SelectContent>\n      <SelectItem\n        v-for=\"role in roleOptions\"\n        :key=\"role.value\"\n        :value=\"role.value\"\n      >\n        {{ role.label }}\n      </SelectItem>\n    </SelectContent>\n  </Select>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-ai-playground/data.ts",
      "content": "import type { Component } from 'vue';\nimport { BirdIcon, BookIcon, BotIcon, Code2Icon, LifeBuoyIcon, MicIcon, PaperclipIcon, RabbitIcon, Settings2Icon, SquareTerminalIcon, SquareUserIcon, TurtleIcon } from 'lucide-vue-next';\n\nexport interface NavItem {\n  label: string;\n  icon: Component;\n  isActive?: boolean;\n}\n\nexport interface ModelOption {\n  value: string;\n  name: string;\n  description: string;\n  icon: Component;\n}\n\nexport interface RoleOption {\n  value: string;\n  label: string;\n}\n\nexport interface ParameterField {\n  id: string;\n  label: string;\n  placeholder: string;\n}\n\nexport interface ChatAction {\n  label: string;\n  tooltip: string;\n  icon: Component;\n}\n\nexport const primaryNavItems: NavItem[] = [\n  { label: 'Playground', icon: SquareTerminalIcon, isActive: true },\n  { label: 'Models', icon: BotIcon },\n  { label: 'API', icon: Code2Icon },\n  { label: 'Documentation', icon: BookIcon },\n  { label: 'Settings', icon: Settings2Icon },\n];\n\nexport const secondaryNavItems: NavItem[] = [\n  { label: 'Help', icon: LifeBuoyIcon },\n  { label: 'Account', icon: SquareUserIcon },\n];\n\nexport const modelOptions: ModelOption[] = [\n  {\n    value: 'genesis',\n    name: 'Genesis',\n    description: 'Our fastest model for general use cases.',\n    icon: RabbitIcon,\n  },\n  {\n    value: 'explorer',\n    name: 'Explorer',\n    description: 'Performance and speed for efficiency.',\n    icon: BirdIcon,\n  },\n  {\n    value: 'quantum',\n    name: 'Quantum',\n    description: 'The most powerful model for complex computations.',\n    icon: TurtleIcon,\n  },\n];\n\nexport const roleOptions: RoleOption[] = [\n  { value: 'system', label: 'System' },\n  { value: 'user', label: 'User' },\n  { value: 'assistant', label: 'Assistant' },\n];\n\nexport const temperatureField: ParameterField = {\n  id: 'temperature',\n  label: 'Temperature',\n  placeholder: '0.4',\n};\n\nexport const samplingFields: ParameterField[] = [\n  { id: 'top-p', label: 'Top P', placeholder: '0.7' },\n  { id: 'top-k', label: 'Top K', placeholder: '0.0' },\n];\n\nexport const chatActions: ChatAction[] = [\n  { label: 'Attach file', tooltip: 'Attach File', icon: PaperclipIcon },\n  { label: 'Use Microphone', tooltip: 'Use Microphone', icon: MicIcon },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "740px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
