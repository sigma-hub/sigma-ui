{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "carousel-api",
  "type": "registry:example",
  "title": "CarouselApi",
  "dependencies": [
    "@vueuse/core@^14.4.0"
  ],
  "registryDependencies": [
    "carousel"
  ],
  "files": [
    {
      "path": "example/CarouselApi.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { watchOnce } from '@vueuse/core';\nimport type { CarouselApi } from '@/components/ui/carousel';\nimport { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel';\n\nconst api = ref<CarouselApi>();\nconst totalCount = ref(0);\nconst current = ref(0);\n\nfunction setApi(val: CarouselApi) {\n  api.value = val;\n}\n\nwatchOnce(api, (api) => {\n  if (!api) {\n    return;\n  }\n\n  totalCount.value = api.scrollSnapList().length;\n  current.value = api.selectedScrollSnap() + 1;\n\n  api.on('select', () => {\n    current.value = api.selectedScrollSnap() + 1;\n  });\n});\n</script>\n\n<template>\n  <div class=\"example-sigma-ui-carousel-api\">\n    <Carousel\n      class=\"example-sigma-ui-carousel-api__carousel\"\n      @init-api=\"setApi\"\n    >\n      <CarouselContent>\n        <CarouselItem\n          v-for=\"(_, index) in 5\"\n          :key=\"index\"\n        >\n          <div class=\"example-sigma-ui-carousel-api__slide\">\n            <div class=\"example-sigma-ui-carousel-api__item\">\n              {{ index + 1 }}\n            </div>\n          </div>\n        </CarouselItem>\n      </CarouselContent>\n      <CarouselPrevious />\n      <CarouselNext />\n    </Carousel>\n\n    <div class=\"example-sigma-ui-carousel-api__counter\">\n      Slide {{ current }} of {{ totalCount }}\n    </div>\n  </div>\n</template>\n\n<style>\n.example-sigma-ui-carousel-api {\n  width: 100%;\n}\n\n@media (width >= 40rem) {\n  .example-sigma-ui-carousel-api {\n    width: auto;\n  }\n}\n\n.example-sigma-ui-carousel-api__carousel {\n  position: relative;\n  width: 100%;\n  max-width: 20rem;\n}\n\n.example-sigma-ui-carousel-api__slide {\n  padding: calc(var(--spacing) * 1);\n}\n\n.example-sigma-ui-carousel-api__item {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: calc(var(--spacing) * 6);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  aspect-ratio: 1;\n  font-size: 2.25rem;\n  font-weight: 600;\n  user-select: none;\n}\n\n.example-sigma-ui-carousel-api__counter {\n  padding-top: calc(var(--spacing) * 2);\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  text-align: center;\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
