{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-inset-variant",
  "type": "registry:example",
  "title": "SidebarInsetVariant",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "separator",
    "sidebar"
  ],
  "files": [
    {
      "path": "example/SidebarInsetVariant.vue",
      "content": "<script setup lang=\"ts\">\nimport { FolderIcon, HomeIcon, InboxIcon, UsersIcon } from '@lucide/vue';\nimport { Separator } from '@/components/ui/separator';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarTrigger,\n} from '@/components/ui/sidebar';\n\nconst items = [\n  { title: 'Home', icon: HomeIcon, isActive: true },\n  { title: 'Inbox', icon: InboxIcon },\n  { title: 'Projects', icon: FolderIcon },\n  { title: 'Team', icon: UsersIcon },\n];\n</script>\n\n<template>\n  <div class=\"example-sidebar-inset\">\n    <SidebarProvider\n      cookie-name=\"\"\n      class=\"example-sidebar-inset__provider\"\n    >\n      <Sidebar\n        variant=\"inset\"\n        class=\"example-sidebar-inset__sidebar\"\n      >\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem\n                  v-for=\"item in items\"\n                  :key=\"item.title\"\n                >\n                  <SidebarMenuButton :is-active=\"item.isActive\">\n                    <component :is=\"item.icon\" />\n                    <span>{{ item.title }}</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n      </Sidebar>\n      <SidebarInset>\n        <header class=\"example-sidebar-inset__header\">\n          <SidebarTrigger />\n          <Separator\n            orientation=\"vertical\"\n            class=\"example-sidebar-inset__separator\"\n          />\n          <span class=\"example-sidebar-inset__title\">Home</span>\n        </header>\n        <div class=\"example-sidebar-inset__body\">\n          <div class=\"example-sidebar-inset__panel\" />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  </div>\n</template>\n\n<style>\n@layer components {\n  .example-sidebar-inset {\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n    height: 420px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    transform: translateZ(0);\n  }\n\n  .example-sidebar-inset .example-sidebar-inset__provider {\n    height: 100%;\n    min-height: 100%;\n  }\n\n  .example-sidebar-inset .example-sidebar-inset__sidebar {\n    height: 100%;\n  }\n\n  .example-sidebar-inset__header {\n    display: flex;\n    height: calc(var(--spacing) * 12);\n    flex-shrink: 0;\n    align-items: center;\n    padding: 0 calc(var(--spacing) * 4);\n    border-bottom: 1px solid var(--border);\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .example-sidebar-inset .example-sidebar-inset__separator {\n    height: calc(var(--spacing) * 4);\n    margin-right: calc(var(--spacing) * 2);\n  }\n\n  .example-sidebar-inset__title {\n    font-size: 0.875rem;\n    font-weight: 500;\n  }\n\n  .example-sidebar-inset__body {\n    display: flex;\n    flex: 1;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n  }\n\n  .example-sidebar-inset__panel {\n    flex: 1;\n    border-radius: calc(var(--radius) + 4px);\n    background-color: color-mix(in oklch, var(--muted) 50%, transparent);\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
