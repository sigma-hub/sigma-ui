{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-command-palette",
  "type": "registry:block",
  "title": "Command palette",
  "description": "A Ctrl+K command palette with recent commands, grouped actions and navigation, key hints and a search box trigger.",
  "dependencies": [
    "@lucide/vue@^1.59.0",
    "@vueuse/core@^15.0.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "command",
    "dialog",
    "empty",
    "kbd"
  ],
  "files": [
    {
      "path": "blocks/dashboard-command-palette/DashboardCommandPalette.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { useEventListener } from '@vueuse/core';\nimport { SearchIcon, SparklesIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';\nimport { Kbd, KbdGroup } from '@/components/ui/kbd';\nimport CommandPalette from './components/CommandPalette.vue';\nimport { commands, initialRecentIds, maxRecentCommands, pageDescription, pageTitle, triggerLabel } from './data';\nimport type { PaletteCommand } from './data';\n\nconst isPaletteOpen = ref(false);\nconst recentIds = ref<string[]>([...initialRecentIds]);\nconst lastCommand = ref<PaletteCommand | null>(null);\nconst recentCommands = computed(() => {\n  return recentIds.value\n    .map(id => commands.find(command => command.id === id))\n    .filter((command): command is PaletteCommand => Boolean(command));\n});\n\nuseEventListener(window, 'keydown', (event: KeyboardEvent) => {\n  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {\n    event.preventDefault();\n    isPaletteOpen.value = !isPaletteOpen.value;\n  }\n});\n\nfunction runCommand(command: PaletteCommand) {\n  lastCommand.value = command;\n  recentIds.value = [command.id, ...recentIds.value.filter(id => id !== command.id)].slice(0, maxRecentCommands);\n}\n</script>\n\n<template>\n  <div class=\"dashboard-command-palette\">\n    <header class=\"dashboard-command-palette__header\">\n      <h2 class=\"dashboard-command-palette__title\">\n        {{ pageTitle }}\n      </h2>\n      <p class=\"dashboard-command-palette__description\">\n        {{ pageDescription }}\n      </p>\n    </header>\n\n    <Button\n      variant=\"outline\"\n      class=\"dashboard-command-palette__trigger\"\n      aria-keyshortcuts=\"Control+K Meta+K\"\n      @click=\"isPaletteOpen = true\"\n    >\n      <SearchIcon />\n      <span class=\"dashboard-command-palette__trigger-label\">{{ triggerLabel }}</span>\n      <KbdGroup>\n        <Kbd>Ctrl</Kbd>\n        <Kbd>K</Kbd>\n      </KbdGroup>\n    </Button>\n\n    <section\n      class=\"dashboard-command-palette__result\"\n      aria-live=\"polite\"\n    >\n      <Empty\n        v-if=\"!lastCommand\"\n        class=\"dashboard-command-palette__empty\"\n      >\n        <EmptyHeader>\n          <EmptyMedia variant=\"icon\">\n            <SparklesIcon />\n          </EmptyMedia>\n          <EmptyTitle>No command run yet</EmptyTitle>\n          <EmptyDescription>\n            Press Ctrl K or use the search box above, then pick a command to run it.\n          </EmptyDescription>\n        </EmptyHeader>\n      </Empty>\n      <div\n        v-else\n        class=\"dashboard-command-palette__last-command\"\n      >\n        <component\n          :is=\"lastCommand.icon\"\n          class=\"dashboard-command-palette__last-icon\"\n        />\n        <div class=\"dashboard-command-palette__last-text\">\n          <span class=\"dashboard-command-palette__last-caption\">Last command</span>\n          <span class=\"dashboard-command-palette__last-label\">{{ lastCommand.label }}</span>\n        </div>\n        <Badge variant=\"secondary\">\n          {{ lastCommand.group }}\n        </Badge>\n      </div>\n\n      <div\n        v-if=\"recentCommands.length > 0\"\n        class=\"dashboard-command-palette__recents\"\n      >\n        <span class=\"dashboard-command-palette__recents-label\">Recent</span>\n        <Button\n          v-for=\"command in recentCommands\"\n          :key=\"command.id\"\n          variant=\"secondary\"\n          size=\"sm\"\n          @click=\"runCommand(command)\"\n        >\n          <component :is=\"command.icon\" />\n          {{ command.label }}\n        </Button>\n      </div>\n    </section>\n\n    <CommandPalette\n      v-model:open=\"isPaletteOpen\"\n      :commands=\"commands\"\n      :recent-ids=\"recentIds\"\n      @select=\"runCommand\"\n    />\n  </div>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-command-palette {\n    display: flex;\n    width: 100%;\n    max-width: 48rem;\n    flex-direction: column;\n    padding: calc(var(--spacing) * 4);\n    margin-inline: auto;\n    gap: calc(var(--spacing) * 6);\n  }\n\n  .dashboard-command-palette__header {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 1);\n  }\n\n  .dashboard-command-palette__title {\n    margin: 0;\n    font-size: 1.5rem;\n    font-weight: 700;\n    letter-spacing: -0.025em;\n    line-height: 2rem;\n  }\n\n  .dashboard-command-palette__description {\n    margin: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-command-palette__trigger.dashboard-command-palette__trigger {\n    width: 100%;\n    height: calc(var(--spacing) * 10);\n    justify-content: flex-start;\n    color: var(--muted-foreground);\n    font-weight: 400;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-command-palette__trigger-label {\n    flex: 1;\n    text-align: left;\n  }\n\n  .dashboard-command-palette__result {\n    display: flex;\n    flex-direction: column;\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-command-palette__empty.dashboard-command-palette__empty {\n    border: 1px dashed var(--border);\n  }\n\n  .dashboard-command-palette__last-command {\n    display: flex;\n    align-items: center;\n    padding: calc(var(--spacing) * 4);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    gap: calc(var(--spacing) * 3);\n  }\n\n  .dashboard-command-palette__last-icon {\n    width: calc(var(--spacing) * 5);\n    height: calc(var(--spacing) * 5);\n    flex-shrink: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-command-palette__last-text {\n    display: flex;\n    min-width: 0;\n    flex: 1;\n    flex-direction: column;\n  }\n\n  .dashboard-command-palette__last-caption {\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n  }\n\n  .dashboard-command-palette__last-label {\n    overflow: hidden;\n    font-weight: 500;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .dashboard-command-palette__recents {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-command-palette__recents-label {\n    color: var(--muted-foreground);\n    font-size: 0.875rem;\n  }\n\n  @media (width >= 40rem) {\n    .dashboard-command-palette {\n      padding: calc(var(--spacing) * 6);\n    }\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-command-palette/components/CommandPalette.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, watch } from 'vue';\nimport { ClockIcon } from '@lucide/vue';\nimport {\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandShortcut,\n} from '@/components/ui/command';\nimport { DialogDescription, DialogTitle } from '@/components/ui/dialog';\nimport { Kbd, KbdGroup } from '@/components/ui/kbd';\nimport type { PaletteCommand } from '../data';\n\nconst props = defineProps<{\n  commands: PaletteCommand[];\n  recentIds: string[];\n}>();\n\nconst open = defineModel<boolean>('open', { default: false });\n\nconst emit = defineEmits<{\n  select: [command: PaletteCommand];\n}>();\n\nconst query = ref('');\nconst isSearching = computed(() => query.value.trim().length > 0);\n\nconst recentCommands = computed(() => {\n  return props.recentIds\n    .map(id => props.commands.find(command => command.id === id))\n    .filter((command): command is PaletteCommand => Boolean(command));\n});\n\n/** While the search is empty, recent commands move to their own group so no command is listed twice. */\nconst groups = computed(() => {\n  const recentIdSet = new Set(isSearching.value ? [] : props.recentIds);\n  const visible = props.commands.filter(command => !recentIdSet.has(command.id));\n\n  return [...new Set(visible.map(command => command.group))].map(name => ({\n    name,\n    commands: visible.filter(command => command.group === name),\n  }));\n});\n\nwatch(open, (isOpen) => {\n  if (isOpen) {\n    query.value = '';\n  }\n});\n\nfunction onInput(event: Event) {\n  query.value = (event.target as HTMLInputElement).value;\n}\n\nfunction select(command: PaletteCommand) {\n  emit('select', command);\n  open.value = false;\n}\n</script>\n\n<template>\n  <CommandDialog v-model:open=\"open\">\n    <DialogTitle class=\"dashboard-command-palette__visually-hidden\">\n      Command palette\n    </DialogTitle>\n    <DialogDescription class=\"dashboard-command-palette__visually-hidden\">\n      Search for a command and press Enter to run it.\n    </DialogDescription>\n    <CommandInput\n      placeholder=\"Type a command or search…\"\n      @input=\"onInput\"\n    />\n    <CommandList>\n      <CommandEmpty>No commands found.</CommandEmpty>\n      <CommandGroup\n        v-if=\"!isSearching && recentCommands.length > 0\"\n        heading=\"Recent\"\n      >\n        <CommandItem\n          v-for=\"command in recentCommands\"\n          :key=\"command.id\"\n          :value=\"command.id\"\n          class=\"dashboard-command-palette__item\"\n          @select=\"select(command)\"\n        >\n          <ClockIcon class=\"dashboard-command-palette__item-icon\" />\n          {{ command.label }}\n        </CommandItem>\n      </CommandGroup>\n      <CommandGroup\n        v-for=\"group in groups\"\n        :key=\"group.name\"\n        :heading=\"group.name\"\n      >\n        <CommandItem\n          v-for=\"command in group.commands\"\n          :key=\"command.id\"\n          :value=\"command.id\"\n          :keywords=\"[command.label, ...(command.keywords ?? [])]\"\n          class=\"dashboard-command-palette__item\"\n          @select=\"select(command)\"\n        >\n          <component\n            :is=\"command.icon\"\n            class=\"dashboard-command-palette__item-icon\"\n          />\n          {{ command.label }}\n          <CommandShortcut v-if=\"command.shortcut\">\n            <KbdGroup>\n              <Kbd\n                v-for=\"key in command.shortcut\"\n                :key=\"key\"\n              >\n                {{ key }}\n              </Kbd>\n            </KbdGroup>\n          </CommandShortcut>\n        </CommandItem>\n      </CommandGroup>\n    </CommandList>\n    <div class=\"dashboard-command-palette__footer\">\n      <span class=\"dashboard-command-palette__hint\"><Kbd>↑</Kbd><Kbd>↓</Kbd> Navigate</span>\n      <span class=\"dashboard-command-palette__hint\"><Kbd>Enter</Kbd> Run</span>\n      <span class=\"dashboard-command-palette__hint dashboard-command-palette__hint-close\"><Kbd>Esc</Kbd> Close</span>\n    </div>\n  </CommandDialog>\n</template>\n\n<style>\n@layer base, components;\n\n@layer components {\n  .dashboard-command-palette__visually-hidden {\n    position: absolute;\n    overflow: hidden;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    border: 0;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  .dashboard-command-palette__item.dashboard-command-palette__item {\n    gap: calc(var(--spacing) * 2);\n  }\n\n  .dashboard-command-palette__item-icon {\n    width: calc(var(--spacing) * 4);\n    height: calc(var(--spacing) * 4);\n    flex-shrink: 0;\n    color: var(--muted-foreground);\n  }\n\n  .dashboard-command-palette__footer {\n    display: flex;\n    align-items: center;\n    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);\n    border-top: 1px solid var(--border);\n    color: var(--muted-foreground);\n    font-size: 0.75rem;\n    gap: calc(var(--spacing) * 4);\n    line-height: 1rem;\n  }\n\n  .dashboard-command-palette__hint {\n    display: flex;\n    align-items: center;\n    gap: calc(var(--spacing) * 1.5);\n  }\n\n  .dashboard-command-palette__hint-close {\n    margin-left: auto;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-command-palette/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  ChartLineIcon,\n  DownloadIcon,\n  FilePlusIcon,\n  FolderKanbanIcon,\n  KeyboardIcon,\n  LayoutDashboardIcon,\n  LifeBuoyIcon,\n  PaletteIcon,\n  SettingsIcon,\n  UploadIcon,\n  UserPlusIcon,\n  UsersIcon,\n} from '@lucide/vue';\n\nexport interface PaletteCommand {\n  id: string;\n  label: string;\n  group: string;\n  icon: Component;\n  /** Extra words that also match the search. */\n  keywords?: string[];\n  /** Key hint shown at the end of the row. */\n  shortcut?: string[];\n}\n\nexport const pageTitle = 'Workspace';\nexport const pageDescription = 'Jump anywhere or run an action without leaving the keyboard.';\nexport const triggerLabel = 'Search commands…';\nexport const maxRecentCommands = 3;\n\nexport const commands: PaletteCommand[] = [\n  { id: 'create-project', label: 'Create project', group: 'Actions', icon: FilePlusIcon, keywords: ['new', 'add'], shortcut: ['Ctrl', 'N'] },\n  { id: 'invite-teammate', label: 'Invite teammate', group: 'Actions', icon: UserPlusIcon, keywords: ['member', 'add', 'people'] },\n  { id: 'import-data', label: 'Import data', group: 'Actions', icon: UploadIcon, keywords: ['upload', 'csv'] },\n  { id: 'export-report', label: 'Export report', group: 'Actions', icon: DownloadIcon, keywords: ['download', 'pdf'] },\n  { id: 'go-dashboard', label: 'Go to dashboard', group: 'Navigation', icon: LayoutDashboardIcon, keywords: ['home', 'overview'], shortcut: ['G', 'D'] },\n  { id: 'go-projects', label: 'Go to projects', group: 'Navigation', icon: FolderKanbanIcon, shortcut: ['G', 'P'] },\n  { id: 'go-team', label: 'Go to team', group: 'Navigation', icon: UsersIcon, keywords: ['members', 'people'], shortcut: ['G', 'T'] },\n  { id: 'go-analytics', label: 'Go to analytics', group: 'Navigation', icon: ChartLineIcon, keywords: ['stats', 'metrics'], shortcut: ['G', 'A'] },\n  { id: 'open-settings', label: 'Open settings', group: 'Settings', icon: SettingsIcon, keywords: ['preferences'], shortcut: ['Ctrl', ','] },\n  { id: 'change-theme', label: 'Change theme', group: 'Settings', icon: PaletteIcon, keywords: ['dark', 'light', 'appearance'] },\n  { id: 'keyboard-shortcuts', label: 'Keyboard shortcuts', group: 'Settings', icon: KeyboardIcon, keywords: ['keys', 'bindings'] },\n  { id: 'help-support', label: 'Help and support', group: 'Settings', icon: LifeBuoyIcon, keywords: ['docs', 'contact'] },\n];\n\nexport const initialRecentIds = ['create-project', 'go-projects'];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "900px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
