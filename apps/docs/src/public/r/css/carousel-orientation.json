{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "carousel-orientation",
  "type": "registry:example",
  "title": "CarouselOrientation",
  "dependencies": [],
  "registryDependencies": [
    "carousel"
  ],
  "files": [
    {
      "path": "example/CarouselOrientation.vue",
      "content": "<script setup lang=\"ts\">\nimport { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from '@/components/ui/carousel';\n</script>\n\n<template>\n  <Carousel\n    orientation=\"vertical\"\n    class=\"example-sigma-ui-carousel-orientation\"\n    :opts=\"{\n      align: 'start',\n    }\"\n  >\n    <CarouselContent class=\"example-sigma-ui-carousel-orientation__content\">\n      <CarouselItem\n        v-for=\"(_, index) in 5\"\n        :key=\"index\"\n        class=\"example-sigma-ui-carousel-orientation__slide\"\n      >\n        <div class=\"example-sigma-ui-carousel-orientation__item\">\n          {{ index + 1 }}\n        </div>\n      </CarouselItem>\n    </CarouselContent>\n    <CarouselPrevious />\n    <CarouselNext />\n  </Carousel>\n</template>\n\n<style>\n@layer components {\n  .example-sigma-ui-carousel-orientation {\n    position: relative;\n    width: 100%;\n    max-width: 20rem;\n  }\n\n  .example-sigma-ui-carousel-orientation__content {\n    height: 200px;\n    margin-top: calc(var(--spacing) * -1);\n  }\n\n  .example-sigma-ui-carousel-orientation__slide {\n    padding: calc(var(--spacing) * 1);\n  }\n\n  @media (width >= 48rem) {\n    .example-sigma-ui-carousel-orientation__slide {\n      flex-basis: 50%;\n    }\n  }\n\n  .example-sigma-ui-carousel-orientation__item {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: calc(var(--spacing) * 6);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    font-size: 2.25rem;\n    font-weight: 600;\n    line-height: 1.1;\n    user-select: none;\n  }\n}\n</style>\n",
      "type": "registry:example"
    }
  ]
}
