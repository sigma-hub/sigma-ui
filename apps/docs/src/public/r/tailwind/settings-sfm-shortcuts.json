{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "settings-sfm-shortcuts",
  "type": "registry:block",
  "title": "Keyboard shortcuts",
  "description": "A keyboard shortcuts editor. Commands are grouped in a table with their keys. A dialog records a new key combination, warns about conflicts, and each command can be reset to its default.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "alert",
    "badge",
    "button",
    "dialog",
    "empty",
    "input-group",
    "kbd",
    "table"
  ],
  "files": [
    {
      "path": "blocks/settings-sfm-shortcuts/SettingsSfmShortcuts.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, reactive, ref } from 'vue';\nimport { PencilIcon, RotateCcwIcon, SearchIcon, XIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';\nimport { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from '@/components/ui/input-group';\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';\nimport KeybindingDisplay from './components/KeybindingDisplay.vue';\nimport ShortcutDialog from './components/ShortcutDialog.vue';\nimport { commands, initialOverrides, pageDescription, pageTitle, searchPlaceholder } from './data';\nimport { bindingToKeys } from './shortcuts';\nimport type { Bindings, ShortcutCommand } from './shortcuts';\n\nconst bindings = reactive<Bindings>({\n  ...Object.fromEntries(commands.map(command => [command.id, command.defaultBinding])),\n  ...initialOverrides,\n});\n\nconst searchQuery = ref('');\nconst editingId = ref<string | null>(null);\nconst isDialogOpen = ref(false);\n\nconst editingCommand = computed(() => commands.find(command => command.id === editingId.value) ?? null);\nconst normalizedQuery = computed(() => searchQuery.value.trim().toLowerCase());\n\nfunction isModified(command: ShortcutCommand) {\n  return bindings[command.id] !== command.defaultBinding;\n}\n\nconst modifiedCount = computed(() => commands.filter(isModified).length);\n\nconst groups = computed(() => {\n  const matching = commands.filter((command) => {\n    if (!normalizedQuery.value) {\n      return true;\n    }\n\n    const keysText = bindingToKeys(bindings[command.id]).join(' ').toLowerCase();\n\n    return [command.label, command.group, command.scope].some(value => value.toLowerCase().includes(normalizedQuery.value))\n      || keysText.includes(normalizedQuery.value);\n  });\n\n  return [...new Set(matching.map(command => command.group))].map(name => ({\n    name,\n    commands: matching.filter(command => command.group === name),\n  }));\n});\n\nfunction edit(command: ShortcutCommand) {\n  editingId.value = command.id;\n  isDialogOpen.value = true;\n}\n\nfunction resetCommand(command: ShortcutCommand) {\n  bindings[command.id] = command.defaultBinding;\n}\n\nfunction resetAll() {\n  commands.forEach(resetCommand);\n}\n\nfunction saveBinding(payload: { id: string; binding: string | null; replaceIds: string[] }) {\n  payload.replaceIds.forEach((id) => {\n    bindings[id] = null;\n  });\n  bindings[payload.id] = payload.binding;\n}\n</script>\n\n<template>\n  <div class=\"mx-auto flex w-full max-w-4xl flex-col gap-6 p-4 sm:p-6\">\n    <header class=\"flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between\">\n      <div class=\"flex flex-col gap-1\">\n        <h2 class=\"text-2xl leading-8 font-bold tracking-tight\">\n          {{ pageTitle }}\n        </h2>\n        <p class=\"text-muted-foreground\">\n          {{ pageDescription }}\n        </p>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <InputGroup class=\"sm:w-56\">\n          <InputGroupAddon>\n            <SearchIcon />\n          </InputGroupAddon>\n          <InputGroupInput\n            v-model=\"searchQuery\"\n            type=\"text\"\n            :placeholder=\"searchPlaceholder\"\n            :aria-label=\"searchPlaceholder\"\n          />\n          <InputGroupAddon\n            v-if=\"searchQuery\"\n            align=\"inline-end\"\n          >\n            <InputGroupButton\n              size=\"icon-xs\"\n              aria-label=\"Clear search\"\n              @click=\"searchQuery = ''\"\n            >\n              <XIcon />\n            </InputGroupButton>\n          </InputGroupAddon>\n        </InputGroup>\n        <Button\n          variant=\"outline\"\n          :disabled=\"modifiedCount === 0\"\n          @click=\"resetAll\"\n        >\n          <RotateCcwIcon />\n          Reset all\n        </Button>\n      </div>\n    </header>\n\n    <div\n      v-if=\"groups.length > 0\"\n      class=\"overflow-hidden rounded-lg border\"\n    >\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead>Command</TableHead>\n            <TableHead>Shortcut</TableHead>\n            <TableHead class=\"hidden sm:table-cell\">\n              When\n            </TableHead>\n            <TableHead class=\"w-20\">\n              <span class=\"sr-only\">Actions</span>\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <template\n            v-for=\"group in groups\"\n            :key=\"group.name\"\n          >\n            <TableRow class=\"bg-muted/50 hover:bg-muted/50\">\n              <TableCell\n                colspan=\"4\"\n                class=\"py-2 text-xs font-medium tracking-wide text-muted-foreground uppercase\"\n              >\n                {{ group.name }}\n              </TableCell>\n            </TableRow>\n            <TableRow\n              v-for=\"command in group.commands\"\n              :key=\"command.id\"\n            >\n              <TableCell class=\"font-medium\">\n                <span class=\"flex flex-wrap items-center gap-2\">\n                  {{ command.label }}\n                  <Badge\n                    v-if=\"isModified(command)\"\n                    variant=\"secondary\"\n                  >\n                    Modified\n                  </Badge>\n                </span>\n              </TableCell>\n              <TableCell>\n                <KeybindingDisplay :binding=\"bindings[command.id]\" />\n              </TableCell>\n              <TableCell class=\"hidden text-muted-foreground sm:table-cell\">\n                {{ command.scope }}\n              </TableCell>\n              <TableCell>\n                <div class=\"flex justify-end gap-1\">\n                  <Button\n                    v-if=\"isModified(command)\"\n                    variant=\"ghost\"\n                    size=\"icon-sm\"\n                    :aria-label=\"`Reset shortcut for ${command.label}`\"\n                    @click=\"resetCommand(command)\"\n                  >\n                    <RotateCcwIcon />\n                  </Button>\n                  <Button\n                    variant=\"ghost\"\n                    size=\"icon-sm\"\n                    :aria-label=\"`Edit shortcut for ${command.label}`\"\n                    @click=\"edit(command)\"\n                  >\n                    <PencilIcon />\n                  </Button>\n                </div>\n              </TableCell>\n            </TableRow>\n          </template>\n        </TableBody>\n      </Table>\n    </div>\n\n    <Empty\n      v-else\n      class=\"border border-dashed\"\n    >\n      <EmptyHeader>\n        <EmptyMedia variant=\"icon\">\n          <SearchIcon />\n        </EmptyMedia>\n        <EmptyTitle>No shortcuts found</EmptyTitle>\n        <EmptyDescription>Try searching for a command name or a key such as “Ctrl”.</EmptyDescription>\n      </EmptyHeader>\n      <EmptyContent>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          @click=\"searchQuery = ''\"\n        >\n          Clear search\n        </Button>\n      </EmptyContent>\n    </Empty>\n\n    <ShortcutDialog\n      v-model:open=\"isDialogOpen\"\n      :command=\"editingCommand\"\n      :commands=\"commands\"\n      :bindings=\"bindings\"\n      @save=\"saveBinding\"\n    />\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-sfm-shortcuts/components/KeybindingDisplay.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport { Kbd, KbdGroup } from '@/components/ui/kbd';\nimport { bindingToKeys } from '../shortcuts';\n\nconst props = defineProps<{\n  binding: string | null;\n  emptyLabel?: string;\n}>();\n\nconst keys = computed(() => bindingToKeys(props.binding));\n</script>\n\n<template>\n  <KbdGroup v-if=\"keys.length > 0\">\n    <Kbd\n      v-for=\"(key, index) in keys\"\n      :key=\"`${key}-${index}`\"\n    >\n      {{ key }}\n    </Kbd>\n  </KbdGroup>\n  <span\n    v-else\n    class=\"text-sm text-muted-foreground\"\n  >\n    {{ emptyLabel ?? 'Not set' }}\n  </span>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-sfm-shortcuts/components/ShortcutDialog.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, ref, watch } from 'vue';\nimport { TriangleAlertIcon } from '@lucide/vue';\nimport { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';\nimport { Button } from '@/components/ui/button';\nimport { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from '@/components/ui/dialog';\nimport KeybindingDisplay from './KeybindingDisplay.vue';\nimport { findConflicts } from '../shortcuts';\nimport type { Bindings, ShortcutCommand } from '../shortcuts';\nimport { useKeyRecorder } from '../useKeyRecorder';\n\nconst props = defineProps<{\n  command: ShortcutCommand | null;\n  commands: ShortcutCommand[];\n  bindings: Bindings;\n}>();\n\nconst open = defineModel<boolean>('open', { default: false });\n\nconst emit = defineEmits<{\n  save: [payload: { id: string; binding: string | null; replaceIds: string[] }];\n}>();\n\nconst recorder = useKeyRecorder();\nconst isRecording = ref(false);\n\nconst currentBinding = computed(() => (props.command ? props.bindings[props.command.id] ?? null : null));\nconst hasChanged = computed(() => recorder.binding.value !== currentBinding.value);\nconst conflicts = computed(() => {\n  return props.command ? findConflicts(props.commands, props.bindings, props.command.id, recorder.binding.value) : [];\n});\nconst conflictNames = computed(() => conflicts.value.map(item => item.label).join(', '));\nconst previewKeys = computed(() => recorder.heldModifiers.value);\n\nwatch(open, (isOpen) => {\n  if (isOpen) {\n    recorder.reset(currentBinding.value);\n  }\n});\n\nfunction save() {\n  if (!props.command) {\n    return;\n  }\n\n  emit('save', {\n    id: props.command.id,\n    binding: recorder.binding.value,\n    replaceIds: conflicts.value.map(item => item.id),\n  });\n  open.value = false;\n}\n</script>\n\n<template>\n  <Dialog v-model:open=\"open\">\n    <DialogContent class=\"sm:max-w-md\">\n      <DialogHeader>\n        <DialogTitle>Edit shortcut</DialogTitle>\n        <DialogDescription>\n          {{ command?.label }}<template v-if=\"command\">\n            · {{ command.scope }}\n          </template>\n        </DialogDescription>\n      </DialogHeader>\n\n      <div class=\"flex flex-col gap-3\">\n        <button\n          type=\"button\"\n          class=\"flex h-20 w-full items-center justify-center rounded-lg border-2 border-dashed bg-muted/40 text-sm outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50\"\n          :class=\"{ 'border-ring bg-muted': isRecording }\"\n          :aria-label=\"`Shortcut recorder for ${command?.label ?? 'command'}. Press the new key combination.`\"\n          @keydown=\"recorder.onKeydown\"\n          @keyup=\"recorder.onKeyup\"\n          @focus=\"isRecording = true\"\n          @blur=\"isRecording = false\"\n        >\n          <KeybindingDisplay\n            v-if=\"recorder.binding.value || previewKeys.length > 0\"\n            :binding=\"previewKeys.length > 0 ? previewKeys.join('+') : recorder.binding.value\"\n          />\n          <span\n            v-else\n            class=\"text-muted-foreground\"\n          >\n            {{ isRecording ? 'Press a key combination…' : 'No shortcut set' }}\n          </span>\n        </button>\n        <p class=\"text-xs text-muted-foreground\">\n          Click the box and press the keys you want to use. Tab and Esc keep working so you can leave the box.\n        </p>\n\n        <Alert\n          v-if=\"conflicts.length > 0\"\n          variant=\"destructive\"\n        >\n          <TriangleAlertIcon />\n          <AlertTitle>Shortcut already in use</AlertTitle>\n          <AlertDescription>\n            {{ conflictNames }} already uses this shortcut. Saving will remove it from there.\n          </AlertDescription>\n        </Alert>\n      </div>\n\n      <DialogFooter class=\"gap-2 sm:justify-between\">\n        <Button\n          variant=\"ghost\"\n          :disabled=\"!recorder.binding.value\"\n          @click=\"recorder.reset(null)\"\n        >\n          Clear\n        </Button>\n        <div class=\"flex flex-col-reverse gap-2 sm:flex-row\">\n          <Button\n            variant=\"outline\"\n            @click=\"open = false\"\n          >\n            Cancel\n          </Button>\n          <Button\n            :disabled=\"!hasChanged\"\n            @click=\"save\"\n          >\n            {{ conflicts.length > 0 ? 'Reassign' : 'Save' }}\n          </Button>\n        </div>\n      </DialogFooter>\n    </DialogContent>\n  </Dialog>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/settings-sfm-shortcuts/data.ts",
      "content": "import type { Bindings, ShortcutCommand } from './shortcuts';\n\nexport const pageTitle = 'Keyboard shortcuts';\nexport const pageDescription = 'Review and customize the keys used for common actions.';\nexport const searchPlaceholder = 'Search shortcuts';\n\nexport const commands: ShortcutCommand[] = [\n  { id: 'command-palette', label: 'Open command palette', group: 'General', scope: 'Global', defaultBinding: 'Ctrl+K' },\n  { id: 'toggle-sidebar', label: 'Toggle sidebar', group: 'General', scope: 'Global', defaultBinding: 'Ctrl+B' },\n  { id: 'open-settings', label: 'Open settings', group: 'General', scope: 'Global', defaultBinding: 'Ctrl+,' },\n  { id: 'reload', label: 'Reload window', group: 'General', scope: 'Global', defaultBinding: null },\n  { id: 'new-item', label: 'New item', group: 'Editing', scope: 'Editor', defaultBinding: 'Ctrl+N' },\n  { id: 'duplicate', label: 'Duplicate', group: 'Editing', scope: 'Editor', defaultBinding: 'Ctrl+D' },\n  { id: 'undo', label: 'Undo', group: 'Editing', scope: 'Editor', defaultBinding: 'Ctrl+Z' },\n  { id: 'redo', label: 'Redo', group: 'Editing', scope: 'Editor', defaultBinding: 'Ctrl+Shift+Z' },\n  { id: 'select-all', label: 'Select all', group: 'List', scope: 'List', defaultBinding: 'Ctrl+A' },\n  { id: 'delete-selected', label: 'Delete selected', group: 'List', scope: 'List', defaultBinding: 'Del' },\n  { id: 'zoom-in', label: 'Zoom in', group: 'View', scope: 'Global', defaultBinding: 'Ctrl+=' },\n  { id: 'zoom-out', label: 'Zoom out', group: 'View', scope: 'Global', defaultBinding: 'Ctrl+-' },\n  { id: 'full-screen', label: 'Toggle full screen', group: 'View', scope: 'Global', defaultBinding: 'F11' },\n];\n\n/** Bindings that differ from the defaults when the page first loads. */\nexport const initialOverrides: Bindings = {\n  'toggle-sidebar': 'Ctrl+Shift+B',\n};\n",
      "type": "registry:lib"
    },
    {
      "path": "blocks/settings-sfm-shortcuts/shortcuts.ts",
      "content": "export type ShortcutScope = 'Global' | 'Editor' | 'List';\n\nexport interface ShortcutCommand {\n  id: string;\n  label: string;\n  group: string;\n  scope: ShortcutScope;\n  defaultBinding: string | null;\n}\n\nexport type Bindings = Record<string, string | null>;\n\nconst MODIFIER_KEYS = new Set(['Control', 'Shift', 'Alt', 'Meta']);\n\nconst NAMED_KEYS: Record<string, string> = {\n  ' ': 'Space',\n  'ArrowUp': 'Up',\n  'ArrowDown': 'Down',\n  'ArrowLeft': 'Left',\n  'ArrowRight': 'Right',\n  'Escape': 'Esc',\n  'Delete': 'Del',\n};\n\n/**\n * Returns the main key of a keyboard event, or null while only modifiers are held.\n * Letters and digits use `event.code`, so Shift or the keyboard layout does not change the name.\n */\nexport function getKeyName(event: KeyboardEvent): string | null {\n  if (MODIFIER_KEYS.has(event.key)) {\n    return null;\n  }\n\n  if (event.code.startsWith('Key')) {\n    return event.code.slice(3);\n  }\n\n  if (event.code.startsWith('Digit')) {\n    return event.code.slice(5);\n  }\n\n  if (event.key.length === 1) {\n    return event.key.toUpperCase();\n  }\n\n  return NAMED_KEYS[event.key] ?? event.key;\n}\n\nexport function getModifiers(event: KeyboardEvent): string[] {\n  const modifiers: string[] = [];\n\n  if (event.ctrlKey) {\n    modifiers.push('Ctrl');\n  }\n\n  if (event.altKey) {\n    modifiers.push('Alt');\n  }\n\n  if (event.shiftKey) {\n    modifiers.push('Shift');\n  }\n\n  if (event.metaKey) {\n    modifiers.push('Meta');\n  }\n\n  return modifiers;\n}\n\n/** Converts a keyboard event into a binding such as `Ctrl+Shift+P`, or null if no main key is pressed. */\nexport function eventToBinding(event: KeyboardEvent): string | null {\n  const key = getKeyName(event);\n\n  return key ? [...getModifiers(event), key].join('+') : null;\n}\n\nexport function bindingToKeys(binding: string | null): string[] {\n  if (!binding) {\n    return [];\n  }\n\n  // A trailing \"+\" is the plus key itself, for example \"Ctrl++\".\n  return binding.endsWith('+') ? [...binding.slice(0, -2).split('+').filter(Boolean), '+'] : binding.split('+');\n}\n\n/** Two commands conflict when they share a binding and can be active at the same time. */\nexport function findConflicts(\n  commands: ShortcutCommand[],\n  bindings: Bindings,\n  commandId: string,\n  binding: string | null,\n): ShortcutCommand[] {\n  const command = commands.find(item => item.id === commandId);\n\n  if (!command || !binding) {\n    return [];\n  }\n\n  return commands.filter((other) => {\n    const overlaps = other.scope === command.scope || other.scope === 'Global' || command.scope === 'Global';\n\n    return other.id !== commandId && bindings[other.id] === binding && overlaps;\n  });\n}\n",
      "type": "registry:lib"
    },
    {
      "path": "blocks/settings-sfm-shortcuts/useKeyRecorder.ts",
      "content": "import { ref } from 'vue';\nimport { eventToBinding, getModifiers } from './shortcuts';\n\n/**\n * Records a key combination from keydown events.\n * Tab and Escape are ignored so keyboard users can always leave the recorder and close the dialog.\n */\nexport function useKeyRecorder(initialBinding: string | null = null) {\n  const binding = ref<string | null>(initialBinding);\n  const heldModifiers = ref<string[]>([]);\n\n  function onKeydown(event: KeyboardEvent) {\n    if (event.key === 'Tab' || event.key === 'Escape') {\n      return;\n    }\n\n    event.preventDefault();\n    event.stopPropagation();\n\n    const recorded = eventToBinding(event);\n\n    if (recorded) {\n      binding.value = recorded;\n      heldModifiers.value = [];\n      return;\n    }\n\n    heldModifiers.value = getModifiers(event);\n  }\n\n  function onKeyup(event: KeyboardEvent) {\n    heldModifiers.value = getModifiers(event);\n  }\n\n  function reset(value: string | null = null) {\n    binding.value = value;\n    heldModifiers.value = [];\n  }\n\n  return { binding, heldModifiers, onKeydown, onKeyup, reset };\n}\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "900px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "settings"
  ]
}
