{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "native-select",
  "type": "registry:ui",
  "dependencies": [
    "lucide-vue-next@^0.475.0",
    "reka-ui@^2.2.1"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "ui/native-select/NativeSelect.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AcceptableValue } from 'reka-ui';\nimport { ChevronDownIcon } from 'lucide-vue-next';\nimport { computed, useAttrs } from 'vue';\nimport { cn } from '@/lib/utils';\n\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst model = defineModel<AcceptableValue | AcceptableValue[]>({\n  default: '',\n});\n\nconst attrs = useAttrs();\nconst selectAttrs = computed(() => Object.fromEntries(\n  Object.entries(attrs).filter(([key]) => key !== 'class'),\n));\n\ndefineSlots<{\n  /**\n   * `NativeSelectOption` and `NativeSelectOptGroup` children.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <div\n    data-slot=\"native-select-wrapper\"\n    :class=\"cn('group/native-select relative w-fit has-[select:disabled]:opacity-50', attrs.class ?? '')\"\n  >\n    <select\n      v-bind=\"selectAttrs\"\n      v-model=\"model\"\n      data-slot=\"native-select\"\n      :class=\"cn(\n        'flex h-10 w-full min-w-0 appearance-none rounded-md border border-border bg-input py-2 pr-9 pl-3 text-sm outline-none',\n        'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',\n        'disabled:cursor-not-allowed disabled:opacity-50',\n        'aria-invalid:border-destructive',\n      )\"\n    >\n      <slot />\n    </select>\n    <ChevronDownIcon\n      class=\"pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground opacity-50\"\n      aria-hidden=\"true\"\n      data-slot=\"native-select-icon\"\n    />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/native-select/NativeSelectOptGroup.vue",
      "content": "<script setup lang=\"ts\">\nimport { cn } from '@/lib/utils';\n\ndefineSlots<{\n  /**\n   * `NativeSelectOption` children of this group.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <optgroup\n    data-slot=\"native-select-optgroup\"\n    :class=\"cn('bg-popover text-popover-foreground', $attrs.class ?? '')\"\n  >\n    <slot />\n  </optgroup>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/native-select/NativeSelectOption.vue",
      "content": "<script setup lang=\"ts\">\nimport { cn } from '@/lib/utils';\n\ndefineSlots<{\n  /**\n   * Label of the option.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <option\n    data-slot=\"native-select-option\"\n    :class=\"cn('bg-popover text-popover-foreground', $attrs.class ?? '')\"\n  >\n    <slot />\n  </option>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/native-select/index.ts",
      "content": "export { default as NativeSelect } from './NativeSelect.vue';\nexport { default as NativeSelectOptGroup } from './NativeSelectOptGroup.vue';\nexport { default as NativeSelectOption } from './NativeSelectOption.vue';\n",
      "type": "registry:ui"
    }
  ]
