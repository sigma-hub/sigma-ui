{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-marketplace",
  "type": "registry:block",
  "title": "Integrations marketplace",
  "description": "A browse, installed, and updates gallery for integrations or plugins with search, category filters, featured cards, install and update progress with cancel, and empty states.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "badge",
    "button",
    "card",
    "empty",
    "input-group",
    "progress",
    "skeleton",
    "spinner",
    "tabs"
  ],
  "files": [
    {
      "path": "blocks/dashboard-marketplace/DashboardMarketplace.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, ref } from 'vue';\nimport { PackageSearchIcon, RefreshCwIcon, SearchIcon, XIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Empty, EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';\nimport { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput } from '@/components/ui/input-group';\nimport { Skeleton } from '@/components/ui/skeleton';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport MarketplaceCard from './components/MarketplaceCard.vue';\nimport { categories, initialApps, pageDescription, pageTitle, searchPlaceholder } from './data';\nimport type { MarketplaceApp, MarketplaceTab } from './data';\n\nconst apps = ref<MarketplaceApp[]>(initialApps.map(app => ({ ...app })));\nconst activeTab = ref<MarketplaceTab>('browse');\nconst category = ref('all');\nconst searchQuery = ref('');\nconst isRefreshing = ref(false);\n\nconst timers = new Map<string, ReturnType<typeof setInterval>>();\nlet refreshTimer: ReturnType<typeof setTimeout> | undefined;\n\nconst normalizedQuery = computed(() => searchQuery.value.trim().toLowerCase());\nconst isFiltering = computed(() => normalizedQuery.value.length > 0 || category.value !== 'all');\n\nconst matchingApps = computed(() => {\n  return apps.value.filter((app) => {\n    const matchesCategory = category.value === 'all' || app.category === category.value;\n    const matchesQuery = normalizedQuery.value.length === 0\n      || [app.name, app.publisher, app.description, app.category].some(value => value.toLowerCase().includes(normalizedQuery.value));\n\n    return matchesCategory && matchesQuery;\n  });\n});\n\nfunction hasUpdate(app: MarketplaceApp) {\n  return app.installed && app.installedVersion !== app.version;\n}\n\nconst installedCount = computed(() => apps.value.filter(app => app.installed).length);\nconst updateCount = computed(() => apps.value.filter(hasUpdate).length);\n\nconst tabs = computed(() => [\n  { value: 'browse' as const, label: 'Browse', count: undefined },\n  { value: 'installed' as const, label: 'Installed', count: installedCount.value },\n  { value: 'updates' as const, label: 'Updates', count: updateCount.value },\n]);\n\nconst visibleApps = computed(() => {\n  if (activeTab.value === 'installed') {\n    return matchingApps.value.filter(app => app.installed);\n  }\n\n  if (activeTab.value === 'updates') {\n    return matchingApps.value.filter(hasUpdate);\n  }\n\n  return matchingApps.value;\n});\n\nconst featuredApps = computed(() => {\n  return activeTab.value === 'browse' && !isFiltering.value ? apps.value.filter(app => app.featured) : [];\n});\n\nconst emptyState = computed(() => {\n  if (isFiltering.value) {\n    return {\n      title: 'No integrations found',\n      description: 'Try a different keyword or category.',\n      action: 'Clear filters',\n    };\n  }\n\n  if (activeTab.value === 'installed') {\n    return {\n      title: 'Nothing installed yet',\n      description: 'Installed integrations will show up here.',\n      action: 'Browse integrations',\n    };\n  }\n\n  return {\n    title: 'Everything is up to date',\n    description: 'You are running the latest version of every integration.',\n    action: 'Browse integrations',\n  };\n});\n\nfunction findApp(id: string) {\n  return apps.value.find(app => app.id === id);\n}\n\nfunction stopTimer(id: string) {\n  const timer = timers.get(id);\n\n  if (timer !== undefined) {\n    clearInterval(timer);\n  }\n\n  timers.delete(id);\n}\n\n// Simulates a download. Replace this with your real install or update request.\nfunction startOperation(id: string) {\n  const app = findApp(id);\n\n  if (!app || app.progress !== null) {\n    return;\n  }\n\n  app.progress = 0;\n  timers.set(id, setInterval(() => {\n    app.progress = Math.min(100, (app.progress ?? 0) + 20);\n\n    if (app.progress >= 100) {\n      stopTimer(id);\n      Object.assign(app, { installed: true, installedVersion: app.version, progress: null });\n    }\n  }, 450));\n}\n\nfunction cancelOperation(id: string) {\n  const app = findApp(id);\n  stopTimer(id);\n\n  if (app) {\n    app.progress = null;\n  }\n}\n\nfunction uninstall(id: string) {\n  const app = findApp(id);\n\n  if (app) {\n    Object.assign(app, { installed: false, installedVersion: undefined });\n  }\n}\n\nfunction updateAll() {\n  apps.value.filter(hasUpdate).forEach(app => startOperation(app.id));\n}\n\nfunction refresh() {\n  isRefreshing.value = true;\n  clearTimeout(refreshTimer);\n  refreshTimer = setTimeout(() => {\n    isRefreshing.value = false;\n  }, 900);\n}\n\nfunction clearFilters() {\n  searchQuery.value = '';\n  category.value = 'all';\n}\n\nfunction handleEmptyAction() {\n  if (isFiltering.value) {\n    clearFilters();\n    return;\n  }\n\n  activeTab.value = 'browse';\n}\n\nonBeforeUnmount(() => {\n  timers.forEach(timer => clearInterval(timer));\n  timers.clear();\n  clearTimeout(refreshTimer);\n});\n</script>\n\n<template>\n  <div class=\"mx-auto flex w-full max-w-6xl flex-col gap-6 p-4 sm:p-6\">\n    <header class=\"flex flex-col gap-1\">\n      <h2 class=\"text-2xl leading-8 font-bold tracking-tight\">\n        {{ pageTitle }}\n      </h2>\n      <p class=\"text-muted-foreground\">\n        {{ pageDescription }}\n      </p>\n    </header>\n\n    <Tabs\n      v-model=\"activeTab\"\n      class=\"flex flex-col gap-6\"\n    >\n      <div class=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\">\n        <TabsList class=\"w-full justify-start sm:w-auto\">\n          <TabsTrigger\n            v-for=\"tab in tabs\"\n            :key=\"tab.value\"\n            :value=\"tab.value\"\n          >\n            {{ tab.label }}\n            <Badge\n              v-if=\"tab.count\"\n              variant=\"secondary\"\n            >\n              {{ tab.count }}\n            </Badge>\n          </TabsTrigger>\n        </TabsList>\n\n        <div class=\"flex items-center gap-2\">\n          <InputGroup class=\"sm:w-64\">\n            <InputGroupAddon>\n              <SearchIcon />\n            </InputGroupAddon>\n            <InputGroupInput\n              v-model=\"searchQuery\"\n              type=\"text\"\n              :placeholder=\"searchPlaceholder\"\n              :aria-label=\"searchPlaceholder\"\n            />\n            <InputGroupAddon\n              v-if=\"searchQuery\"\n              align=\"inline-end\"\n            >\n              <InputGroupButton\n                size=\"icon-xs\"\n                aria-label=\"Clear search\"\n                @click=\"searchQuery = ''\"\n              >\n                <XIcon />\n              </InputGroupButton>\n            </InputGroupAddon>\n          </InputGroup>\n          <Button\n            variant=\"outline\"\n            size=\"icon\"\n            aria-label=\"Refresh integrations\"\n            :disabled=\"isRefreshing\"\n            @click=\"refresh\"\n          >\n            <RefreshCwIcon :class=\"{ 'animate-spin': isRefreshing }\" />\n          </Button>\n        </div>\n      </div>\n\n      <div\n        class=\"-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0\"\n        role=\"group\"\n        aria-label=\"Categories\"\n      >\n        <Button\n          v-for=\"item in categories\"\n          :key=\"item.value\"\n          :variant=\"category === item.value ? 'secondary' : 'outline'\"\n          size=\"sm\"\n          :aria-pressed=\"category === item.value\"\n          @click=\"category = item.value\"\n        >\n          {{ item.label }}\n        </Button>\n      </div>\n\n      <TabsContent\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n        class=\"flex flex-col gap-8\"\n      >\n        <div\n          v-if=\"isRefreshing && activeTab === tab.value\"\n          class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"\n          aria-busy=\"true\"\n        >\n          <Skeleton\n            v-for=\"index in 6\"\n            :key=\"index\"\n            class=\"h-48\"\n          />\n        </div>\n\n        <template v-else-if=\"activeTab === tab.value\">\n          <section\n            v-if=\"featuredApps.length > 0\"\n            class=\"flex flex-col gap-4\"\n          >\n            <h3 class=\"text-lg leading-7 font-semibold\">\n              Featured\n            </h3>\n            <ul class=\"m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3\">\n              <li\n                v-for=\"app in featuredApps\"\n                :key=\"app.id\"\n              >\n                <MarketplaceCard\n                  :app=\"app\"\n                  @install=\"startOperation\"\n                  @update=\"startOperation\"\n                  @cancel=\"cancelOperation\"\n                />\n              </li>\n            </ul>\n          </section>\n\n          <section\n            v-if=\"visibleApps.length > 0\"\n            class=\"flex flex-col gap-4\"\n          >\n            <div class=\"flex items-center justify-between gap-4\">\n              <h3 class=\"text-lg leading-7 font-semibold\">\n                {{ tab.value === 'browse' ? (featuredApps.length > 0 ? 'All integrations' : 'Integrations') : tab.label }}\n              </h3>\n              <Button\n                v-if=\"tab.value === 'updates' && updateCount > 1\"\n                variant=\"outline\"\n                size=\"sm\"\n                @click=\"updateAll\"\n              >\n                Update all\n              </Button>\n            </div>\n            <ul class=\"m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3\">\n              <li\n                v-for=\"app in visibleApps\"\n                :key=\"app.id\"\n              >\n                <MarketplaceCard\n                  :app=\"app\"\n                  :manage=\"tab.value === 'installed'\"\n                  @install=\"startOperation\"\n                  @update=\"startOperation\"\n                  @uninstall=\"uninstall\"\n                  @cancel=\"cancelOperation\"\n                />\n              </li>\n            </ul>\n          </section>\n\n          <Empty\n            v-else\n            class=\"border border-dashed\"\n          >\n            <EmptyHeader>\n              <EmptyMedia variant=\"icon\">\n                <PackageSearchIcon />\n              </EmptyMedia>\n              <EmptyTitle>{{ emptyState.title }}</EmptyTitle>\n              <EmptyDescription>{{ emptyState.description }}</EmptyDescription>\n            </EmptyHeader>\n            <EmptyContent>\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                @click=\"handleEmptyAction\"\n              >\n                {{ emptyState.action }}\n              </Button>\n            </EmptyContent>\n          </Empty>\n        </template>\n      </TabsContent>\n    </Tabs>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-marketplace/components/MarketplaceCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport { CheckIcon, TriangleAlertIcon, XIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card } from '@/components/ui/card';\nimport { Progress } from '@/components/ui/progress';\nimport { Spinner } from '@/components/ui/spinner';\nimport type { MarketplaceApp } from '../data';\n\nconst props = withDefaults(defineProps<{\n  app: MarketplaceApp;\n  /** Show the uninstall action for installed apps. */\n  manage?: boolean;\n  featured?: boolean;\n}>(), {\n  manage: false,\n  featured: false,\n});\n\nconst emit = defineEmits<{\n  install: [id: string];\n  update: [id: string];\n  uninstall: [id: string];\n  cancel: [id: string];\n}>();\n\nconst isBusy = computed(() => props.app.progress !== null);\nconst hasUpdate = computed(() => props.app.installed && props.app.installedVersion !== props.app.version);\nconst busyLabel = computed(() => (props.app.installed ? 'Updating…' : 'Installing…'));\nconst versionLabel = computed(() => `v${props.app.installedVersion ?? props.app.version}`);\nconst badgeLabel = computed(() => (props.app.badge === 'official' ? 'Official' : 'Community'));\n</script>\n\n<template>\n  <Card class=\"flex h-full flex-col gap-4 p-4\">\n    <div class=\"flex items-start gap-3\">\n      <div\n        class=\"flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground [&_svg]:size-5\"\n        aria-hidden=\"true\"\n      >\n        <component :is=\"app.icon\" />\n      </div>\n      <div class=\"flex min-w-0 flex-1 flex-col\">\n        <h3 class=\"truncate text-sm leading-5 font-semibold\">\n          {{ app.name }}\n        </h3>\n        <p class=\"truncate text-xs text-muted-foreground\">\n          by {{ app.publisher }}\n        </p>\n      </div>\n      <Badge :variant=\"app.badge === 'official' ? 'default' : 'secondary'\">\n        {{ badgeLabel }}\n      </Badge>\n    </div>\n\n    <p class=\"line-clamp-2 flex-1 text-sm text-muted-foreground\">\n      {{ app.description }}\n    </p>\n\n    <div class=\"flex flex-wrap items-center gap-2 text-xs text-muted-foreground\">\n      <Badge variant=\"outline\">\n        {{ app.category }}\n      </Badge>\n      <span>{{ versionLabel }}</span>\n      <span\n        v-if=\"hasUpdate\"\n        class=\"text-foreground\"\n      >\n        v{{ app.version }} available\n      </span>\n    </div>\n\n    <p\n      v-if=\"app.incompatibleReason && !app.installed\"\n      class=\"flex items-center gap-2 text-xs text-destructive\"\n      role=\"note\"\n    >\n      <TriangleAlertIcon\n        class=\"size-4 shrink-0\"\n        aria-hidden=\"true\"\n      />\n      {{ app.incompatibleReason }}\n    </p>\n\n    <Progress\n      v-if=\"isBusy\"\n      :model-value=\"app.progress ?? 0\"\n      :aria-label=\"`${busyLabel} ${app.name}`\"\n    />\n\n    <div class=\"flex items-center gap-2\">\n      <template v-if=\"isBusy\">\n        <Button\n          class=\"flex-1\"\n          variant=\"secondary\"\n          disabled\n        >\n          <Spinner />\n          {{ busyLabel }}\n        </Button>\n        <Button\n          variant=\"ghost\"\n          size=\"icon\"\n          :aria-label=\"`Cancel ${busyLabel.toLowerCase()} ${app.name}`\"\n          @click=\"emit('cancel', app.id)\"\n        >\n          <XIcon />\n        </Button>\n      </template>\n      <template v-else-if=\"app.installed\">\n        <Button\n          v-if=\"hasUpdate\"\n          class=\"flex-1\"\n          @click=\"emit('update', app.id)\"\n        >\n          Update\n        </Button>\n        <Button\n          v-if=\"manage\"\n          class=\"flex-1\"\n          variant=\"outline\"\n          @click=\"emit('uninstall', app.id)\"\n        >\n          Uninstall\n        </Button>\n        <Button\n          v-else-if=\"!hasUpdate\"\n          class=\"flex-1\"\n          variant=\"secondary\"\n          disabled\n        >\n          <CheckIcon />\n          Installed\n        </Button>\n      </template>\n      <Button\n        v-else\n        class=\"flex-1\"\n        :disabled=\"Boolean(app.incompatibleReason)\"\n        @click=\"emit('install', app.id)\"\n      >\n        Install\n      </Button>\n    </div>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-marketplace/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  BellRingIcon,\n  CalendarIcon,\n  ChartLineIcon,\n  CloudIcon,\n  DatabaseIcon,\n  FileTextIcon,\n  GitBranchIcon,\n  MailIcon,\n  MessageSquareIcon,\n  ShieldCheckIcon,\n  WorkflowIcon,\n} from '@lucide/vue';\n\nexport type MarketplaceTab = 'browse' | 'installed' | 'updates';\nexport type MarketplaceBadge = 'official' | 'community';\n\nexport interface MarketplaceCategory {\n  value: string;\n  label: string;\n}\n\nexport interface MarketplaceApp {\n  id: string;\n  name: string;\n  publisher: string;\n  description: string;\n  icon: Component;\n  category: string;\n  badge: MarketplaceBadge;\n  /** Latest published version. */\n  version: string;\n  featured?: boolean;\n  /** When set, the app cannot be installed and this text explains why. */\n  incompatibleReason?: string;\n  installed: boolean;\n  installedVersion?: string;\n  /** 0-100 while an install or update is running, otherwise null. */\n  progress: number | null;\n}\n\nexport const pageTitle = 'Integrations';\nexport const pageDescription = 'Connect your workspace to the tools your team already uses.';\nexport const searchPlaceholder = 'Search integrations';\n\nexport const categories: MarketplaceCategory[] = [\n  { value: 'all', label: 'All' },\n  { value: 'productivity', label: 'Productivity' },\n  { value: 'developer', label: 'Developer' },\n  { value: 'analytics', label: 'Analytics' },\n  { value: 'communication', label: 'Communication' },\n  { value: 'security', label: 'Security' },\n];\n\nexport const initialApps: MarketplaceApp[] = [\n  {\n    id: 'git-sync',\n    name: 'Git Sync',\n    publisher: 'Northwind',\n    description: 'Mirror repositories and keep branches in sync across every workspace automatically.',\n    icon: GitBranchIcon,\n    category: 'developer',\n    badge: 'official',\n    version: '2.5.0',\n    installed: true,\n    installedVersion: '2.4.0',\n    progress: null,\n  },\n  {\n    id: 'pulse-analytics',\n    name: 'Pulse Analytics',\n    publisher: 'Northwind',\n    description: 'Track product usage with ready-made dashboards, funnels and weekly reports.',\n    icon: ChartLineIcon,\n    category: 'analytics',\n    badge: 'official',\n    version: '1.8.2',\n    featured: true,\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'relay-chat',\n    name: 'Relay Chat',\n    publisher: 'Open Relay',\n    description: 'Post updates, alerts and daily summaries to your team channels.',\n    icon: MessageSquareIcon,\n    category: 'communication',\n    badge: 'community',\n    version: '3.1.0',\n    installed: true,\n    installedVersion: '3.1.0',\n    progress: null,\n  },\n  {\n    id: 'calendar-bridge',\n    name: 'Calendar Bridge',\n    publisher: 'Northwind',\n    description: 'Show deadlines and releases in your calendar and block focus time for reviews.',\n    icon: CalendarIcon,\n    category: 'productivity',\n    badge: 'official',\n    version: '1.2.4',\n    featured: true,\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'inbox-digest',\n    name: 'Inbox Digest',\n    publisher: 'Mailroom Labs',\n    description: 'Collect notifications into one digest email instead of dozens of separate messages.',\n    icon: MailIcon,\n    category: 'communication',\n    badge: 'community',\n    version: '0.9.3',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'cloud-backup',\n    name: 'Cloud Backup',\n    publisher: 'Northwind',\n    description: 'Schedule encrypted backups of your data to the storage provider of your choice.',\n    icon: CloudIcon,\n    category: 'developer',\n    badge: 'official',\n    version: '2.0.1',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'access-guard',\n    name: 'Access Guard',\n    publisher: 'Northwind',\n    description: 'Single sign-on, session policies and audit logs for larger teams.',\n    icon: ShieldCheckIcon,\n    category: 'security',\n    badge: 'official',\n    version: '4.0.0',\n    incompatibleReason: 'Requires version 3.2 or later',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'alert-rules',\n    name: 'Alert Rules',\n    publisher: 'Signal Works',\n    description: 'Create rules that notify you when a metric crosses a threshold.',\n    icon: BellRingIcon,\n    category: 'analytics',\n    badge: 'community',\n    version: '1.4.0',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'doc-exporter',\n    name: 'Doc Exporter',\n    publisher: 'Paperline',\n    description: 'Export pages and reports to PDF, Markdown or Word with your own templates.',\n    icon: FileTextIcon,\n    category: 'productivity',\n    badge: 'community',\n    version: '1.1.0',\n    installed: true,\n    installedVersion: '1.0.2',\n    progress: null,\n  },\n  {\n    id: 'warehouse-loader',\n    name: 'Warehouse Loader',\n    publisher: 'Northwind',\n    description: 'Stream events to your data warehouse every few minutes with schema checks.',\n    icon: DatabaseIcon,\n    category: 'analytics',\n    badge: 'official',\n    version: '2.2.0',\n    installed: false,\n    progress: null,\n  },\n  {\n    id: 'workflow-builder',\n    name: 'Workflow Builder',\n    publisher: 'Northwind',\n    description: 'Automate repetitive work with a visual builder for triggers, conditions and actions.',\n    icon: WorkflowIcon,\n    category: 'productivity',\n    badge: 'official',\n    version: '1.6.0',\n    featured: true,\n    installed: false,\n    progress: null,\n  },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "900px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
