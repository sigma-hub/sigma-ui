{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-demo",
  "type": "registry:example",
  "title": "Sidebar",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "collapsible",
    "separator",
    "sidebar"
  ],
  "files": [
    {
      "path": "example/Sidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Component } from 'vue';\nimport {\n  BookOpenIcon,\n  ChevronRightIcon,\n  ChevronsUpDownIcon,\n  GalleryVerticalEndIcon,\n  LayoutDashboardIcon,\n  MoreHorizontalIcon,\n  Settings2Icon,\n  SquareTerminalIcon,\n} from '@lucide/vue';\nimport { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible';\nimport { Separator } from '@/components/ui/separator';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuAction,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarMenuSub,\n  SidebarMenuSubButton,\n  SidebarMenuSubItem,\n  SidebarProvider,\n  SidebarRail,\n  SidebarTrigger,\n} from '@/components/ui/sidebar';\n\ninterface NavigationItem {\n  title: string;\n  icon: Component;\n  isActive?: boolean;\n  items: { title: string; isActive?: boolean }[];\n}\n\nconst navigation: NavigationItem[] = [\n  {\n    title: 'Dashboard',\n    icon: LayoutDashboardIcon,\n    isActive: true,\n    items: [\n      { title: 'Overview', isActive: true },\n      { title: 'Analytics' },\n      { title: 'Reports' },\n    ],\n  },\n  {\n    title: 'Playground',\n    icon: SquareTerminalIcon,\n    items: [\n      { title: 'History' },\n      { title: 'Starred' },\n    ],\n  },\n  {\n    title: 'Documentation',\n    icon: BookOpenIcon,\n    items: [\n      { title: 'Introduction' },\n      { title: 'Get started' },\n      { title: 'Changelog' },\n    ],\n  },\n  {\n    title: 'Settings',\n    icon: Settings2Icon,\n    items: [\n      { title: 'General' },\n      { title: 'Team' },\n      { title: 'Billing' },\n    ],\n  },\n];\n</script>\n\n<template>\n  <div class=\"relative h-[520px] w-full overflow-hidden rounded-lg border [transform:translateZ(0)]\">\n    <SidebarProvider\n      cookie-name=\"sidebar_example_state\"\n      class=\"h-full min-h-full\"\n    >\n      <Sidebar\n        collapsible=\"icon\"\n        class=\"h-full\"\n      >\n        <SidebarHeader>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton\n                size=\"lg\"\n                tooltip=\"Acme Inc\"\n              >\n                <div class=\"flex aspect-square size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground\">\n                  <GalleryVerticalEndIcon class=\"size-4\" />\n                </div>\n                <div class=\"grid flex-1 text-left text-sm leading-tight\">\n                  <span class=\"truncate font-medium\">Acme Inc</span>\n                  <span class=\"truncate text-xs text-muted-foreground\">Enterprise</span>\n                </div>\n                <ChevronsUpDownIcon class=\"ml-auto\" />\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Platform</SidebarGroupLabel>\n            <SidebarMenu>\n              <Collapsible\n                v-for=\"item in navigation\"\n                :key=\"item.title\"\n                as-child\n                :default-open=\"item.isActive\"\n                class=\"group/collapsible\"\n              >\n                <SidebarMenuItem>\n                  <CollapsibleTrigger as-child>\n                    <SidebarMenuButton :tooltip=\"item.title\">\n                      <component :is=\"item.icon\" />\n                      <span>{{ item.title }}</span>\n                      <ChevronRightIcon class=\"ml-auto transition-transform duration-200 group-data-[state=open]/collapsible:rotate-90\" />\n                    </SidebarMenuButton>\n                  </CollapsibleTrigger>\n                  <CollapsibleContent>\n                    <SidebarMenuSub>\n                      <SidebarMenuSubItem\n                        v-for=\"subItem in item.items\"\n                        :key=\"subItem.title\"\n                      >\n                        <SidebarMenuSubButton\n                          href=\"#\"\n                          :is-active=\"subItem.isActive\"\n                          @click.prevent\n                        >\n                          <span>{{ subItem.title }}</span>\n                        </SidebarMenuSubButton>\n                      </SidebarMenuSubItem>\n                    </SidebarMenuSub>\n                  </CollapsibleContent>\n                </SidebarMenuItem>\n              </Collapsible>\n            </SidebarMenu>\n          </SidebarGroup>\n        </SidebarContent>\n        <SidebarFooter>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton\n                size=\"lg\"\n                tooltip=\"Jane Doe\"\n              >\n                <div class=\"flex size-8 shrink-0 items-center justify-center rounded-lg bg-secondary text-xs font-medium\">\n                  JD\n                </div>\n                <div class=\"grid flex-1 text-left text-sm leading-tight\">\n                  <span class=\"truncate font-medium\">Jane Doe</span>\n                  <span class=\"truncate text-xs text-muted-foreground\">jane@example.com</span>\n                </div>\n              </SidebarMenuButton>\n              <SidebarMenuAction show-on-hover>\n                <MoreHorizontalIcon />\n                <span class=\"sr-only\">More</span>\n              </SidebarMenuAction>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarFooter>\n        <SidebarRail />\n      </Sidebar>\n      <SidebarInset>\n        <header class=\"flex h-14 shrink-0 items-center gap-2 border-b px-4\">\n          <SidebarTrigger class=\"-ml-1\" />\n          <Separator\n            orientation=\"vertical\"\n            class=\"mr-2 h-4!\"\n          />\n          <span class=\"text-sm font-medium\">Overview</span>\n        </header>\n        <div class=\"flex flex-1 flex-col gap-4 p-4\">\n          <div class=\"grid auto-rows-min gap-4 md:grid-cols-3\">\n            <div class=\"aspect-video rounded-xl bg-muted/50\" />\n            <div class=\"aspect-video rounded-xl bg-muted/50\" />\n            <div class=\"aspect-video rounded-xl bg-muted/50\" />\n          </div>\n          <div class=\"min-h-24 flex-1 rounded-xl bg-muted/50\" />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  </div>\n</template>\n",
      "type": "registry:example"
    }
  ]
}
