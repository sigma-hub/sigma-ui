{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tooltip-demo",
  "type": "registry:example",
  "title": "Tooltip",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "tooltip"
  ],
  "files": [
    {
      "path": "example/Tooltip.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\n</script>\n\n<template>\n  <TooltipProvider>\n    <Tooltip :delay-duration=\"0\">\n      <TooltipTrigger as-child>\n        <Button variant=\"outline\">\n          Hover\n        </Button>\n      </TooltipTrigger>\n      <TooltipContent>\n        <p>Add to library</p>\n      </TooltipContent>\n    </Tooltip>\n  </TooltipProvider>\n</template>\n",
      "type": "registry:example"
    }
  ]
}
