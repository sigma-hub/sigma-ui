{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-product-edit",
  "type": "registry:block",
  "title": "Product edit page",
  "description": "A product edit page. The product edit page has a form to edit the product details, stock, product category, product status, and product images. The product edit page has a sidebar navigation and a main content area. The main content area has a form to edit the product details, stock, product category, product status, and product images. The sidebar navigation has links to product details, stock, product category, product status, and product images.",
  "dependencies": [
    "lucide-vue-next@^0.475.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "label",
    "select",
    "sheet",
    "table",
    "textarea",
    "toggle-group",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-product-edit/DashboardProductEdit.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport ArchiveProductCard from './components/ArchiveProductCard.vue';\nimport ProductCategoryCard from './components/ProductCategoryCard.vue';\nimport ProductDetailsCard from './components/ProductDetailsCard.vue';\nimport ProductImagesCard from './components/ProductImagesCard.vue';\nimport ProductStatusCard from './components/ProductStatusCard.vue';\nimport ProductStockCard from './components/ProductStockCard.vue';\nimport ProductToolbar from './components/ProductToolbar.vue';\n</script>\n\n<template>\n  <div class=\"flex min-h-screen w-full flex-col bg-muted/40\">\n    <AppSidebar />\n    <div class=\"flex flex-col sm:gap-4 sm:py-4 sm:pl-14\">\n      <AppHeader />\n      <main class=\"grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8\">\n        <div class=\"mx-auto grid max-w-[59rem] flex-1 auto-rows-max gap-4\">\n          <ProductToolbar />\n          <div class=\"grid gap-4 md:grid-cols-[1fr_250px] lg:grid-cols-3 lg:gap-8\">\n            <div class=\"grid auto-rows-max items-start gap-4 lg:col-span-2 lg:gap-8\">\n              <ProductDetailsCard />\n              <ProductStockCard />\n              <ProductCategoryCard />\n            </div>\n            <div class=\"grid auto-rows-max items-start gap-4 lg:gap-8\">\n              <ProductStatusCard />\n              <ProductImagesCard />\n              <ArchiveProductCard />\n            </div>\n          </div>\n          <div class=\"flex items-center justify-center gap-2 md:hidden\">\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n            >\n              Discard\n            </Button>\n            <Button size=\"sm\">\n              Save Product\n            </Button>\n          </div>\n        </div>\n      </main>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport { breadcrumbLinks, breadcrumbPage, mobileNavItems } from '../data';\n</script>\n\n<template>\n  <header class=\"sticky top-0 z-30 flex h-14 items-center gap-4 border-b bg-background px-4 sm:static sm:h-auto sm:border-0 sm:bg-transparent sm:px-6\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"sm:hidden\"\n        >\n          <PanelLeftIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">Toggle Menu</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"sm:max-w-xs\"\n      >\n        <nav class=\"grid gap-6 text-lg font-medium\">\n          <a\n            href=\"#\"\n            class=\"group flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:text-base\"\n          >\n            <Package2Icon class=\"h-5 w-5 transition-all group-hover:scale-110\" />\n            <span class=\"sr-only\">Acme Inc</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"flex items-center gap-4 px-2.5\"\n            :class=\"item.isActive ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n          >\n            <component\n              :is=\"item.icon\"\n              class=\"h-5 w-5\"\n            />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"hidden md:flex\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link.label\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a :href=\"link.href\">{{ link.label }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"relative ml-auto flex-1 md:grow-0\">\n      <SearchIcon class=\"absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground\" />\n      <Input\n        type=\"search\"\n        placeholder=\"Search...\"\n        class=\"w-full rounded-lg bg-background pl-8 md:w-[200px] lg:w-[336px]\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"rounded-full\"\n        >\n          <CircleUserIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">Toggle user menu</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>My Account</DropdownMenuLabel>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>Settings</DropdownMenuItem>\n        <DropdownMenuItem>Support</DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem>Logout</DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from 'lucide-vue-next';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport { sidebarFooterNavItems, sidebarNavItems } from '../data';\n</script>\n\n<template>\n  <aside class=\"fixed inset-y-0 left-0 z-10 hidden w-14 flex-col border-r bg-background sm:flex\">\n    <nav class=\"flex flex-col items-center gap-4 px-2 sm:py-5\">\n      <a\n        href=\"#\"\n        class=\"group flex h-9 w-9 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:h-8 md:w-8 md:text-base\"\n      >\n        <Package2Icon class=\"h-4 w-4 transition-all group-hover:scale-110\" />\n        <span class=\"sr-only\">Acme Inc</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in sidebarNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:text-foreground md:h-8 md:w-8\"\n              :class=\"item.isActive ? 'bg-secondary text-secondary-foreground' : 'text-muted-foreground'\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"mt-auto flex flex-col items-center gap-4 px-2 sm:py-5\">\n      <TooltipProvider\n        v-for=\"item in sidebarFooterNavItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:text-foreground md:h-8 md:w-8\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ArchiveProductCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Archive Product</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit.\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div />\n      <Button\n        size=\"sm\"\n        variant=\"secondary\"\n      >\n        Archive Product\n      </Button>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductCategoryCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Label } from '@/components/ui/label';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { categoryOptions, subcategoryOptions } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Category</CardTitle>\n    </CardHeader>\n    <CardContent>\n      <div class=\"grid gap-6 sm:grid-cols-3\">\n        <div class=\"grid gap-3\">\n          <Label for=\"category\">Category</Label>\n          <Select>\n            <SelectTrigger\n              id=\"category\"\n              aria-label=\"Select category\"\n            >\n              <SelectValue placeholder=\"Select category\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in categoryOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n        <div class=\"grid gap-3\">\n          <Label for=\"subcategory\">\n            Subcategory (optional)\n          </Label>\n          <Select>\n            <SelectTrigger\n              id=\"subcategory\"\n              aria-label=\"Select subcategory\"\n            >\n              <SelectValue placeholder=\"Select subcategory\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in subcategoryOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductDetailsCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Textarea } from '@/components/ui/textarea';\nimport { Label } from '@/components/ui/label';\nimport { productDescription, productName } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Details</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"grid gap-6\">\n        <div class=\"grid gap-3\">\n          <Label for=\"name\">Name</Label>\n          <Input\n            id=\"name\"\n            type=\"text\"\n            class=\"w-full\"\n            :model-value=\"productName\"\n          />\n        </div>\n        <div class=\"grid gap-3\">\n          <Label for=\"description\">Description</Label>\n          <Textarea\n            id=\"description\"\n            :model-value=\"productDescription\"\n            class=\"min-h-32\"\n          />\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductImagesCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { UploadIcon } from 'lucide-vue-next';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { mainProductImage, productThumbnails } from '../data';\n</script>\n\n<template>\n  <Card class=\"overflow-hidden\">\n    <CardHeader>\n      <CardTitle>Product imgs</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <div class=\"grid gap-2\">\n        <img\n          :alt=\"mainProductImage.alt\"\n          class=\"aspect-square w-full rounded-md object-cover\"\n          :height=\"mainProductImage.size\"\n          :src=\"mainProductImage.src\"\n          :width=\"mainProductImage.size\"\n        >\n        <div class=\"grid grid-cols-3 gap-2\">\n          <button\n            v-for=\"(thumbnail, thumbnailIndex) in productThumbnails\"\n            :key=\"thumbnailIndex\"\n          >\n            <img\n              :alt=\"thumbnail.alt\"\n              class=\"aspect-square w-full rounded-md object-cover\"\n              :height=\"thumbnail.size\"\n              :src=\"thumbnail.src\"\n              :width=\"thumbnail.size\"\n            >\n          </button>\n          <button class=\"flex aspect-square w-full items-center justify-center rounded-md border border-dashed\">\n            <UploadIcon class=\"h-4 w-4 text-muted-foreground\" />\n            <span class=\"sr-only\">Upload</span>\n          </button>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductStatusCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Label } from '@/components/ui/label';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { statusOptions } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Product Status</CardTitle>\n    </CardHeader>\n    <CardContent>\n      <div class=\"grid gap-6\">\n        <div class=\"grid gap-3\">\n          <Label for=\"status\">Status</Label>\n          <Select>\n            <SelectTrigger\n              id=\"status\"\n              aria-label=\"Select status\"\n            >\n              <SelectValue placeholder=\"Select status\" />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem\n                v-for=\"option in statusOptions\"\n                :key=\"option.value\"\n                :value=\"option.value\"\n              >\n                {{ option.label }}\n              </SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductStockCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { PlusCircleIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport { sizeOptions, stockVariants } from '../data';\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>Stock</CardTitle>\n      <CardDescription>\n        Lipsum dolor sit amet, consectetur adipiscing elit\n      </CardDescription>\n    </CardHeader>\n    <CardContent>\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead class=\"w-[100px]\">\n              SKU\n            </TableHead>\n            <TableHead>Stock</TableHead>\n            <TableHead>Price</TableHead>\n            <TableHead class=\"w-[100px]\">\n              Size\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <TableRow\n            v-for=\"variant in stockVariants\"\n            :key=\"variant.sku\"\n          >\n            <TableCell class=\"font-semibold\">\n              {{ variant.sku }}\n            </TableCell>\n            <TableCell>\n              <Label\n                :for=\"`stock-${variant.id}`\"\n                class=\"sr-only\"\n              >\n                Stock\n              </Label>\n              <Input\n                :id=\"`stock-${variant.id}`\"\n                type=\"number\"\n                :model-value=\"variant.stock\"\n              />\n            </TableCell>\n            <TableCell>\n              <Label\n                :for=\"`price-${variant.id}`\"\n                class=\"sr-only\"\n              >\n                {{ variant.priceLabel }}\n              </Label>\n              <Input\n                :id=\"`price-${variant.id}`\"\n                type=\"number\"\n                :model-value=\"variant.price\"\n              />\n            </TableCell>\n            <TableCell>\n              <ToggleGroup\n                type=\"single\"\n                :default-value=\"variant.defaultSize\"\n                variant=\"outline\"\n              >\n                <ToggleGroupItem\n                  v-for=\"size in sizeOptions\"\n                  :key=\"size.value\"\n                  :value=\"size.value\"\n                >\n                  {{ size.label }}\n                </ToggleGroupItem>\n              </ToggleGroup>\n            </TableCell>\n          </TableRow>\n        </TableBody>\n      </Table>\n    </CardContent>\n    <CardFooter class=\"justify-center border-t p-4\">\n      <Button\n        size=\"sm\"\n        variant=\"ghost\"\n        class=\"gap-1\"\n      >\n        <PlusCircleIcon class=\"h-3.5 w-3.5\" />\n        Add Variant\n      </Button>\n    </CardFooter>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/components/ProductToolbar.vue",
      "content": "<script setup lang=\"ts\">\nimport { ChevronLeftIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\n</script>\n\n<template>\n  <div class=\"flex items-center gap-4\">\n    <Button\n      variant=\"outline\"\n      size=\"icon\"\n      class=\"h-7 w-7\"\n    >\n      <ChevronLeftIcon class=\"h-4 w-4\" />\n      <span class=\"sr-only\">Back</span>\n    </Button>\n    <h1 class=\"flex-1 shrink-0 whitespace-nowrap text-xl font-semibold tracking-tight sm:grow-0\">\n      Pro Controller\n    </h1>\n    <Badge\n      variant=\"outline\"\n      class=\"ml-auto sm:ml-0\"\n    >\n      In stock\n    </Badge>\n    <div class=\"hidden items-center gap-2 md:ml-auto md:flex\">\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n      >\n        Discard\n      </Button>\n      <Button size=\"sm\">\n        Save Product\n      </Button>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-product-edit/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  HomeIcon,\n  LineChartIcon,\n  PackageIcon,\n  SettingsIcon,\n  ShoppingCartIcon,\n  Users2Icon,\n} from 'lucide-vue-next';\n\nexport interface NavItem {\n  label: string;\n  icon: Component;\n  isActive?: boolean;\n}\n\nexport interface BreadcrumbLinkItem {\n  label: string;\n  href: string;\n}\n\nexport interface SelectOption {\n  value: string;\n  label: string;\n}\n\nexport interface StockVariant {\n  id: number;\n  sku: string;\n  stock: string;\n  price: string;\n  priceLabel: string;\n  defaultSize: string;\n}\n\nexport interface ProductImage {\n  alt: string;\n  src: string;\n  size: number;\n}\n\nexport const sidebarNavItems: NavItem[] = [\n  { label: 'Dashboard', icon: HomeIcon },\n  { label: 'Orders', icon: ShoppingCartIcon, isActive: true },\n  { label: 'Products', icon: PackageIcon },\n  { label: 'Customers', icon: Users2Icon },\n  { label: 'Analytics', icon: LineChartIcon },\n];\n\nexport const sidebarFooterNavItems: NavItem[] = [\n  { label: 'Settings', icon: SettingsIcon },\n];\n\nexport const mobileNavItems: NavItem[] = [\n  { label: 'Dashboard', icon: HomeIcon },\n  { label: 'Orders', icon: ShoppingCartIcon },\n  { label: 'Products', icon: PackageIcon, isActive: true },\n  { label: 'Customers', icon: Users2Icon },\n  { label: 'Settings', icon: LineChartIcon },\n];\n\nexport const breadcrumbLinks: BreadcrumbLinkItem[] = [\n  { label: 'Dashboard', href: '#' },\n  { label: 'Products', href: '#' },\n];\n\nexport const breadcrumbPage = 'Edit Product';\n\nexport const productName = 'Gamer Gear Pro Controller';\n\nexport const productDescription = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam auctor, nisl nec ultricies ultricies, nunc nisl ultricies nunc, nec ultricies nunc nisl nec nunc.';\n\nexport const sizeOptions: SelectOption[] = [\n  { value: 's', label: 'S' },\n  { value: 'm', label: 'M' },\n  { value: 'l', label: 'L' },\n];\n\nexport const stockVariants: StockVariant[] = [\n  { id: 1, sku: 'GGPC-001', stock: '100', price: '99.99', priceLabel: 'Price', defaultSize: 's' },\n  { id: 2, sku: 'GGPC-002', stock: '143', price: '99.99', priceLabel: 'Price', defaultSize: 'm' },\n  { id: 3, sku: 'GGPC-003', stock: '32', price: '99.99', priceLabel: 'Stock', defaultSize: 's' },\n];\n\nexport const categoryOptions: SelectOption[] = [\n  { value: 'clothing', label: 'Clothing' },\n  { value: 'electronics', label: 'Electronics' },\n  { value: 'accessories', label: 'Accessories' },\n];\n\nexport const subcategoryOptions: SelectOption[] = [\n  { value: 't-shirts', label: 'T-Shirts' },\n  { value: 'hoodies', label: 'Hoodies' },\n  { value: 'sweatshirts', label: 'Sweatshirts' },\n];\n\nexport const statusOptions: SelectOption[] = [\n  { value: 'draft', label: 'Draft' },\n  { value: 'published', label: 'Active' },\n  { value: 'archived', label: 'Archived' },\n];\n\nexport const mainProductImage: ProductImage = { alt: 'Product image', src: '/placeholder.svg', size: 300 };\n\nexport const productThumbnails: ProductImage[] = [\n  { alt: 'Product image', src: '/placeholder.svg', size: 84 },\n  { alt: 'Product image', src: '/placeholder.svg', size: 84 },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "1200px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
