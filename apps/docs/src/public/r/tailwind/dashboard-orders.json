{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-orders",
  "type": "registry:block",
  "title": "Orders dashboard",
  "description": "An orders dashboard with a sidebar navigation. The sidebar has icon navigation. The content area has a breadcrumb and search in the header. The main area has a list of recent orders with a filter and export button. The main area also has a detailed view of a single order with order details, shipping information, billing information, customer information, and payment information.",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "checkbox",
    "dropdown-menu",
    "input",
    "pagination",
    "progress",
    "separator",
    "sheet",
    "table",
    "tabs",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-orders/DashboardOrders.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport OrderDetails from './components/OrderDetails.vue';\nimport OrdersSummary from './components/OrdersSummary.vue';\nimport OrdersTable from './components/OrdersTable.vue';\nimport {\n  accountMenuGroups,\n  billingInformation,\n  brandName,\n  breadcrumbLinks,\n  breadcrumbPage,\n  customerFields,\n  defaultOrderTab,\n  headerCopy,\n  mobileNavItems,\n  orderActionGroups,\n  orderColumns,\n  orderDetailCopy,\n  orderFilters,\n  orderLineItems,\n  orderSummaryLines,\n  orderTabs,\n  orders,\n  ordersIntro,\n  ordersTableCopy,\n  paginationPageSize,\n  paymentMethod,\n  selectedOrder,\n  shippingAddressLines,\n  sidebarFooterItems,\n  sidebarNavItems,\n  statCards,\n} from './data';\n</script>\n\n<template>\n  <div class=\"flex min-h-screen w-full flex-col bg-muted/40\">\n    <AppSidebar\n      :nav-items=\"sidebarNavItems\"\n      :footer-items=\"sidebarFooterItems\"\n      :brand-name=\"brandName\"\n    />\n    <div class=\"flex flex-col sm:gap-4 sm:py-4 sm:pl-14\">\n      <AppHeader\n        :mobile-nav-items=\"mobileNavItems\"\n        :breadcrumb-links=\"breadcrumbLinks\"\n        :breadcrumb-page=\"breadcrumbPage\"\n        :account-menu-groups=\"accountMenuGroups\"\n        :brand-name=\"brandName\"\n        :header=\"headerCopy\"\n      />\n      <main class=\"grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8 lg:grid-cols-3 xl:grid-cols-3\">\n        <div class=\"grid auto-rows-max items-start gap-4 md:gap-8 lg:col-span-2\">\n          <OrdersSummary\n            :intro=\"ordersIntro\"\n            :stat-cards=\"statCards\"\n          />\n          <OrdersTable\n            :tabs=\"orderTabs\"\n            :active-tab=\"defaultOrderTab\"\n            :filters=\"orderFilters\"\n            :orders=\"orders\"\n            :columns=\"orderColumns\"\n            :copy=\"ordersTableCopy\"\n          />\n        </div>\n        <div>\n          <OrderDetails\n            :order=\"selectedOrder\"\n            :action-groups=\"orderActionGroups\"\n            :line-items=\"orderLineItems\"\n            :summary-lines=\"orderSummaryLines\"\n            :shipping-address-lines=\"shippingAddressLines\"\n            :billing-information=\"billingInformation\"\n            :customer-fields=\"customerFields\"\n            :payment-method=\"paymentMethod\"\n            :page-size=\"paginationPageSize\"\n            :copy=\"orderDetailCopy\"\n          />\n        </div>\n      </main>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { HeaderCopy, NavItem } from '../data';\n\ndefineProps<{\n  mobileNavItems: NavItem[];\n  breadcrumbLinks: string[];\n  breadcrumbPage: string;\n  accountMenuGroups: string[][];\n  brandName: string;\n  header: HeaderCopy;\n}>();\n</script>\n\n<template>\n  <header class=\"sticky top-0 z-30 flex h-14 items-center gap-4 border-b bg-background px-4 sm:static sm:h-auto sm:border-0 sm:bg-transparent sm:px-6\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"sm:hidden\"\n        >\n          <PanelLeftIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">{{ header.toggleMenu }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"sm:max-w-xs\"\n      >\n        <nav class=\"grid gap-6 text-lg font-medium\">\n          <a\n            href=\"#\"\n            class=\"group flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:text-base\"\n          >\n            <Package2Icon class=\"h-5 w-5 transition-all group-hover:scale-110\" />\n            <span class=\"sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"flex items-center gap-4 px-2.5\"\n            :class=\"item.isActive ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n          >\n            <component\n              :is=\"item.icon\"\n              class=\"h-5 w-5\"\n            />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"hidden md:flex\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a href=\"#\">{{ link }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"relative ml-auto flex-1 md:grow-0\">\n      <SearchIcon class=\"absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground\" />\n      <Input\n        type=\"search\"\n        :placeholder=\"header.searchPlaceholder\"\n        class=\"w-full rounded-lg bg-background pl-8 md:w-[200px] lg:w-[336px]\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"rounded-full\"\n        >\n          <CircleUserIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">{{ header.toggleAccount }}</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>{{ header.accountLabel }}</DropdownMenuLabel>\n        <template\n          v-for=\"(group, groupIndex) in accountMenuGroups\"\n          :key=\"groupIndex\"\n        >\n          <DropdownMenuSeparator />\n          <DropdownMenuItem\n            v-for=\"item in group\"\n            :key=\"item\"\n          >\n            {{ item }}\n          </DropdownMenuItem>\n        </template>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from 'lucide-vue-next';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport type { NavItem } from '../data';\n\ndefineProps<{\n  navItems: NavItem[];\n  footerItems: NavItem[];\n  brandName: string;\n}>();\n</script>\n\n<template>\n  <aside class=\"fixed inset-y-0 left-0 z-10 hidden w-14 flex-col border-r bg-background sm:flex\">\n    <nav class=\"flex flex-col items-center gap-4 px-2 sm:py-5\">\n      <a\n        href=\"#\"\n        class=\"group flex h-9 w-9 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:h-8 md:w-8 md:text-base\"\n      >\n        <Package2Icon class=\"h-4 w-4 transition-all group-hover:scale-110\" />\n        <span class=\"sr-only\">{{ brandName }}</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in navItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:text-foreground md:h-8 md:w-8\"\n              :class=\"item.isActive ? 'bg-secondary text-secondary-foreground' : 'text-muted-foreground'\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"mt-auto flex flex-col items-center gap-4 px-2 sm:py-5\">\n      <TooltipProvider\n        v-for=\"item in footerItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:text-foreground md:h-8 md:w-8\"\n              :class=\"item.isActive ? 'bg-secondary text-secondary-foreground' : 'text-muted-foreground'\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/OrderDetails.vue",
      "content": "<script setup lang=\"ts\">\nimport { CopyIcon, CreditCardIcon, MoreVerticalIcon, TruckIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Pagination,\n  PaginationList,\n  PaginationNext,\n  PaginationPrev,\n} from '@/components/ui/pagination';\nimport { Separator } from '@/components/ui/separator';\nimport type { CustomerField, OrderDetailCopy, OrderLineItem, OrderSummaryLine, PaymentMethod, SelectedOrder } from '../data';\n\ndefineProps<{\n  order: SelectedOrder;\n  actionGroups: string[][];\n  lineItems: OrderLineItem[];\n  summaryLines: OrderSummaryLine[];\n  shippingAddressLines: string[];\n  billingInformation: string;\n  customerFields: CustomerField[];\n  paymentMethod: PaymentMethod;\n  pageSize: number;\n  copy: OrderDetailCopy;\n}>();\n</script>\n\n<template>\n  <Card class=\"overflow-hidden\">\n    <CardHeader class=\"flex flex-row items-start bg-muted/50\">\n      <div class=\"grid gap-0.5\">\n        <CardTitle class=\"group flex items-center gap-2 text-lg\">\n          {{ copy.id }} {{ order.id }}\n          <Button\n            size=\"icon\"\n            variant=\"outline\"\n            class=\"h-6 w-6 opacity-0 transition-opacity group-hover:opacity-100\"\n          >\n            <CopyIcon class=\"h-3 w-3\" />\n            <span class=\"sr-only\">{{ copy.copyId }}</span>\n          </Button>\n        </CardTitle>\n        <CardDescription>{{ copy.date }} {{ order.date }}</CardDescription>\n      </div>\n      <div class=\"ml-auto flex items-center gap-1\">\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          class=\"h-8 gap-1\"\n        >\n          <TruckIcon class=\"h-3.5 w-3.5\" />\n          <span class=\"lg:sr-only xl:not-sr-only xl:whitespace-nowrap\">\n            {{ copy.trackOrder }}\n          </span>\n        </Button>\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              size=\"icon\"\n              variant=\"outline\"\n              class=\"h-8 w-8\"\n            >\n              <MoreVerticalIcon class=\"h-3.5 w-3.5\" />\n              <span class=\"sr-only\">{{ copy.more }}</span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <template\n              v-for=\"(group, groupIndex) in actionGroups\"\n              :key=\"groupIndex\"\n            >\n              <DropdownMenuSeparator v-if=\"groupIndex > 0\" />\n              <DropdownMenuItem\n                v-for=\"item in group\"\n                :key=\"item\"\n              >\n                {{ item }}\n              </DropdownMenuItem>\n            </template>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </div>\n    </CardHeader>\n    <CardContent class=\"p-6 text-sm\">\n      <div class=\"grid gap-3\">\n        <div class=\"font-semibold\">\n          {{ copy.details }}\n        </div>\n        <ul class=\"grid gap-3\">\n          <li\n            v-for=\"item in lineItems\"\n            :key=\"item.name\"\n            class=\"flex items-center justify-between\"\n          >\n            <span class=\"text-muted-foreground\">\n              {{ item.name }} x <span>{{ item.quantity }}</span>\n            </span>\n            <span>{{ item.price }}</span>\n          </li>\n        </ul>\n        <Separator class=\"my-2\" />\n        <ul class=\"grid gap-3\">\n          <li\n            v-for=\"line in summaryLines\"\n            :key=\"line.label\"\n            class=\"flex items-center justify-between\"\n            :class=\"{ 'font-semibold': line.isTotal }\"\n          >\n            <span class=\"text-muted-foreground\">{{ line.label }}</span>\n            <span>{{ line.value }}</span>\n          </li>\n        </ul>\n      </div>\n      <Separator class=\"my-4\" />\n      <div class=\"grid grid-cols-2 gap-4\">\n        <div class=\"grid gap-3\">\n          <div class=\"font-semibold\">\n            {{ copy.shipping }}\n          </div>\n          <address class=\"grid gap-0.5 not-italic text-muted-foreground\">\n            <span\n              v-for=\"line in shippingAddressLines\"\n              :key=\"line\"\n            >{{ line }}</span>\n          </address>\n        </div>\n        <div class=\"grid auto-rows-max gap-3\">\n          <div class=\"font-semibold\">\n            {{ copy.billing }}\n          </div>\n          <div class=\"text-muted-foreground\">\n            {{ billingInformation }}\n          </div>\n        </div>\n      </div>\n      <Separator class=\"my-4\" />\n      <div class=\"grid gap-3\">\n        <div class=\"font-semibold\">\n          {{ copy.customer }}\n        </div>\n        <dl class=\"grid gap-3\">\n          <div\n            v-for=\"field in customerFields\"\n            :key=\"field.label\"\n            class=\"flex items-center justify-between\"\n          >\n            <dt class=\"text-muted-foreground\">\n              {{ field.label }}\n            </dt>\n            <dd>\n              <a\n                v-if=\"field.href\"\n                :href=\"field.href\"\n              >{{ field.value }}</a>\n              <template v-else>\n                {{ field.value }}\n              </template>\n            </dd>\n          </div>\n        </dl>\n      </div>\n      <Separator class=\"my-4\" />\n      <div class=\"grid gap-3\">\n        <div class=\"font-semibold\">\n          {{ copy.payment }}\n        </div>\n        <dl class=\"grid gap-3\">\n          <div class=\"flex items-center justify-between\">\n            <dt class=\"flex items-center gap-1 text-muted-foreground\">\n              <CreditCardIcon class=\"h-4 w-4\" />\n              {{ paymentMethod.brand }}\n            </dt>\n            <dd>{{ paymentMethod.maskedNumber }}</dd>\n          </div>\n        </dl>\n      </div>\n    </CardContent>\n    <CardFooter class=\"flex flex-row items-center border-t bg-muted/50 px-6 py-3\">\n      <div class=\"text-xs text-muted-foreground\">\n        {{ copy.updated }} <time :datetime=\"order.updatedAt.dateTime\">{{ order.updatedAt.label }}</time>\n      </div>\n      <Pagination\n        class=\"ml-auto mr-0 w-auto\"\n        :items-per-page=\"pageSize\"\n      >\n        <PaginationList class=\"gap-1\">\n          <PaginationPrev\n            variant=\"outline\"\n            class=\"h-6 w-6\"\n          />\n          <PaginationNext\n            variant=\"outline\"\n            class=\"h-6 w-6\"\n          />\n        </PaginationList>\n      </Pagination>\n    </CardFooter>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/OrdersSummary.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Progress } from '@/components/ui/progress';\nimport type { OrdersIntro, StatCard } from '../data';\n\ndefineProps<{\n  intro: OrdersIntro;\n  statCards: StatCard[];\n}>();\n</script>\n\n<template>\n  <div class=\"grid gap-4 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4\">\n    <Card class=\"sm:col-span-2\">\n      <CardHeader class=\"pb-3\">\n        <CardTitle>{{ intro.title }}</CardTitle>\n        <CardDescription class=\"max-w-lg text-balance leading-relaxed\">\n          {{ intro.description }}\n        </CardDescription>\n      </CardHeader>\n      <CardFooter>\n        <Button>{{ intro.action }}</Button>\n      </CardFooter>\n    </Card>\n    <Card\n      v-for=\"stat in statCards\"\n      :key=\"stat.description\"\n    >\n      <CardHeader class=\"pb-2\">\n        <CardDescription>{{ stat.description }}</CardDescription>\n        <CardTitle :class=\"stat.valueSize === 'large' ? 'text-4xl' : 'text-3xl'\">\n          {{ stat.value }}\n        </CardTitle>\n      </CardHeader>\n      <CardContent>\n        <div class=\"text-xs text-muted-foreground\">\n          {{ stat.change }}\n        </div>\n      </CardContent>\n      <CardFooter>\n        <Progress\n          :model-value=\"stat.progress\"\n          :aria-label=\"stat.progressLabel\"\n        />\n      </CardFooter>\n    </Card>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/components/OrdersTable.vue",
      "content": "<script setup lang=\"ts\">\nimport { FileIcon, ListFilterIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from '@/components/ui/tabs';\nimport type { Order, OrderColumns, OrderTab, OrdersTableCopy } from '../data';\n\ndefineProps<{\n  tabs: OrderTab[];\n  activeTab: string;\n  filters: string[];\n  orders: Order[];\n  columns: OrderColumns;\n  copy: OrdersTableCopy;\n}>();\n</script>\n\n<template>\n  <Tabs :default-value=\"activeTab\">\n    <div class=\"flex items-center\">\n      <TabsList>\n        <TabsTrigger\n          v-for=\"tab in tabs\"\n          :key=\"tab.value\"\n          :value=\"tab.value\"\n        >\n          {{ tab.label }}\n        </TabsTrigger>\n      </TabsList>\n      <div class=\"ml-auto flex items-center gap-2\">\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              class=\"h-7 gap-1 rounded-md px-3\"\n            >\n              <ListFilterIcon class=\"h-3.5 w-3.5\" />\n              <span class=\"sr-only sm:not-sr-only\">{{ copy.filter }}</span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <DropdownMenuLabel>{{ copy.filterBy }}</DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem\n              v-for=\"filter in filters\"\n              :key=\"filter\"\n            >\n              <div class=\"items-top flex space-x-2\">\n                <Checkbox id=\"terms1\" />\n                <label\n                  for=\"terms2\"\n                  class=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n                >\n                  {{ filter }}\n                </label>\n              </div>\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          class=\"h-7 gap-1 rounded-md px-3\"\n        >\n          <FileIcon class=\"h-3.5 w-3.5\" />\n          <span class=\"sr-only sm:not-sr-only\">{{ copy.export }}</span>\n        </Button>\n      </div>\n    </div>\n    <TabsContent :value=\"activeTab\">\n      <Card>\n        <CardHeader class=\"px-7\">\n          <CardTitle>{{ copy.title }}</CardTitle>\n          <CardDescription>\n            {{ copy.description }}\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <Table>\n            <TableHeader>\n              <TableRow>\n                <TableHead>{{ columns.customer }}</TableHead>\n                <TableHead class=\"hidden sm:table-cell\">\n                  {{ columns.type }}\n                </TableHead>\n                <TableHead class=\"hidden sm:table-cell\">\n                  {{ columns.status }}\n                </TableHead>\n                <TableHead class=\"hidden md:table-cell\">\n                  {{ columns.date }}\n                </TableHead>\n                <TableHead class=\"text-right\">\n                  {{ columns.amount }}\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              <TableRow\n                v-for=\"(order, orderIndex) in orders\"\n                :key=\"orderIndex\"\n                :class=\"{ 'bg-secondary': order.isSelected }\"\n              >\n                <TableCell>\n                  <div class=\"font-medium\">\n                    {{ order.customer }}\n                  </div>\n                  <div class=\"hidden text-sm text-muted-foreground md:inline\">\n                    {{ order.email }}\n                  </div>\n                </TableCell>\n                <TableCell class=\"hidden sm:table-cell\">\n                  {{ order.type }}\n                </TableCell>\n                <TableCell class=\"hidden sm:table-cell\">\n                  <Badge\n                    class=\"text-xs\"\n                    :variant=\"order.badgeVariant\"\n                  >\n                    {{ order.status }}\n                  </Badge>\n                </TableCell>\n                <TableCell class=\"hidden md:table-cell\">\n                  {{ order.date }}\n                </TableCell>\n                <TableCell class=\"text-right\">\n                  {{ order.amount }}\n                </TableCell>\n              </TableRow>\n            </TableBody>\n          </Table>\n        </CardContent>\n      </Card>\n    </TabsContent>\n  </Tabs>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-orders/data.ts",
