{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-analytics",
  "type": "registry:block",
  "title": "Analytics dashboard",
  "description": "An application shell with a header and main content area. The header has a navbar, a search input and and a user nav dropdown. The user nav is toggled by a button with an avatar image. The main content area is divided into two rows. The first row has a grid of cards with statistics. The second row has a grid of cards with a table of recent transactions and a list of recent sales.",
  "dependencies": [
    "lucide-vue-next@^0.475.0"
  ],
  "registryDependencies": [
    "avatar",
    "badge",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "sheet",
    "table"
  ],
  "files": [
    {
      "path": "blocks/dashboard-analytics/DashboardAnalytics.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport RecentSalesCard from './components/RecentSalesCard.vue';\nimport StatCard from './components/StatCard.vue';\nimport TransactionsCard from './components/TransactionsCard.vue';\nimport {\n  accountMenu,\n  brandHref,\n  brandName,\n  headerLinks,\n  navigationLabel,\n  recentSales,\n  recentSalesTitle,\n  searchPlaceholder,\n  statCards,\n  transactionColumnLabels,\n  transactions,\n  transactionsActionHref,\n  transactionsActionLabel,\n  transactionsDescription,\n  transactionsTitle,\n  userMenuLabel,\n} from './data';\n</script>\n\n<template>\n  <div class=\"flex min-h-screen w-full flex-col\">\n    <AppHeader\n      :brand-name=\"brandName\"\n      :brand-href=\"brandHref\"\n      :links=\"headerLinks\"\n      :search-placeholder=\"searchPlaceholder\"\n      :menu-entries=\"accountMenu\"\n      :user-menu-label=\"userMenuLabel\"\n      :navigation-label=\"navigationLabel\"\n    />\n    <main class=\"flex flex-1 flex-col gap-4 p-4 md:gap-8 md:p-8\">\n      <div class=\"grid gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4\">\n        <StatCard\n          v-for=\"stat in statCards\"\n          :key=\"stat.title\"\n          :title=\"stat.title\"\n          :value=\"stat.value\"\n          :change=\"stat.change\"\n          :icon=\"stat.icon\"\n        />\n      </div>\n      <div class=\"grid gap-4 md:gap-8 lg:grid-cols-2 xl:grid-cols-3\">\n        <TransactionsCard\n          class=\"xl:col-span-2\"\n          :title=\"transactionsTitle\"\n          :description=\"transactionsDescription\"\n          :action-label=\"transactionsActionLabel\"\n          :action-href=\"transactionsActionHref\"\n          :column-labels=\"transactionColumnLabels\"\n          :rows=\"transactions\"\n        />\n        <RecentSalesCard\n          :title=\"recentSalesTitle\"\n          :sales=\"recentSales\"\n        />\n      </div>\n    </main>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { MenuIcon, Package2Icon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { AccountMenuEntry, NavLink } from '../data';\nimport SearchForm from './SearchForm.vue';\nimport UserMenu from './UserMenu.vue';\n\ndefineProps<{\n  brandName: string;\n  brandHref: string;\n  links: NavLink[];\n  searchPlaceholder: string;\n  menuEntries: AccountMenuEntry[];\n  userMenuLabel: string;\n  navigationLabel: string;\n}>();\n</script>\n\n<template>\n  <header class=\"sticky top-0 flex h-16 items-center gap-4 border-b bg-background px-4 md:px-6\">\n    <nav class=\"hidden flex-col gap-6 text-lg font-medium md:flex md:flex-row md:items-center md:gap-5 md:text-sm lg:gap-6\">\n      <a\n        :href=\"brandHref\"\n        class=\"flex items-center gap-2 text-lg font-semibold md:text-base\"\n      >\n        <Package2Icon class=\"h-6 w-6\" />\n        <span class=\"sr-only\">{{ brandName }}</span>\n      </a>\n      <a\n        v-for=\"link in links\"\n        :key=\"link.label\"\n        :href=\"link.href\"\n        class=\"transition-colors hover:text-foreground\"\n        :class=\"link.isActive ? 'text-foreground' : 'text-muted-foreground'\"\n      >\n        {{ link.label }}\n      </a>\n    </nav>\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          variant=\"outline\"\n          size=\"icon\"\n          class=\"shrink-0 md:hidden\"\n        >\n          <MenuIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">{{ navigationLabel }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent side=\"left\">\n        <nav class=\"grid gap-6 text-lg font-medium\">\n          <a\n            :href=\"brandHref\"\n            class=\"flex items-center gap-2 text-lg font-semibold\"\n          >\n            <Package2Icon class=\"h-6 w-6\" />\n            <span class=\"sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"link in links\"\n            :key=\"link.label\"\n            :href=\"link.href\"\n            :class=\"link.isActive ? 'hover:text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n          >\n            {{ link.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <div class=\"flex w-full items-center gap-4 md:ml-auto md:gap-2 lg:gap-4\">\n      <SearchForm :placeholder=\"searchPlaceholder\" />\n      <UserMenu\n        :entries=\"menuEntries\"\n        :trigger-label=\"userMenuLabel\"\n      />\n    </div>\n  </header>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/RecentSalesCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Avatar } from '@/components/ui/avatar';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { SaleRow } from '../data';\n\ndefineProps<{\n  title: string;\n  sales: SaleRow[];\n}>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader>\n      <CardTitle>{{ title }}</CardTitle>\n    </CardHeader>\n    <CardContent class=\"grid gap-8\">\n      <div\n        v-for=\"sale in sales\"\n        :key=\"sale.id\"\n        class=\"flex items-center gap-4\"\n      >\n        <Avatar\n          size=\"sm\"\n          class=\"hidden h-9 w-9 sm:flex\"\n        />\n        <div class=\"grid gap-1\">\n          <p class=\"text-sm font-medium leading-none\">\n            {{ sale.name }}\n          </p>\n          <p class=\"text-sm text-muted-foreground\">\n            {{ sale.email }}\n          </p>\n        </div>\n        <div class=\"ml-auto font-medium\">\n          {{ sale.amount }}\n        </div>\n      </div>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/SearchForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { SearchIcon } from 'lucide-vue-next';\nimport { Input } from '@/components/ui/input';\n\ndefineProps<{\n  placeholder: string;\n}>();\n</script>\n\n<template>\n  <form class=\"ml-auto flex-1 sm:flex-initial\">\n    <div class=\"relative\">\n      <SearchIcon class=\"absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground\" />\n      <Input\n        type=\"search\"\n        :placeholder=\"placeholder\"\n        class=\"pl-8 sm:w-[300px] md:w-[200px] lg:w-[300px]\"\n      />\n    </div>\n  </form>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/StatCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport type { StatCardData } from '../data';\n\ndefineProps<StatCardData>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader class=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n      <CardTitle class=\"text-sm font-medium\">\n        {{ title }}\n      </CardTitle>\n      <component\n        :is=\"icon\"\n        class=\"h-4 w-4 text-muted-foreground\"\n      />\n    </CardHeader>\n    <CardContent>\n      <div class=\"text-2xl font-bold\">\n        {{ value }}\n      </div>\n      <p class=\"text-xs text-muted-foreground\">\n        {{ change }}\n      </p>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/TransactionsCard.vue",
      "content": "<script setup lang=\"ts\">\nimport { ArrowUpRightIcon } from 'lucide-vue-next';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';\nimport type { TransactionColumnLabels, TransactionRow } from '../data';\n\ndefineProps<{\n  title: string;\n  description: string;\n  actionLabel: string;\n  actionHref: string;\n  columnLabels: TransactionColumnLabels;\n  rows: TransactionRow[];\n}>();\n</script>\n\n<template>\n  <Card>\n    <CardHeader class=\"flex flex-row items-center\">\n      <div class=\"grid gap-2\">\n        <CardTitle>{{ title }}</CardTitle>\n        <CardDescription>\n          {{ description }}\n        </CardDescription>\n      </div>\n      <Button\n        as-child\n        size=\"sm\"\n        class=\"ml-auto gap-1\"\n      >\n        <a :href=\"actionHref\">\n          {{ actionLabel }}\n          <ArrowUpRightIcon class=\"h-4 w-4\" />\n        </a>\n      </Button>\n    </CardHeader>\n    <CardContent>\n      <Table>\n        <TableHeader>\n          <TableRow>\n            <TableHead>{{ columnLabels.customer }}</TableHead>\n            <TableHead class=\"hidden xl:table-column\">\n              {{ columnLabels.type }}\n            </TableHead>\n            <TableHead class=\"hidden xl:table-column\">\n              {{ columnLabels.status }}\n            </TableHead>\n            <TableHead class=\"hidden xl:table-column\">\n              {{ columnLabels.date }}\n            </TableHead>\n            <TableHead class=\"text-right\">\n              {{ columnLabels.amount }}\n            </TableHead>\n          </TableRow>\n        </TableHeader>\n        <TableBody>\n          <TableRow\n            v-for=\"row in rows\"\n            :key=\"row.id\"\n          >\n            <TableCell>\n              <div class=\"font-medium\">\n                {{ row.customerName }}\n              </div>\n              <div class=\"hidden text-sm text-muted-foreground md:inline\">\n                {{ row.email }}\n              </div>\n            </TableCell>\n            <TableCell class=\"hidden xl:table-column\">\n              {{ row.type }}\n            </TableCell>\n            <TableCell class=\"hidden xl:table-column\">\n              <Badge\n                class=\"text-xs\"\n                variant=\"outline\"\n              >\n                {{ row.status }}\n              </Badge>\n            </TableCell>\n            <TableCell class=\"hidden md:table-cell lg:hidden xl:table-column\">\n              {{ row.date }}\n            </TableCell>\n            <TableCell class=\"text-right\">\n              {{ row.amount }}\n            </TableCell>\n          </TableRow>\n        </TableBody>\n      </Table>\n    </CardContent>\n  </Card>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/components/UserMenu.vue",
      "content": "<script setup lang=\"ts\">\nimport { CircleUserIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuLabel, DropdownMenuSeparator, DropdownMenuTrigger } from '@/components/ui/dropdown-menu';\nimport type { AccountMenuEntry } from '../data';\n\ndefineProps<{\n  entries: AccountMenuEntry[];\n  triggerLabel: string;\n}>();\n</script>\n\n<template>\n  <DropdownMenu>\n    <DropdownMenuTrigger as-child>\n      <Button\n        variant=\"secondary\"\n        size=\"icon\"\n        class=\"rounded-full\"\n      >\n        <CircleUserIcon class=\"h-5 w-5\" />\n        <span class=\"sr-only\">{{ triggerLabel }}</span>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\">\n      <template\n        v-for=\"entry in entries\"\n        :key=\"entry.id\"\n      >\n        <DropdownMenuLabel v-if=\"entry.kind === 'label'\">\n          {{ entry.label }}\n        </DropdownMenuLabel>\n        <DropdownMenuSeparator v-else-if=\"entry.kind === 'separator'\" />\n        <DropdownMenuItem v-else-if=\"entry.kind === 'action'\">\n          {{ entry.label }}\n        </DropdownMenuItem>\n      </template>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-analytics/data.ts",
      "content": "import type { Component } from 'vue';\nimport { ActivityIcon, CreditCardIcon, DollarSignIcon, UsersIcon } from 'lucide-vue-next';\n\nexport interface NavLink {\n  label: string;\n  href: string;\n  isActive?: boolean;\n}\n\nexport type AccountMenuEntry =\n  | { id: string; kind: 'label'; label: string }\n  | { id: string; kind: 'separator' }\n  | { id: string; kind: 'action'; label: string };\n\nexport interface StatCardData {\n  title: string;\n  value: string;\n  change: string;\n  icon: Component;\n}\n\nexport interface TransactionColumnLabels {\n  customer: string;\n  type: string;\n  status: string;\n  date: string;\n  amount: string;\n}\n\nexport interface TransactionRow {\n  id: string;\n  customerName: string;\n  email: string;\n  type: string;\n  status: string;\n  date: string;\n  amount: string;\n}\n\nexport interface SaleRow {\n  id: string;\n  name: string;\n  email: string;\n  amount: string;\n}\n\nexport const brandName = 'Acme Inc';\n\nexport const brandHref = '#';\n\nexport const searchPlaceholder = 'Search products...';\n\nexport const navigationLabel = 'Toggle navigation menu';\n\nexport const userMenuLabel = 'Toggle user menu';\n\nexport const headerLinks: NavLink[] = [\n  { label: 'Dashboard', href: '#', isActive: true },\n  { label: 'Orders', href: '#' },\n  { label: 'Products', href: '#' },\n  { label: 'Customers', href: '#' },\n  { label: 'Analytics', href: '#' },\n];\n\nexport const accountMenu: AccountMenuEntry[] = [\n  { id: 'account-label', kind: 'label', label: 'My Account' },\n  { id: 'account-separator', kind: 'separator' },\n  { id: 'settings', kind: 'action', label: 'Settings' },\n  { id: 'support', kind: 'action', label: 'Support' },\n  { id: 'logout-separator', kind: 'separator' },\n  { id: 'logout', kind: 'action', label: 'Logout' },\n];\n\nexport const statCards: StatCardData[] = [\n  { title: 'Total Revenue', value: '$45,231.89', change: '+20.1% from last month', icon: DollarSignIcon },\n  { title: 'Subscriptions', value: '+2350', change: '+180.1% from last month', icon: UsersIcon },\n  { title: 'Sales', value: '+12,234', change: '+19% from last month', icon: CreditCardIcon },\n  { title: 'Active Now', value: '+573', change: '+201 since last hour', icon: ActivityIcon },\n];\n\nexport const transactionsTitle = 'Transactions';\n\nexport const transactionsDescription = 'Recent transactions from your store.';\n\nexport const transactionsActionLabel = 'View All';\n\nexport const transactionsActionHref = '#';\n\nexport const transactionColumnLabels: TransactionColumnLabels = {\n  customer: 'Customer',\n  type: 'Type',\n  status: 'Status',\n  date: 'Date',\n  amount: 'Amount',\n};\n\nexport const transactions: TransactionRow[] = [\n  { id: 'liam-johnson-2023-06-23', customerName: 'Liam Johnson', email: 'liam@example.com', type: 'Sale', status: 'Approved', date: '2023-06-23', amount: '$250.00' },\n  { id: 'olivia-smith-2023-06-24', customerName: 'Olivia Smith', email: 'olivia@example.com', type: 'Refund', status: 'Declined', date: '2023-06-24', amount: '$150.00' },\n  { id: 'noah-williams-2023-06-25', customerName: 'Noah Williams', email: 'noah@example.com', type: 'Subscription', status: 'Approved', date: '2023-06-25', amount: '$350.00' },\n  { id: 'emma-brown-2023-06-26', customerName: 'Emma Brown', email: 'emma@example.com', type: 'Sale', status: 'Approved', date: '2023-06-26', amount: '$450.00' },\n  { id: 'liam-johnson-2023-06-27', customerName: 'Liam Johnson', email: 'liam@example.com', type: 'Sale', status: 'Approved', date: '2023-06-27', amount: '$550.00' },\n];\n\nexport const recentSalesTitle = 'Recent Sales';\n\nexport const recentSales: SaleRow[] = [\n  { id: 'olivia-martin', name: 'Olivia Martin', email: 'olivia.martin@email.com', amount: '+$1,999.00' },\n  { id: 'jackson-lee', name: 'Jackson Lee', email: 'jackson.lee@email.com', amount: '+$39.00' },\n  { id: 'isabella-nguyen', name: 'Isabella Nguyen', email: 'isabella.nguyen@email.com', amount: '+$299.00' },\n  { id: 'william-kim', name: 'William Kim', email: 'will@email.com', amount: '+$99.00' },\n  { id: 'sofia-davis', name: 'Sofia Davis', email: 'sofia.davis@email.com', amount: '+$39.00' },\n];\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "825px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "dashboard"
  ]
}
