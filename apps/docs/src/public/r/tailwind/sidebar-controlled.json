{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-controlled",
  "type": "registry:example",
  "title": "SidebarControlled",
  "dependencies": [
    "lucide-vue-next@^1.0.0"
  ],
  "registryDependencies": [
    "button",
    "sidebar"
  ],
  "files": [
    {
      "path": "example/SidebarControlled.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { CalendarIcon, HomeIcon, InboxIcon } from 'lucide-vue-next';\nimport { Button } from '@/components/ui/button';\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n} from '@/components/ui/sidebar';\n\nconst isOpen = ref(true);\n\nconst items = [\n  { title: 'Home', icon: HomeIcon },\n  { title: 'Inbox', icon: InboxIcon },\n  { title: 'Calendar', icon: CalendarIcon },\n];\n</script>\n\n<template>\n  <div class=\"relative h-[360px] w-full overflow-hidden rounded-lg border [transform:translateZ(0)]\">\n    <SidebarProvider\n      v-model:open=\"isOpen\"\n      cookie-name=\"\"\n      class=\"h-full min-h-full\"\n    >\n      <SidebarInset>\n        <div class=\"flex flex-1 flex-col items-start gap-4 p-4\">\n          <Button\n            variant=\"outline\"\n            @click=\"isOpen = !isOpen\"\n          >\n            {{ isOpen ? 'Close sidebar' : 'Open sidebar' }}\n          </Button>\n          <p class=\"text-sm text-muted-foreground\">\n            The sidebar is {{ isOpen ? 'open' : 'closed' }}.\n          </p>\n        </div>\n      </SidebarInset>\n      <Sidebar\n        side=\"right\"\n        class=\"h-full\"\n      >\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                <SidebarMenuItem\n                  v-for=\"item in items\"\n                  :key=\"item.title\"\n                >\n                  <SidebarMenuButton>\n                    <component :is=\"item.icon\" />\n                    <span>{{ item.title }}</span>\n                  </SidebarMenuButton>\n                </SidebarMenuItem>\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n      </Sidebar>\n    </SidebarProvider>\n  </div>\n</template>\n",
      "type": "registry:example"
    }
  ]
}
