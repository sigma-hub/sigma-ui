{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-products",
  "type": "registry:block",
  "title": "Products dashboard",
  "description": "An products dashboard with a sidebar navigation. The sidebar has icon navigation. The content area has a breadcrumb and search in the header. It displays a list of products in a table with actions.",
  "dependencies": [
    "@lucide/vue@^1.59.0"
  ],
  "registryDependencies": [
    "badge",
    "breadcrumb",
    "button",
    "card",
    "dropdown-menu",
    "input",
    "sheet",
    "table",
    "tabs",
    "tooltip"
  ],
  "files": [
    {
      "path": "blocks/dashboard-products/DashboardProducts.vue",
      "content": "<script setup lang=\"ts\">\nimport AppHeader from './components/AppHeader.vue';\nimport AppSidebar from './components/AppSidebar.vue';\nimport ProductsPanel from './components/ProductsPanel.vue';\nimport {\n  accountMenuGroups,\n  brandName,\n  breadcrumbLinks,\n  currentBreadcrumb,\n  defaultProductTab,\n  filterOptions,\n  headerCopy,\n  mobileNavLinks,\n  productActions,\n  productDetailColumns,\n  productTabs,\n  products,\n  productsCopy,\n  productsSummary,\n  sidebarFooterLinks,\n  sidebarLinks,\n} from './data';\n</script>\n\n<template>\n  <div class=\"flex min-h-screen w-full flex-col bg-muted/40\">\n    <AppSidebar\n      :nav-items=\"sidebarLinks\"\n      :footer-items=\"sidebarFooterLinks\"\n      :brand-name=\"brandName\"\n    />\n    <div class=\"flex flex-col sm:gap-4 sm:py-4 sm:pl-14\">\n      <AppHeader\n        :mobile-nav-items=\"mobileNavLinks\"\n        :breadcrumb-links=\"breadcrumbLinks\"\n        :breadcrumb-page=\"currentBreadcrumb\"\n        :account-menu-groups=\"accountMenuGroups\"\n        :brand-name=\"brandName\"\n        :header=\"headerCopy\"\n      />\n      <main class=\"grid flex-1 items-start gap-4 p-4 sm:px-6 sm:py-0 md:gap-8\">\n        <ProductsPanel\n          :tabs=\"productTabs\"\n          :active-tab=\"defaultProductTab\"\n          :filter-options=\"filterOptions\"\n          :products=\"products\"\n          :detail-columns=\"productDetailColumns\"\n          :actions=\"productActions\"\n          :summary=\"productsSummary\"\n          :copy=\"productsCopy\"\n        />\n      </main>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/AppHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  CircleUserIcon,\n  Package2Icon,\n  PanelLeftIcon,\n  SearchIcon,\n} from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport { Input } from '@/components/ui/input';\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from '@/components/ui/breadcrumb';\nimport { Sheet, SheetContent, SheetTrigger } from '@/components/ui/sheet';\nimport type { HeaderCopy, MobileNavLink } from '../data';\n\ndefineProps<{\n  mobileNavItems: MobileNavLink[];\n  breadcrumbLinks: string[];\n  breadcrumbPage: string;\n  accountMenuGroups: string[][];\n  brandName: string;\n  header: HeaderCopy;\n}>();\n</script>\n\n<template>\n  <header class=\"sticky top-0 z-30 flex h-14 items-center gap-4 border-b bg-background px-4 sm:static sm:h-auto sm:border-0 sm:bg-transparent sm:px-6\">\n    <Sheet>\n      <SheetTrigger as-child>\n        <Button\n          size=\"icon\"\n          variant=\"outline\"\n          class=\"sm:hidden\"\n        >\n          <PanelLeftIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">{{ header.toggleMenu }}</span>\n        </Button>\n      </SheetTrigger>\n      <SheetContent\n        side=\"left\"\n        class=\"sm:max-w-xs\"\n      >\n        <nav class=\"grid gap-6 text-lg font-medium\">\n          <a\n            href=\"#\"\n            class=\"group flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:text-base\"\n          >\n            <Package2Icon class=\"h-5 w-5 transition-all group-hover:scale-110\" />\n            <span class=\"sr-only\">{{ brandName }}</span>\n          </a>\n          <a\n            v-for=\"item in mobileNavItems\"\n            :key=\"item.label\"\n            href=\"#\"\n            class=\"flex items-center gap-4 px-2.5\"\n            :class=\"item.isActive ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n          >\n            <component\n              :is=\"item.icon\"\n              class=\"h-5 w-5\"\n            />\n            {{ item.label }}\n          </a>\n        </nav>\n      </SheetContent>\n    </Sheet>\n    <Breadcrumb class=\"hidden md:flex\">\n      <BreadcrumbList>\n        <template\n          v-for=\"link in breadcrumbLinks\"\n          :key=\"link\"\n        >\n          <BreadcrumbItem>\n            <BreadcrumbLink as-child>\n              <a href=\"#\">{{ link }}</a>\n            </BreadcrumbLink>\n          </BreadcrumbItem>\n          <BreadcrumbSeparator />\n        </template>\n        <BreadcrumbItem>\n          <BreadcrumbPage>{{ breadcrumbPage }}</BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n    <div class=\"relative ml-auto flex-1 md:grow-0\">\n      <SearchIcon class=\"absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground\" />\n      <Input\n        type=\"search\"\n        :placeholder=\"header.searchPlaceholder\"\n        class=\"w-full rounded-lg bg-background pl-8 md:w-[200px] lg:w-[320px]\"\n      />\n    </div>\n    <DropdownMenu>\n      <DropdownMenuTrigger as-child>\n        <Button\n          variant=\"secondary\"\n          size=\"icon\"\n          class=\"rounded-full\"\n        >\n          <CircleUserIcon class=\"h-5 w-5\" />\n          <span class=\"sr-only\">{{ header.toggleAccount }}</span>\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\">\n        <DropdownMenuLabel>{{ header.accountLabel }}</DropdownMenuLabel>\n        <template\n          v-for=\"(group, groupIndex) in accountMenuGroups\"\n          :key=\"groupIndex\"\n        >\n          <DropdownMenuSeparator />\n          <DropdownMenuItem\n            v-for=\"item in group\"\n            :key=\"item\"\n          >\n            {{ item }}\n          </DropdownMenuItem>\n        </template>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  </header>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/AppSidebar.vue",
      "content": "<script setup lang=\"ts\">\nimport { Package2Icon } from '@lucide/vue';\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from '@/components/ui/tooltip';\nimport type { SidebarLink } from '../data';\n\ndefineProps<{\n  navItems: SidebarLink[];\n  footerItems: SidebarLink[];\n  brandName: string;\n}>();\n</script>\n\n<template>\n  <aside class=\"fixed inset-y-0 left-0 z-10 hidden w-14 flex-col border-r bg-background sm:flex\">\n    <nav class=\"flex flex-col items-center gap-4 px-2 py-4\">\n      <a\n        href=\"#\"\n        class=\"group flex h-9 w-9 shrink-0 items-center justify-center gap-2 rounded-full bg-primary text-lg font-semibold text-primary-foreground md:h-8 md:w-8 md:text-base\"\n      >\n        <Package2Icon class=\"h-4 w-4 transition-all group-hover:scale-110\" />\n        <span class=\"sr-only\">{{ brandName }}</span>\n      </a>\n      <TooltipProvider\n        v-for=\"item in navItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:text-foreground md:h-8 md:w-8\"\n              :class=\"{ 'bg-secondary text-secondary-foreground': item.tone === 'active', 'text-muted-foreground': item.tone === 'muted' }\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n    <nav class=\"mt-auto flex flex-col items-center gap-4 px-2 py-4\">\n      <TooltipProvider\n        v-for=\"item in footerItems\"\n        :key=\"item.label\"\n      >\n        <Tooltip>\n          <TooltipTrigger as-child>\n            <a\n              href=\"#\"\n              class=\"flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:text-foreground md:h-8 md:w-8\"\n              :class=\"{ 'bg-secondary text-secondary-foreground': item.tone === 'active', 'text-muted-foreground': item.tone === 'muted' }\"\n            >\n              <component\n                :is=\"item.icon\"\n                class=\"h-5 w-5\"\n              />\n              <span class=\"sr-only\">{{ item.label }}</span>\n            </a>\n          </TooltipTrigger>\n          <TooltipContent side=\"right\">\n            {{ item.label }}\n          </TooltipContent>\n        </Tooltip>\n      </TooltipProvider>\n    </nav>\n  </aside>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/components/ProductsPanel.vue",
      "content": "<script setup lang=\"ts\">\nimport { FileIcon, ListFilterIcon, MoreHorizontalIcon, PlusCircleIcon } from '@lucide/vue';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from '@/components/ui/dropdown-menu';\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from '@/components/ui/table';\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from '@/components/ui/tabs';\nimport type { FilterOption, Product, ProductTab, ProductsCopy } from '../data';\n\ndefineProps<{\n  tabs: ProductTab[];\n  activeTab: string;\n  filterOptions: FilterOption[];\n  products: Product[];\n  detailColumns: string[];\n  actions: string[];\n  summary: { range: string; total: number };\n  copy: ProductsCopy;\n}>();\n</script>\n\n<template>\n  <Tabs :default-value=\"activeTab\">\n    <div class=\"flex items-center\">\n      <TabsList>\n        <TabsTrigger\n          v-for=\"tab in tabs\"\n          :key=\"tab.value\"\n          :value=\"tab.value\"\n          :class=\"{ 'hidden sm:flex': tab.isHiddenOnMobile }\"\n        >\n          {{ tab.label }}\n        </TabsTrigger>\n      </TabsList>\n      <div class=\"ml-auto flex items-center gap-2\">\n        <DropdownMenu>\n          <DropdownMenuTrigger as-child>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              class=\"h-7 gap-1\"\n            >\n              <ListFilterIcon class=\"h-3.5 w-3.5\" />\n              <span class=\"sr-only sm:not-sr-only sm:whitespace-nowrap\">\n                {{ copy.filter }}\n              </span>\n            </Button>\n          </DropdownMenuTrigger>\n          <DropdownMenuContent align=\"end\">\n            <DropdownMenuLabel>{{ copy.filterBy }}</DropdownMenuLabel>\n            <DropdownMenuSeparator />\n            <DropdownMenuItem\n              v-for=\"option in filterOptions\"\n              :key=\"option.label\"\n              v-bind=\"option.isSelected ? { modelValue: true } : {}\"\n            >\n              {{ option.label }}\n            </DropdownMenuItem>\n          </DropdownMenuContent>\n        </DropdownMenu>\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          class=\"h-7 gap-1\"\n        >\n          <FileIcon class=\"h-3.5 w-3.5\" />\n          <span class=\"sr-only sm:not-sr-only sm:whitespace-nowrap\">\n            {{ copy.export }}\n          </span>\n        </Button>\n        <Button\n          size=\"sm\"\n          class=\"h-7 gap-1\"\n        >\n          <PlusCircleIcon class=\"h-3.5 w-3.5\" />\n          <span class=\"sr-only sm:not-sr-only sm:whitespace-nowrap\">\n            {{ copy.addProduct }}\n          </span>\n        </Button>\n      </div>\n    </div>\n    <TabsContent :value=\"activeTab\">\n      <Card>\n        <CardHeader>\n          <CardTitle>{{ copy.title }}</CardTitle>\n          <CardDescription>\n            {{ copy.description }}\n          </CardDescription>\n        </CardHeader>\n        <CardContent>\n          <Table>\n            <TableHeader>\n              <TableRow>\n                <TableHead class=\"hidden w-[100px] sm:table-cell\">\n                  <span class=\"sr-only\">{{ copy.imageColumn }}</span>\n                </TableHead>\n                <TableHead>{{ copy.nameColumn }}</TableHead>\n                <TableHead>{{ copy.statusColumn }}</TableHead>\n                <TableHead\n                  v-for=\"column in detailColumns\"\n                  :key=\"column\"\n                  class=\"hidden md:table-cell\"\n                >\n                  {{ column }}\n                </TableHead>\n                <TableHead>\n                  <span class=\"sr-only\">{{ copy.actionsColumn }}</span>\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              <TableRow\n                v-for=\"product in products\"\n                :key=\"product.name\"\n              >\n                <TableCell class=\"hidden sm:table-cell\">\n                  <img\n                    :alt=\"copy.imageAlt\"\n                    class=\"aspect-square rounded-md object-cover\"\n                    height=\"64\"\n                    :src=\"product.imageUrl\"\n                    width=\"64\"\n                  >\n                </TableCell>\n                <TableCell class=\"font-medium\">\n                  {{ product.name }}\n                </TableCell>\n                <TableCell>\n                  <Badge :variant=\"product.badgeVariant\">\n                    {{ product.status }}\n                  </Badge>\n                </TableCell>\n                <TableCell class=\"hidden md:table-cell\">\n                  {{ product.price }}\n                </TableCell>\n                <TableCell class=\"hidden md:table-cell\">\n                  {{ product.totalSales }}\n                </TableCell>\n                <TableCell class=\"hidden md:table-cell\">\n                  {{ product.createdAt }}\n                </TableCell>\n                <TableCell>\n                  <DropdownMenu>\n                    <DropdownMenuTrigger as-child>\n                      <Button\n                        aria-haspopup=\"true\"\n                        size=\"icon\"\n                        variant=\"ghost\"\n                      >\n                        <MoreHorizontalIcon class=\"h-4 w-4\" />\n                        <span class=\"sr-only\">{{ copy.rowMenu }}</span>\n                      </Button>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent align=\"end\">\n                      <DropdownMenuLabel>{{ copy.actionsMenu }}</DropdownMenuLabel>\n                      <DropdownMenuItem\n                        v-for=\"action in actions\"\n                        :key=\"action\"\n                      >\n                        {{ action }}\n                      </DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </TableCell>\n              </TableRow>\n            </TableBody>\n          </Table>\n        </CardContent>\n        <CardFooter>\n          <div class=\"text-xs text-muted-foreground\">\n            {{ copy.showing }} <strong>{{ summary.range }}</strong> {{ copy.of }} <strong>{{ summary.total }}</strong>\n            {{ copy.products }}\n          </div>\n        </CardFooter>\n      </Card>\n    </TabsContent>\n  </Tabs>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/dashboard-products/data.ts",
      "content": "import type { Component } from 'vue';\nimport {\n  HomeIcon,\n  LineChartIcon,\n  PackageIcon,\n  SettingsIcon,\n  ShoppingCartIcon,\n  Users2Icon,\n} from '@lucide/vue';\nimport { placeholderImage } from './placeholder';\n\nexport type SidebarLinkTone = 'default' | 'muted' | 'active';\n\nexport interface SidebarLink {\n  label: string;\n  icon: Component;\n  tone: SidebarLinkTone;\n}\n\nexport interface MobileNavLink {\n  label: string;\n  icon: Component;\n  isActive: boolean;\n}\n\nexport interface ProductTab {\n  value: string;\n  label: string;\n  isHiddenOnMobile: boolean;\n}\n\nexport interface FilterOption {\n  label: string;\n  isSelected?: boolean;\n}\n\nexport type ProductStatus = 'Active' | 'Draft';\n\nexport interface Product {\n  name: string;\n  status: ProductStatus;\n  badgeVariant: 'outline' | 'secondary';\n  price: string;\n  totalSales: number;\n  createdAt: string;\n  imageUrl: string;\n}\n\nexport interface HeaderCopy {\n  toggleMenu: string;\n  searchPlaceholder: string;\n  toggleAccount: string;\n  accountLabel: string;\n}\n\nexport interface ProductsCopy {\n  title: string;\n  description: string;\n  filter: string;\n  filterBy: string;\n  export: string;\n  addProduct: string;\n  imageAlt: string;\n  imageColumn: string;\n  nameColumn: string;\n  statusColumn: string;\n  actionsColumn: string;\n  actionsMenu: string;\n  rowMenu: string;\n  showing: string;\n  of: string;\n  products: string;\n}\n\nexport const sidebarLinks: SidebarLink[] = [\n  { label: 'Dashboard', icon: HomeIcon, tone: 'muted' },\n  { label: 'Orders', icon: ShoppingCartIcon, tone: 'default' },\n  { label: 'Products', icon: PackageIcon, tone: 'active' },\n  { label: 'Customers', icon: Users2Icon, tone: 'muted' },\n  { label: 'Analytics', icon: LineChartIcon, tone: 'muted' },\n];\n\nexport const sidebarFooterLinks: SidebarLink[] = [\n  { label: 'Settings', icon: SettingsIcon, tone: 'muted' },\n];\n\nexport const mobileNavLinks: MobileNavLink[] = [\n  { label: 'Dashboard', icon: HomeIcon, isActive: false },\n  { label: 'Orders', icon: ShoppingCartIcon, isActive: false },\n  { label: 'Products', icon: PackageIcon, isActive: true },\n  { label: 'Customers', icon: Users2Icon, isActive: false },\n  { label: 'Settings', icon: LineChartIcon, isActive: false },\n];\n\nexport const breadcrumbLinks: string[] = ['Dashboard', 'Products'];\n\nexport const currentBreadcrumb = 'All Products';\n\nexport const productTabs: ProductTab[] = [\n  { value: 'all', label: 'All', isHiddenOnMobile: false },\n  { value: 'active', label: 'Active', isHiddenOnMobile: false },\n  { value: 'draft', label: 'Draft', isHiddenOnMobile: false },\n  { value: 'archived', label: 'Archived', isHiddenOnMobile: true },\n];\n\nexport const filterOptions: FilterOption[] = [\n  { label: 'Active', isSelected: true },\n  { label: 'Draft' },\n  { label: 'Archived' },\n];\n\nexport const productDetailColumns: string[] = ['Price', 'Total Sales', 'Created at'];\n\nexport const productActions: string[] = ['Edit', 'Delete'];\n\nexport const products: Product[] = [\n  {\n    name: 'Laser Lemonade Machine',\n    status: 'Draft',\n    badgeVariant: 'outline',\n    price: '$499.99',\n    totalSales: 25,\n    createdAt: '2023-07-12 10:42 AM',\n    imageUrl: placeholderImage,\n  },\n  {\n    name: 'Hypernova Headphones',\n    status: 'Active',\n    badgeVariant: 'outline',\n    price: '$129.99',\n    totalSales: 100,\n    createdAt: '2023-10-18 03:21 PM',\n    imageUrl: placeholderImage,\n  },\n  {\n    name: 'AeroGlow Desk Lamp',\n    status: 'Active',\n    badgeVariant: 'outline',\n    price: '$39.99',\n    totalSales: 50,\n    createdAt: '2023-11-29 08:15 AM',\n    imageUrl: placeholderImage,\n  },\n  {\n    name: 'TechTonic Energy Drink',\n    status: 'Draft',\n    badgeVariant: 'secondary',\n    price: '$2.99',\n    totalSales: 0,\n    createdAt: '2023-12-25 11:59 PM',\n    imageUrl: placeholderImage,\n  },\n  {\n    name: 'Gamer Gear Pro Controller',\n    status: 'Active',\n    badgeVariant: 'outline',\n    price: '$59.99',\n    totalSales: 75,\n    createdAt: '2024-01-01 12:00 AM',\n    imageUrl: placeholderImage,\n  },\n  {\n    name: 'Luminous VR Headset',\n    status: 'Active',\n    badgeVariant: 'outline',\n    price: '$199.99',\n    totalSales: 30,\n    createdAt: '2024-02-14 02:14 PM',\n    imageUrl: placeholderImage,\n  },\n];\n\nexport const productsSummary = {\n  range: '1-10',\n  total: 32,\n};\n\nexport const brandName = 'Acme Inc';\n\nexport const defaultProductTab = 'all';\n\nexport const headerCopy: HeaderCopy = {\n  toggleMenu: 'Toggle Menu',\n  searchPlaceholder: 'Search...',\n  toggleAccount: 'Toggle user menu',\n  accountLabel: 'My Account',\n};\n\nexport const accountMenuGroups: string[][] = [\n  ['Settings', 'Support'],\n  ['Logout'],\n];\n\nexport const productsCopy: ProductsCopy = {\n  title: 'Products',\n  description: 'Manage your products and view their sales performance.',\n  filter: 'Filter',\n  filterBy: 'Filter by',\n  export: 'Export',\n  addProduct: 'Add Product',\n  imageAlt: 'Product image',\n  imageColumn: 'img',\n  nameColumn: 'Name',\n  statusColumn: 'Status',\n  actionsColumn: 'Actions',\n  actionsMenu: 'Actions',\n  rowMenu: 'Toggle menu',\n  showing: 'Showing',\n  of: 'of',\n  products: 'products',\n};\n",
      "type": "registry:lib"
    },
    {
