      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\n</script>\n\n<template>\n  <div class=\"w-full h-[100vh] flex lg:min-h-[600px] xl:min-h-[800px]\">\n    <div class=\"flex-1 flex items-center justify-center py-12\">\n      <div class=\"mx-auto w-[350px] max-w-full\">\n        <div class=\"grid gap-2 text-center\">\n          <h1 class=\"text-3xl font-bold\">\n            Login\n          </h1>\n          <p class=\"mb-8 text-pretty text-muted-foreground\">\n            Enter your credentials below to login to your account\n          </p>\n        </div>\n        <div class=\"grid gap-4\">\n          <div class=\"grid gap-2\">\n            <Label for=\"email\">Email</Label>\n            <Input\n              id=\"email\"\n              type=\"email\"\n              placeholder=\"m@example.com\"\n              required\n            />\n          </div>\n          <div class=\"grid gap-2\">\n            <div class=\"flex items-center\">\n              <Label for=\"password\">Password</Label>\n              <a\n                href=\"/forgot-password\"\n                class=\"ml-auto inline-block text-sm underline\"\n              >\n                Forgot your password?\n              </a>\n            </div>\n            <Input\n              id=\"password\"\n              type=\"password\"\n              required\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            class=\"w-full\"\n          >\n            Login\n          </Button>\n          <Button\n            variant=\"outline\"\n            type=\"button\"\n            class=\"w-full\"\n          >\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              viewBox=\"0 0 24 24\"\n              class=\"size-4\"\n              aria-hidden=\"true\"\n            >\n              <path\n                fill=\"#4285F4\"\n                d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z\"\n              />\n              <path\n                fill=\"#34A853\"\n                d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z\"\n              />\n              <path\n                fill=\"#FBBC05\"\n                d=\"M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84Z\"\n              />\n              <path\n                fill=\"#EA4335\"\n                d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z\"\n              />\n            </svg>\n            Login with Google\n          </Button>\n        </div>\n        <div class=\"mt-4 text-center text-sm\">\n          Don't have an account?\n          <a\n            href=\"#\"\n            class=\"underline\"\n          >\n            Sign up\n          </a>\n        </div>\n      </div>\n    </div>\n    <div class=\"hidden lg:flex lg:flex-1 bg-muted\">\n      <img\n        src=\"/placeholder.svg\"\n        alt=\"Image\"\n        width=\"1920\"\n        height=\"1080\"\n        class=\"h-full w-full object-cover dark:invert dark:hue-rotate-180 select-none\"\n      >\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    }
