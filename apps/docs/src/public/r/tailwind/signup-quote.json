{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "signup-quote",
  "type": "registry:block",
  "title": "Sign up with quote",
  "description": "A two-column sign up page. One column quotes a customer. The other collects an email, offers GitHub, and links to the terms and privacy policy.",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label",
    "separator"
  ],
  "files": [
    {
      "path": "blocks/signup-quote/SignupQuote.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport SignupForm from './components/SignupForm.vue';\nimport {\n  brandName,\n  conjunctionLabel,\n  description,\n  dividerLabel,\n  emailLabel,\n  emailPlaceholder,\n  emailSubmitLabel,\n  githubLabel,\n  googleLabel,\n  loginHref,\n  loginLabel,\n  privacyHref,\n  privacyLabel,\n  quote,\n  quoteAuthor,\n  quoteAuthorRole,\n  stats,\n  termsHref,\n  termsLabel,\n  termsLead,\n  title,\n} from './data';\n\nconst quoteAuthorInitials = quoteAuthor\n  .split(' ')\n  .map(part => part.charAt(0))\n  .join('');\n</script>\n\n<template>\n  <div class=\"relative grid min-h-screen lg:grid-cols-2\">\n    <div class=\"relative hidden h-full flex-col overflow-hidden border-r bg-muted p-10 text-foreground lg:flex\">\n      <div\n        class=\"pointer-events-none absolute -top-32 -left-32 size-96 rounded-full bg-primary/10 blur-3xl\"\n        aria-hidden=\"true\"\n      />\n      <div\n        class=\"pointer-events-none absolute -right-24 -bottom-40 size-96 rounded-full bg-primary/5 blur-3xl\"\n        aria-hidden=\"true\"\n      />\n      <div class=\"relative flex items-center gap-2 text-lg font-medium\">\n        <span class=\"flex size-8 items-center justify-center rounded-md bg-primary text-primary-foreground\">\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            class=\"size-4\"\n            aria-hidden=\"true\"\n          >\n            <path d=\"M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3\" />\n          </svg>\n        </span>\n        {{ brandName }}\n      </div>\n      <figure class=\"relative my-auto flex max-w-md flex-col gap-6 py-12\">\n        <blockquote class=\"text-2xl leading-snug font-medium tracking-tight text-balance\">\n          &ldquo;{{ quote }}&rdquo;\n        </blockquote>\n        <figcaption class=\"flex items-center gap-3\">\n          <span\n            class=\"flex size-10 items-center justify-center rounded-full border bg-background text-sm font-medium\"\n            aria-hidden=\"true\"\n          >\n            {{ quoteAuthorInitials }}\n          </span>\n          <span class=\"flex flex-col\">\n            <span class=\"text-sm font-medium\">{{ quoteAuthor }}</span>\n            <span class=\"text-sm text-muted-foreground\">{{ quoteAuthorRole }}</span>\n          </span>\n        </figcaption>\n      </figure>\n      <dl class=\"relative grid grid-cols-3 gap-6 border-t pt-6\">\n        <div\n          v-for=\"stat in stats\"\n          :key=\"stat.label\"\n          class=\"flex flex-col gap-1\"\n        >\n          <dt class=\"text-sm text-muted-foreground\">\n            {{ stat.label }}\n          </dt>\n          <dd class=\"order-first text-2xl font-semibold tracking-tight\">\n            {{ stat.value }}\n          </dd>\n        </div>\n      </dl>\n    </div>\n    <div class=\"relative flex items-center justify-center px-6 py-16 lg:px-10\">\n      <Button\n        as=\"a\"\n        variant=\"ghost\"\n        :href=\"loginHref\"\n        class=\"absolute top-4 right-4 md:top-8 md:right-8\"\n      >\n        {{ loginLabel }}\n      </Button>\n      <div class=\"flex w-full max-w-sm flex-col gap-6\">\n        <div class=\"flex flex-col gap-2 text-center\">\n          <h1 class=\"text-2xl font-semibold tracking-tight\">\n            {{ title }}\n          </h1>\n          <p class=\"text-sm text-muted-foreground\">\n            {{ description }}\n          </p>\n        </div>\n        <SignupForm\n          :email-label=\"emailLabel\"\n          :email-placeholder=\"emailPlaceholder\"\n          :email-submit-label=\"emailSubmitLabel\"\n          :divider-label=\"dividerLabel\"\n          :google-label=\"googleLabel\"\n          :github-label=\"githubLabel\"\n        />\n        <p class=\"px-6 text-center text-sm text-balance text-muted-foreground\">\n          {{ termsLead }}\n          <a\n            :href=\"termsHref\"\n            class=\"underline underline-offset-4 hover:text-primary\"\n          >{{ termsLabel }}</a>\n          {{ conjunctionLabel }}\n          <a\n            :href=\"privacyHref\"\n            class=\"underline underline-offset-4 hover:text-primary\"\n          >{{ privacyLabel }}</a>.\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/components/SignupForm.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Separator } from '@/components/ui/separator';\n\ndefineProps<{\n  emailLabel: string;\n  emailPlaceholder: string;\n  emailSubmitLabel: string;\n  dividerLabel: string;\n  googleLabel: string;\n  githubLabel: string;\n}>();\n\nconst isLoading = ref(false);\n\nfunction onSubmit(event: Event) {\n  event.preventDefault();\n  isLoading.value = true;\n\n  setTimeout(() => {\n    isLoading.value = false;\n  }, 3000);\n}\n</script>\n\n<template>\n  <div class=\"grid gap-6\">\n    <form\n      class=\"grid gap-3\"\n      @submit=\"onSubmit\"\n    >\n      <Label\n        class=\"sr-only\"\n        for=\"email\"\n      >\n        {{ emailLabel }}\n      </Label>\n      <Input\n        id=\"email\"\n        :placeholder=\"emailPlaceholder\"\n        type=\"email\"\n        auto-capitalize=\"none\"\n        auto-complete=\"email\"\n        auto-correct=\"off\"\n        :disabled=\"isLoading\"\n      />\n      <Button\n        type=\"submit\"\n        class=\"w-full\"\n        :is-loading=\"isLoading\"\n      >\n        {{ emailSubmitLabel }}\n      </Button>\n    </form>\n    <div class=\"flex items-center gap-3\">\n      <Separator class=\"flex-1\" />\n      <span class=\"text-xs tracking-wide text-muted-foreground uppercase\">\n        {{ dividerLabel }}\n      </span>\n      <Separator class=\"flex-1\" />\n    </div>\n    <div class=\"grid gap-3 sm:grid-cols-2\">\n      <Button\n        variant=\"outline\"\n        type=\"button\"\n        class=\"w-full\"\n        :disabled=\"isLoading\"\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          class=\"size-4\"\n          aria-hidden=\"true\"\n        >\n          <path\n            fill=\"#4285F4\"\n            d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1Z\"\n          />\n          <path\n            fill=\"#34A853\"\n            d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z\"\n          />\n          <path\n            fill=\"#FBBC05\"\n            d=\"M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84Z\"\n          />\n          <path\n            fill=\"#EA4335\"\n            d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52Z\"\n          />\n        </svg>\n        {{ googleLabel }}\n      </Button>\n      <Button\n        variant=\"outline\"\n        type=\"button\"\n        class=\"w-full\"\n        :disabled=\"isLoading\"\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          fill=\"currentColor\"\n          class=\"size-4\"\n          aria-hidden=\"true\"\n        >\n          <path d=\"M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z\" />\n        </svg>\n        {{ githubLabel }}\n      </Button>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "blocks/signup-quote/data.ts",
      "content": "export const loginLabel = 'Login';\nexport const loginHref = '#';\nexport const brandName = 'Acme Inc';\nexport const quote = 'This library has saved me countless hours of work and helped me deliver stunning designs to my clients faster than ever before.';\nexport const quoteAuthor = 'Sofia Davis';\nexport const quoteAuthorRole = 'Founder, Northwind Studio';\nexport const stats = [\n  { value: '12k+', label: 'Teams onboarded' },\n  { value: '4.9/5', label: 'Average rating' },\n  { value: '99.9%', label: 'Uptime' },\n];\nexport const title = 'Create an account';\nexport const description = 'Enter your email below to create your account';\nexport const termsLead = 'By clicking continue, you agree to our';\nexport const termsLabel = 'Terms of Service';\nexport const termsHref = '#';\nexport const privacyLabel = 'Privacy Policy';\nexport const privacyHref = '#';\nexport const conjunctionLabel = 'and';\nexport const emailLabel = 'Email';\nexport const emailPlaceholder = 'name@example.com';\nexport const emailSubmitLabel = 'Continue with email';\nexport const dividerLabel = 'Or continue with';\nexport const googleLabel = 'Google';\nexport const githubLabel = 'GitHub';\n",
      "type": "registry:lib"
    }
  ],
  "meta": {
    "iframeHeight": "800px",
    "containerClass": "w-full h-full"
  },
  "categories": [
    "authentication",
    "signup",
    "signup-quote"
  ]
}
