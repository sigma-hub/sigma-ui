{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "direction",
  "type": "registry:ui",
  "title": "Direction",
  "description": "Sets the reading direction for Reka primitives, including right-to-left layouts.",
  "dependencies": [
    "reka-ui@^2.11.0"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "ui/direction/Direction.vue",
      "content": "<script setup lang=\"ts\">\nimport { useAttrs } from 'vue';\n\nimport { ConfigProvider, type ConfigProviderProps } from 'reka-ui';\nimport { cn } from '@/lib/utils';\n\ndefineOptions({\n  inheritAttrs: false,\n});\n\nconst attrs = useAttrs();\n\nconst delegatedAttrs = () => {\n  return Object.fromEntries(Object.entries(attrs).filter(([key]) => key !== 'class'));\n};\n\ninterface DirectionProps {\n  /**\n   * Reading direction inherited by Reka primitives inside this provider.\n   */\n  dir?: ConfigProviderProps['dir'];\n  /**\n   * Locale inherited by Reka primitives inside this provider.\n   */\n  locale?: ConfigProviderProps['locale'];\n}\n\nconst props = withDefaults(defineProps<DirectionProps>(), {\n  dir: 'ltr',\n  locale: 'en',\n});\n\ndefineSlots<{\n  /**\n   * Content that inherits this reading direction.\n   */\n  default?: () => unknown;\n}>();\n</script>\n\n<template>\n  <ConfigProvider\n    :dir=\"props.dir\"\n    :locale=\"props.locale\"\n  >\n    <div\n      data-slot=\"direction\"\n      v-bind=\"delegatedAttrs()\"\n      :dir=\"props.dir\"\n      :class=\"cn('contents', $attrs.class ?? '')\"\n    >\n      <slot />\n    </div>\n  </ConfigProvider>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "ui/direction/index.ts",
      "content": "export { default as Direction } from './Direction.vue';\nexport { useDirection } from 'reka-ui';\n",
      "type": "registry:ui"
    }
  ]
}
