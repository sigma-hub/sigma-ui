{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"],
      "~/*": ["../../*"]
    },
    "isolatedModules": false,
    "target": "ES2022",
    "lib": ["ES2023"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "test"]
}
