{
  "name": "sigma-ui",
  "type": "module",
  "version": "2.0.0",
  "description": "CLI for SIGMA-UI components.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigma-hub/sigma-ui.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ui",
    "components",
    "collection",
    "library",
    "vue",
    "nuxt",
    "tailwind",
    "reka-ui",
    "shadcn",
    "sigma-hub",
    "sigma-ui"
  ],
  "exports": "./dist/index.js",
  "bin": {
    "sigma-ui": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepack": "pnpm build && node ../../scripts/copy-publish-files.mjs",
    "ts": "tsc --noEmit",
    "clean": "node ./scripts/rimraf.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start:dev": "SIGMA_UI_REGISTRY_URL=http://localhost:5173/r node dist/index.js",
    "preview:dev": "pnpm build && SIGMA_UI_REGISTRY_URL=http://localhost:5173/r node dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "consola": "^3.4.2",
    "diff": "^7.0.0",
    "lodash-es": "catalog:",
    "magicast": "^0.3.5",
    "ora": "^8.2.0",
    "pathe": "catalog:",
    "pkg-types": "^1.3.1",
    "prompts": "^2.4.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sigma-ui/shared": "workspace:*",
    "@types/diff": "^7.0.2",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "type-fest": "^4.41.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
