{
  "name": "sigma-ui-nuxt",
  "version": "1.0.0",
  "description": "Nuxt module that auto-imports SIGMA-UI components.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigma-hub/sigma-ui.git",
    "directory": "packages/nuxt-module"
  },
  "homepage": "https://sigma-ui.dev/docs/installation/nuxt",
  "bugs": "https://github.com/sigma-hub/sigma-ui/issues",
  "license": "MIT",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "ui",
    "components",
    "reka-ui",
    "tailwind",
    "sigma-ui"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "ts": "nuxt-module-build prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.1",
    "oxc-parser": "^0.154.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@sigma-ui/shared": "workspace:*",
    "@types/node": "^22.13.1",
    "nuxt": "^4.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
